 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -1063,6 +1063,24 @@ REARC_ENGINE_EXPORT void ReArcEngineSetLinkOpenCallback(ReArcLinkOpenCallback, v
 // registration replacement or 30 s timeout. Explicit rel=opener is unsupported.
 REARC_ENGINE_EXPORT ReArcStatus ReArcLinkOpenRespond(uint64_t request_id, uint64_t tab_id);
 
+// Page key equivalents (key_equivalent_events, ABI 1.42). With a callback
+// set, every Command or Control key-down a tab's page acknowledges is
+// reported once, after the page saw it: consumed true when the page took it
+// (a keydown handler's preventDefault, or an editing command such as Copy in
+// a field), false when Chromium would otherwise drop it unhandled. The host
+// runs its own shortcut for an unconsumed key; the engine never does.
+// key_code is the macOS virtual key code, modifiers the NSEventModifierFlags
+// shift/control/option/command bits, characters the key's text ignoring
+// modifiers (borrowed UTF-8). Delivered asynchronously on the main thread.
+typedef struct ReArcKeyEquivalentEvent {
+  uint64_t profile_id, tab_id, modifiers;
+  uint32_t key_code;
+  bool consumed;
+  const char* characters;
+} ReArcKeyEquivalentEvent;
+typedef void (*ReArcKeyEquivalentCallback)(void*, const ReArcKeyEquivalentEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetKeyEquivalentCallback(ReArcKeyEquivalentCallback, void* context);
+
 // Password leak detection (password_leak_detection, ABI 1.35): Chromium's
 // profile.password_manager_leak_detection pref, default on as in Chrome. When
 // on, a successfully submitted sign-in's credential is checked against
