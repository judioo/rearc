diff --git a/chrome/browser/rearc_bridge/rearc_key_equivalents.cc b/chrome/browser/rearc_bridge/rearc_key_equivalents.cc
new file mode 100644
index 0000000000..7031d55a14
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_key_equivalents.cc
@@ -0,0 +1,129 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_key_equivalents.h"
+
+#include <pthread.h>
+
+#include <set>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_observer.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+
+namespace rearc {
+namespace {
+ReArcKeyEquivalentCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+
+// NSEventModifierFlags, so the host compares with its own NSEvent.
+constexpr uint64_t kShift = 1ull << 17, kControl = 1ull << 18,
+                   kOption = 1ull << 19, kCommand = 1ull << 20;
+
+// Watches every widget of one tab (main frame and out-of-process iframes) for
+// the page's verdict on Command/Control key-downs. Widgets are attached just
+// before a key is forwarded, and dropped when they are destroyed.
+class KeyAcks : public content::WebContentsUserData<KeyAcks>,
+                public content::RenderWidgetHost::InputEventObserver,
+                public content::RenderWidgetHostObserver {
+ public:
+  ~KeyAcks() override {
+    for (auto* widget : widgets_) {
+      widget->RemoveInputEventObserver(this);
+      widget->RemoveObserver(this);
+    }
+  }
+  void Attach(uint64_t tab_id) {
+    tab_id_ = tab_id;
+    GetWebContents().ForEachRenderFrameHost(
+        [this](content::RenderFrameHost* frame) {
+          auto* widget = frame->GetRenderWidgetHost();
+          if (!widget || !widgets_.insert(widget).second) return;
+          widget->AddInputEventObserver(this);
+          widget->AddObserver(this);
+        });
+  }
+
+  // content::RenderWidgetHost::InputEventObserver:
+  void OnInputEventAck(const content::RenderWidgetHost&,
+                       blink::mojom::InputEventResultSource,
+                       blink::mojom::InputEventResultState state,
+                       const blink::WebInputEvent& event) override {
+    if (!host || event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+      return;
+    }
+    const auto& key = static_cast<const blink::WebKeyboardEvent&>(event);
+    const int modifiers = key.GetModifiers();
+    if (!(modifiers & (blink::WebInputEvent::kMetaKey |
+                       blink::WebInputEvent::kControlKey))) {
+      return;
+    }
+    uint64_t flags = 0;
+    if (modifiers & blink::WebInputEvent::kShiftKey) flags |= kShift;
+    if (modifiers & blink::WebInputEvent::kControlKey) flags |= kControl;
+    if (modifiers & blink::WebInputEvent::kAltKey) flags |= kOption;
+    if (modifiers & blink::WebInputEvent::kMetaKey) flags |= kCommand;
+    TabSession* session = TabRegistry::Get().FindSession(tab_id_);
+    std::string characters = base::UTF16ToUTF8(key.unmodified_text.data());
+    // Posted: the host's shortcut may close this tab, and with it the widget
+    // still notifying its observers.
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, uint64_t profile_id, uint64_t tab_id,
+           uint64_t flags, uint32_t key_code, bool consumed,
+           std::string characters) {
+          if (!host || expected != epoch) return;
+          ReArcKeyEquivalentEvent out{profile_id, tab_id, flags, key_code,
+                                      consumed, characters.c_str()};
+          host(host_context, &out);
+        },
+        epoch, session ? session->profile_id() : 0, tab_id_, flags,
+        static_cast<uint32_t>(key.native_key_code),
+        state == blink::mojom::InputEventResultState::kConsumed,
+        std::move(characters)));
+  }
+
+  // content::RenderWidgetHostObserver:
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost* widget) override {
+    widget->RemoveInputEventObserver(this);
+    widget->RemoveObserver(this);
+    widgets_.erase(widget);
+  }
+
+ private:
+  friend class content::WebContentsUserData<KeyAcks>;
+  explicit KeyAcks(content::WebContents* contents)
+      : content::WebContentsUserData<KeyAcks>(*contents) {}
+  uint64_t tab_id_ = 0;
+  std::set<content::RenderWidgetHost*> widgets_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(KeyAcks);
+}  // namespace
+
+void ObserveHostKeyEquivalents(uint64_t tab_id,
+                               content::WebContents* contents) {
+  if (!host || !contents) return;
+  KeyAcks::GetOrCreateForWebContents(contents)->Attach(tab_id);
+}
+}  // namespace rearc
+
+void ReArcEngineSetKeyEquivalentCallback(ReArcKeyEquivalentCallback callback,
+                                         void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+}
