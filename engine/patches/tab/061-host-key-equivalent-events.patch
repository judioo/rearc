+// Wave 30 (key_equivalent_events): called before a key reaches the page, so
+// the page's acknowledgement of a Command/Control key-down reaches the host.
+void ObserveHostKeyEquivalents(uint64_t tab_id, content::WebContents* contents);
+}  // namespace rearc
