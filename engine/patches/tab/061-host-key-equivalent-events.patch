+  ObserveHostKeyEquivalents(tab_id_, source);
   return HandleHostFullscreenKey(source, event)
              ? content::KeyboardEventProcessingResult::HANDLED
              : content::KeyboardEventProcessingResult::NOT_HANDLED;
