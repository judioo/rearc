+
+void DownloadHistory::RestoreArchivedRows(base::OnceClosure done) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!initial_history_query_complete_) {
+    after_load_.push_back(base::BindOnce(&DownloadHistory::RestoreArchivedRows,
+                                         weak_ptr_factory_.GetWeakPtr(),
+                                         std::move(done)));
+    return;
+  }
+  if (!has_archived_rows()) {
+    std::move(done).Run();
+    return;
+  }
+  after_restore_.push_back(std::move(done));
+  if (restoring_) {
+    return;
+  }
+  restoring_ = true;
+  // Archived rows keep a summary only: items need the database's full rows.
+  history_->QueryDownloads(base::BindOnce(
+      &DownloadHistory::RestoreQueryCallback, weak_ptr_factory_.GetWeakPtr()));
+}
+
+// static
+std::unique_ptr<DownloadHistory::RestoreLoad>
+DownloadHistory::PrepareRestoreRows(std::vector<history::DownloadRow> rows,
+                                    scoped_refptr<const ArchivedRows> archived) {
+  std::set<std::string> guids;
+  for (const ArchivedRow& row : archived->data) {
+    guids.insert(row.guid);
+  }
+  auto load = std::make_unique<RestoreLoad>();
+  for (history::DownloadRow& row : rows) {
+    if (guids.contains(row.guid)) {
+      load->rows.push_back(std::move(row));
+    }
+  }
+  std::sort(load->rows.begin(), load->rows.end(),
+            [](const history::DownloadRow& a, const history::DownloadRow& b) {
+              if (a.start_time != b.start_time) {
+                return a.start_time > b.start_time;
+              }
+              return a.id > b.id;
+            });
+  return load;
+}
+
+void DownloadHistory::RestoreQueryCallback(
+    std::vector<history::DownloadRow> rows) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!notifier_.GetManager()) {
+    return;
+  }
+  if (!archived_rows_) {
+    FinishRestore();
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&DownloadHistory::PrepareRestoreRows, std::move(rows),
+                     scoped_refptr<const ArchivedRows>(archived_rows_)),
+      base::BindOnce(&DownloadHistory::RestorePrepared,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void DownloadHistory::RestorePrepared(std::unique_ptr<RestoreLoad> load) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!notifier_.GetManager()) {
+    return;
+  }
+  restore_load_ = std::move(load);
+  RestoreSlice();
+}
+
+void DownloadHistory::RestoreSlice() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::DownloadManager* manager = notifier_.GetManager();
+  if (!manager || !restore_load_) {
+    return;
+  }
+  const base::TimeTicks deadline =
+      base::TimeTicks::Now() + kHistoryLoadSliceBudget;
+  RestoreLoad& load = *restore_load_;
+  while (load.next < load.rows.size()) {
+    const history::DownloadRow& row = load.rows[load.next++];
+    // Removed meanwhile (the host, clearing browsing data), or an item now.
+    if (!restore_removed_.contains(row.guid) &&
+        !manager->GetDownloadByGuid(row.guid) &&
+        LoadHistoryRow(row, base::FilePath())) {
+      ++live_row_count_;
+    }
+    manager = notifier_.GetManager();
+    if (!manager) {
+      return;
+    }
+    if (load.next < load.rows.size() && base::TimeTicks::Now() >= deadline) {
+      content::GetUIThreadTaskRunner({})->PostTask(
+          FROM_HERE, base::BindOnce(&DownloadHistory::RestoreSlice,
+                                    weak_ptr_factory_.GetWeakPtr()));
+      return;
+    }
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::TaskPriority::BEST_EFFORT},
+      base::DoNothingWithBoundArgs(std::move(restore_load_)));
+  FinishRestore();
+}
+
+void DownloadHistory::FinishRestore() {
+  // Every archived row is an item now, or was removed.
+  archived_rows_ = nullptr;
+  restoring_ = false;
+  restore_removed_.clear();
+  for (base::OnceClosure& closure : std::exchange(after_restore_, {})) {
+    std::move(closure).Run();
+  }
+  const LoadPolicyData* policy =
+      GetLoadPolicy(notifier_.GetManager()->GetBrowserContext());
+  if (policy && policy->on_loaded) {
+    policy->on_loaded.Run();
+  }
+}
+
 void DownloadHistory::MaybeAddToHistory(download::DownloadItem* item) {
   DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
 
