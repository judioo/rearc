 void InitializeDownloadHistory(content::BrowserContext* context) {
   DownloadCoreService* service =
       DownloadCoreServiceFactory::GetForBrowserContext(context);
@@ -1136,11 +1175,17 @@ ExtensionFunction::ResponseAction DownloadsFunction::Run() {
       return RespondLater();
     }
   }
+  if (RestoreArchivedRowsFirst(this, manager->GetBrowserContext())) {
+    return RespondLater();
+  }
 
   return RunInternal();
 }
 
 void DownloadsFunction::ExecuteFromQueue() {
+  if (RestoreArchivedRowsFirst(this, browser_context())) {
+    return;
+  }
   ResponseAction action = RunInternal();
   action.Execute();
 }
