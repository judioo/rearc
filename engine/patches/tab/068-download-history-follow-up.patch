+// ReArc: a downloads function waiting for archived history rows to become
+// items. Dropped unrun (the history goes away), it fails as a function queued
+// for initialization does when the manager goes down.
+class PendingArchivedRestore {
+ public:
+  explicit PendingArchivedRestore(scoped_refptr<DownloadsFunction> function)
+      : function_(std::move(function)) {}
+  ~PendingArchivedRestore() {
+    if (function_) {
+      function_->OnManagerGoingDown();
+    }
+  }
+  void Run() { std::exchange(function_, nullptr)->ExecuteFromQueue(); }
+
+ private:
+  scoped_refptr<DownloadsFunction> function_;
+};
+
+// ReArc (download history at scale): any downloads function but download()
+// may address an archived history row (search, erase, an ID from an earlier
+// session), so archived rows become items first; true when |function| waits.
+bool RestoreArchivedRowsFirst(DownloadsFunction* function,
+                              content::BrowserContext* context) {
+  if (!context || std::string_view(function->name()) == "downloads.download") {
+    return false;
+  }
+  DownloadHistory* history = DownloadHistory::ForContext(
+      Profile::FromBrowserContext(context)->GetOriginalProfile());
+  if (!history || !history->has_archived_rows()) {
+    return false;
+  }
+  history->RestoreArchivedRows(base::BindOnce(
+      &PendingArchivedRestore::Run,
+      base::Owned(std::make_unique<PendingArchivedRestore>(
+          base::WrapRefCounted(function)))));
+  return true;
+}
