+// Returns a self-contained isolated-world script. Host scope is checked for
+// each document; a pathname prefix matches only at a path-segment boundary.
+std::string ScriptSource(const Script& s, bool css_only) {
+  base::ListValue rules;
+  for (const auto& scope : s.scopes) {
+    rules.Append(base::DictValue()
+                     .Set("host", scope.host)
+                     .Set("path", scope.path)
+                     .Set("subdomains", scope.subdomains)
+                     .Set("schemes", static_cast<int>(scope.schemes)));
+  }
+  std::string body =
+      "(()=>{if(window!==window.top)return;const rules=" +
+      base::WriteJson(rules).value() +
+      ";function eligible(){const l=location;const "
+      "scheme=l.protocol==='http:'?1:"
+      "l.protocol==='https:'?2:0;return !!scheme&&rules.some(r=>"
+      "(r.schemes&scheme)&&(l.hostname===r.host||r.subdomains&&"
+      "l.hostname.endsWith('.'+r.host))&&(!r.path||l.pathname===r.path||"
+      "l.pathname.startsWith(r.path.endsWith('/')?r.path:r.path+'/')));}"
+      "const id='rearc-boost-'+" +
+      Quote(s.id) +
+      ";function css(){let "
+      "n=document.getElementById(id);if(!eligible()){if(n)n.remove();return;}"
+      "const text=" +
+      Quote(s.css) +
+      ";if(!text){if(n)n.remove();return;}"
+      "if(!document.documentElement)return;const "
+      "allowed=document.documentElement."
+      "getAttribute('data-rearc-abi-plan');if(allowed&&!JSON.parse(allowed)."
+      "includes(id))"
+      "{if(n)n.remove();return;}if(!n){n=document.createElement('style');n.id="
+      "id;"
+      "n.setAttribute('data-rearc-abi','');}n.textContent=text;const order=" +
+      std::to_string(s.order) +
+      ";n.setAttribute('data-rearc-order',String(order));"
+      "const "
+      "next=Array.from(document.querySelectorAll('style[data-rearc-abi]'))."
+      "find("
+      "x=>x!==n&&Number(x.getAttribute('data-rearc-order'))>order);"
+      "if(next)next.before(n);else(document.head||document.documentElement)."
+      "appendChild(n);}";
+  const std::string listener =
+      "if(!globalThis.__rearcCSSListener){window.addEventListener('pageshow',()"
+      "=>"
+      "{if(globalThis.__rearcApplyCSS)globalThis.__rearcApplyCSS();});"
+      "globalThis.__rearcCSSListener=true;}globalThis.__rearcApplyCSS=css;";
+  if (css_only) {
+    return body + listener + "css();})();";
+  }
+  body +=
+      "if(!globalThis.__rearcCSSListener){window.addEventListener('pageshow',()"
+      "=>"
+      "{if(globalThis.__rearcApplyCSS)globalThis.__rearcApplyCSS();});"
+      "globalThis.__rearcCSSListener=true;}globalThis.__rearcApplyCSS=css;"
+      "function run(){css();if(!eligible()||globalThis.__rearcRan)return;"
+      "globalThis.__rearcRan=true;try{\n" +
+      s.source + "\n}catch(e){console.error('[ReArc Boost]',e);}}";
+  if (s.run_at == 0) {
+    body +=
+        "run();if(!document.documentElement)"
+        "document.addEventListener('DOMContentLoaded',css,{once:true});";
+  } else {
