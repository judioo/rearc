+             "(()=>{if(window!==window.top)return;"
+             "if(globalThis.__rearcPeek){document.removeEventListener('click',"
+             "globalThis.__rearcPeek,true);globalThis.__rearcPeek=null;}") +
+         (enabled ? "globalThis.__rearcPeek=function(e){if(!e.isTrusted||!e."
+                    "shiftKey||e.button!==0)return;"
+                    "const "
+                    "a=e.composedPath().find(n=>n&&n.tagName==='A'&&n.href);if("
+                    "!a)return;"
+                    "let u;try{u=new URL(a.href);}catch(_){return;}"
+                    "if(u.protocol!=='http:'&&u.protocol!=='https:')return;"
+                    "e.preventDefault();e.stopImmediatePropagation();"
+                    "globalThis.rearcLinkPeek(u.href);};"
+                    "document.addEventListener('click',globalThis.__rearcPeek,"
+                    "true);"
+                  : "") +
+         "})();";
+}
