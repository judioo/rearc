+class PageServices;
+auto& Pages() {
+  static base::NoDestructor<std::map<uint64_t, std::unique_ptr<PageServices>>>
+      pages;
+  return *pages;
+}
+
+// Internal, per-WebContents CDP client: no remote debugging server, no protocol
+// entry point exported to the host. Restricted to the current top-level page;
+// no browser target, files, WebUI, user-gesture grants or main-world
+// evaluation.
+class PageServices : public content::DevToolsAgentHostClient,
+                     public content::WebContentsObserver {
+ public:
+  using Reply = base::OnceCallback<void(ReArcStatus, base::DictValue)>;
+  explicit PageServices(TabSession& s)
+      : content::WebContentsObserver(s.web_contents()),
+        tab_id_(s.tab_id()),
+        profile_id_(s.profile_id()),
+        generation_(s.content_generation()),
+        host_(content::DevToolsAgentHost::GetOrCreateFor(s.web_contents())) {
+    CHECK(pthread_main_np());
+    attached_ = host_->AttachClient(this);
+    if (attached_) {
+      Send("Page.enable", {}, {});
+      Send("Runtime.enable", {}, {});
+      Send("Runtime.addBinding",
+           base::DictValue()
+               .Set("name", "rearcLinkPeek")
+               .Set("executionContextName", "rearc.host"),
+           {});
+    }
+  }
+  ~PageServices() override {
+    CHECK(pthread_main_np());
+    if (attached_) {
+      host_->DetachClient(this);
+    }
+    CancelPending(REARC_CANCELLED);
+    weak_factory_.InvalidateWeakPtrs();
+  }
+  bool IsTrusted() override { return false; }
+  bool MayReadLocalFiles() override { return false; }
+  bool MayWriteLocalFiles() override { return false; }
+  bool MayAttachToURL(const GURL& url, bool webui) override {
+    return !webui && (url.is_empty() || url.SchemeIsHTTPOrHTTPS() ||
+                      url.spec() == "about:blank");
+  }
+  bool MayAttachToRenderFrameHost(content::RenderFrameHost* frame) override {
+    return content::DevToolsAgentHostClient::MayAttachToRenderFrameHost(frame);
+  }
+  void AgentHostClosed(content::DevToolsAgentHost*) override {
+    CHECK(pthread_main_np());
+    attached_ = false;
+    contexts_.clear();
+    CancelPending(REARC_CANCELLED);
+  }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    CHECK(pthread_main_np());
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      ++document_epoch_;
+      contexts_.clear();
+      // Snapshot results cannot cross documents even within one content gen.
+      if (snapshot_callback_) {
+        FinishSnapshot(REARC_CANCELLED, {});
+      }
+    }
+  }
+  void WebContentsDestroyed() override {
+    CHECK(pthread_main_np());
+    if (attached_) {
+      host_->DetachClient(this);
+    }
+    attached_ = false;
+    CancelPending(REARC_CANCELLED);
+    Observe(nullptr);
+  }
+  void DispatchProtocolMessage(content::DevToolsAgentHost*,
+                               base::span<const uint8_t> bytes) override {
+    CHECK(pthread_main_np());
+    auto value = base::JSONReader::ReadDict(
+        std::string_view(reinterpret_cast<const char*>(bytes.data()),
+                         bytes.size()),
+        base::JSON_PARSE_RFC);
+    if (!value) {
+      return;
+    }
+    if (auto id = value->FindInt("id")) {
+      auto it = pending_.find(*id);
+      if (it == pending_.end()) {
+        return;
+      }
+      auto callback = std::move(it->second->reply);
+      pending_.erase(it);
+      if (callback) {
+        auto* result = value->FindDict("result");
+        std::move(callback).Run(
+            value->contains("error") ? REARC_UNSUPPORTED : REARC_OK,
+            result ? result->Clone() : base::DictValue());
+      }
+      return;
+    }
+    const auto* method = value->FindString("method");
+    const auto* params = value->FindDict("params");
+    if (!method || !params) {
+      return;
+    }
+    if (*method == "Page.frameNavigated") {
+      const auto* frame = params->FindDict("frame");
+      if (frame && !frame->contains("parentId")) {
+        if (const auto* id = frame->FindString("id")) {
+          main_frame_ = *id;
+        }
+      }
+    } else if (*method == "Runtime.executionContextCreated") {
+      const auto* c = params->FindDict("context");
+      if (!c) {
+        return;
+      }
+      const auto* name = c->FindString("name");
+      const auto* aux = c->FindDict("auxData");
+      auto id = c->FindInt("id");
+      if (name && *name == "rearc.host" && aux && id) {
+        if (const auto* frame = aux->FindString("frameId")) {
+          contexts_[*id] = *frame;
+        }
+      }
+    } else if (*method == "Runtime.executionContextDestroyed") {
+      if (auto id = params->FindInt("executionContextId")) {
+        contexts_.erase(*id);
+      }
+    } else if (*method == "Runtime.executionContextsCleared") {
+      contexts_.clear();
+    } else if (*method == "Runtime.bindingCalled" && peek_enabled_) {
+      const auto* name = params->FindString("name");
+      const auto* payload = params->FindString("payload");
+      auto id = params->FindInt("executionContextId");
+      if (!name || *name != "rearcLinkPeek" || !payload || !id ||
+          !contexts_.contains(*id) || contexts_.at(*id) != main_frame_ ||
+          !Current()) {
+        return;
+      }
+      GURL href(*payload);
+      if (!href.is_valid() || !href.SchemeIsHTTPOrHTTPS()) {
+        return;
+      }
+      ServiceEvent event;
+      event.kind = ServiceEventKind::kMediaStateChanged;  // Dedicated C kind 3.
+      event.profile_id = profile_id_;
+      event.tab_id = tab_id_;
+      event.content_generation = generation_;
+      PublishService(std::move(event), href.spec());
+    } else if (*method == "Page.navigatedWithinDocument") {
+      const auto* frame = params->FindString("frameId");
+      if (frame && *frame == main_frame_) {
+        RefreshStyles();
+      }
+    }
+  }
+
+  bool available() const { return attached_; }
+  bool busy() const { return installing_; }
+  bool snapshot_busy() const { return snapshot_callback_ != nullptr; }
+
+  void SetScripts(std::vector<Script> scripts,
+                  ReArcCompletion completion,
+                  void* context) {
+    installing_ = true;
+    install_completion_ = completion;
+    install_context_ = context;
+    desired_scripts_ = std::move(scripts);
+    // Remove registrations one at a time; on an error keep unremoved IDs so a
+    // later replacement can retry, rather than silently leaking user scripts.
+    RemoveNextScript();
+  }
+  void RefreshStyles() {
+    CHECK(pthread_main_np());
+    std::string cleanup = "(()=>{const ids=new Set([";
+    for (const auto& s : scripts_) {
+      cleanup += Quote("rearc-boost-" + s.id) + ",";
+    }
+    cleanup +=
+        "]);if(document.documentElement)document.documentElement.setAttribute("
+        "'data-rearc-abi-plan',JSON.stringify(Array.from(ids)));"
+        "document.querySelectorAll('style[data-rearc-abi]').forEach(n=>"
+        "{if(!ids.has(n.id))n.remove();});})();";
+    Evaluate("rearc.host", cleanup);
+    for (const auto& s : scripts_) {
+      Evaluate("rearc.boost." + s.id, ScriptSource(s, true));
+    }
+  }
+  void SetPeek(bool enabled, ReArcCompletion completion, void* context) {
+    peek_installing_ = true;
+    // Replacing a listener must also replace its future-document registration.
+    if (!peek_script_id_.empty()) {
+      Send(
+          "Page.removeScriptToEvaluateOnNewDocument",
+          base::DictValue().Set("identifier", peek_script_id_),
+          base::BindOnce(&PageServices::InstallPeek, weak_factory_.GetWeakPtr(),
+                         enabled, completion, context));
+    } else {
+      InstallPeek(enabled, completion, context, REARC_OK, {});
+    }
+  }
+  bool peek_busy() const { return peek_installing_; }
+
+  void Snapshot(uint32_t scope, ReArcSnapshotCallback callback, void* context) {
+    snapshot_callback_ = callback;
+    snapshot_context_ = context;
+    snapshot_epoch_ = document_epoch_;
+    Send("Page.getLayoutMetrics", {},
+         base::BindOnce(&PageServices::Capture, weak_factory_.GetWeakPtr(),
+                        scope, document_epoch_));
+  }
+
+ private:
+  struct Pending {
+    Reply reply;
+    base::OneShotTimer timeout;
+  };
+  bool Current() const {
+    auto* s = TabRegistry::Get().FindSession(tab_id_);
+    return s && s->content_generation() == generation_ &&
+           s->close_state() == TabSession::CloseState::kOpen;
+  }
+  void Send(std::string method, base::DictValue params, Reply reply) {
+    CHECK(pthread_main_np());
+    if (!attached_) {
+      if (reply) {
+        std::move(reply).Run(REARC_INVALID_STATE, {});
+      }
+      return;
+    }
+    int id = next_message_++;
+    if (reply) {
+      auto pending = std::make_unique<Pending>();
+      pending->reply = std::move(reply);
+      pending->timeout.Start(FROM_HERE, base::Seconds(30),
+                             base::BindOnce(&PageServices::Timeout,
+                                            weak_factory_.GetWeakPtr(), id));
+      pending_.emplace(id, std::move(pending));
+    }
+    std::string message = base::WriteJson(base::DictValue()
+                                              .Set("id", id)
+                                              .Set("method", method)
+                                              .Set("params", std::move(params)))
+                              .value();
+    host_->DispatchProtocolMessage(this, base::as_byte_span(message));
+  }
+  void Timeout(int id) {
+    auto it = pending_.find(id);
+    if (it == pending_.end()) {
+      return;
+    }
+    auto reply = std::move(it->second->reply);
+    pending_.erase(it);
+    std::move(reply).Run(REARC_CANCELLED, {});
+  }
+  void CancelPending(ReArcStatus status) {
+    // Callbacks can start follow-up commands; detached state rejects them.
+    attached_ = false;
+    auto pending = std::move(pending_);
+    for (auto& [id, p] : pending) {
+      if (p->reply) {
+        std::move(p->reply).Run(status, {});
+      }
+    }
+    if (snapshot_callback_) {
+      FinishSnapshot(status, {});
+    }
+  }
+  void RemoveNextScript() {
+    if (script_ids_.empty()) {
+      scripts_.clear();
+      AddNextScript();
+      return;
+    }
+    Send("Page.removeScriptToEvaluateOnNewDocument",
+         base::DictValue().Set("identifier", script_ids_.back()),
+         base::BindOnce(
+             [](base::WeakPtr<PageServices> self, ReArcStatus status,
+                base::DictValue) {
+               if (!self) {
+                 return;
+               }
+               if (status) {
+                 self->FinishInstall(status);
+                 return;
+               }
+               self->script_ids_.pop_back();
+               self->RemoveNextScript();
+             },
+             weak_factory_.GetWeakPtr()));
+  }
+  void AddNextScript() {
+    if (scripts_.size() == desired_scripts_.size()) {
+      RefreshStyles();
+      FinishInstall(REARC_OK);
+      return;
+    }
+    const auto& s = desired_scripts_[scripts_.size()];
+    Send("Page.addScriptToEvaluateOnNewDocument",
+         base::DictValue()
+             .Set("source", ScriptSource(s, false))
+             .Set("worldName", "rearc.boost." + s.id),
+         base::BindOnce(
+             [](base::WeakPtr<PageServices> self, ReArcStatus status,
+                base::DictValue result) {
+               if (!self) {
+                 return;
+               }
+               const auto* id = result.FindString("identifier");
+               if (status || !id) {
+                 self->FinishInstall(status ? status : REARC_INTERNAL);
+                 return;
+               }
+               self->script_ids_.push_back(*id);
+               self->scripts_.push_back(
+                   self->desired_scripts_[self->scripts_.size()]);
+               self->AddNextScript();
+             },
+             weak_factory_.GetWeakPtr()));
+  }
+  void FinishInstall(ReArcStatus status) {
+    if (!installing_) {
+      return;
+    }
+    installing_ = false;
+    auto callback = install_completion_;
+    install_completion_ = nullptr;
+    Complete(callback, install_context_, status);
+  }
+  void Evaluate(std::string world, std::string expression) {
+    // Discover top frame at use time (also works before first frameNavigated).
+    Send("Page.getFrameTree", {},
+         base::BindOnce(
+             [](base::WeakPtr<PageServices> self, std::string world,
+                std::string expression, ReArcStatus status,
+                base::DictValue result) {
+               if (!self || status || !self->Current()) {
+                 return;
+               }
+               const auto* id =
+                   result.FindStringByDottedPath("frameTree.frame.id");
+               if (!id) {
+                 return;
+               }
+               self->main_frame_ = *id;
+               self->Send("Page.createIsolatedWorld",
+                          base::DictValue()
+                              .Set("frameId", *id)
+                              .Set("worldName", world)
+                              .Set("grantUniveralAccess", false),
+                          base::BindOnce(
+                              [](base::WeakPtr<PageServices> self,
+                                 std::string expression, ReArcStatus status,
+                                 base::DictValue result) {
+                                if (!self || status || !self->Current()) {
+                                  return;
+                                }
+                                auto id = result.FindInt("executionContextId");
+                                if (id) {
+                                  self->Send("Runtime.evaluate",
+                                             base::DictValue()
+                                                 .Set("expression", expression)
+                                                 .Set("contextId", *id)
+                                                 .Set("userGesture", false)
+                                                 .Set("returnByValue", true),
+                                             {});
+                                }
+                              },
+                              self, std::move(expression)));
+             },
+             weak_factory_.GetWeakPtr(), std::move(world),
+             std::move(expression)));
+  }
+  void InstallPeek(bool enabled,
+                   ReArcCompletion completion,
+                   void* context,
+                   ReArcStatus status,
+                   base::DictValue) {
+    if (status) {
+      peek_installing_ = false;
+      Complete(completion, context, status);
+      return;
+    }
+    peek_script_id_.clear();
+    Send("Page.addScriptToEvaluateOnNewDocument",
+         base::DictValue()
+             .Set("worldName", "rearc.host")
+             .Set("source", PeekSource(enabled)),
+         base::BindOnce(
+             [](base::WeakPtr<PageServices> self, bool enabled,
+                ReArcCompletion completion, void* context, ReArcStatus status,
+                base::DictValue result) {
+               if (!self) {
+                 Complete(completion, context, REARC_CANCELLED);
+                 return;
+               }
+               self->peek_installing_ = false;
+               const auto* id = result.FindString("identifier");
+               if (!status && id) {
+                 self->peek_script_id_ = *id;
+                 self->peek_enabled_ = enabled;
+                 self->Evaluate("rearc.host", PeekSource(enabled));
+               } else if (!status) {
+                 status = REARC_INTERNAL;
+               }
+               Complete(completion, context, status);
+             },
+             weak_factory_.GetWeakPtr(), enabled, completion, context));
+  }
+  void Capture(uint32_t scope,
+               uint64_t epoch,
+               ReArcStatus status,
+               base::DictValue result) {
+    if (!snapshot_callback_ || snapshot_epoch_ != epoch) {
+      return;
+    }
+    if (status || !Current() || epoch != document_epoch_) {
+      FinishSnapshot(status ? status : REARC_CANCELLED, {});
+      return;
+    }
+    const auto* dimensions =
+        result.FindDict(scope ? "cssContentSize" : "cssVisualViewport");
+    if (!dimensions) {
+      FinishSnapshot(REARC_UNSUPPORTED, {});
+      return;
+    }
+    const double width =
+        dimensions->FindDouble(scope ? "width" : "clientWidth").value_or(0);
+    const double height =
+        dimensions->FindDouble(scope ? "height" : "clientHeight").value_or(0);
+    if (!std::isfinite(width) || !std::isfinite(height) || width <= 0 ||
+        height <= 0 || width > 16384 || height > 16384 ||
+        width * height > 64000000) {
+      FinishSnapshot(REARC_TOO_LARGE, {});
+      return;
+    }
+    base::DictValue params;
+    params.Set("format", "png");
+    params.Set("fromSurface", true);
+    params.Set("captureBeyondViewport", scope != 0);
+    if (scope) {
+      params.Set("clip", base::DictValue()
+                             .Set("x", 0)
+                             .Set("y", 0)
+                             .Set("width", width)
+                             .Set("height", height)
+                             .Set("scale", 1));
+    }
+    Send("Page.captureScreenshot", std::move(params),
+         base::BindOnce(
+             [](base::WeakPtr<PageServices> self, uint64_t epoch,
+                ReArcStatus status, base::DictValue result) {
+               if (!self || !self->snapshot_callback_ ||
+                   self->snapshot_epoch_ != epoch) {
+                 return;
+               }
+               if (status || !self->Current() ||
+                   epoch != self->document_epoch_) {
+                 self->FinishSnapshot(status ? status : REARC_CANCELLED, {});
+                 return;
+               }
+               const auto* encoded = result.FindString("data");
+               std::string png;
+               if (!encoded ||
+                   encoded->size() > ((REARC_MAX_BLOB_BYTES + 2) / 3) * 4) {
+                 self->FinishSnapshot(
+                     encoded ? REARC_TOO_LARGE : REARC_INTERNAL, {});
+                 return;
+               }
+               if (!base::Base64Decode(*encoded, &png) ||
+                   !png.starts_with("\x89PNG\r\n\x1a\n")) {
+                 self->FinishSnapshot(REARC_INTERNAL, {});
+                 return;
+               }
+               if (png.size() > REARC_MAX_BLOB_BYTES) {
+                 self->FinishSnapshot(REARC_TOO_LARGE, {});
+                 return;
+               }
+               self->FinishSnapshot(REARC_OK, std::move(png));
+             },
+             weak_factory_.GetWeakPtr(), epoch));
+  }
+  void FinishSnapshot(ReArcStatus status, std::string png) {
+    auto callback = snapshot_callback_;
+    snapshot_callback_ = nullptr;
+    ABIPost(base::BindOnce(
+        [](ReArcSnapshotCallback callback, void* context, ReArcStatus status,
+           uint64_t id, uint64_t gen, std::string png) {
+          uint8_t* data = nullptr;
+          if (!status) {
+            data = static_cast<uint8_t*>(malloc(png.size()));
+            if (data) {
+              std::memcpy(data, png.data(), png.size());
+            } else {
+              status = REARC_INTERNAL;
+            }
+          }
+          callback(context, status, id, gen, data, status ? 0 : png.size());
+        },
+        callback, snapshot_context_.get(), status, tab_id_, generation_,
+        std::move(png)));
+  }
+
+  const uint64_t tab_id_, profile_id_, generation_;
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  bool attached_ = false, installing_ = false, peek_installing_ = false,
+       peek_enabled_ = false;
+  int next_message_ = 1;
+  uint64_t document_epoch_ = 0, snapshot_epoch_ = 0;
+  std::string main_frame_, peek_script_id_;
+  std::map<int, std::string> contexts_;
+  std::map<int, std::unique_ptr<Pending>> pending_;
+  std::vector<Script> scripts_, desired_scripts_;
+  std::vector<std::string> script_ids_;
+  ReArcCompletion install_completion_ = nullptr;
+  raw_ptr<void> install_context_ = nullptr;
+  ReArcSnapshotCallback snapshot_callback_ = nullptr;
+  raw_ptr<void> snapshot_context_ = nullptr;
+  base::WeakPtrFactory<PageServices> weak_factory_{this};
+};
+
+ReArcStatus MediaStatus(MediaCommandResult result) {
+  switch (result) {
+    case MediaCommandResult::kAccepted:
+      return REARC_OK;
+    case MediaCommandResult::kInvalidState:
+      return REARC_INVALID_STATE;
+    case MediaCommandResult::kUnsupported:
+      return REARC_UNSUPPORTED;
+  }
+}
+ReArcStatus FindPage(uint64_t id, PageServices** page) {
+  TabSession* s;
+  if (auto status = ABICheckTab(id, &s)) {
+    return status;
+  }
+  auto it = Pages().find(id);
+  if (it == Pages().end() || !it->second->available()) {
+    return REARC_UNSUPPORTED;
+  }
+  *page = it->second.get();
+  return REARC_OK;
+}
+}  // namespace
+
+void ABIAttachServices(uint64_t id) {
+  CHECK(pthread_main_np());
+  auto* s = TabRegistry::Get().FindSession(id);
+  if (!s) {
+    return;
+  }
+  SetServiceEventSink(&Sink());
+  AttachFaviconAdapter(id);
+  AttachMediaAdapter(id);
+  AttachSecurityAdapter(id);
+  Pages().emplace(id, std::make_unique<PageServices>(*s));
+}
+void ABIDetachServices(uint64_t id) {
+  CHECK(pthread_main_np());
+  Pages().erase(id);
+}
+bool ABIHasServiceFeature(const char* feature) {
+  CHECK(pthread_main_np());
+  const std::string_view name(feature);
+  return name == "media_session" || name == "favicon" ||
+         name == "security_state" || name == "user_scripts" ||
+         name == "link_peek" || name == "snapshot_viewport" ||
+         name == "snapshot_full_page";
+}
+}  // namespace rearc
+
+void ReArcEngineSetServiceCallback(ReArcServiceCallback callback,
+                                   void* context) {
+  CHECK(pthread_main_np());
+  rearc::service_callback = callback;
+  rearc::service_context = context;
+}
+ReArcStatus ReArcTabMediaAction(uint64_t id, uint32_t action) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  if (action > 5) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (action == 5) {
+    // Suspend every registered player in the addressed WebContents, without
+    // relying on a currently focused global session or muting other tabs.
+    if (auto* media = content::MediaSession::GetIfExists(s->web_contents())) {
+      media->Suspend(media_session::mojom::MediaSession::SuspendType::kUI);
+    }
+    return REARC_OK;
+  }
+  return rearc::MediaStatus(rearc::MediaSetPlayback(
+      id, static_cast<rearc::MediaPlaybackAction>(action)));
+}
+ReArcStatus ReArcTabSetMuted(uint64_t id, bool muted) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  return rearc::MediaStatus(rearc::MediaSetMuted(id, muted));
+}
+ReArcStatus ReArcEnginePauseAllMedia(void) {
+  CHECK(pthread_main_np());
+  if (!ReArcEngineDefaultProfile()) {
+    return REARC_ENGINE_NOT_READY;
+  }
+  for (uint64_t id : rearc::TabRegistry::Get().SessionIds()) {
+    auto status = ReArcTabMediaAction(id, 5);
+    if (status && status != REARC_INVALID_STATE) {
+      return status;
+    }
+  }
+  return REARC_OK;
+}
+ReArcStatus ReArcTabSetPictureInPicture(uint64_t id, bool active) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  return REARC_UNSUPPORTED;
+}
+ReArcStatus ReArcFaviconGet(uint64_t id,
+                            const char* ref,
+                            uint8_t** data,
+                            size_t* size) {
+  CHECK(pthread_main_np());
+  if (data) {
+    *data = nullptr;
+  }
+  if (size) {
+    *size = 0;
+  }
+  if (!data || !size || !ref || !base::IsStringUTF8(ref)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  std::vector<uint8_t> png;
+  auto result = rearc::FaviconGet(id, ref, REARC_MAX_BLOB_BYTES, &png);
+  if (result == rearc::FaviconGetResult::kNotFound) {
+    return REARC_NOT_FOUND;
+  }
+  if (result == rearc::FaviconGetResult::kTooLarge) {
+    return REARC_TOO_LARGE;
+  }
+  *data = static_cast<uint8_t*>(malloc(png.size()));
+  if (!*data) {
+    return REARC_INTERNAL;
+  }
+  std::memcpy(*data, png.data(), png.size());
+  *size = png.size();
+  return REARC_OK;
+}
+ReArcStatus ReArcTabSetScripts(uint64_t id,
+                               const ReArcScript* entries,
+                               size_t count,
+                               ReArcCompletion completion,
+                               void* context) {
+  CHECK(pthread_main_np());
+  if (!completion || (count && !entries)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (count > 128) {
+    return REARC_TOO_LARGE;
+  }
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) {
+    return status;
+  }
+  if (page->busy()) {
+    return REARC_BUSY;
+  }
+  std::vector<rearc::Script> scripts;
+  std::set<std::string> ids;
+  size_t bytes = 0;
+  auto validate_text = [&bytes](const char* text) -> ReArcStatus {
+    if (!text || !base::IsStringUTF8(text)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    bytes += std::strlen(text);
+    return bytes > 1048576 ? REARC_TOO_LARGE : REARC_OK;
+  };
+  for (size_t i = 0; i < count; ++i) {
+    const auto& e = entries[i];
+    if (!e.scopes || !e.scope_count || e.scope_count > 32 || e.run_at > 1) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    for (const char* text : {e.id, e.source, e.css}) {
+      if (auto status = validate_text(text)) {
+        return status;
+      }
+    }
+    std::string key(e.id);
+    if (key.empty() || key.size() > 128 || !ids.insert(key).second ||
+        !std::all_of(key.begin(), key.end(), [](char c) {
+          return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '_' ||
+                 c == '-';
+        })) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    std::vector<rearc::Scope> scopes;
+    for (size_t j = 0; j < e.scope_count; ++j) {
+      const auto& r = e.scopes[j];
+      if (auto status = validate_text(r.host)) {
+        return status;
+      }
+      if (auto status = validate_text(r.path_prefix)) {
+        return status;
+      }
+      std::string host(r.host), path(r.path_prefix);
+      if ((!path.empty() && path[0] != '/') || !r.scheme_mask ||
+          r.scheme_mask > 3) {
+        return REARC_INVALID_ARGUMENT;
+      }
+      GURL url("https://" + host + "/");
+      if (!url.is_valid() || url.host() != host || !url.username().empty() ||
+          !url.password().empty() || url.has_port() || url.path() != "/") {
+        return REARC_INVALID_ARGUMENT;
+      }
+      if (r.include_subdomains &&
+          net::registry_controlled_domains::GetDomainAndRegistry(
+              host,
+              net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES) !=
+              host) {
+        return REARC_INVALID_ARGUMENT;
+      }
+      scopes.push_back({host, path, r.include_subdomains, r.scheme_mask});
+    }
+    scripts.push_back({key, e.source, e.css, std::move(scopes), e.run_at, i});
+  }
+  page->SetScripts(std::move(scripts), completion, context);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabRefreshStyles(uint64_t id) {
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) {
+    return status;
+  }
+  if (page->busy()) {
+    return REARC_BUSY;
+  }
+  page->RefreshStyles();
+  return REARC_OK;
+}
+ReArcStatus ReArcTabSetLinkPeek(uint64_t id,
+                                bool enabled,
+                                ReArcCompletion completion,
+                                void* context) {
+  CHECK(pthread_main_np());
+  if (!completion) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) {
+    return status;
+  }
+  if (page->peek_busy()) {
+    return REARC_BUSY;
+  }
+  page->SetPeek(enabled, completion, context);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabCaptureSnapshot(uint64_t id,
+                                    uint32_t scope,
+                                    ReArcSnapshotCallback completion,
+                                    void* context) {
+  CHECK(pthread_main_np());
+  if (!completion || scope > 1) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) {
+    return status;
+  }
+  if (page->snapshot_busy()) {
+    return REARC_BUSY;
+  }
+  page->Snapshot(scope, completion, context);
+  return REARC_OK;
+}
