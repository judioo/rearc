+void PublishService(ServiceEvent event, std::string href = {}) {
+  CHECK(pthread_main_np());
+  ABIPost(base::BindOnce(
+      [](ServiceEvent e, std::string href) {
+        CHECK(pthread_main_np());
+        if (!service_callback) {
+          return;
+        }
+        std::string title = base::UTF16ToUTF8(e.media_title);
+        std::string artist = base::UTF16ToUTF8(e.media_artist);
+        std::string album = base::UTF16ToUTF8(e.media_album);
+        ReArcServiceEvent c{};
+        c.kind = href.empty() ? static_cast<uint32_t>(e.kind) : 3;
+        c.profile_id = e.profile_id;
+        c.tab_id = e.tab_id;
+        c.content_generation = e.content_generation;
+        c.page_url = e.favicon_page_url.c_str();
+        c.icon_ref = e.favicon_icon_ref.c_str();
+        c.favicon_cleared = e.favicon_cleared;
+        c.playback = static_cast<uint32_t>(e.playback);
+        c.audible = e.audible;
+        c.muted = e.muted;
+        c.pip_available = e.pip_available;
+        c.pip_active = e.pip_active;
+        c.has_metadata = e.has_metadata;
+        c.title = title.c_str();
+        c.artist = artist.c_str();
+        c.album = album.c_str();
+        c.security = static_cast<uint32_t>(e.security_state);
+        c.href = href.c_str();
+        service_callback(service_context, &c);
+      },
+      std::move(event), std::move(href)));
+}
