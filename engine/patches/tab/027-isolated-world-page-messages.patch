+
+void ReArcEngineSetPageMessageCallback(ReArcPageMessageCallback callback,
+                                      void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::message_registration;
+  rearc::message_callback = callback;
+  rearc::message_context = context;
+}
