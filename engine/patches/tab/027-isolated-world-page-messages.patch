   void DidStartNavigation(content::NavigationHandle* handle) override {
@@ -296,6 +316,9 @@ class PageServices : public content::DevToolsAgentHostClient,
     if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
       ++document_epoch_;
       contexts_.clear();
+      // Retain message context identities until CDP reports destruction: an
+      // aborted navigation can leave the same document/world alive. Pending
+      // navigation rejects new sends; document_epoch_ cancels queued ones.
       if (evaluation_busy()) {
         FinishEvaluation(REARC_CANCELLED, {}, "navigation", "Document navigated");
       }
@@ -371,6 +394,12 @@ class PageServices : public content::DevToolsAgentHostClient,
       const auto* name = c->FindString("name");
       const auto* aux = c->FindDict("auxData");
