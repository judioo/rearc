+// Installed boost and explicitly evaluated isolated worlds get
+// rearcPostMessage(JSON.stringify(value)). Never injected into the main world.
+// Top-frame http(s) only; valid UTF-8 RFC JSON <=64 KiB, <=60 attempts/sec/tab,
+// <=60 queued deliveries/tab. Excess/malformed/stale messages are dropped.
+// Borrowed event/strings. Messages are data, never trusted shell commands.
+typedef struct ReArcPageMessage {
+  ReArcDocumentIdentity document;
+  const char* boost_id;  // editor, installed ID, or host-evaluated isolated ID.
+  const char* json;
+} ReArcPageMessage;
+typedef void (*ReArcPageMessageCallback)(void* context,
+                                         const ReArcPageMessage* message);
+// Null disables delivery, including already queued messages. Register before
+// installing scripts/evaluating the editor. No polling or per-message reply.
+REARC_ENGINE_EXPORT void ReArcEngineSetPageMessageCallback(
+    ReArcPageMessageCallback callback, void* context);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
