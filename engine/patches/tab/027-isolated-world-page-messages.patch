@@ -339,6 +339,23 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetZoomFactor(uint64_t tab_id,
 REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetZoomFactor(uint64_t tab_id,
