   std::map<int, std::unique_ptr<Pending>> pending_;
   std::vector<Script> scripts_, desired_scripts_;
   std::vector<std::string> script_ids_;
@@ -990,7 +1087,7 @@ bool ABIHasServiceFeature(const char* feature) {
   return name == "media_session" || name == "media_metadata_snapshot" || name == "favicon" ||
          name == "security_state" || name == "user_scripts" ||
          name == "link_peek" || name == "snapshot_viewport" ||
-         name == "snapshot_full_page" || name == "script_evaluation" || name == "script_evaluation_identity" || name == "page_zoom";
+         name == "snapshot_full_page" || name == "script_evaluation" || name == "script_evaluation_identity" || name == "page_zoom" || name == "isolated_page_messages";
 }
 }  // namespace rearc
 
@@ -1277,3 +1374,11 @@ ReArcStatus ReArcTabSetZoomFactor(uint64_t id, double factor) {
   if (auto status = rearc::FindPage(id, &page)) return status;
