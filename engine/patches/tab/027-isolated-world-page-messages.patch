+        }
+      }
       if (name && *name == "rearc.host" && aux && id) {
         if (const auto* frame = aux->FindString("frameId")) {
           contexts_[*id] = *frame;
@@ -379,9 +408,15 @@ class PageServices : public content::DevToolsAgentHostClient,
     } else if (*method == "Runtime.executionContextDestroyed") {
       if (auto id = params->FindInt("executionContextId")) {
         contexts_.erase(*id);
+        message_contexts_.erase(*id);
       }
     } else if (*method == "Runtime.executionContextsCleared") {
       contexts_.clear();
+      message_contexts_.clear();
+    } else if (*method == "Runtime.bindingCalled" &&
+               params->FindString("name") &&
+               *params->FindString("name") == "__rearcPostJSON") {
+      ReceiveMessage(*params);
     } else if (*method == "Runtime.bindingCalled" && peek_enabled_) {
       const auto* name = params->FindString("name");
       const auto* payload = params->FindString("payload");
@@ -409,6 +444,39 @@ class PageServices : public content::DevToolsAgentHostClient,
     }
   }
 
+  void ReceiveMessage(const base::DictValue& params) {
+    auto id = params.FindInt("executionContextId");
+    const auto* payload = params.FindString("payload");
+    if (!id || !payload || !message_callback || !Current() || navigation_pending() ||
+        !web_contents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() ||
+        !message_contexts_.contains(*id) ||
+        message_contexts_.at(*id).first != main_frame_) return;
+    const auto now = base::TimeTicks::Now();
+    if (now - message_window_ >= base::Seconds(1)) {
+      message_window_ = now;
+      message_attempts_ = 0;
+    }
+    if (message_attempts_ >= 60) return;
+    ++message_attempts_;  // Invalid/oversize attempts also consume the budget.
+    if (payload->size() > 65536 || queued_messages_ >= 60 ||
+        !base::IsStringUTF8(*payload) ||
+        !base::JSONReader::Read(*payload, base::JSON_PARSE_RFC)) return;
+    ++queued_messages_;
+    auto identity = document();
+    ABIPost(base::BindOnce([](base::WeakPtr<PageServices> self,
+        ReArcDocumentIdentity identity, uint64_t epoch, uint64_t registration,
+        std::string boost, std::string json) {
+      if (!self) return;
+      --self->queued_messages_;
+      if (!self->Current() || !message_callback || registration != message_registration ||
+          self->document_epoch_ != epoch ||
+          self->document().document_generation != identity.document_generation)
+        return;
+      ReArcPageMessage message{identity, boost.c_str(), json.c_str()};
+      message_callback(message_context, &message);
+    }, weak_factory_.GetWeakPtr(), identity, document_epoch_, message_registration,
+       message_contexts_.at(*id).second, *payload));
+  }
   bool available() const { return !host_ || attached_; }
   bool busy() const { return installing_; }
   bool snapshot_busy() const { return snapshot_callback_ != nullptr; }
@@ -507,6 +575,7 @@ class PageServices : public content::DevToolsAgentHostClient,
                                    "context", "Primary frame unavailable", std::move(result));
             return;
