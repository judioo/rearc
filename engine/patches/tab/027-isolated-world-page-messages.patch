+std::string MessageBootstrap() {
+  return R"JS((()=>{
+    if(window!==window.top||!/^https?:$/.test(location.protocol)||
+       typeof globalThis.rearcPostMessage==='function')return;
+    const send=globalThis.__rearcPostJSON;if(typeof send!=='function')return;
+    delete globalThis.__rearcPostJSON;
+    let start=performance.now(),count=0;
+    Object.defineProperty(globalThis,'rearcPostMessage',{value(json){
+      if(typeof json!=='string'||json.length>65536)return false;
+      const now=performance.now();if(now-start>=1000){start=now;count=0;}
+      if(count++>=60||new TextEncoder().encode(json).byteLength>65536)return false;
+      send(json);return true;
+    }});
+  })();)JS";
+}
 struct Scope {
   std::string host, path;
   bool subdomains;
@@ -181,7 +200,7 @@ std::string ScriptSource(const Script& s, bool css_only) {
       "globalThis.__rearcCSSListener=true;}globalThis.__rearcApplyCSS=css;"
       "function run(){css();if(!eligible()||globalThis.__rearcRan)return;"
       "globalThis.__rearcRan=true;try{\n" +
-      s.source + "\n}catch(e){console.error('[ReArc Boost]',e);}}";
+      MessageBootstrap() + s.source + "\n}catch(e){console.error('[ReArc Boost]',e);}}";
   if (s.run_at == 0) {
     body +=
         "run();if(!document.documentElement)"
@@ -289,6 +308,7 @@ class PageServices : public content::DevToolsAgentHostClient,
     CHECK(pthread_main_np());
