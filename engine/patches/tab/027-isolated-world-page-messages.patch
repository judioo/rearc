               }, self, request, std::move(source)));
         }, weak_factory_.GetWeakPtr(), request, std::move(source), std::move(world)));
   }
@@ -615,6 +684,19 @@ class PageServices : public content::DevToolsAgentHostClient,
   bool EvaluationCurrent(uint64_t request) const {
     return evaluation_busy() && evaluation_request_ == request;
   }
+  void RunIsolatedEvaluation(uint64_t request, std::string source, int context_id) {
+    Send("Runtime.addBinding", base::DictValue()
+        .Set("name", "__rearcPostJSON").Set("executionContextId", context_id),
+        base::BindOnce([](base::WeakPtr<PageServices> self, uint64_t request,
+            std::string source, int context_id, ReArcStatus status, base::DictValue) {
+          if (!self || !self->EvaluationCurrent(request)) return;
+          if (status) {
+            self->FinishEvaluation(status, {}, "binding", "Message binding unavailable");
+          } else {
+            self->RunEvaluation(request, MessageBootstrap() + "\n" + source, context_id);
+          }
+        }, weak_factory_.GetWeakPtr(), request, std::move(source), context_id));
+  }
   void RunEvaluation(uint64_t request, std::string source, int context_id) {
     base::DictValue params;
     params.Set("expression", std::move(source));
@@ -709,6 +791,18 @@ class PageServices : public content::DevToolsAgentHostClient,
       FinishInstall(REARC_OK);
       return;
     }
+    const auto& s = desired_scripts_[scripts_.size()];
+    Send("Runtime.addBinding", base::DictValue()
+        .Set("name", "__rearcPostJSON")
+        .Set("executionContextName", "rearc.boost." + s.id),
+        base::BindOnce([](base::WeakPtr<PageServices> self, ReArcStatus status,
+                         base::DictValue) {
+          if (!self) return;
+          if (status) self->FinishInstall(status);
+          else self->RegisterNextScript();
+        }, weak_factory_.GetWeakPtr()));
+  }
+  void RegisterNextScript() {
     const auto& s = desired_scripts_[scripts_.size()];
     Send("Page.addScriptToEvaluateOnNewDocument",
          base::DictValue()
@@ -927,6 +1021,9 @@ class PageServices : public content::DevToolsAgentHostClient,
   uint64_t document_epoch_ = 0, snapshot_epoch_ = 0;
