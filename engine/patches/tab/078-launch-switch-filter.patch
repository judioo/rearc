+// ABI 1.56 (launch_switch_filter). Release (NDEBUG) engines drop switches
+// that hand the profile to another process or turn off the sandbox, web
+// security or certificate checks, whoever launched the app. The test set is
+// kept only after the host's ReArcEngineAllowTestSwitches (its self-test).
+// Chromium reads "--name" and "-name" switches on macOS.
+enum class LaunchSwitch { kKeep, kTest, kNever };
+LaunchSwitch ClassifyLaunchSwitch(const std::string& arg) {
+  std::string_view name(arg);
+  if (name.starts_with("--")) {
+    name.remove_prefix(2);
+  } else if (name.starts_with("-")) {
+    name.remove_prefix(1);
+  } else {
+    return LaunchSwitch::kKeep;
+  }
+  name = name.substr(0, name.find('='));
+  static constexpr std::string_view kNever[] = {
+      "remote-allow-origins", "no-sandbox", "disable-gpu-sandbox",
+      "disable-web-security", "disable-site-isolation-trials", "js-flags",
+      "renderer-cmd-prefix", "utility-cmd-prefix", "gpu-launcher",
+      "browser-subprocess-path", "ignore-certificate-errors",
+      "proxy-server", "proxy-pac-url", "unsafely-treat-insecure-origin-as-secure",
+      "allow-running-insecure-content", "enable-automation"};
+  static constexpr std::string_view kTest[] = {
+      "load-extension", "disable-extensions-except", "host-resolver-rules",
+      "ignore-certificate-errors-spki-list"};
+  if (name.starts_with("remote-debugging-") ||
+      std::ranges::find(kNever, name) != std::end(kNever)) {
+    return LaunchSwitch::kNever;
+  }
+  return std::ranges::find(kTest, name) != std::end(kTest) ? LaunchSwitch::kTest
+                                                           : LaunchSwitch::kKeep;
+}
+
 bool Terminate(void*) {
   ABIPost(base::BindOnce([] {
     auto& a = ABI::Get();
@@ -708,6 +745,7 @@ bool ReArcEngineHasFeature(const char* feature) {
          std::string(feature) == "devtools_docking" ||
          std::string(feature) == "extension_bulk_install" ||
          std::string(feature) == "extension_background_tabs" ||
+         std::string(feature) == "launch_switch_filter" ||
          std::string(feature) == "history_recording" ||
          std::string(feature) == "history_query" ||
          std::string(feature) == "search_autocomplete" ||
@@ -809,6 +847,15 @@ ReArcStatus ReArcEngineSetEarlyWindowCallback(ReArcEarlyWindowCallback callback,
   a.early_window_context = callback ? context : nullptr;
   return REARC_OK;
 }
+ReArcStatus ReArcEngineAllowTestSwitches(void) {
+  CHECK([NSThread isMainThread]);
+  auto& a = ABI::Get();
+  if (!a.configured || a.ran) {
+    return REARC_INVALID_STATE;
+  }
+  a.allow_test_switches = true;
+  return REARC_OK;
+}
 int ReArcEngineRun(int argc, const char* const* argv) {
   auto& a = ABI::Get();
   if (!a.configured || a.ran || argc < 1 || !argv) {
@@ -826,6 +873,14 @@ int ReArcEngineRun(int argc, const char* const* argv) {
         arg == "--incognito" || arg == "--guest") {
       return -REARC_UNSUPPORTED;
     }
+#if defined(NDEBUG)
+    const auto kind = rearc::ClassifyLaunchSwitch(arg);
+    if (kind == rearc::LaunchSwitch::kNever ||
+        (kind == rearc::LaunchSwitch::kTest && !a.allow_test_switches)) {
+      LOG(WARNING) << "ReArc engine: ignoring launch switch " << arg.substr(0, arg.find('='));
+      continue;
+    }
+#endif
     if (arg.starts_with("--profile-directory=")) {
       profile = true;
     }
