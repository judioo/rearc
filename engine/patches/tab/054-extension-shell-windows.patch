+// Extension window routing (extension_windows, ABI 1.36). UI thread only.
+// Host reports logical window membership, selection and focus independently of
+// native view visibility (split views can present several tabs). window_id is a
+// positive signed 32-bit shell ID; 0 removes membership. One active tab/window,
+// one focused window; windows may not contain different profiles.
+typedef struct ReArcExtensionTabState {
+  int32_t tab_id; // Chromium extension ID, distinct from the bridge tab_id.
+  int32_t window_id;
+  bool active;
+  bool focused;
+} ReArcExtensionTabState;
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetExtensionWindow(uint64_t tab_id, int32_t window_id, bool active, bool focused);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetExtensionState(uint64_t tab_id, ReArcExtensionTabState* state);
+// kind: 0 tabs.create, 1 windows.create, 2 options page, 3 activate existing.
+// phase: 0 request, 1 withdrawn. Borrowed strings during callback only.
+// opener_tab_id and tab_id are bridge IDs. window_id=0 means current space.
+// Reply with an open, mapped tab in the requested profile, or 0 to cancel.
+// Creation uses ReArcTabCreate with about:blank; on reply the engine loads
+// the validated extension URL (including its own options page). Activation must
+// be reported before reply. No callback => API error, no Chromium window.
+typedef struct ReArcExtensionTabRequest {
+  uint64_t request_id, profile_id, tab_id, opener_tab_id;
+  int32_t window_id;
+  uint32_t kind, phase;
+  bool active;
+  const char* url;
+  const char* extension_id;
+} ReArcExtensionTabRequest;
+typedef void (*ReArcExtensionTabRequestCallback)(void*, const ReArcExtensionTabRequest*);
+REARC_ENGINE_EXPORT void ReArcEngineSetExtensionTabRequestCallback(ReArcExtensionTabRequestCallback, void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcExtensionTabRequestRespond(uint64_t request_id, uint64_t tab_id);
+
 // Password leak detection (password_leak_detection, ABI 1.35): Chromium's
 // profile.password_manager_leak_detection pref, default on as in Chrome. When
 // on, a successfully submitted sign-in's credential is checked against
