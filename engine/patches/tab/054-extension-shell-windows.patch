+namespace rearc {
+namespace {
+struct State { int window; bool active; };
+auto& States() { static base::NoDestructor<std::map<uint64_t, State>> s; return *s; }
+int focused_window = 0;
+ReArcExtensionTabRequestCallback host = nullptr;
+void* context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+struct Request {
+  ReArcExtensionTabRequest event{};
+  std::string url, extension;
+  base::OnceCallback<void(content::WebContents*)> done;
+};
+auto& Requests() { static base::NoDestructor<std::map<uint64_t, Request>> r; return *r; }
+bool Open(TabSession* s) {
+  return s && s->close_state() == TabSession::CloseState::kOpen &&
+    extensions::GetViewType(s->web_contents()) == extensions::mojom::ViewType::kTabContents;
+}
+bool Visible(ExtensionFunction* f, TabSession* s) {
+  auto* p = Profile::FromBrowserContext(f->browser_context());
+  auto* candidate = Profile::FromBrowserContext(s->web_contents()->GetBrowserContext());
+  return Open(s) && States().contains(s->tab_id()) &&
+    p->IsSameOrParent(candidate) && (p == candidate || f->include_incognito_information());
+}
+void Publish(uint64_t id, ReArcExtensionTabRequest e, std::string url, std::string extension) {
+  ABIPost(base::BindOnce([](uint64_t expected, uint64_t id, ReArcExtensionTabRequest e, std::string u, std::string x) {
+    if (!host || expected != epoch || (!e.phase && !Requests().contains(id))) return;
+    e.url = u.c_str(); e.extension_id = x.c_str(); host(context, &e);
+  }, epoch, id, e, std::move(url), std::move(extension)));
+}
+void Cancel(uint64_t id) {
+  auto it = Requests().find(id); if (it == Requests().end()) return;
+  auto r = std::move(it->second); Requests().erase(it);
+  r.event.phase = 1; Publish(id, r.event, r.url, r.extension);
+  std::move(r.done).Run(nullptr);
+}
+}
+TabSession* ExtensionSession(content::WebContents* c) {
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id);
+    if (Open(s) && s->web_contents() == c) return s;
+  }
+  return nullptr;
+}
+void DecorateExtensionTab(content::WebContents* c, extensions::api::tabs::Tab& tab) {
+  auto* s = ExtensionSession(c); if (!s) return;
+  auto it = States().find(s->tab_id()); if (it == States().end()) return;
+  tab.window_id = it->second.window;
+  tab.active = it->second.active; tab.selected = tab.active; tab.highlighted = tab.active;
+  tab.index = 0;
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* other = TabRegistry::Get().FindSession(id);
+    auto state = States().find(id);
+    if (Open(other) && state != States().end() && state->second.window == tab.window_id &&
+        std::pair(other->order_index(), id) < std::pair(s->order_index(), s->tab_id())) ++tab.index;
+  }
+}
+content::WebContents* ActiveExtensionContents(Profile* p) {
+  content::WebContents* fallback = nullptr;
+  for (auto [id, state] : States()) {
+    auto* s = TabRegistry::Get().FindSession(id);
+    if (Open(s) && s->web_contents()->GetBrowserContext() == p && state.active) {
+      fallback = s->web_contents(); if (state.window == focused_window) return fallback;
+    }
+  }
+  return fallback;
+}
+base::ListValue QueryExtensionTabs(ExtensionFunction* f, const extensions::api::tabs::Query::Params::QueryInfo& q, const extensions::URLPatternSet& patterns) {
+  base::ListValue result;
+  auto* current = ActiveExtensionContents(Profile::FromBrowserContext(f->browser_context()));
+  int current_window = 0;
+  if (auto* s = ExtensionSession(current)) current_window = States().at(s->tab_id()).window;
+  auto matches = [](const std::optional<bool>& wanted, bool value) { return !wanted || *wanted == value; };
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id); if (!Visible(f,s)) continue;
+    auto* c = s->web_contents();
+    auto tab = extensions::ExtensionTabUtil::CreateTabObject(c,
+      extensions::ExtensionTabUtil::GetScrubTabBehavior(f->extension(), f->source_context_type(), c), f->extension(), nullptr, -1);
+    if ((q.window_id && (*q.window_id == -2 ? tab.window_id != current_window : *q.window_id >= 0 && *q.window_id != tab.window_id)) ||
+        (q.index && *q.index != tab.index) || !matches(q.active,tab.active) || !matches(q.highlighted,tab.highlighted) ||
+        !matches(q.current_window,tab.window_id == current_window) || !matches(q.last_focused_window,tab.window_id == focused_window) ||
+        !matches(q.pinned,false) || !matches(q.audible,tab.audible.value_or(false)) || !matches(q.muted,c->IsAudioMuted()) ||
+        !matches(q.discarded,c->WasDiscarded()) || !matches(q.frozen,false) || !matches(q.auto_discardable,true) ||
+        (q.group_id && *q.group_id != -1) || (q.split_view_id && *q.split_view_id != -1) ||
+        (q.window_type != extensions::api::tabs::WindowType::kNone && q.window_type != extensions::api::tabs::WindowType::kNormal) ||
+        (q.status != extensions::api::tabs::TabStatus::kNone && q.status != tab.status)) continue;
+    if (q.title && !q.title->empty() && (!tab.title || !base::MatchPattern(*tab.title,*q.title))) continue;
+    if (!patterns.is_empty() && !(tab.url && patterns.MatchesURL(GURL(*tab.url))) &&
+        !(tab.pending_url && patterns.MatchesURL(GURL(*tab.pending_url)))) continue;
+    result.Append(tab.ToValue());
+  }
+  return result;
+}
+base::ListValue QueryExtensionWindows(ExtensionFunction* f, int window, bool populate) {
+  base::ListValue result; std::set<int> seen;
+  if (window == -2) {
+    auto* c = ActiveExtensionContents(Profile::FromBrowserContext(f->browser_context()));
+    auto* s = ExtensionSession(c); window = s ? States().at(s->tab_id()).window : 0;
+  }
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id); if (!Visible(f,s)) continue;
+    int w = States().at(id).window;
+    if ((window >= 0 && window != w) || !seen.insert(w).second) continue;
+    base::DictValue value;
+    value.Set("id",w); value.Set("focused",w == focused_window); value.Set("type","normal");
+    value.Set("state","normal"); value.Set("incognito",s->web_contents()->GetBrowserContext()->IsOffTheRecord());
+    value.Set("alwaysOnTop",false);
+    if (populate) {
+      extensions::api::tabs::Query::Params::QueryInfo q; q.window_id = w;
+      value.Set("tabs",QueryExtensionTabs(f,q,extensions::URLPatternSet()));
+    }
+    result.Append(std::move(value));
+  }
+  return result;
+}
+void RequestExtensionTab(Profile* p, const std::string& extension, const GURL& url, bool active, uint64_t opener, int window, uint32_t kind, uint64_t tab, base::OnceCallback<void(content::WebContents*)> done) {
+  uint64_t profile = BridgeProfileId(p);
+  if (!host || !profile || Requests().size() >= 64 || (!url.is_empty() && ABIValidateNavigationURL(url) != REARC_OK && !(url.SchemeIs("chrome-extension") && url.host() == extension))) {
+    ABIPost(base::BindOnce(std::move(done),nullptr)); return;
+  }
+  uint64_t id = next_id++;
+  Request r; r.event = {id,profile,tab,opener,window,kind,0,active,nullptr,nullptr};
+  r.url = url.spec(); r.extension = extension; r.done = std::move(done);
+  auto event = r.event; Requests().emplace(id,std::move(r));
+  Publish(id,event,url.spec(),extension);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,base::BindOnce(&Cancel,id),base::Seconds(30));
+}
+void ABICancelExtensionTabs(uint64_t tab, uint64_t profile) {
+  std::vector<uint64_t> ids;
+  for (auto& [id,r] : Requests()) if ((tab && (r.event.tab_id == tab || r.event.opener_tab_id == tab)) || (profile && r.event.profile_id == profile)) ids.push_back(id);
+  for (auto id : ids) Cancel(id);
+  if (tab) States().erase(tab);
+}
+}
+ReArcStatus ReArcTabSetExtensionWindow(uint64_t id, int32_t window, bool active, bool focused) {
+  CHECK(pthread_main_np());
+  rearc::TabSession* s; if (auto status = rearc::ABICheckTab(id,&s)) return status;
+  if (!rearc::ExtensionSession(s->web_contents())) return REARC_UNSUPPORTED;
+  if (window < 0 || (!window && (active || focused))) return REARC_INVALID_ARGUMENT;
+  for (auto [other,state] : rearc::States()) {
+    auto* candidate = rearc::TabRegistry::Get().FindSession(other);
+    if (window && candidate && state.window == window && candidate->profile_id() != s->profile_id()) return REARC_INVALID_ARGUMENT;
+  }
+  if (!window) { rearc::States().erase(id); return REARC_OK; }
+  if (active) for (auto& [other,state] : rearc::States()) if (state.window == window) state.active = false;
+  rearc::States()[id] = {window,active};
+  if (focused) rearc::focused_window = window;
+  else if (rearc::focused_window == window) rearc::focused_window = 0;
+  return REARC_OK;
+}
+ReArcStatus ReArcTabGetExtensionState(uint64_t id, ReArcExtensionTabState* out) {
+  CHECK(pthread_main_np()); if (out) *out = {};
+  rearc::TabSession* s; if (auto status = rearc::ABICheckTab(id,&s)) return status;
+  if (!out) return REARC_INVALID_ARGUMENT;
+  if (!rearc::ExtensionSession(s->web_contents())) return REARC_UNSUPPORTED;
+  out->tab_id = extensions::ExtensionTabUtil::GetTabId(s->web_contents());
+  auto it = rearc::States().find(id);
+  if (it != rearc::States().end()) { out->window_id = it->second.window; out->active = it->second.active; out->focused = it->second.window == rearc::focused_window; }
+  return REARC_OK;
+}
+void ReArcEngineSetExtensionTabRequestCallback(ReArcExtensionTabRequestCallback cb, void* ctx) {
+  CHECK(pthread_main_np());
+  std::vector<uint64_t> ids; for (auto& [id,r] : rearc::Requests()) ids.push_back(id);
+  for (auto id : ids) rearc::Cancel(id);
+  ++rearc::epoch; rearc::host = cb; rearc::context = ctx;
+}
+ReArcStatus ReArcExtensionTabRequestRespond(uint64_t id, uint64_t tab) {
+  CHECK(pthread_main_np()); auto it = rearc::Requests().find(id); if (it == rearc::Requests().end()) return REARC_NOT_FOUND;
+  if (tab) {
+    rearc::TabSession* s; if (auto status = rearc::ABICheckTab(tab,&s)) return status;
+    auto state = rearc::States().find(tab);
+    if (!rearc::ExtensionSession(s->web_contents()) || state == rearc::States().end()) return REARC_INVALID_STATE;
+    const auto& e = it->second.event;
+    if (s->profile_id() != e.profile_id) return REARC_INVALID_ARGUMENT;
+    if ((e.tab_id && e.tab_id != tab) || (e.window_id > 0 && e.window_id != state->second.window) || (e.active && !state->second.active)) return REARC_INVALID_STATE;
+  }
+  auto done = std::move(it->second.done);
+  if (tab && it->second.event.kind != 3) {
+    auto* s = rearc::TabRegistry::Get().FindSession(tab);
+    content::NavigationController::LoadURLParams params(GURL(it->second.url));
+    params.is_renderer_initiated = true;
+    params.initiator_origin = url::Origin::Create(GURL("chrome-extension://" + it->second.extension));
+    params.source_site_instance = content::SiteInstance::CreateForURL(s->web_contents()->GetBrowserContext(),params.initiator_origin->GetURL());
+    s->web_contents()->GetController().LoadURLWithParams(params);
+  }
+  rearc::Requests().erase(it);
+  rearc::ABIPost(base::BindOnce([](base::OnceCallback<void(content::WebContents*)> done, uint64_t tab) {
+    auto* s = rearc::TabRegistry::Get().FindSession(tab);
+    std::move(done).Run(rearc::Open(s) ? s->web_contents() : nullptr);
+  }, std::move(done), tab)); return REARC_OK;
+}
