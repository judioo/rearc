+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_FAVICON_ADAPTER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_FAVICON_ADAPTER_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rearc {
+
+// Dormant S5 seam: no automatic attachment in frozen TabSession. UI thread
+// only, after tab.created. ContentFaviconDriver is the sole admitted helper:
+// profile FaviconService client, no Browser/TabInterface/TabFeatures required.
+void AttachFaviconAdapter(uint64_t tab_id);
+void DetachFaviconAdapter(uint64_t tab_id);
+
+enum class FaviconGetResult { kFound, kNotFound, kTooLarge };
+
+// Immutable, tab/profile-scoped PNG refs; bounded cache eviction, navigation,
+// detach and content teardown invalidate them. Transport maps results to
+// favicon.get.reply / not_found / too_large and supplies max_blob_bytes.
+FaviconGetResult FaviconGet(uint64_t tab_id,
+                            const std::string& icon_ref,
+                            size_t max_blob_bytes,
+                            std::vector<uint8_t>* out_png);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_FAVICON_ADAPTER_H_
