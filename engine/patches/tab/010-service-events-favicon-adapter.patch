diff --git a/chrome/browser/rearc_bridge/favicon_adapter.cc b/chrome/browser/rearc_bridge/favicon_adapter.cc
new file mode 100644
index 0000000000..531f1adfd0
--- /dev/null
+++ b/chrome/browser/rearc_bridge/favicon_adapter.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/favicon_adapter.h"
+
+#include <pthread.h>
+
+#include <deque>
+#include <utility>
+
+#include "base/check.h"
+#include "base/memory/raw_ptr.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/favicon/favicon_utils.h"
+#include "chrome/browser/rearc_bridge/ipc_service_events.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "components/favicon/content/content_favicon_driver.h"
+#include "components/favicon/core/favicon_driver_observer.h"
+#include "content/public/browser/favicon_status.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image.h"
+#include "url/gurl.h"
+
+namespace rearc {
+namespace {
+
+constexpr size_t kMaxPngBytes = 64 * 1024;
+constexpr size_t kMaxCacheEntries = 16;
+
+class FaviconAdapter : public content::WebContentsObserver,
+                       public content::WebContentsUserData<FaviconAdapter>,
+                       public favicon::FaviconDriverObserver {
+ public:
+  ~FaviconAdapter() override { UnobserveDriver(); }
+
+  void PublishInitial() {
+    auto* entry = web_contents()->GetController().GetLastCommittedEntry();
+    if (entry && driver_->FaviconIsValid()) {
+      Publish(entry->GetFavicon().url, driver_->GetFavicon());
+    } else {
+      Publish(GURL(), gfx::Image());
+    }
+  }
+
+  void OnFaviconUpdated(favicon::FaviconDriver* driver,
+                        NotificationIconType icon_type,
+                        const GURL& icon_url,
+                        bool icon_url_changed,
+                        const gfx::Image& image) override {
+    if (icon_type == NON_TOUCH_16_DIP && driver == driver_) {
+      // Unchanged URLs can carry freshly downloaded pixels. The upstream
+      // driver filters old-page completions before notifying observers.
+      Publish(icon_url, image);
+    }
+  }
+
+  void PrimaryPageChanged(content::Page& page) override {
+    // Runs before the driver's DidFinishNavigation starts the new fetch.
+    cache_.clear();
+    Publish(GURL(), gfx::Image());
+  }
+
+  void WebContentsDestroyed() override {
+    UnobserveDriver();
+    cache_.clear();
+    Observe(nullptr);
+  }
+
+  FaviconGetResult Get(const std::string& ref,
+                       size_t max_blob_bytes,
+                       std::vector<uint8_t>* out_png) const {
+    auto* session = TabRegistry::Get().FindSession(tab_id_);
+    if (!web_contents() || web_contents()->IsBeingDestroyed() || !session ||
+        session->content_generation() != generation_) {
+      return FaviconGetResult::kNotFound;
+    }
+    for (const auto& entry : cache_) {
+      if (entry.first == ref) {
+        if (entry.second.size() > max_blob_bytes) {
+          return FaviconGetResult::kTooLarge;
+        }
+        *out_png = entry.second;
+        return FaviconGetResult::kFound;
+      }
+    }
+    return FaviconGetResult::kNotFound;
+  }
+
+ private:
+  friend class content::WebContentsUserData<FaviconAdapter>;
+  FaviconAdapter(content::WebContents* contents,
+                 uint64_t tab_id,
+                 uint64_t generation)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<FaviconAdapter>(*contents),
+        tab_id_(tab_id),
+        generation_(generation) {
+    favicon::CreateContentFaviconDriverForWebContents(contents);
+    driver_ = favicon::ContentFaviconDriver::FromWebContents(contents);
+    CHECK(driver_);
+    driver_->AddObserver(this);
+  }
+
+  void UnobserveDriver() {
+    if (driver_) {
+      driver_->RemoveObserver(this);
+      driver_ = nullptr;
+    }
+  }
+
+  void Publish(const GURL& icon_url, const gfx::Image& image) {
+    if (!web_contents()) {
+      return;
+    }
+    ServiceEvent event;
+    event.kind = ServiceEventKind::kFaviconChanged;
+    event.tab_id = tab_id_;
+    event.content_generation = generation_;
+    event.favicon_page_url = web_contents()->GetLastCommittedURL().spec();
+    event.favicon_cleared = true;
+    if (icon_url.is_valid() && !image.IsEmpty()) {
+      const SkBitmap bitmap = image.AsBitmap();
+      // Bound synchronous encoding work even if an unexpected driver image
+      // reaches this 16-DIP slot. No original ICO/SVG bytes are exposed.
+      if (bitmap.width() > 0 && bitmap.width() <= 256 && bitmap.height() > 0 &&
+          bitmap.height() <= 256) {
+        auto png = gfx::PNGCodec::EncodeBGRASkBitmap(
+            bitmap, /*discard_transparency=*/false);
+        if (png && !png->empty() && png->size() <= kMaxPngBytes) {
+          event.favicon_icon_ref = base::UnguessableToken::Create().ToString();
+          event.favicon_cleared = false;
+          if (cache_.size() == kMaxCacheEntries) {
+            cache_.pop_front();
+          }
+          cache_.emplace_back(event.favicon_icon_ref, std::move(*png));
+        }
+      }
+    }
+    if (event.favicon_cleared) {
+      cache_.clear();
+    }
+    EmitServiceEvent(std::move(event));
+  }
+
+  const uint64_t tab_id_;
+  const uint64_t generation_;
+  raw_ptr<favicon::ContentFaviconDriver> driver_ = nullptr;
+  std::deque<std::pair<std::string, std::vector<uint8_t>>> cache_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FaviconAdapter);
+
+}  // namespace
+
+void AttachFaviconAdapter(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || !session->web_contents() ||
+      FaviconAdapter::FromWebContents(session->web_contents())) {
+    return;
+  }
+  FaviconAdapter::CreateForWebContents(session->web_contents(), tab_id,
+                                       session->content_generation());
+  FaviconAdapter::FromWebContents(session->web_contents())->PublishInitial();
+}
+
+void DetachFaviconAdapter(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  if (auto* session = TabRegistry::Get().FindSession(tab_id)) {
+    session->web_contents()->RemoveUserData(FaviconAdapter::UserDataKey());
+  }
+}
+
+FaviconGetResult FaviconGet(uint64_t tab_id,
+                            const std::string& icon_ref,
+                            size_t max_blob_bytes,
+                            std::vector<uint8_t>* out_png) {
+  CHECK(pthread_main_np());
+  CHECK(out_png);
+  out_png->clear();
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session) {
+    return FaviconGetResult::kNotFound;
+  }
+  auto* adapter = FaviconAdapter::FromWebContents(session->web_contents());
+  return adapter ? adapter->Get(icon_ref, max_blob_bytes, out_png)
+                 : FaviconGetResult::kNotFound;
+}
+
+}  // namespace rearc
