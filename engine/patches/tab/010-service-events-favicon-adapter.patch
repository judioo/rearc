@@ -0,0 +1,93 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/ipc_service_events.h"
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/web_contents.h"
+
+namespace rearc {
+
+namespace {
+
+ServiceEventSink*& GetServiceEventSinkSlot() {
+  // A plain static: the slot is trivially initialized and never torn down.
+  static ServiceEventSink* sink = nullptr;
+  return sink;
+}
+
+}  // namespace
+
+const char* ServiceEventKindName(ServiceEventKind kind) {
+  switch (kind) {
+    case ServiceEventKind::kFaviconChanged:
+      // Wire carrier: tab.updated changes.favicon (rearc.ipc.v1 §§3,7).
+      return "tab.updated";
+    case ServiceEventKind::kSecurityStateChanged:
+      // Wire carrier: tab.updated changes.security_state (§3).
+      return "tab.updated";
+    case ServiceEventKind::kMediaStateChanged:
+      // Wire carrier: media.state_changed (§7).
+      return "media.state_changed";
+  }
+}
+
+const char* TabSecurityStateName(TabSecurityState state) {
+  switch (state) {
+    case TabSecurityState::kSecure:
+      return "secure";
+    case TabSecurityState::kInsecure:
+      return "insecure";
+    case TabSecurityState::kDangerous:
+      return "dangerous";
+    case TabSecurityState::kNone:
+      return "none";
+    case TabSecurityState::kUnknown:
+      return "unknown";
+  }
+}
+
+const char* MediaPlaybackName(MediaPlayback playback) {
+  switch (playback) {
+    case MediaPlayback::kPlaying:
+      return "playing";
+    case MediaPlayback::kPaused:
+      return "paused";
+    case MediaPlayback::kStopped:
+      return "stopped";
+    case MediaPlayback::kUnknown:
+      return "unknown";
+  }
+}
+
+void SetServiceEventSink(ServiceEventSink* sink) {
+  CHECK(pthread_main_np());
+  GetServiceEventSinkSlot() = sink;
+}
+
+void EmitServiceEvent(ServiceEvent event) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(event.tab_id);
+  if (!session || session->web_contents()->IsBeingDestroyed() ||
+      session->content_generation() != event.content_generation ||
+      session->close_state() == TabSession::CloseState::kClosed) {
+    VLOG(1) << "rearc: dropping service event " << static_cast<int>(event.kind)
+            << " for unknown tab_id " << event.tab_id;
+    return;
+  }
+  ServiceEventSink* sink = GetServiceEventSinkSlot();
+  if (!sink) {
+    VLOG(1) << "rearc: no ServiceEventSink registered; dropping service event "
+            << static_cast<int>(event.kind) << " for tab_id " << event.tab_id;
+    return;
+  }
+  sink->OnServiceEvent(event);
+}
+
+}  // namespace rearc
diff --git a/chrome/browser/rearc_bridge/ipc_service_events.h b/chrome/browser/rearc_bridge/ipc_service_events.h
new file mode 100644
index 0000000000..dd060bd1dd
--- /dev/null
+++ b/chrome/browser/rearc_bridge/ipc_service_events.h
@@ -0,0 +1,103 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_IPC_SERVICE_EVENTS_H_
+#define CHROME_BROWSER_REARC_BRIDGE_IPC_SERVICE_EVENTS_H_
+
+#include <cstdint>
+#include <string>
+
+namespace rearc {
+
+// Typed service-event surface (P-TAB-001 slice S5), the S3-style scaffolding
+// for rearc.ipc.v1 §7 (favicons and media) and the §3 tab.updated change
+// fields that S3's frozen TabEvent struct does not carry: favicon,
+// security_state, is_audible / is_muted.
+//
+// Why a parallel surface: ipc_tab_events.{h,cc} is tab/008's frozen file
+// (series-mechanics invariant), so the S5 adapters emit through their own
+// typed surface. Wire mapping is documented per event:
+//   * kFaviconChanged / kSecurityStateChanged serialize into the tab.updated
+//     `changes` table (favicon / security_state entries — §3).
+//   * kMediaStateChanged serializes as media.state_changed (§7).
+// Same scaffolding posture as S3: events are typed C++ structs delivered to
+// a registered ServiceEventSink; with no sink they drop with a VLOG.
+//
+// All calls are main thread (Chromium BrowserThread::UI) only.
+
+enum class ServiceEventKind {
+  kFaviconChanged,
+  kMediaStateChanged,
+  kSecurityStateChanged,
+};
+
+// Wire carrier names: "tab.updated" (favicon/security_state change entries)
+// and "media.state_changed" (§7). Emitted as literals for the strings gate.
+const char* ServiceEventKindName(ServiceEventKind kind);
+
+// rearc.ipc.v1 §3 security_state enum: "secure" | "insecure" | "dangerous" |
+// "none" | "unknown". Never derived from the URL scheme — mapped from
+// chrome_security_state::GetSecurityLevel() only ("report unknown until
+// valid").
+enum class TabSecurityState { kSecure, kInsecure, kDangerous, kNone, kUnknown };
+const char* TabSecurityStateName(TabSecurityState state);
+
+// rearc.ipc.v1 §7 playback enum: "playing" | "paused" | "stopped" |
+// "unknown". `stopped` means no active playback session.
+enum class MediaPlayback { kPlaying, kPaused, kStopped, kUnknown };
+const char* MediaPlaybackName(MediaPlayback playback);
+
+struct ServiceEvent {
+  ServiceEventKind kind;
+  uint64_t tab_id = 0;
+  // Captured at adapter attachment; never restamped at completion.
+  uint64_t content_generation = 0;
+
+  // kFaviconChanged — tab.updated changes.favicon (§7): one of
+  // {page_url,format:"png",data} / {page_url,icon_ref} / {page_url,
+  // cleared:true}. The typed surface carries the ref form day-one; inline
+  // bytes are the transport slice's choice (max_blob_bytes policy).
+  std::string favicon_page_url;
+  // Session-scoped, profile-bound, immutable cache reference; empty when no
+  // icon is available. `favicon_cleared` takes precedence when set.
+  std::string favicon_icon_ref;
+  bool favicon_cleared = false;
+
+  // kMediaStateChanged — media.state_changed (§7).
+  MediaPlayback playback = MediaPlayback::kUnknown;
+  bool audible = false;
+  bool muted = false;
+  // Baseline v1: pip_native is not advertised (IPC-CONTRACT §7), so both are
+  // always false; fields exist so the transport's serializer is stable.
+  bool pip_available = false;
+  bool pip_active = false;
+  bool has_metadata = false;
+  std::u16string media_title;
+  std::u16string media_artist;
+  std::u16string media_album;
+
+  // kSecurityStateChanged — tab.updated changes.security_state (§3).
+  TabSecurityState security_state = TabSecurityState::kUnknown;
+};
+
+// Sink for the typed service-event stream. Main thread only; the sink must
+// outlive its registration.
+class ServiceEventSink {
+ public:
+  virtual ~ServiceEventSink() = default;
+  virtual void OnServiceEvent(const ServiceEvent& event) = 0;
+};
+
+// Registers (or clears, with nullptr) the service-event sink.
+void SetServiceEventSink(ServiceEventSink* sink);
+
+// Generic emission path. Rejects events whose captured content generation is
+// stale; events for unknown/destroyed sessions drop with a VLOG (service events
+// never legitimately race teardown — adapters detach on
+// WebContentsDestroyed, unlike S3's tab.closed).
+void EmitServiceEvent(ServiceEvent event);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_IPC_SERVICE_EVENTS_H_
