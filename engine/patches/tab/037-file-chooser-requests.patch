+#include <sys/stat.h>
+#include <map>
+#include <string>
+#include <vector>
+#include "base/check.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "content/public/browser/file_select_listener.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+namespace rearc {
+namespace {
+using Mode = blink::mojom::FileChooserParams::Mode;
+class Chooser;
+ReArcFileChooserCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+auto& Pending() {
+ static base::NoDestructor<std::map<uint64_t, base::WeakPtr<Chooser>>> map;
+ return *map;
+}
+struct Selection { bool ok = false; std::vector<base::FilePath> files; base::FilePath root; };
+Selection ReadSelection(Mode mode, std::vector<base::FilePath> paths) {
+ Selection result;
+ if (mode == Mode::kUploadFolder) {
+  result.root = paths[0];
+  if (!base::DirectoryExists(result.root) || base::IsLink(result.root)) return result;
+  base::FileEnumerator e(result.root, true, base::FileEnumerator::FILES | base::FileEnumerator::SHOW_SYM_LINKS,
+      base::FilePath::StringType(), base::FileEnumerator::FolderSearchPolicy::ALL,
+      base::FileEnumerator::ErrorPolicy::STOP_ENUMERATION);
+  size_t bytes = 0;
+  for (auto path = e.Next(); !path.empty(); path = e.Next()) {
+   if (!S_ISREG(e.GetInfo().stat().st_mode)) continue;
+   bytes += path.value().size();
+   if (result.files.size() == 10000 || bytes > 8*1024*1024) return result;
+   result.files.push_back(path);
+  }
+  result.ok = e.GetError() == base::File::FILE_OK;
+  return result;
+ }
+ for (const auto& path : paths) {
+  if (mode == Mode::kSave) {
+   if (!base::DirectoryExists(path.DirName()) || base::DirectoryExists(path)) return result;
+  } else if (mode == Mode::kOpenDirectory) {
+   if (!base::DirectoryExists(path)) return result;
+  } else {
+   base::File::Info info;
+   if (!base::GetFileInfo(path, &info) || info.is_directory) return result;
+  }
+ }
+ result.ok = true; result.files = std::move(paths); return result;
+}
+class Chooser : public content::WebContentsObserver, public content::WebContentsUserData<Chooser> {
+ public:
+ ~Chooser() override { Cancel(); }
+ void Start(content::RenderFrameHost* frame, scoped_refptr<content::FileSelectListener> listener,
+            const blink::mojom::FileChooserParams& params) {
+  Cancel();
+  TabSession* s = nullptr;
+  for (auto id : TabRegistry::Get().SessionIds()) {
+   auto* candidate = TabRegistry::Get().FindSession(id);
+   if (candidate->web_contents() == web_contents()) { s = candidate; break; }
+  }
+  if (!host || !s || params.use_media_capture) { listener->FileSelectionCanceled(); return; }
+  listener_ = std::move(listener); mode_ = params.mode; id_ = next_id++;
+  event_ = {s->profile_id(), s->tab_id(), s->content_generation(), id_, 0,
+            static_cast<uint32_t>(mode_), nullptr, nullptr, nullptr, nullptr, 0};
+  origin_ = frame->GetLastCommittedOrigin().Serialize(); frame_ = frame->GetGlobalId();
+  title_ = base::UTF16ToUTF8(params.title); path_ = params.default_file_name.AsUTF8Unsafe();
+  types_.clear(); for (const auto& type : params.accept_types) types_.push_back(base::UTF16ToUTF8(type));
+  Pending().emplace(id_, weak_.GetWeakPtr()); Publish(0);
+ }
+ bool responding() const { return responding_; }
+ Mode mode() const { return mode_; }
+ void Respond(std::vector<base::FilePath> paths) {
+  responding_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE,
+    {base::MayBlock(), base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+    base::BindOnce(&ReadSelection, mode_, std::move(paths)),
+    base::BindOnce(&Chooser::Selected, weak_.GetWeakPtr(), id_));
+ }
+ void Selected(uint64_t id, Selection selection) {
+  if (id != id_) return;
+  if (!selection.ok) { Cancel(); return; }
+  auto listener = std::move(listener_); Pending().erase(id_); id_ = 0; responding_ = false;
+  std::vector<blink::mojom::FileChooserFileInfoPtr> files;
+  for (const auto& path : selection.files) files.push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
+    blink::mojom::NativeFileInfo::New(path, u"", std::vector<std::u16string>())));
+  listener->FileSelected(std::move(files), selection.root, mode_);
+ }
+ void Cancel() {
+  if (!id_) return;
+  Publish(1); Pending().erase(id_); id_ = 0; responding_ = false;
+  auto listener = std::move(listener_); listener->FileSelectionCanceled();
+ }
+ void DidStartNavigation(content::NavigationHandle* h) override {
+  if (h->IsInPrimaryMainFrame() && !h->IsSameDocument()) Cancel();
+ }
+ void RenderFrameDeleted(content::RenderFrameHost* f) override { if (id_ && f->GetGlobalId() == frame_) Cancel(); }
+ void WebContentsDestroyed() override { Cancel(); }
+ private:
+ friend class content::WebContentsUserData<Chooser>;
+ explicit Chooser(content::WebContents* c) : content::WebContentsObserver(c), content::WebContentsUserData<Chooser>(*c) {}
+ void Publish(uint32_t phase) {
+  auto event = event_; event.phase = phase;
+  ABIPost(base::BindOnce([](uint64_t expected, ReArcFileChooserEvent e, std::string origin,
+      std::string title, std::string path, std::vector<std::string> types) {
+   if (!host || expected != epoch || (!e.phase && !Pending().contains(e.request_id))) return;
+   std::vector<const char*> pointers; for (const auto& type : types) pointers.push_back(type.c_str());
+   e.origin = origin.c_str(); e.title = title.c_str(); e.default_path = path.c_str();
+   e.accept_types = pointers.data(); e.accept_type_count = pointers.size(); host(host_context, &e);
+  }, epoch, event, origin_, title_, path_, types_));
+ }
+ uint64_t id_ = 0;
+ bool responding_ = false;
+ Mode mode_ = Mode::kOpen;
+ ReArcFileChooserEvent event_{};
+ std::string origin_, title_, path_;
+ std::vector<std::string> types_;
+ content::GlobalRenderFrameHostId frame_;
+ scoped_refptr<content::FileSelectListener> listener_;
+ base::WeakPtrFactory<Chooser> weak_{this};
+ WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Chooser);
+class SaveListener : public content::FileSelectListener {
+ public:
+ explicit SaveListener(base::OnceCallback<void(const base::FilePath&)> cb) : cb_(std::move(cb)) {}
+ void FileSelected(std::vector<blink::mojom::FileChooserFileInfoPtr> files,
+     const base::FilePath&, Mode) override {
+   std::move(cb_).Run(files.empty() ? base::FilePath() : files[0]->get_native_file()->file_path);
+ }
+ void FileSelectionCanceled() override { std::move(cb_).Run(base::FilePath()); }
+ private:
+ ~SaveListener() override = default;
+ base::OnceCallback<void(const base::FilePath&)> cb_;
+};
+}  // namespace
+bool HasHostFileChooser() { return host != nullptr; }
+void RunHostSaveChooser(content::WebContents* contents, const base::FilePath& path,
+    base::OnceCallback<void(const base::FilePath&)> cb) {
+ blink::mojom::FileChooserParams params;
+ params.mode = Mode::kSave; params.default_file_name = path;
+ RunHostFileChooser(contents->GetPrimaryMainFrame(), base::MakeRefCounted<SaveListener>(std::move(cb)), params);
+}
+void RunHostFileChooser(content::RenderFrameHost* frame, scoped_refptr<content::FileSelectListener> listener,
+                        const blink::mojom::FileChooserParams& params) {
+ CHECK(pthread_main_np());
+ auto* c = content::WebContents::FromRenderFrameHost(frame);
+ Chooser::GetOrCreateForWebContents(c)->Start(frame, std::move(listener), params);
+}
+void ABICancelFileChooser(uint64_t tab) {
+ if (auto* s = TabRegistry::Get().FindSession(tab)) {
+  if (auto* c = Chooser::FromWebContents(s->web_contents())) c->Cancel();
+ }
+}
+}  // namespace rearc
+void ReArcEngineSetFileChooserCallback(ReArcFileChooserCallback cb, void* ctx) {
+ CHECK(pthread_main_np());
+ auto pending = rearc::Pending(); for (auto& [id, c] : pending) if (c) c->Cancel();
+ ++rearc::epoch; rearc::host = cb; rearc::host_context = ctx;
+}
+ReArcStatus ReArcFileChooserRespond(uint64_t id, bool cancel, const char* const* paths, size_t count) {
+ CHECK(pthread_main_np());
+ auto it = rearc::Pending().find(id);
+ if (it == rearc::Pending().end() || !it->second) return REARC_NOT_FOUND;
+ auto* c = it->second.get();
+ if (c->responding()) return REARC_NOT_FOUND;
+ if ((cancel && count) || (!cancel && (!paths || !count || count > 4096 ||
+     (c->mode() != rearc::Mode::kOpenMultiple && count != 1)))) return REARC_INVALID_ARGUMENT;
+ std::vector<base::FilePath> selected;
+ for (size_t i = 0; i < count; ++i) {
+  if (!paths[i]) return REARC_INVALID_ARGUMENT;
+  std::string value(paths[i]); base::FilePath path(value);
+  if (value.size() > 4096 || !base::IsStringUTF8(value) || !path.IsAbsolute() || path.ReferencesParent()) return REARC_INVALID_ARGUMENT;
+  selected.push_back(path);
+ }
+ if (cancel) c->Cancel(); else c->Respond(std::move(selected));
+ return REARC_OK;
+}
