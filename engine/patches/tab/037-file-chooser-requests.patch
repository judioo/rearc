+// File chooser (file_chooser, ABI 1.19). phase 0 request, 1 cancelled.
+// mode: 0 open, 1 open_multiple, 2 upload_folder, 3 open_directory, 4 save.
+// accept_types are the page's MIME types/extensions, advisory filters.
+// Folder replies contain one root; engine enumerates regular descendants
+// off-thread without traversing symlinks (10k files / 8 MiB path bound).
+typedef struct ReArcFileChooserEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase, mode;
+  const char* origin;
+  const char* title;
+  const char* default_path;
+  const char* const* accept_types;
+  size_t accept_type_count;
+} ReArcFileChooserEvent;
+typedef void (*ReArcFileChooserCallback)(void*, const ReArcFileChooserEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetFileChooserCallback(
+    ReArcFileChooserCallback callback, void* context);
+// cancel requires count=0. Otherwise absolute UTF-8 paths without '..',
+// <=4096 bytes/path, <=4096 paths; one except open_multiple. Invalid replies
+// leave the request pending. Filesystem failure asynchronously cancels it.
+REARC_ENGINE_EXPORT ReArcStatus ReArcFileChooserRespond(
+    uint64_t request_id, bool cancel, const char* const* paths, size_t count);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
