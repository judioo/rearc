 uint64_t epoch = 0, next_id = 1;
 auto& Pending() {
   static base::NoDestructor<std::map<uint64_t, base::WeakPtr<Offer>>> map;
@@ -123,6 +127,38 @@ bool OfferHostPasswordPrompt(
   }
   return false;
