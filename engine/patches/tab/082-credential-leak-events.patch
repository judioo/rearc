+void NotifyHostCredentialLeak(
+    content::WebContents* contents,
+    const password_manager::LeakedPasswordDetails& details) {
+  CHECK(pthread_main_np());
+  if (!leak_host) {
+    return;
+  }
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id);
+    if (!s || s->web_contents() != contents) {
+      continue;
+    }
+    ReArcCredentialLeakEvent event{s->profile_id(), s->tab_id(),
+                                   s->content_generation(),
+                                   static_cast<uint32_t>(details.leak_type),
+                                   nullptr, nullptr};
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, ReArcCredentialLeakEvent e, std::string origin,
+           std::string username) {
+          if (!leak_host || expected != leak_epoch) {
+            return;
+          }
+          e.origin = origin.c_str();
+          e.username = username.c_str();
+          leak_host(leak_context, &e);
+        },
+        leak_epoch, event,
+        url::Origin::Create(details.credentials.url).Serialize(),
+        base::UTF16ToUTF8(details.credentials.username_value)));
+    return;
+  }
+}
 void ABICancelPasswords(uint64_t tab) {
   if (auto* s = TabRegistry::Get().FindSession(tab)) {
     if (auto* o = Offer::FromWebContents(s->web_contents())) {
@@ -144,6 +180,13 @@ void ReArcEngineSetPasswordPromptCallback(ReArcPasswordPromptCallback cb,
   rearc::host = cb;
   rearc::host_context = ctx;
 }
+void ReArcEngineSetCredentialLeakCallback(ReArcCredentialLeakCallback cb,
+                                          void* ctx) {
+  CHECK(pthread_main_np());
+  ++rearc::leak_epoch;
+  rearc::leak_host = cb;
+  rearc::leak_context = ctx;
+}
 ReArcStatus ReArcPasswordPromptRespond(uint64_t id, uint32_t action) {
   CHECK(pthread_main_np());
   if (action > 2) {
