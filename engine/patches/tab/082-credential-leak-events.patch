+// Credential leaks (credential_leak_events, ABI 1.60). With leak detection on
+// (1.35), Chromium checks a credential used to sign in against Google's
+// breach data; a match in a registry tab posts this event, where Chrome shows
+// its "change your password" dialog. Notification only: nothing to answer.
+// leak_type: Chromium's CredentialLeakFlags, 1 saved, 2 used on other sites,
+// 4 synced, 8 the site has a change-password URL, 16 saved as backup.
+// origin: the credential's origin; username may be empty. The password never
+// crosses this ABI.
+typedef struct ReArcCredentialLeakEvent {
+  uint64_t profile_id, tab_id, content_generation;
+  uint32_t leak_type;
+  const char* origin;
+  const char* username;
+} ReArcCredentialLeakEvent;
+typedef void (*ReArcCredentialLeakCallback)(void*,
+                                            const ReArcCredentialLeakEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetCredentialLeakCallback(
+    ReArcCredentialLeakCallback callback, void* context);
 
