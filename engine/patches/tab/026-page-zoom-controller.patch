+#include "third_party/blink/public/common/page/page_zoom.h"
 #include "content/public/browser/devtools_agent_host.h"
 #include "content/public/browser/devtools_agent_host_client.h"
 #include "content/public/browser/media_session.h"
@@ -49,6 +52,8 @@
 namespace rearc {
 namespace {
 
+ReArcZoomCallback zoom_callback = nullptr;
+void* zoom_context = nullptr;
 ReArcServiceCallback service_callback = nullptr;
 void* service_context = nullptr;
 
@@ -222,7 +227,8 @@ auto& Pages() {
 // no browser target, file I/O or user-gesture grants. File/WebUI documents
 // retain future registrations but cannot receive host evaluations or boosts.
 class PageServices : public content::DevToolsAgentHostClient,
-                     public content::WebContentsObserver {
+                     public content::WebContentsObserver,
+                     public zoom::ZoomObserver {
  public:
   using Reply = base::OnceCallback<void(ReArcStatus, base::DictValue)>;
   explicit PageServices(TabSession& s)
@@ -231,15 +237,39 @@ class PageServices : public content::DevToolsAgentHostClient,
         profile_id_(s.profile_id()),
         generation_(s.content_generation()) {
     CHECK(pthread_main_np());
+    zoom_ = zoom::ZoomController::CreateForWebContents(s.web_contents());
+    zoom_->SetShowsNotificationBubble(false);
+    zoom_->AddObserver(this);
+    PublishZoom();
   }
   ~PageServices() override {
     CHECK(pthread_main_np());
+    if (zoom_) zoom_->RemoveObserver(this);
     if (attached_) {
       host_->DetachClient(this);
     }
     CancelPending(REARC_CANCELLED);
     weak_factory_.InvalidateWeakPtrs();
   }
+  double zoom_factor() const {
+    return blink::ZoomLevelToZoomFactor(zoom_->GetZoomLevel());
+  }
+  bool SetZoom(double factor) {
+    return zoom_ && zoom_->SetZoomLevel(blink::ZoomFactorToZoomLevel(factor));
+  }
+  void OnZoomControllerDestroyed(zoom::ZoomController* controller) override {
+    controller->RemoveObserver(this);
+    zoom_ = nullptr;
+  }
+  void OnZoomChanged(const zoom::ZoomController::ZoomChangedEventData&) override {
+    PublishZoom();
+  }
+  void PublishZoom() {
+    ReArcZoomEvent event{document(), zoom_factor()};
+    ABIPost(base::BindOnce([](base::WeakPtr<PageServices> self, ReArcZoomEvent e) {
+      if (self && self->Current() && zoom_callback) zoom_callback(zoom_context, &e);
+    }, weak_factory_.GetWeakPtr(), event));
+  }
   bool IsTrusted() override { return false; }
   bool MayReadLocalFiles() override { return false; }
   bool MayWriteLocalFiles() override { return false; }
@@ -888,6 +918,7 @@ class PageServices : public content::DevToolsAgentHostClient,
         std::move(png)));
   }
 
+  raw_ptr<zoom::ZoomController> zoom_ = nullptr;
   const uint64_t tab_id_, profile_id_, generation_;
   scoped_refptr<content::DevToolsAgentHost> host_;
   bool attached_ = false, installing_ = false, peek_installing_ = false,
@@ -959,7 +990,7 @@ bool ABIHasServiceFeature(const char* feature) {
   return name == "media_session" || name == "media_metadata_snapshot" || name == "favicon" ||
          name == "security_state" || name == "user_scripts" ||
          name == "link_peek" || name == "snapshot_viewport" ||
-         name == "snapshot_full_page" || name == "script_evaluation" || name == "script_evaluation_identity";
+         name == "snapshot_full_page" || name == "script_evaluation" || name == "script_evaluation_identity" || name == "page_zoom";
 }
 }  // namespace rearc
 
@@ -1223,3 +1254,26 @@ ReArcStatus ReArcTabGetDocumentIdentity(uint64_t id, ReArcDocumentIdentity* out)
   *out = page->document();
   return REARC_OK;
 }
+
+void ReArcEngineSetZoomCallback(ReArcZoomCallback callback, void* context) {
+  CHECK(pthread_main_np());
+  rearc::zoom_callback = callback;
+  rearc::zoom_context = context;
+}
+ReArcStatus ReArcTabGetZoomFactor(uint64_t id, double* factor) {
+  CHECK(pthread_main_np());
+  if (!factor) return REARC_INVALID_ARGUMENT;
+  *factor = 0;
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) return status;
+  *factor = page->zoom_factor();
+  return REARC_OK;
+}
+ReArcStatus ReArcTabSetZoomFactor(uint64_t id, double factor) {
+  CHECK(pthread_main_np());
+  if (!std::isfinite(factor) || factor < blink::kMinimumBrowserZoomFactor ||
+      factor > blink::kMaximumBrowserZoomFactor) return REARC_INVALID_ARGUMENT;
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) return status;
+  return page->SetZoom(factor) ? REARC_OK : REARC_INVALID_STATE;
+}
