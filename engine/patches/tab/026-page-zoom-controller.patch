@@ -42,7 +42,7 @@ enum {
   REARC_SCRIPT_ERROR = 17,
   REARC_TIMEOUT = 18
 };
-enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 7, REARC_MAX_BLOB_BYTES = 16777216 };
+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 8, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // changes bits: URL=1, title=2, loading=4, progress=8, crashed=16,
@@ -324,6 +324,21 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcTabEvaluateScript2(
     uint64_t tab_id, const char* source, uint32_t world, const char* boost_id,
     uint32_t timeout_ms, ReArcScriptCallback2 completion, void* context);
 
+// Chromium default HostZoomMap behavior: per-host, shared within the profile,
+// persisted by its ZoomLevelPrefs; OTR uses Chromium's inherited/private map.
+// Factor is finite, in Chromium's browser range [0.25,5]. Not CSS/pinch zoom.
+typedef struct ReArcZoomEvent {
+  ReArcDocumentIdentity document;
+  double factor;
+} ReArcZoomEvent;
+typedef void (*ReArcZoomCallback)(void* context, const ReArcZoomEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetZoomCallback(ReArcZoomCallback callback,
+                                                     void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetZoomFactor(uint64_t tab_id,
+                                                      double* factor);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetZoomFactor(uint64_t tab_id,
+                                                      double factor);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
