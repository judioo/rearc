+bool ReArcTabDelegate::CanDragEnter(
+    content::WebContents* source,
+    const content::DropData& data,
+    blink::DragOperationsMask operations_allowed) {
+  if (!HasHostDropPolicy()) {
+    return true;  // ABI <=1.28 behavior: events, then an aborted drop.
+  }
+  content::DropData filtered = data;
+  return FilterHostDropData(&filtered);
+}
