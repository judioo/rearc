@@ -112,6 +112,22 @@ bool IsPathScreenShot(const base::FilePath& path) const {
 ////////////////////////////////////////////////////////////////////////////////
 // WebContentsViewCocoa
 
+// ReArc page_drops: UTIs whose drags never reach web content.
+namespace {
+NSSet<NSString*>* __strong g_rejected_drag_types;
+bool IsRejectedDrag(id<NSDraggingInfo> sender) {
+  if (!g_rejected_drag_types.count) {
+    return false;
+  }
+  for (NSString* type in sender.draggingPasteboard.types) {
+    if ([g_rejected_drag_types containsObject:type]) {
+      return true;
+    }
+  }
+  return false;
+}
+}  // namespace
+
 @implementation WebContentsViewCocoa {
   // Instances of this class are owned by both `_host` and AppKit. The `_host`
   // must call `-setHost:nil` in its destructor.
@@ -366,8 +382,13 @@ - (void)draggingSession:(NSDraggingSession*)session
 
 // NSDraggingDestination methods
 
++ (void)setRejectedDragTypes:(NSSet<NSString*>*)types {
+  g_rejected_drag_types = [types copy];
+}
+
 - (NSDragOperation)draggingEntered:(id<NSDraggingInfo>)sender {
-  if (!_host)
+  // Rejected drags never reach the drag destination, so no page event fires.
+  if (!_host || IsRejectedDrag(sender))
     return NSDragOperationNone;
 
   // Fill out a DropData from pasteboard.
@@ -389,13 +410,13 @@ - (NSDragOperation)draggingEntered:(id<NSDraggingInfo>)sender {
 }
 
 - (void)draggingExited:(id<NSDraggingInfo>)sender {
-  if (!_host)
+  if (!_host || IsRejectedDrag(sender))
     return;
   _host->DraggingExited();
 }
 
 - (NSDragOperation)draggingUpdated:(id<NSDraggingInfo>)sender {
-  if (!_host)
+  if (!_host || IsRejectedDrag(sender))
     return NSDragOperationNone;
   auto draggingInfo = DraggingInfo::New();
   [self populateDraggingInfo:draggingInfo.get() fromNSDraggingInfo:sender];
@@ -405,7 +426,7 @@ - (NSDragOperation)draggingUpdated:(id<NSDraggingInfo>)sender {
 }
 
 - (BOOL)performDragOperation:(id<NSDraggingInfo>)sender {
-  if (!_host)
+  if (!_host || IsRejectedDrag(sender))
     return NO;
   auto draggingInfo = DraggingInfo::New();
   [self populateDraggingInfo:draggingInfo.get() fromNSDraggingInfo:sender];
