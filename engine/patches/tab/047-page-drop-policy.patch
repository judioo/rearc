+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_DROP_POLICY_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_DROP_POLICY_H_
+namespace content {
+struct DropData;
+}
+namespace rearc {
+// page_drops (ABI 1.29). False until the host sets a policy: drops are then
+// aborted at drop time, as before.
