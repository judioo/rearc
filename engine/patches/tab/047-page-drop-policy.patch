 #include <pthread.h>
 
@@ -84,8 +85,15 @@ void ShowContextMenu(content::RenderFrameHost& render_frame_host,
 
   void OnPerformingDrop(const content::DropData& drop_data,
                         DropCompletionCallback callback) override {
-    VLOG(1) << "ReArc bridge: drop aborted (no shell drop policy yet).";
-    std::move(callback).Run(std::nullopt);
+    // Wave 18e (page_drops): without a host policy drops stay aborted.
+    // With one, the page receives only the kinds the host accepts.
+    content::DropData filtered = drop_data;
+    if (!HasHostDropPolicy() || !FilterHostDropData(&filtered)) {
+      VLOG(1) << "ReArc bridge: drop aborted by host drop policy.";
+      std::move(callback).Run(std::nullopt);
+      return;
+    }
+    std::move(callback).Run(std::move(filtered));
   }
 
