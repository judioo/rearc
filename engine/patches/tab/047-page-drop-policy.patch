diff --git a/chrome/browser/rearc_bridge/rearc_drop_policy.mm b/chrome/browser/rearc_bridge/rearc_drop_policy.mm
new file mode 100644
index 0000000000..22c68f1949
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_drop_policy.mm
@@ -0,0 +1,81 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_drop_policy.h"
+
+#import <AppKit/AppKit.h>
+#include <pthread.h>
+
+#include <string>
+
+#include "base/check.h"
+#include "base/strings/string_util.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_abi.h"
+#import "content/app_shim_remote_cocoa/web_contents_view_cocoa.h"
+#include "content/public/common/drop_data.h"
+
+namespace rearc {
+namespace {
+bool configured = false;
+uint32_t accepted = 0;
+}  // namespace
+bool HasHostDropPolicy() {
+  return configured;
+}
+bool FilterHostDropData(content::DropData* data) {
+  CHECK(configured);
+  if (!(accepted & REARC_DROP_FILES)) {
+    data->filenames.clear();
+    data->file_mime_types.clear();
+    data->file_system_files.clear();
+    data->filesystem_id.clear();
+  }
+  if (!(accepted & REARC_DROP_TEXT)) {
+    data->text.reset();
+    data->html.reset();
+    data->html_base_url = GURL();
+    data->custom_data.clear();
+  }
+  if (!(accepted & REARC_DROP_URLS)) {
+    data->url_infos.clear();
+    data->download_metadata.reset();
+  }
+  if (!(accepted & REARC_DROP_IMAGES)) {
+    data->file_contents.clear();
+    data->file_contents_image_accessible = false;
+    data->file_contents_source_url = GURL();
+    data->file_contents_filename_extension.clear();
+    data->file_contents_content_disposition.clear();
+  }
+  return !data->filenames.empty() || !data->file_system_files.empty() ||
+         data->text || data->html || !data->custom_data.empty() ||
+         !data->url_infos.empty() || !data->file_contents.empty();
+}
+}  // namespace rearc
+
+ReArcStatus ReArcEngineSetDropPolicy(uint32_t accept,
+                                     const char* const* blocked_types,
+                                     size_t count) {
+  CHECK(pthread_main_np());
+  constexpr uint32_t kAll = REARC_DROP_FILES | REARC_DROP_TEXT |
+                            REARC_DROP_URLS | REARC_DROP_IMAGES;
+  if (accept & ~kAll || count > 32 || (count && !blocked_types)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  NSMutableSet<NSString*>* types = [NSMutableSet set];
+  for (size_t i = 0; i < count; ++i) {
+    const char* type = blocked_types[i];
+    if (!type) return REARC_INVALID_ARGUMENT;
+    std::string value(type);
+    if (value.empty() || value.size() > 256 || !base::IsStringASCII(value) ||
+        value.find_first_of(" \t\r\n") != std::string::npos) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    [types addObject:base::SysUTF8ToNSString(value)];
+  }
+  [WebContentsViewCocoa setRejectedDragTypes:types];
+  rearc::configured = true;
+  rearc::accepted = accept;
+  return REARC_OK;
+}
