+// Drops into pages (page_drops, ABI 1.29). Until a policy is set, drops are
+// aborted at drop time as in ABI <=1.28 (pages can still see dragenter/over).
+// accept selects the parts of a drag that reach pages: files (Finder file
+// URLs; Chromium grants the renderer read access to exactly those files),
+// text (plain/HTML/RTF and web custom data), URLs, and image data (promised or
+// raw image bytes, exposed as a File). A drag with no accepted part is refused
+// before the page sees any event; partial drags are filtered. Unhandled drops
+// follow Chromium (e.g. a dropped link or file may navigate the frame).
+// blocked_types: exact pasteboard UTIs, <=32, ASCII 1..256 bytes. Any drag
+// carrying one is never offered to any page (no events, no operation), so
+// the shell's private drags (e.g. sidebar tab drags) never reach web content.
+// Each call replaces the whole policy; accept 0 refuses every drop.
+enum {
+  REARC_DROP_FILES = 1,
+  REARC_DROP_TEXT = 2,
+  REARC_DROP_URLS = 4,
+  REARC_DROP_IMAGES = 8
+};
+REARC_ENGINE_EXPORT ReArcStatus ReArcEngineSetDropPolicy(
+    uint32_t accept, const char* const* blocked_types, size_t count);
+
 
 // Register a +0 NSWindow* before attachment; engine retains until Closed/Run
 // returns. Duplicate/zero IDs rejected. Closing a window keeps its tabs alive.
