+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_PERF_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_PERF_H_
+
+#include <cstdint>
+#include <string>
+
+namespace content {
+class WebContents;
+}
+
+// perf-0: os_signpost intervals and events under subsystem net.rearc.engine
+// (docs/PERFORMANCE-PLAN.md §2.1), plus the hooks the perf_metrics ABI
+// (rearc_perf_metrics.cc) needs from the lease and tab code. Signposts cost a
+// branch when nothing records them (os_signpost_enabled).
+namespace rearc::perf {
+
+// Synchronous ABI entry points with an "abi" interval (entry to return), and
+// the delivery of each event or completion (dispatch to callback return).
+enum class AbiCall {
+  kDispatch,
+  kTabCreate,
+  kTabClose,
+  kTabNavigate,
+  kViewAttach,
+  kViewDetach,
+  kViewResize,
+  kViewSetVisible,
+  kHistoryQuery,
+  kAutocompleteStart,
+};
+
+class ScopedAbiInterval {
+ public:
+  explicit ScopedAbiInterval(AbiCall call);
+  ScopedAbiInterval(const ScopedAbiInterval&) = delete;
+  ScopedAbiInterval& operator=(const ScopedAbiInterval&) = delete;
+  ~ScopedAbiInterval();
+
+ private:
+  const AbiCall call_;
+  uint64_t id_ = 0;  // os_signpost_id_t; 0 when not recording.
+};
+
+// "view" intervals that end asynchronously, on presentation feedback. Begin
+// returns 0 when not recording; End ignores 0.
+enum class ViewInterval { kTabSwitchPresentation, kResizeToPresentation };
+uint64_t BeginView(ViewInterval interval);
+void EndView(ViewInterval interval, uint64_t id);
+
+// Tab events, timeline only (the ABI events carry the values).
+void TabMilestone(uint32_t kind, uint64_t tab_id, uint64_t navigation_id);
+
+// Profile opens by registry key, from the first request to its completion.
+void ProfileOpenBegin(const std::string& key);
+void ProfileOpenEnd(const std::string& key, bool ok);
+
+// Called by the lease registry (attachment_lease.cc) before the transitions
+// that produce presentation feedback (a hidden-again tab's incomplete switch is
+// recorded by Chromium itself). No-ops without a presentation callback.
+void WillShowTab(uint64_t tab_id,
+                 uint64_t attachment_id,
+                 content::WebContents* contents);
+void DidResizeView(uint64_t tab_id,
+                   uint64_t attachment_id,
+                   content::WebContents* contents);
+
+// From ABIInitializeTab: attaches page_load_metrics when a page timing
+// callback is set.
+void AttachPageTiming(uint64_t tab_id, content::WebContents* contents);
+
+}  // namespace rearc::perf
+
+// os_signpost stays out of this header: <os/signpost.h> brings mach-o macros
+// (PLATFORM_IOS) that collide with generated protobuf code.
+#define REARC_ABI_INTERVAL(call) \
+  ::rearc::perf::ScopedAbiInterval rearc_abi_interval(::rearc::perf::AbiCall::call)
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_PERF_H_
