+
+void ReArcEngineSetPageTimingCallback(ReArcPageTimingCallback callback,
+                                      void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::page_epoch;
+  rearc::page_host = callback;
+  rearc::page_host_context = context;
+}
+
+void ReArcEngineSetViewPresentationCallback(
+    ReArcViewPresentationCallback callback,
+    void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::view_epoch;
+  rearc::view_host = callback;
+  rearc::view_host_context = context;
+  if (callback) {
+    rearc::ShowTracker::Get().Start();
+  } else {
+    rearc::ShowTracker::Get().Stop();
+  }
+}
