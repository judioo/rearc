index 0000000000..469216e3ca
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_perf.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_perf.h"
+
+#include <os/signpost.h>
+#include <pthread.h>
+
+#include <map>
+#include <string>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+
+namespace rearc::perf {
+namespace {
+
+enum class Category { kAbi, kTab, kProfile, kView };
+
+os_log_t Log(Category category) {
+  static os_log_t logs[] = {
+      os_log_create("net.rearc.engine", "abi"),
+      os_log_create("net.rearc.engine", "tab"),
+      os_log_create("net.rearc.engine", "profile"),
+      os_log_create("net.rearc.engine", "view"),
+  };
+  return logs[static_cast<int>(category)];
+}
+
+os_signpost_id_t Begin(Category category,
+                       void (*begin)(os_log_t, os_signpost_id_t)) {
+  os_log_t log = Log(category);
+  if (!os_signpost_enabled(log)) return 0;  // OS_SIGNPOST_ID_NULL
+  const os_signpost_id_t id = os_signpost_id_generate(log);
+  begin(log, id);
+  return id;
+}
+
+}  // namespace
+
+ScopedAbiInterval::ScopedAbiInterval(AbiCall call) : call_(call) {
+  os_log_t log = Log(Category::kAbi);
+  if (!os_signpost_enabled(log)) return;
+  const os_signpost_id_t id = os_signpost_id_generate(log);
+  id_ = id;
+  switch (call_) {
+    case AbiCall::kDispatch:
+      os_signpost_interval_begin(log, id, "Dispatch");
+      break;
+    case AbiCall::kTabCreate:
+      os_signpost_interval_begin(log, id, "TabCreate");
+      break;
+    case AbiCall::kTabClose:
+      os_signpost_interval_begin(log, id, "TabClose");
+      break;
+    case AbiCall::kTabNavigate:
+      os_signpost_interval_begin(log, id, "TabNavigate");
+      break;
+    case AbiCall::kViewAttach:
+      os_signpost_interval_begin(log, id, "ViewAttach");
+      break;
+    case AbiCall::kViewDetach:
+      os_signpost_interval_begin(log, id, "ViewDetach");
+      break;
+    case AbiCall::kViewResize:
+      os_signpost_interval_begin(log, id, "ViewResize");
+      break;
+    case AbiCall::kViewSetVisible:
+      os_signpost_interval_begin(log, id, "ViewSetVisible");
+      break;
+    case AbiCall::kHistoryQuery:
+      os_signpost_interval_begin(log, id, "HistoryQuery");
+      break;
+    case AbiCall::kAutocompleteStart:
+      os_signpost_interval_begin(log, id, "AutocompleteStart");
+      break;
+  }
+}
+
+ScopedAbiInterval::~ScopedAbiInterval() {
+  if (!id_) return;
+  os_log_t log = Log(Category::kAbi);
+  const os_signpost_id_t id = id_;
+  switch (call_) {
+    case AbiCall::kDispatch:
+      os_signpost_interval_end(log, id, "Dispatch");
+      break;
+    case AbiCall::kTabCreate:
+      os_signpost_interval_end(log, id, "TabCreate");
+      break;
+    case AbiCall::kTabClose:
+      os_signpost_interval_end(log, id, "TabClose");
+      break;
+    case AbiCall::kTabNavigate:
+      os_signpost_interval_end(log, id, "TabNavigate");
+      break;
+    case AbiCall::kViewAttach:
+      os_signpost_interval_end(log, id, "ViewAttach");
+      break;
+    case AbiCall::kViewDetach:
+      os_signpost_interval_end(log, id, "ViewDetach");
+      break;
+    case AbiCall::kViewResize:
+      os_signpost_interval_end(log, id, "ViewResize");
+      break;
+    case AbiCall::kViewSetVisible:
+      os_signpost_interval_end(log, id, "ViewSetVisible");
+      break;
+    case AbiCall::kHistoryQuery:
+      os_signpost_interval_end(log, id, "HistoryQuery");
+      break;
+    case AbiCall::kAutocompleteStart:
+      os_signpost_interval_end(log, id, "AutocompleteStart");
+      break;
+  }
+}
+
+uint64_t BeginView(ViewInterval interval) {
+  return Begin(Category::kView, interval == ViewInterval::kTabSwitchPresentation
+                                    ? +[](os_log_t log, os_signpost_id_t id) {
+                                        os_signpost_interval_begin(
+                                            log, id, "TabSwitchPresentation");
+                                      }
+                                    : +[](os_log_t log, os_signpost_id_t id) {
+                                        os_signpost_interval_begin(
+                                            log, id, "ResizeToPresentation");
+                                      });
+}
+
+void EndView(ViewInterval interval, uint64_t id) {
+  if (!id) return;
+  if (interval == ViewInterval::kTabSwitchPresentation) {
+    os_signpost_interval_end(Log(Category::kView), id, "TabSwitchPresentation");
+  } else {
+    os_signpost_interval_end(Log(Category::kView), id, "ResizeToPresentation");
+  }
+}
+
+void TabMilestone(uint32_t kind, uint64_t tab_id, uint64_t navigation_id) {
+  os_log_t log = Log(Category::kTab);
+  if (!os_signpost_enabled(log)) return;
+  // Kinds as ReArcPageTimingEvent.
+  switch (kind) {
+    case 0:
+      os_signpost_event_emit(log, OS_SIGNPOST_ID_EXCLUSIVE, "ResponseStart",
+                             "tab=%llu nav=%llu", tab_id, navigation_id);
+      break;
+    case 1:
+      os_signpost_event_emit(log, OS_SIGNPOST_ID_EXCLUSIVE, "FirstPaint",
+                             "tab=%llu nav=%llu", tab_id, navigation_id);
+      break;
+    case 2:
+      os_signpost_event_emit(log, OS_SIGNPOST_ID_EXCLUSIVE,
+                             "FirstContentfulPaint", "tab=%llu nav=%llu",
+                             tab_id, navigation_id);
+      break;
+    case 3:
+      os_signpost_event_emit(log, OS_SIGNPOST_ID_EXCLUSIVE,
+                             "DOMContentLoaded", "tab=%llu nav=%llu", tab_id,
+                             navigation_id);
+      break;
+    case 4:
+      os_signpost_event_emit(log, OS_SIGNPOST_ID_EXCLUSIVE, "LoadEventStart",
+                             "tab=%llu nav=%llu", tab_id, navigation_id);
+      break;
+    case 5:
+      os_signpost_event_emit(log, OS_SIGNPOST_ID_EXCLUSIVE,
+                             "LargestContentfulPaint", "tab=%llu nav=%llu",
+                             tab_id, navigation_id);
+      break;
+  }
+}
+
+namespace {
+std::map<std::string, os_signpost_id_t>& ProfileOpens() {
+  static base::NoDestructor<std::map<std::string, os_signpost_id_t>> opens;
+  return *opens;
+}
+}  // namespace
+
+void ProfileOpenBegin(const std::string& key) {
+  CHECK(pthread_main_np());
+  const os_signpost_id_t id =
+      Begin(Category::kProfile, [](os_log_t log, os_signpost_id_t id) {
+        os_signpost_interval_begin(log, id, "ProfileOpen");
+      });
+  if (id) ProfileOpens()[key] = id;
+}
+
+void ProfileOpenEnd(const std::string& key, bool ok) {
+  CHECK(pthread_main_np());
+  auto it = ProfileOpens().find(key);
+  if (it == ProfileOpens().end()) return;
+  os_signpost_interval_end(Log(Category::kProfile), it->second, "ProfileOpen",
+                           "ok=%d", ok);
+  ProfileOpens().erase(it);
+}
+
+}  // namespace rearc::perf
