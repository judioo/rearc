+// Performance metrics (perf_metrics, ABI 1.44). Every *_us time is
+// microseconds on mach_absolute_time's clock (base::TimeTicks on macOS), the
+// clock of CACurrentMediaTime() and NSEvent.timestamp: host and engine times
+// compare after multiplying the host's seconds by 1e6. Measurement only; with
+// no callback set nothing is attached and no behavior changes.
+//
+// Page timing: with a callback set, tabs created afterwards attach Chromium's
+// page_load_metrics (MetricsWebContentsObserver with its core UMA observer, so
+// PageLoad.PaintTiming.* histograms are recorded as in Chrome; no UKM) and
+// report main-frame milestones of each committed navigation once each, as the
+// renderer's timing update arrives (batched by Chromium, so the event can lag
+// its value_us). kind: 0 response start, 1 first paint, 2 first contentful
+// paint, 3 DOMContentLoaded event start, 4 load event start, 5 largest
+// contentful paint candidate (main frame and subframes merged, repeated for
+// each later candidate; size in pixels). navigation_id is the tab event's;
+// value_us = navigation_start_us + Chromium's offset. url borrowed.
+typedef struct ReArcPageTimingEvent {
+  uint64_t profile_id, tab_id, content_generation, navigation_id;
+  uint32_t kind;
+  int64_t navigation_start_us, value_us;
+  uint64_t size;
+  const char* url;
+} ReArcPageTimingEvent;
+typedef void (*ReArcPageTimingCallback)(void*, const ReArcPageTimingEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetPageTimingCallback(ReArcPageTimingCallback, void* context);
+
+// View presentation feedback, with a callback set. kind 0 shown: the lease's
+// hidden-to-visible transition first calls WebContents::SetTabSwitchStartTime,
+// and the event carries Chromium's own Browser.Tabs.TotalSwitchDuration3
+// sample (1 ms resolution; presented_us = start_us + sample): status 0, or 1
+// when Chromium recorded it as incomplete (hidden again first). kind 1
+// resized: a ResizeView that changes the compositor viewport reports the first
+// renderer frame activated at the new pixel size (activated_us) and the
+// browser compositor's next presented frame after it (presented_us, an upper
+// bound within one frame; 0 if the view has no compositor). status 0, 2
+// superseded by a newer resize, 3 no frame within 2 s. width/height: pixels.
+typedef struct ReArcViewPresentationEvent {
+  uint64_t profile_id, tab_id, attachment_id, request_id;
+  uint32_t kind, status;
+  int64_t start_us, activated_us, presented_us;
+  int32_t width, height;
+} ReArcViewPresentationEvent;
+typedef void (*ReArcViewPresentationCallback)(void*, const ReArcViewPresentationEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetViewPresentationCallback(ReArcViewPresentationCallback, void* context);
+
+// A browser-process snapshot of one UMA histogram after merging child-process
+// deltas (content::FetchHistogramsAsynchronously, 2 s bound), so values match
+// CDP Browser.getHistogram in Chrome. Buckets are [min, max). Deferred, exactly
+// once; not_found when no sample was recorded under that name. Borrowed.
+typedef struct ReArcHistogramBucket {
+  int64_t min, max, count;
+} ReArcHistogramBucket;
+typedef struct ReArcHistogramSnapshot {
+  const char* name;
+  int64_t count, sum;
+  const ReArcHistogramBucket* buckets;
+  size_t bucket_count;
+} ReArcHistogramSnapshot;
+typedef void (*ReArcHistogramCallback)(void* context, ReArcStatus status,
+                                       const ReArcHistogramSnapshot* histogram);
+// name: UTF-8, 1..256 bytes.
+REARC_ENGINE_EXPORT ReArcStatus ReArcMetricsGetHistogram(
+    const char* name, ReArcHistogramCallback completion, void* context);
+
+// The engine's processes: the browser (the host's own process) first, then
+// every live renderer and browser child process. type: 0 browser,
+// 1 renderer, 2 gpu, 3 utility (name: the service's display name), 4 other.
+// Renderers name their profile (0 if not a bridge profile), whether they host
+// an extension, and the registry tabs with a frame in them. Memory and CPU
+// from proc_pid_rusage(RUSAGE_INFO_V4): phys_footprint (Activity Monitor's
+// Memory column), resident size, user+system CPU. Deferred, exactly once.
+typedef struct ReArcProcessInfo {
+  int32_t pid;
+  uint32_t type;
+  const char* name;
+  uint64_t profile_id;
+  bool is_extension;
+  const uint64_t* tab_ids;
+  size_t tab_count;
+  uint64_t phys_footprint, resident_size;
+  int64_t cpu_time_us;
+} ReArcProcessInfo;
+typedef void (*ReArcProcessListCallback)(void* context, ReArcStatus status,
+                                         const ReArcProcessInfo* processes,
+                                         size_t count);
+REARC_ENGINE_EXPORT ReArcStatus ReArcEngineGetProcesses(
+    ReArcProcessListCallback completion, void* context);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
