+namespace rearc {
+namespace {
+
+int64_t Micros(base::TimeTicks ticks) {
+  return (ticks - base::TimeTicks()).InMicroseconds();
+}
+
+// --- Page timing -----------------------------------------------------------
+
+ReArcPageTimingCallback page_host = nullptr;
+void* page_host_context = nullptr;
+uint64_t page_epoch = 0;
+
+// Kinds as ReArcPageTimingEvent.
+enum PageKind : uint32_t {
+  kResponseStart = 0,
+  kFirstPaint = 1,
+  kFirstContentfulPaint = 2,
+  kDomContentLoaded = 3,
+  kLoadEventStart = 4,
+  kLargestContentfulPaint = 5,
+};
+
+void EmitPageTiming(uint64_t tab_id,
+                    uint64_t navigation_id,
+                    uint32_t kind,
+                    base::TimeTicks navigation_start,
+                    base::TimeDelta offset,
+                    uint64_t size,
+                    const std::string& url) {
+  perf::TabMilestone(kind, tab_id, navigation_id);
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!page_host || !session) return;
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, ReArcPageTimingEvent event, std::string url) {
+        if (!page_host || expected != page_epoch) return;
+        event.url = url.c_str();
+        page_host(page_host_context, &event);
+      },
+      page_epoch,
+      ReArcPageTimingEvent{session->profile_id(), tab_id,
+                           session->content_generation(), navigation_id, kind,
+                           Micros(navigation_start),
+                           Micros(navigation_start + offset), size, nullptr},
+      url));
+}
+
+// Forwards the main frame's milestones; one instance per page load.
+class PageTimingObserver : public page_load_metrics::PageLoadMetricsObserver {
+ public:
+  explicit PageTimingObserver(uint64_t tab_id) : tab_id_(tab_id) {}
+
+  const char* GetObserverName() const override {
+    return "ReArcPageTimingObserver";
+  }
+  ObservePolicy OnFencedFramesStart(content::NavigationHandle*,
+                                    const GURL&) override {
+    return STOP_OBSERVING;
+  }
+  ObservePolicy OnPrerenderStart(content::NavigationHandle*,
+                                 const GURL&) override {
+    return STOP_OBSERVING;
+  }
+  ObservePolicy OnCommit(content::NavigationHandle* handle) override {
+    navigation_id_ = static_cast<uint64_t>(handle->GetNavigationId());
+    url_ = handle->GetURL().spec();
+    return CONTINUE_OBSERVING;
+  }
+  void OnTimingUpdate(
+      content::RenderFrameHost* subframe_rfh,
+      const page_load_metrics::mojom::PageLoadTiming& timing) override {
+    if (!response_sent_ && timing.response_start) {
+      response_sent_ = true;
+      Emit(kResponseStart, *timing.response_start);
+    }
+    const auto& lcp = GetDelegate()
+                          .GetLargestContentfulPaintHandler()
+                          .MergeMainFrameAndSubframes();
+    if (lcp.ContainsValidTime() &&
+        (!last_lcp_ || *lcp.Time() > *last_lcp_ ||
+         lcp.Size() != last_lcp_size_)) {
+      last_lcp_ = lcp.Time();
+      last_lcp_size_ = lcp.Size();
+      Emit(kLargestContentfulPaint, *lcp.Time(), lcp.Size());
+    }
+  }
+  void OnFirstPaintInPage(
+      const page_load_metrics::mojom::PageLoadTiming& timing) override {
+    if (timing.paint_timing->first_paint) {
+      Emit(kFirstPaint, *timing.paint_timing->first_paint);
+    }
+  }
+  void OnFirstContentfulPaintInPage(
+      const page_load_metrics::mojom::PageLoadTiming& timing) override {
+    Emit(kFirstContentfulPaint, *timing.paint_timing->first_contentful_paint);
+  }
+  void OnDomContentLoadedEventStart(
+      const page_load_metrics::mojom::PageLoadTiming& timing) override {
+    Emit(kDomContentLoaded,
+         *timing.document_timing->dom_content_loaded_event_start);
+  }
+  void OnLoadEventStart(
+      const page_load_metrics::mojom::PageLoadTiming& timing) override {
+    Emit(kLoadEventStart, *timing.document_timing->load_event_start);
+  }
+
+ private:
+  void Emit(uint32_t kind, base::TimeDelta offset, uint64_t size = 0) {
+    EmitPageTiming(tab_id_, navigation_id_, kind,
+                   GetDelegate().GetNavigationStart(), offset, size, url_);
+  }
+
+  const uint64_t tab_id_;
+  uint64_t navigation_id_ = 0;
+  std::string url_;
+  bool response_sent_ = false;
+  std::optional<base::TimeDelta> last_lcp_;
+  uint64_t last_lcp_size_ = 0;
+};
+
+// Chromium's core UMA observer (PageLoad.PaintTiming.* and friends, as Chrome
+// records them, so CDP Browser.getHistogram in Chrome compares like for like)
+// plus the forwarder. Not the other common or chrome/ observers: those bring
+// UKM, performance_manager and services that registry tabs do not have.
+class ReArcPageLoadMetricsEmbedder
+    : public page_load_metrics::PageLoadMetricsEmbedderBase {
+ public:
+  ReArcPageLoadMetricsEmbedder(content::WebContents* contents, uint64_t tab_id)
+      : PageLoadMetricsEmbedderBase(contents), tab_id_(tab_id) {}
+  ~ReArcPageLoadMetricsEmbedder() override = default;
+
+  void RegisterObservers(page_load_metrics::PageLoadTracker* tracker,
+                         content::NavigationHandle* handle) override {
+    tracker->AddObserver(std::make_unique<UmaPageLoadMetricsObserver>());
+    tracker->AddObserver(std::make_unique<PageTimingObserver>(tab_id_));
+  }
+  bool IsNewTabPageUrl(const GURL&) override { return false; }
+  bool IsNoStatePrefetch(content::WebContents*) override { return false; }
+  bool IsExtensionUrl(const GURL& url) override {
+    return url.SchemeIs("chrome-extension");
+  }
+  bool IsNonTabWebUI(const GURL&) override { return false; }
+
+ private:
+  const uint64_t tab_id_;
+};
+
+// --- View presentation -----------------------------------------------------
+
+ReArcViewPresentationCallback view_host = nullptr;
+void* view_host_context = nullptr;
+uint64_t view_epoch = 0;
+uint64_t next_request_id = 1;
+
+void EmitPresentation(ReArcViewPresentationEvent event) {
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, ReArcViewPresentationEvent event) {
+        if (!view_host || expected != view_epoch) return;
+        view_host(view_host_context, &event);
+      },
+      view_epoch, event));
+}
+
+// Tab shows awaiting Chromium's TotalSwitchDuration3 sample. Samples carry no
+// tab, so each goes to the pending show whose elapsed time it matches best.
+struct PendingShow {
+  ReArcViewPresentationEvent event;
+  base::TimeTicks start;
+  uint64_t signpost = 0;
+};
+
+class ShowTracker {
+ public:
+  static ShowTracker& Get() {
+    static base::NoDestructor<ShowTracker> tracker;
+    return *tracker;
+  }
+
+  void Start() {
+    if (complete_) return;
+    complete_ = std::make_unique<
+        base::StatisticsRecorder::ScopedHistogramSampleObserver>(
+        "Browser.Tabs.TotalSwitchDuration3",
+        base::BindRepeating(&ShowTracker::OnSample, base::Unretained(this),
+                            0u));
+    incomplete_ = std::make_unique<
+        base::StatisticsRecorder::ScopedHistogramSampleObserver>(
+        "Browser.Tabs.TotalIncompleteSwitchDuration3",
+        base::BindRepeating(&ShowTracker::OnSample, base::Unretained(this),
+                            1u));
+  }
+  void Stop() {
+    complete_.reset();
+    incomplete_.reset();
+    for (auto& show : pending_) perf::EndView(perf::ViewInterval::kTabSwitchPresentation, show.signpost);
+    pending_.clear();
+  }
+
+  void Add(PendingShow show) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    // A show Chromium never measured (no live widget) must not take a later
+    // sample.
+    std::erase_if(pending_, [now](const PendingShow& old) {
+      if (now - old.start < base::Seconds(5)) return false;
+      perf::EndView(perf::ViewInterval::kTabSwitchPresentation, old.signpost);
+      return true;
+    });
+    pending_.push_back(std::move(show));
+  }
+
+ private:
+  void OnSample(uint32_t status,
+                std::string_view,
+                uint64_t,
+                base::HistogramBase::Sample32 sample_ms) {
+    if (pending_.empty()) return;
+    const base::TimeTicks now = base::TimeTicks::Now();
+    auto best = pending_.end();
+    double best_error = 0;
+    for (auto it = pending_.begin(); it != pending_.end(); ++it) {
+      const double elapsed = (now - it->start).InMillisecondsF();
+      // The sample is recorded on presentation feedback, so it never exceeds
+      // the time since its show.
+      if (elapsed + 1 < sample_ms) continue;
+      const double error = std::abs(elapsed - sample_ms);
+      if (best == pending_.end() || error < best_error) {
+        best = it;
+        best_error = error;
+      }
+    }
+    if (best == pending_.end()) return;
+    ReArcViewPresentationEvent event = best->event;
+    event.status = status;
+    event.presented_us =
+        event.start_us + static_cast<int64_t>(sample_ms) * 1000;
+    perf::EndView(perf::ViewInterval::kTabSwitchPresentation, best->signpost);
+    pending_.erase(best);
+    EmitPresentation(event);
+  }
+
+  std::unique_ptr<base::StatisticsRecorder::ScopedHistogramSampleObserver>
+      complete_, incomplete_;
+  std::vector<PendingShow> pending_;
+};
+
+// One pending resize per tab: the first renderer frame activated at the new
+// viewport size, then the browser compositor's next presentation. The
+// provider belongs to the widget, which a WebContents destroys before its
+// user data (and replaces on renderer swaps): the watcher lets go of both when
+// the widget goes.
+class ResizeWatcher
+    : public content::WebContentsUserData<ResizeWatcher>,
+      public content::RenderFrameMetadataProvider::Observer,
+      public content::RenderWidgetHostObserver {
+ public:
+  ~ResizeWatcher() override {
+    Detach();
+    Finish(3);
+  }
+
+  void Begin(uint64_t tab_id, uint64_t attachment_id) {
+    auto* view = static_cast<content::RenderWidgetHostViewBase*>(
+        GetWebContents().GetRenderWidgetHostView());
+    if (!view) return;
+    const gfx::Size target = view->GetCompositorViewportPixelSize();
+    if (target.IsEmpty()) return;
+    if (pending_ && target == target_) return;
+    if (!pending_ && target == presented_size_) return;
+    Finish(2);
+    Attach(content::RenderWidgetHostImpl::From(view->GetRenderWidgetHost()));
+    if (!provider_) return;
+    TabSession* session = TabRegistry::Get().FindSession(tab_id);
+    target_ = target;
+    start_ = base::TimeTicks::Now();
+    event_ = ReArcViewPresentationEvent{
+        session ? session->profile_id() : 0,
+        tab_id,
+        attachment_id,
+        next_request_id++,
+        1,
+        0,
+        Micros(start_),
+        0,
+        0,
+        target.width(),
+        target.height()};
+    signpost_ = perf::BeginView(perf::ViewInterval::kResizeToPresentation);
+    pending_ = true;
+    timeout_.Start(FROM_HERE, base::Seconds(2),
+                   base::BindOnce(&ResizeWatcher::Finish,
+                                  base::Unretained(this), 3u));
+  }
+
+  // content::RenderFrameMetadataProvider::Observer:
+  void OnRenderFrameMetadataChangedBeforeActivation(
+      const cc::RenderFrameMetadata&) override {}
+  void OnRenderFrameMetadataChangedAfterActivation(
+      base::TimeTicks activation_time) override {
+    if (!pending_ || event_.activated_us || !provider_) return;
+    if (provider_->LastRenderFrameMetadata().viewport_size_in_pixels !=
+        target_) {
+      return;
+    }
+    event_.activated_us = Micros(activation_time);
+    auto* view = static_cast<content::RenderWidgetHostViewBase*>(
+        GetWebContents().GetRenderWidgetHostView());
+    ui::Compositor* compositor = view ? view->GetCompositor() : nullptr;
+    if (!compositor) {
+      Finish(0);
+      return;
+    }
+    compositor->RequestSuccessfulPresentationTimeForNextFrame(base::BindOnce(
+        [](base::WeakPtr<ResizeWatcher> watcher, uint64_t request_id,
+           const viz::FrameTimingDetails& details) {
+          if (!watcher || !watcher->pending_ ||
+              watcher->event_.request_id != request_id) {
+            return;
+          }
+          watcher->event_.presented_us =
+              Micros(details.presentation_feedback.timestamp);
+          watcher->Finish(0);
+        },
+        weak_factory_.GetWeakPtr(), event_.request_id));
+    // The activation itself may not damage the browser layer tree: force a frame.
+    compositor->ScheduleFullRedraw();
+  }
+  void OnRenderFrameSubmission() override {}
+  void OnLocalSurfaceIdChanged(const cc::RenderFrameMetadata&) override {}
+
+  // content::RenderWidgetHostObserver:
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost* widget) override {
+    // Still alive here: the widget notifies before destroying its members.
+    Detach();
+    Finish(3);
+  }
+
+ private:
+  friend class content::WebContentsUserData<ResizeWatcher>;
+  explicit ResizeWatcher(content::WebContents* contents)
+      : content::WebContentsUserData<ResizeWatcher>(*contents) {}
+
+  void Attach(content::RenderWidgetHostImpl* widget) {
+    content::RenderFrameMetadataProviderImpl* provider =
+        widget ? widget->render_frame_metadata_provider() : nullptr;
+    if (provider == provider_) return;
+    Detach();
+    if (!provider) return;
+    provider_ = provider;
+    widget_ = widget;
+    provider_->AddObserver(this);
+    widget_->AddObserver(this);
+  }
+  void Detach() {
+    if (provider_) provider_->RemoveObserver(this);
+    if (widget_) widget_->RemoveObserver(this);
+    provider_ = nullptr;
+    widget_ = nullptr;
+  }
+
+  void Finish(uint32_t status) {
+    if (!pending_) return;
+    pending_ = false;
+    timeout_.Stop();
+    event_.status = status;
+    if (status == 0) presented_size_ = target_;
+    perf::EndView(perf::ViewInterval::kResizeToPresentation, signpost_);
+    signpost_ = 0;
+    EmitPresentation(event_);
+  }
+
+  raw_ptr<content::RenderFrameMetadataProviderImpl> provider_ = nullptr;
+  raw_ptr<content::RenderWidgetHostImpl> widget_ = nullptr;
+  bool pending_ = false;
+  gfx::Size target_, presented_size_;
+  base::TimeTicks start_;
+  ReArcViewPresentationEvent event_{};
+  uint64_t signpost_ = 0;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<ResizeWatcher> weak_factory_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ResizeWatcher);
+
+// --- Process list ----------------------------------------------------------
+
+struct ProcessRow {
+  int32_t pid = 0;
+  uint32_t type = 4;
+  std::string name;
+  uint64_t profile_id = 0;
+  bool is_extension = false;
+  std::vector<uint64_t> tab_ids;
+};
+
+void FillUsage(ReArcProcessInfo& info) {
+  rusage_info_v4 usage{};
+  if (proc_pid_rusage(info.pid, RUSAGE_INFO_V4,
+                      reinterpret_cast<rusage_info_t*>(&usage)) != 0) {
+    return;
+  }
+  info.phys_footprint = usage.ri_phys_footprint;
+  info.resident_size = usage.ri_resident_size;
+  // ri_*_time are mach absolute time units.
+  mach_timebase_info_data_t timebase;
+  mach_timebase_info(&timebase);
+  const uint64_t nanos =
+      (usage.ri_user_time + usage.ri_system_time) * timebase.numer /
+      timebase.denom;
+  info.cpu_time_us = static_cast<int64_t>(nanos / 1000);
+}
+
+}  // namespace
+
+namespace perf {
+
+void AttachPageTiming(uint64_t tab_id, content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  if (!page_host || !contents ||
+      page_load_metrics::MetricsWebContentsObserver::FromWebContents(
+          contents)) {
+    return;
+  }
+  page_load_metrics::MetricsWebContentsObserver::CreateForWebContents(
+      contents,
+      std::make_unique<ReArcPageLoadMetricsEmbedder>(contents, tab_id));
+}
+
+void WillShowTab(uint64_t tab_id,
+                 uint64_t attachment_id,
+                 content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  if (!view_host || !contents || !contents->GetRenderWidgetHostView() ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    return;
+  }
+  const base::TimeTicks start = base::TimeTicks::Now();
+  // As Chrome's tab strip does (loaded: not loading; registry tabs are never
+  // frozen by a tab helper).
+  const content::RenderWidgetHostView* rwhv = contents->GetRenderWidgetHostView();
+  contents->SetTabSwitchStartTime(start, !contents->IsLoading(),
+                                  rwhv->HasSavedCompositorFrame(),
+                                  /*destination_is_frozen=*/false);
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  PendingShow show{
+      ReArcViewPresentationEvent{session ? session->profile_id() : 0, tab_id,
+                                 attachment_id, next_request_id++, 0, 0,
+                                 Micros(start), 0, 0, 0, 0},
+      start};
+  if (auto* view = static_cast<content::RenderWidgetHostViewBase*>(
+          contents->GetRenderWidgetHostView())) {
+    const gfx::Size size = view->GetCompositorViewportPixelSize();
+    show.event.width = size.width();
+    show.event.height = size.height();
+  }
+  show.signpost = BeginView(ViewInterval::kTabSwitchPresentation);
+  ShowTracker::Get().Add(std::move(show));
+}
+
+void DidResizeView(uint64_t tab_id,
+                   uint64_t attachment_id,
+                   content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  if (!view_host || !contents) return;
+  ResizeWatcher::GetOrCreateForWebContents(contents)->Begin(tab_id,
+                                                            attachment_id);
+}
