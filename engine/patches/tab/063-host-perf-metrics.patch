+ReArcStatus ReArcMetricsGetHistogram(const char* name,
+                                     ReArcHistogramCallback completion,
+                                     void* context) {
+  CHECK(pthread_main_np());
+  if (!name || !completion) return REARC_INVALID_ARGUMENT;
+  std::string histogram(name);
+  if (histogram.empty() || histogram.size() > 256 ||
+      !base::IsStringUTF8(histogram)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  content::FetchHistogramsAsynchronously(
+      base::SingleThreadTaskRunner::GetCurrentDefault(),
+      base::BindOnce(
+          [](std::string name, ReArcHistogramCallback completion,
+             void* context) {
+            base::HistogramBase* found =
+                base::StatisticsRecorder::FindHistogram(name);
+            std::unique_ptr<base::HistogramSamples> samples =
+                found ? found->SnapshotSamples() : nullptr;
+            if (!samples || samples->TotalCount() == 0) {
+              completion(context, REARC_NOT_FOUND, nullptr);
+              return;
+            }
+            std::vector<ReArcHistogramBucket> buckets;
+            for (auto it = samples->Iterator(); !it->Done(); it->Next()) {
+              base::HistogramBase::Sample32 min = 0;
+              int64_t max = 0;
+              base::HistogramBase::Count32 count = 0;
+              it->Get(&min, &max, &count);
+              buckets.push_back({min, max, count});
+            }
+            ReArcHistogramSnapshot snapshot{name.c_str(),
+                                            samples->TotalCount(),
+                                            samples->sum(), buckets.data(),
+                                            buckets.size()};
+            completion(context, REARC_OK, &snapshot);
+          },
+          std::move(histogram), completion, context),
+      base::Seconds(2));
+  return REARC_OK;
+}
+
+ReArcStatus ReArcEngineGetProcesses(ReArcProcessListCallback completion,
+                                    void* context) {
+  CHECK(pthread_main_np());
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  rearc::ABIPost(base::BindOnce(
+      [](ReArcProcessListCallback completion, void* context) {
+        std::vector<rearc::ProcessRow> rows;
+        rows.push_back({static_cast<int32_t>(getpid()), 0, "browser"});
+        std::map<int, size_t> renderers;
+        for (auto it = content::RenderProcessHost::AllHostsIterator();
+             !it.IsAtEnd(); it.Advance()) {
+          content::RenderProcessHost* host = it.GetCurrentValue();
+          if (!host->IsInitializedAndNotDead() || !host->GetProcess().IsValid()) {
+            continue;
+          }
+          rearc::ProcessRow row;
+          row.pid = host->GetProcess().Pid();
+          row.type = 1;
+          content::BrowserContext* context = host->GetBrowserContext();
+          row.profile_id =
+              rearc::BridgeProfileId(Profile::FromBrowserContext(context));
+          if (auto* map = extensions::ProcessMap::Get(context)) {
+            row.is_extension = map->Contains(host->GetDeprecatedID());
+          }
+          renderers[host->GetDeprecatedID()] = rows.size();
+          rows.push_back(std::move(row));
+        }
+        auto& registry = rearc::TabRegistry::Get();
+        for (uint64_t id : registry.SessionIds()) {
+          rearc::TabSession* session = registry.FindSession(id);
+          if (!session) continue;
+          std::set<size_t> hosting;
+          session->web_contents()->ForEachRenderFrameHost(
+              [&](content::RenderFrameHost* frame) {
+                auto found =
+                    renderers.find(frame->GetProcess()->GetDeprecatedID());
+                if (found != renderers.end()) hosting.insert(found->second);
+              });
+          for (size_t index : hosting) rows[index].tab_ids.push_back(id);
+        }
+        for (content::BrowserChildProcessHostIterator it; !it.Done(); ++it) {
+          const base::Process& process = it.GetProcess();
+          if (!process.IsValid()) continue;
+          const content::ChildProcessData& data = it.GetData();
+          rearc::ProcessRow row;
+          row.pid = process.Pid();
+          row.type = data.process_type == content::PROCESS_TYPE_GPU ? 2
+                     : data.process_type == content::PROCESS_TYPE_UTILITY ? 3
+                                                                          : 4;
+          row.name = data.metrics_name.empty() ? base::UTF16ToUTF8(data.name)
+                                               : data.metrics_name;
+          rows.push_back(std::move(row));
+        }
+        std::vector<ReArcProcessInfo> infos;
+        for (const auto& row : rows) {
+          ReArcProcessInfo info{row.pid,
+                                row.type,
+                                row.name.c_str(),
+                                row.profile_id,
+                                row.is_extension,
+                                row.tab_ids.data(),
+                                row.tab_ids.size(),
+                                0,
+                                0,
+                                0};
+          rearc::FillUsage(info);
+          infos.push_back(info);
+        }
+        completion(context, REARC_OK, infos.data(), infos.size());
+      },
+      completion, context));
+  return REARC_OK;
+}
