+void ReArcTabDelegate::RequestMediaAccessPermission(content::WebContents* contents,
+    const content::MediaStreamRequest& request, content::MediaResponseCallback callback) {
+  using Type = blink::mojom::MediaStreamType;
+  if ((request.audio_type != Type::NO_SERVICE && request.audio_type != Type::DEVICE_AUDIO_CAPTURE) ||
+      (request.video_type != Type::NO_SERVICE && request.video_type != Type::DEVICE_VIDEO_CAPTURE)) {
+    content::WebContentsDelegate::RequestMediaAccessPermission(contents, request, std::move(callback));
+    return;
+  }
+  MediaCaptureDevicesDispatcher::GetInstance()->ProcessMediaAccessRequest(
+      contents, request, std::move(callback), nullptr);
+}
+bool ReArcTabDelegate::CheckMediaAccessPermission(content::RenderFrameHost* frame,
+    const url::Origin& origin, blink::mojom::MediaStreamType type) {
+  using Type = blink::mojom::MediaStreamType;
+  return (type == Type::DEVICE_AUDIO_CAPTURE || type == Type::DEVICE_VIDEO_CAPTURE) &&
+      MediaCaptureDevicesDispatcher::GetInstance()->CheckMediaAccessPermission(frame, origin, type);
+}
