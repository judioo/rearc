+// Permissions (permission_prompts, ABI 1.20). Chromium request manager owns
+// origin/security/gesture/policy checks, grouping and cancellation. phase 0
+// request, 1 cancelled. types are Chromium PermissionKeyForRequestType names;
+// a combined camera/microphone prompt has both. One response covers the group.
+typedef struct ReArcPermissionEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase;
+  const char* origin;
+  const char* embedding_origin;
+  const char* const* types;
+  size_t type_count;
+} ReArcPermissionEvent;
+typedef void (*ReArcPermissionCallback)(void*, const ReArcPermissionEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetPermissionCallback(
+    ReArcPermissionCallback callback, void* context);
+// decision: 0 allow, 1 deny, 2 dismiss. persist=false affects this request
+// only; persist=true lets Chromium record its normal HostContentSettingsMap
+// decision. Dismiss never persists. OS/TCC permission remains independent.
+REARC_ENGINE_EXPORT ReArcStatus ReArcPermissionRespond(
+    uint64_t request_id, uint32_t decision, bool persist);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
