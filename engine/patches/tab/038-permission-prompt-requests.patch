diff --git a/chrome/browser/rearc_bridge/rearc_permission_prompt.cc b/chrome/browser/rearc_bridge/rearc_permission_prompt.cc
new file mode 100644
index 0000000000..6243f7365e
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_permission_prompt.cc
@@ -0,0 +1,108 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_permission_prompt.h"
+#include <pthread.h>
+#include <map>
+#include <string>
+#include <vector>
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "components/permissions/permission_request.h"
+#include "components/permissions/permission_request_manager.h"
+#include "components/permissions/permission_uma_constants.h"
+#include "components/permissions/request_type.h"
+namespace rearc {
+namespace {
+class Prompt;
+ReArcPermissionCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+auto& Pending() { static base::NoDestructor<std::map<uint64_t, base::WeakPtr<Prompt>>> map; return *map; }
+class Prompt : public permissions::PermissionPrompt {
+ public:
+ Prompt(TabSession& s, Delegate* delegate) : delegate_(delegate->GetWeakPtr()), id_(next_id++) {
+  event_ = {s.profile_id(), s.tab_id(), s.content_generation(), id_, 0, nullptr, nullptr, nullptr, 0};
+  origin_ = delegate->GetRequestingOrigin().spec(); embedding_ = delegate->GetEmbeddingOrigin().spec();
+  for (const auto& request : delegate->Requests()) {
+   types_.emplace_back(permissions::PermissionKeyForRequestType(request->request_type()));
+  }
+  Pending().emplace(id_, weak_.GetWeakPtr());
+  if (host) Publish(0);
+  else ABIPost(base::BindOnce([](base::WeakPtr<Prompt> p) { if (p) p->Respond(2, false); }, weak_.GetWeakPtr()));
+ }
+ ~Prompt() override { if (!resolved_) Publish(1); Pending().erase(id_); }
+ bool UpdateAnchor() override { return true; }
+ TabSwitchingBehavior GetTabSwitchingBehavior() override { return kKeepPromptAlive; }
+ permissions::PermissionPromptDisposition GetPromptDisposition() const override {
+  return permissions::PermissionPromptDisposition::CUSTOM_MODAL_DIALOG;
+ }
+ bool IsAskPrompt() const override { return true; }
+ std::optional<gfx::Rect> GetViewBoundsInScreen() const override { return std::nullopt; }
+ std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants() const override { return {}; }
+ std::optional<permissions::feature_params::PermissionElementPromptPosition> GetPromptPosition() const override { return std::nullopt; }
+ void Respond(uint32_t decision, bool persist) {
+  auto delegate = delegate_;
+  resolved_ = true; Pending().erase(id_);
+  if (!delegate) return;
+  PromptOptions options = std::monostate();
+  for (const auto& request : delegate->Requests()) {
+   request->set_persist_decision(persist);
+   if (request->GetContentSettingsType() == ContentSettingsType::GEOLOCATION_WITH_OPTIONS) {
+    options = GeolocationPromptOptions{delegate->GetInitialGeolocationAccuracySelection()};
+   }
+  }
+  // These can destroy this prompt synchronously. Do not access members after.
+  if (decision == 0) delegate->Accept(options);
+  else if (decision == 1) delegate->Deny(options);
+  else delegate->Dismiss(options);
+ }
+ uint64_t tab() const { return event_.tab_id; }
+ void Cancel() { Publish(1); Respond(2, false); }
+ private:
+ void Publish(uint32_t phase) {
+  auto event = event_; event.phase = phase;
+  ABIPost(base::BindOnce([](uint64_t expected, ReArcPermissionEvent e, std::string origin,
+     std::string embedding, std::vector<std::string> types) {
+   if (!host || expected != epoch || (!e.phase && !Pending().contains(e.request_id))) return;
+   std::vector<const char*> pointers; for (const auto& type : types) pointers.push_back(type.c_str());
+   e.origin = origin.c_str(); e.embedding_origin = embedding.c_str();
+   e.types = pointers.data(); e.type_count = pointers.size(); host(host_context, &e);
+  }, epoch, event, origin_, embedding_, types_));
+ }
+ base::WeakPtr<Delegate> delegate_;
+ const uint64_t id_;
+ bool resolved_ = false;
+ ReArcPermissionEvent event_{};
+ std::string origin_, embedding_;
+ std::vector<std::string> types_;
+ base::WeakPtrFactory<Prompt> weak_{this};
+};
+}  // namespace
+std::unique_ptr<permissions::PermissionPrompt> CreateHostPermissionPrompt(
+    content::WebContents* contents, permissions::PermissionPrompt::Delegate* delegate) {
+ for (auto id : TabRegistry::Get().SessionIds()) {
+  auto* s = TabRegistry::Get().FindSession(id);
+  if (s->web_contents() == contents) return std::make_unique<Prompt>(*s, delegate);
+ }
+ return nullptr;
+}
+void ABICancelPermissions(uint64_t tab) {
+ auto pending = Pending(); for (auto& [id, prompt] : pending) if (prompt && prompt->tab() == tab) prompt->Cancel();
+}
+}  // namespace rearc
+void ReArcEngineSetPermissionCallback(ReArcPermissionCallback cb, void* ctx) {
+ CHECK(pthread_main_np());
+ auto pending = rearc::Pending(); for (auto& [id, p] : pending) if (p) p->Cancel();
+ ++rearc::epoch; rearc::host = cb; rearc::host_context = ctx;
+}
+ReArcStatus ReArcPermissionRespond(uint64_t id, uint32_t decision, bool persist) {
+ CHECK(pthread_main_np());
+ if (decision > 2) return REARC_INVALID_ARGUMENT;
+ auto it = rearc::Pending().find(id); if (it == rearc::Pending().end() || !it->second) return REARC_NOT_FOUND;
+ it->second->Respond(decision, persist); return REARC_OK;
+}
