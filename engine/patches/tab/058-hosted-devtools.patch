+ReArcStatus ReArcTabOpenDevTools(uint64_t target_tab_id, uint64_t* frontend_tab_id) {
+  CHECK(pthread_main_np());
+  if (frontend_tab_id) *frontend_tab_id = 0;
+  if (!frontend_tab_id) return REARC_INVALID_ARGUMENT;
+  rearc::TabSession* target;
+  if (auto status = rearc::ABICheckTab(target_tab_id, &target)) return status;
+  auto* inspected = target->web_contents();
+  if (rearc::IsHostedDevTools(inspected)) return REARC_UNSUPPORTED;
+  auto* profile = Profile::FromBrowserContext(inspected->GetBrowserContext());
+  if (!IsInspectionAllowed(profile, inspected)) return REARC_UNSUPPORTED;
+  const GURL url(rearc::kFrontend);
+  content::WebContents::CreateParams params(profile,
+      content::SiteInstance::CreateForURL(profile, url));
+  params.initially_hidden = true;
+  auto contents = content::WebContents::Create(params);
+  extensions::SetViewType(contents.get(), extensions::mojom::ViewType::kDeveloperTools);
+  rearc::TabSession::CreateArgs args;
+  args.browser_context = profile;
+  args.space_id = target->space_id();
+  args.order_index = target->order_index();
+  auto* raw = contents.get();
+  const uint64_t id = rearc::TabRegistry::Get().AdoptSession(args, std::move(contents));
+  rearc::HostedFrontend::CreateForWebContents(raw, id, target_tab_id);
+  rearc::TabEvent event;
+  event.kind = rearc::TabEventKind::kTabCreated;
+  event.tab_id = id;
+  event.space_id = args.space_id;
+  event.opener_tab_id = target_tab_id;
+  event.disposition = rearc::TabDisposition::kForegroundTab;
+  event.url = url.spec();
+  rearc::EmitTabEvent(std::move(event));
+  rearc::ABIInitializeTab(id);
+  raw->GetController().LoadURL(url, content::Referrer(),
+                              ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
+  *frontend_tab_id = id;
+  return REARC_OK;
+}
