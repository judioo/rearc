+namespace rearc {
+namespace {
+constexpr char kFrontend[] =
+    "devtools://devtools/bundled/devtools_app.html?targetType=tab&panel=elements";
+
+// No Browser, DevToolsWindow or native window ownership. IDs are resolved at
+// use, so no target pointer can outlive its registry session.
+class HostedDelegate : public DevToolsUIBindings::Delegate {
+ public:
+  HostedDelegate(uint64_t frontend, uint64_t target)
+      : frontend_(frontend), target_(target) {}
+  content::WebContents* GetInspectedWebContents() override {
+    auto* session = TabRegistry::Get().FindSession(target_);
+    return session ? session->web_contents() : nullptr;
+  }
+  void ActivateWindow() override {}  // Native placement/focus belongs to host.
+  void CloseWindow() override { ForceCloseTab(frontend_); }
+  void InspectedContentsClosing() override { ForceCloseTab(frontend_); }
+  void RenderProcessGone(bool crashed) override { ForceCloseTab(frontend_); }
+  void OnLoadCompleted() override {
+    auto* frontend = TabRegistry::Get().FindSession(frontend_);
+    auto* target = GetInspectedWebContents();
+    if (!frontend || !target) { CloseWindow(); return; }
+    auto* bindings = DevToolsUIBindings::ForWebContents(frontend->web_contents());
+    bindings->CallClientMethod("DevToolsAPI", "setUseSoftMenu", base::Value(true));
+  }
+  // Every auxiliary embedder operation is refused before dispatch by hosted
+  // bindings. Safe delegates remain explicit even for unused operations.
+  void Inspect(scoped_refptr<content::DevToolsAgentHost>) override {}
+  void SetInspectedPageBounds(const gfx::Rect&) override {}
+  void InspectElementCompleted() override {}
+  void SetIsDocked(bool) override {}
+  void OpenInNewTab(const std::string&) override {}
+  void OpenSearchResultsInNewTab(const std::string&) override {}
+  void SetWhitelistedShortcuts(const std::string&) override {}
+  void SetEyeDropperActive(bool) override {}
+  void OpenNodeFrontend() override {}
+  void ReadyForTest() override {}
+  void ConnectionReady() override {}
+  void SetOpenNewWindowForPopups(bool) override {}
+  infobars::ContentInfoBarManager* GetInfoBarManager() override { return nullptr; }
+  void ShowCertificateViewer(const std::string&) override {}
+  int GetDockStateForLogging() override { return 0; }
+  int GetOpenedByForLogging() override { return 0; }
+  int GetClosedByForLogging() override { return 0; }
+ private:
+  const uint64_t frontend_, target_;
+};
+
+class TargetWatch : public content::WebContentsObserver {
+ public:
+  TargetWatch(content::WebContents* target, uint64_t frontend)
+      : WebContentsObserver(target), frontend_(frontend) {}
+  void WebContentsDestroyed() override { ForceCloseTab(frontend_); }
+ private:
+  const uint64_t frontend_;
+};
+
+class HostedFrontend : public content::WebContentsObserver,
+                       public content::WebContentsUserData<HostedFrontend> {
+ public:
+  void Configure(DevToolsUIBindings* bindings) {
+    bindings->SetHostedMode();
+    bindings->SetDelegate(new HostedDelegate(frontend_, target_));
+    auto* target = TabRegistry::Get().FindSession(target_);
+    if (target) bindings->AttachTo(content::DevToolsAgentHost::GetOrCreateForTab(target->web_contents()));
+    else ForceCloseTab(frontend_);
+  }
+ private:
+  friend class content::WebContentsUserData<HostedFrontend>;
+  HostedFrontend(content::WebContents* contents, uint64_t frontend, uint64_t target)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<HostedFrontend>(*contents),
+        frontend_(frontend), target_(target),
+        target_watch_(TabRegistry::Get().FindSession(target)->web_contents(), frontend) {}
+  const uint64_t frontend_, target_;
+  TargetWatch target_watch_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(HostedFrontend);
+
+class FrontendNavigation : public content::NavigationThrottle {
+ public:
+  explicit FrontendNavigation(content::NavigationThrottleRegistry& registry)
+      : NavigationThrottle(registry) {}
+  const char* GetNameForLogging() override { return "ReArcHostedDevTools"; }
+  ThrottleCheckResult WillStartRequest() override { return Check(); }
+  ThrottleCheckResult WillRedirectRequest() override { return Check(); }
+  ThrottleCheckResult WillCommitWithoutUrlLoader() override { return Check(); }
+ private:
+  ThrottleCheckResult Check() {
+    const auto& url = navigation_handle()->GetURL();
+    if (IsHostedDevTools(navigation_handle()->GetWebContents())) {
+      // No remote/custom frontend; this contents can only reload its bundled
+      // app. Same-document hash changes retain the same origin/bindings.
+      return url.GetWithoutRef() == GURL(kFrontend) ? PROCEED : CANCEL_AND_IGNORE;
+    }
+    return url.SchemeIs("devtools") ||
+                   (url.SchemeIs("chrome") && url.host() == "devtools")
+               ? CANCEL_AND_IGNORE : PROCEED;
+  }
+};
+}  // namespace
+
+void ConfigureHostedDevToolsBindings(DevToolsUIBindings* bindings) {
+  if (auto* hosted = HostedFrontend::FromWebContents(bindings->web_contents())) hosted->Configure(bindings);
+}
+
+bool IsHostedDevTools(const content::WebContents* contents) {
+  return contents && HostedFrontend::FromWebContents(contents);
+}
+
+void AddHostedDevToolsNavigationThrottle(content::NavigationThrottleRegistry& registry) {
+  auto* contents = registry.GetNavigationHandle().GetWebContents();
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    if (TabRegistry::Get().FindSession(id)->web_contents() == contents) {
+      registry.AddThrottle(std::make_unique<FrontendNavigation>(registry));
+      return;
+    }
+  }
+}
+}  // namespace rearc
