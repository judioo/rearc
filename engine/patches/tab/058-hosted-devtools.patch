@@ -2403,6 +2449,27 @@ void DevToolsUIBindings::DispatchProtocolMessageFromDevToolsFrontend(
   if (!agent_host_) {
     return;
   }
+  if (hosted_) {
+    auto command = base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+    const std::string* method = command ? command->FindString("method") : nullptr;
+    VLOG(1) << "ReArc DevTools protocol: " << (method ? *method : "invalid");
+    // Stay on the inspected target and its auto-attached frames/workers. Never
+    // discover/attach arbitrary targets, create windows or control the browser.
+    const auto* params = command ? command->FindDict("params") : nullptr;
+    if (!method || method->starts_with("Browser.") ||
+        (*method == "Target.getTargetInfo" && params && params->contains("targetId")) ||
+        (method->starts_with("Target.") && *method != "Target.setAutoAttach" &&
+         *method != "Target.getTargetInfo") || *method == "Page.setDownloadBehavior") {
+      if (command && command->FindInt("id")) {
+        base::DictValue reply;
+        reply.Set("id", *command->FindInt("id"));
+        if (const auto* session = command->FindString("sessionId")) reply.Set("sessionId", *session);
+        reply.Set("error", base::DictValue().Set("code", -32601).Set("message", "unsupported"));
+        CallClientMethod("DevToolsAPI", "dispatchMessage", base::Value(base::WriteJson(reply).value()));
+      }
+      return;
+    }
+  }
   agent_host_->DispatchProtocolMessage(this, base::as_byte_span(message));
 }
 
