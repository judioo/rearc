+// Search engine choice (search_engines, ABI 1.46): the engines Chrome's
+// settings offer as the default (the current default, prepopulated and
+// policy-provided engines), in TemplateURLService order. id is Chromium's
+// TemplateURLID, stable for the profile. search_url as above; favicon_url
+// empty when unknown. can_make_default is false for every row when the default
+// is policy-managed (default_is_managed). Same loading, deferral and OTR rules
+// as the calls above; the list is borrowed for the callback.
+typedef struct ReArcSearchEngine {
+  int64_t id;
+  const char* name;
+  const char* keyword;
+  const char* search_url;
+  const char* favicon_url;
+  bool is_default, is_prepopulated, can_make_default;
+} ReArcSearchEngine;
+typedef struct ReArcSearchEngineList {
+  const ReArcSearchEngine* engines;
+  size_t count;
+  bool default_is_managed;
+} ReArcSearchEngineList;
+typedef void (*ReArcSearchEngineListCallback)(
+    void* context, ReArcStatus status, uint64_t profile_id,
+    const ReArcSearchEngineList* list);
+REARC_ENGINE_EXPORT ReArcStatus ReArcSearchListEngines(
+    uint64_t profile_id, ReArcSearchEngineListCallback completion,
+    void* context);
+// Makes an engine of the list the user-selected default (Chromium persists
+// it). id <= 0: invalid_argument; unknown id: not_found; policy-managed
+// default or an engine that cannot be default: invalid_state; OTR: unsupported.
+REARC_ENGINE_EXPORT ReArcStatus ReArcSearchSetDefaultEngine(
+    uint64_t profile_id, int64_t engine_id, ReArcCompletion completion,
+    void* context);
 
 // ABI 1.15 (history_recording, password_autofill): every tab carries Chromium's
 // HistoryTabHelper (non-OTR profiles), autofill client and
@@ -556,6 +588,47 @@ typedef void (*ReArcVideoOverlayPixelCallback)(void* context,
                                                uint32_t rgba);
 REARC_ENGINE_EXPORT ReArcStatus ReArcVideoOverlayReadPixel(
     uint64_t overlay_id, ReArcVideoOverlayPixelCallback callback, void* context);
+// Media capture (media_capture, ABI 1.46), per registry tab. capturing_video
+// and capturing_audio say the page holds a live camera / microphone stream,
+// capturing_display a screen, window or tab share; all three come from
+// Chromium's MediaStreamCaptureIndicator, the source of Chrome's tab recording
+// indicators. camera and microphone are the page's own on/off state from its
+// media session (navigator.mediaSession.setCameraActive/setMicrophoneActive):
+// REARC_CAPTURE_DEVICE_*; unknown when the page reports nothing. A stream can
+// stay live while the page reports the device off (a muted microphone), and a
+// page may stop the camera's stream when it turns it off. can_toggle_* say the
+// page handles the "togglecamera" / "togglemicrophone" media session actions.
+enum {
+  REARC_CAPTURE_DEVICE_UNKNOWN = 0,
+  REARC_CAPTURE_DEVICE_ON = 1,
+  REARC_CAPTURE_DEVICE_OFF = 2
+};
+typedef struct ReArcMediaCaptureState {
+  uint64_t profile_id, tab_id, content_generation;
+  bool capturing_video, capturing_audio, capturing_display;
+  uint32_t camera, microphone;
+  bool can_toggle_camera, can_toggle_microphone;
+} ReArcMediaCaptureState;
+// Posted on main after any field changes, at most once per change, never after
+// tab.closed. Setting a callback first posts the current state of every tab
+// that is not idle (idle: all false, both unknown). Null clears.
+typedef void (*ReArcMediaCaptureCallback)(void* context,
+                                          const ReArcMediaCaptureState* state);
+REARC_ENGINE_EXPORT void ReArcEngineSetMediaCaptureCallback(
+    ReArcMediaCaptureCallback callback, void* context);
+// Current state, synchronously. null state: invalid_argument.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetMediaCapture(
+    uint64_t tab_id, ReArcMediaCaptureState* state);
+// device: 0 camera, 1 microphone; muted=true asks for it off. Mute is the
+// page's: the engine sends the page's togglecamera/togglemicrophone action,
+// as Chrome's video-conferencing PiP buttons do, and the page turns its own
+// device off (it may disable or stop the track; the engine never touches the
+// track, and a page can ignore the action). OK when sent or already in that
+// state; the new state arrives as an event when the page reports it. No page
+// handler: unsupported. Handler but unknown state: invalid_state.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetCaptureMuted(uint64_t tab_id,
+                                                        uint32_t device,
+                                                        bool muted);
 // Output is +1 malloc PNG, free with ReArcBufferFree. Bound to tab/profile.
 REARC_ENGINE_EXPORT ReArcStatus ReArcFaviconGet(uint64_t tab_id,
                                                 const char* icon_ref,
