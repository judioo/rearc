new file mode 100644
index 0000000000..37d5aa0a4b
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_media_capture.cc
@@ -0,0 +1,310 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <pthread.h>
+
+#include <algorithm>
+#include <optional>
+#include <set>
+#include <vector>
+
+#include "base/check.h"
+#include "base/containers/flat_map.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/media_session/public/cpp/media_image.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/cpp/media_position.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace rearc {
+namespace {
+using media_session::mojom::CameraState;
+using media_session::mojom::MediaSessionAction;
+using media_session::mojom::MicrophoneState;
+
+ReArcMediaCaptureCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+
+MediaStreamCaptureIndicator* Indicator() {
+  return MediaCaptureDevicesDispatcher::GetInstance()
+      ->GetMediaStreamCaptureIndicator()
+      .get();
+}
+
+class CaptureWatch;
+std::set<CaptureWatch*>& Watches() {
+  static base::NoDestructor<std::set<CaptureWatch*>> watches;
+  return *watches;
+}
+
+// One indicator observer for every watched tab. It is registered only while a
+// tab is watched: the indicator's observer list must be empty when the
+// dispatcher singleton releases it at exit, and every registry tab is closed
+// (and unwatched) before then.
+class IndicatorObserver : public MediaStreamCaptureIndicator::Observer {
+ public:
+  void OnIsCapturingVideoChanged(content::WebContents* contents,
+                                 bool) override {
+    Refresh(contents);
+  }
+  void OnIsCapturingAudioChanged(content::WebContents* contents,
+                                 bool) override {
+    Refresh(contents);
+  }
+  void OnIsCapturingTabChanged(content::WebContents* contents,
+                               bool) override {
+    Refresh(contents);
+  }
+  void OnIsCapturingWindowChanged(content::WebContents* contents,
+                                  bool) override {
+    Refresh(contents);
+  }
+  void OnIsCapturingDisplayChanged(content::WebContents* contents,
+                                   bool) override {
+    Refresh(contents);
+  }
+
+ private:
+  static void Refresh(content::WebContents* contents);
+};
+IndicatorObserver& IndicatorWatcher() {
+  static base::NoDestructor<IndicatorObserver> observer;
+  return *observer;
+}
+
+void Deliver(uint64_t expected, ReArcMediaCaptureState state) {
+  if (!host || expected != epoch) return;
+  // Nothing after tab.closed, nor for a replaced content generation.
+  TabSession* session = TabRegistry::Get().FindSession(state.tab_id);
+  if (!session || session->content_generation() != state.content_generation) {
+    return;
+  }
+  host(host_context, &state);
+}
+
+// Capture devices from MediaStreamCaptureIndicator (Chrome's tab recording
+// indicators); camera and microphone state from the tab's media session, as
+// the page reports it with navigator.mediaSession.setCameraActive() and
+// setMicrophoneActive() (Chrome's video-conferencing PiP reads the same).
+class CaptureWatch : public content::WebContentsUserData<CaptureWatch>,
+                     public media_session::mojom::MediaSessionObserver {
+ public:
+  ~CaptureWatch() override {
+    Watches().erase(this);
+    if (Watches().empty()) Indicator()->RemoveObserver(&IndicatorWatcher());
+  }
+
+  ReArcMediaCaptureState State() {
+    ReArcMediaCaptureState state{};
+    state.profile_id = profile_id_;
+    state.tab_id = tab_id_;
+    state.content_generation = generation_;
+    content::WebContents* contents = &GetWebContents();
+    MediaStreamCaptureIndicator* indicator = Indicator();
+    state.capturing_video = indicator->IsCapturingVideo(contents);
+    state.capturing_audio = indicator->IsCapturingAudio(contents);
+    state.capturing_display = indicator->IsCapturingTab(contents) ||
+                              indicator->IsCapturingWindow(contents) ||
+                              indicator->IsCapturingDisplay(contents);
+    state.camera = camera_;
+    state.microphone = microphone_;
+    state.can_toggle_camera = Has(MediaSessionAction::kToggleCamera);
+    state.can_toggle_microphone = Has(MediaSessionAction::kToggleMicrophone);
+    return state;
+  }
+
+  // Posts the state when it differs from the last one reported. Without a
+  // host the state is still remembered, so a later host hears only changes;
+  // ReArcEngineSetMediaCaptureCallback replays the live non-idle tabs.
+  void Publish() {
+    ReArcMediaCaptureState state = State();
+    if (Same(state, sent_)) return;
+    sent_ = state;
+    if (host) ABIPost(base::BindOnce(&Deliver, epoch, state));
+  }
+  void Replay() {
+    sent_ = State();
+    if (!Same(sent_, ReArcMediaCaptureState{})) {
+      ABIPost(base::BindOnce(&Deliver, epoch, sent_));
+    }
+  }
+
+  // device: 0 camera, 1 microphone.
+  ReArcStatus SetMuted(uint32_t device, bool muted) {
+    const bool camera = device == 0;
+    if (!Has(camera ? MediaSessionAction::kToggleCamera
+                    : MediaSessionAction::kToggleMicrophone)) {
+      return REARC_UNSUPPORTED;
+    }
+    const uint32_t now = camera ? camera_ : microphone_;
+    if (now == REARC_CAPTURE_DEVICE_UNKNOWN) return REARC_INVALID_STATE;
+    if ((now == REARC_CAPTURE_DEVICE_OFF) == muted) return REARC_OK;
+    auto* session = content::MediaSession::GetIfExists(&GetWebContents());
+    if (!session) return REARC_INVALID_STATE;
+    if (camera) {
+      session->ToggleCamera();
+    } else {
+      session->ToggleMicrophone();
+    }
+    return REARC_OK;
+  }
+
+  // media_session::mojom::MediaSessionObserver:
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr info) override {
+    camera_ = REARC_CAPTURE_DEVICE_UNKNOWN;
+    microphone_ = REARC_CAPTURE_DEVICE_UNKNOWN;
+    if (info) {
+      if (info->camera_state == CameraState::kTurnedOn) {
+        camera_ = REARC_CAPTURE_DEVICE_ON;
+      } else if (info->camera_state == CameraState::kTurnedOff) {
+        camera_ = REARC_CAPTURE_DEVICE_OFF;
+      }
+      if (info->microphone_state == MicrophoneState::kUnmuted) {
+        microphone_ = REARC_CAPTURE_DEVICE_ON;
+      } else if (info->microphone_state == MicrophoneState::kMuted) {
+        microphone_ = REARC_CAPTURE_DEVICE_OFF;
+      }
+    }
+    Publish();
+  }
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>&) override {}
+  void MediaSessionActionsChanged(
+      const std::vector<MediaSessionAction>& actions) override {
+    actions_ = actions;
+    Publish();
+  }
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>&) override {
+  }
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>&) override {}
+
+ private:
+  friend class content::WebContentsUserData<CaptureWatch>;
+  CaptureWatch(content::WebContents* contents,
+               uint64_t profile_id,
+               uint64_t tab_id,
+               uint64_t generation)
+      : content::WebContentsUserData<CaptureWatch>(*contents),
+        profile_id_(profile_id),
+        tab_id_(tab_id),
+        generation_(generation) {
+    if (Watches().empty()) Indicator()->AddObserver(&IndicatorWatcher());
+    Watches().insert(this);
+    content::MediaSession::Get(contents)->AddObserver(
+        receiver_.BindNewPipeAndPassRemote());
+    // Unretained is scoped to the receiver, a member destroyed first.
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &CaptureWatch::OnDisconnected, base::Unretained(this)));
+  }
+
+  static bool Same(const ReArcMediaCaptureState& a,
+                   const ReArcMediaCaptureState& b) {
+    return a.capturing_video == b.capturing_video &&
+           a.capturing_audio == b.capturing_audio &&
+           a.capturing_display == b.capturing_display &&
+           a.camera == b.camera && a.microphone == b.microphone &&
+           a.can_toggle_camera == b.can_toggle_camera &&
+           a.can_toggle_microphone == b.can_toggle_microphone;
+  }
+  bool Has(MediaSessionAction action) const {
+    return std::find(actions_.begin(), actions_.end(), action) !=
+           actions_.end();
+  }
+  void OnDisconnected() {
+    receiver_.reset();
+    actions_.clear();
+    camera_ = microphone_ = REARC_CAPTURE_DEVICE_UNKNOWN;
+    Publish();
+  }
+
+  const uint64_t profile_id_, tab_id_, generation_;
+  uint32_t camera_ = REARC_CAPTURE_DEVICE_UNKNOWN;
+  uint32_t microphone_ = REARC_CAPTURE_DEVICE_UNKNOWN;
+  std::vector<MediaSessionAction> actions_;
+  ReArcMediaCaptureState sent_{};
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(CaptureWatch);
+
+void IndicatorObserver::Refresh(content::WebContents* contents) {
+  if (auto* watch = CaptureWatch::FromWebContents(contents)) watch->Publish();
+}
+
+CaptureWatch* FindWatch(uint64_t tab_id) {
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  return session && session->web_contents()
+             ? CaptureWatch::FromWebContents(session->web_contents())
+             : nullptr;
+}
+}  // namespace
+
+void ABIAttachMediaCapture(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || !session->web_contents() ||
+      CaptureWatch::FromWebContents(session->web_contents())) {
+    return;
+  }
+  CaptureWatch::CreateForWebContents(session->web_contents(),
+                                     session->profile_id(), tab_id,
+                                     session->content_generation());
+  CaptureWatch::FromWebContents(session->web_contents())->Publish();
+}
+
+void ABIDetachMediaCapture(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (session && session->web_contents()) {
+    session->web_contents()->RemoveUserData(CaptureWatch::UserDataKey());
+  }
+}
+}  // namespace rearc
+
+void ReArcEngineSetMediaCaptureCallback(ReArcMediaCaptureCallback callback,
+                                        void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+  if (!callback) return;
+  for (rearc::CaptureWatch* watch : rearc::Watches()) watch->Replay();
+}
+
+ReArcStatus ReArcTabGetMediaCapture(uint64_t tab_id,
+                                    ReArcMediaCaptureState* state) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) return status;
+  if (!state) return REARC_INVALID_ARGUMENT;
+  rearc::CaptureWatch* watch = rearc::FindWatch(tab_id);
+  if (!watch) return REARC_INVALID_STATE;
+  *state = watch->State();
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabSetCaptureMuted(uint64_t tab_id,
+                                    uint32_t device,
+                                    bool muted) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) return status;
+  if (device > 1) return REARC_INVALID_ARGUMENT;
+  rearc::CaptureWatch* watch = rearc::FindWatch(tab_id);
+  if (!watch) return REARC_INVALID_STATE;
+  return watch->SetMuted(device, muted);
+}
