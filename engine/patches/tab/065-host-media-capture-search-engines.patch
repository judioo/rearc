+ReArcStatus ReArcSearchListEngines(uint64_t profile_id,
+                                   ReArcSearchEngineListCallback completion,
+                                   void* context) {
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  return state->WhenLoaded(base::BindOnce(
+      [](uint64_t id, ReArcSearchEngineListCallback completion, void* context,
+         ReArcStatus status) {
+        struct Engine {
+          int64_t id;
+          std::string name, keyword, search, favicon;
+          bool is_default, prepopulated, can_make_default;
+        };
+        std::vector<Engine> engines;
+        bool managed = false;
+        if (!status) {
+          TemplateURLService* urls = rearc::States().at(id)->service();
+          const TemplateURL* current = urls->GetDefaultSearchProvider();
+          managed = urls->is_default_search_managed();
+          // Chrome's settings pop-up: the default plus prepopulated and
+          // policy-provided engines, in the service's order.
+          for (TemplateURL* url : urls->GetTemplateURLs()) {
+            if (!urls->ShowInDefaultList(url)) continue;
+            engines.push_back(
+                {url->id(), base::UTF16ToUTF8(url->short_name()),
+                 base::UTF16ToUTF8(url->keyword()),
+                 rearc::Resolve(url->url_ref(), urls->search_terms_data()),
+                 url->favicon_url().is_valid() ? url->favicon_url().spec()
+                                               : std::string(),
+                 url == current, url->prepopulate_id() > 0,
+                 !managed && urls->CanMakeDefault(url)});
+          }
+        }
+        rearc::ABIPost(base::BindOnce(
+            [](uint64_t id, ReArcSearchEngineListCallback completion,
+               void* context, ReArcStatus status, bool managed,
+               std::vector<Engine> engines) {
+              std::vector<ReArcSearchEngine> rows;
+              for (const Engine& e : engines) {
+                rows.push_back({e.id, e.name.c_str(), e.keyword.c_str(),
+                                e.search.c_str(), e.favicon.c_str(),
+                                e.is_default, e.prepopulated,
+                                e.can_make_default});
+              }
+              ReArcSearchEngineList list{rows.empty() ? nullptr : rows.data(),
+                                         rows.size(), managed};
+              completion(context, status, id, status ? nullptr : &list);
+            },
+            id, completion, context, status, managed, std::move(engines)));
+      },
+      profile_id, completion, context));
+}
+
+ReArcStatus ReArcSearchSetDefaultEngine(uint64_t profile_id,
+                                        int64_t engine_id,
+                                        ReArcCompletion completion,
+                                        void* context) {
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  // OTR shares (redirects to) its original's keywords; never mutate them.
+  if (state->profile()->IsOffTheRecord()) return REARC_UNSUPPORTED;
+  if (!completion || engine_id <= 0) return REARC_INVALID_ARGUMENT;
+  return state->WhenLoaded(base::BindOnce(
+      [](uint64_t id, int64_t engine_id, ReArcCompletion completion,
+         void* context, ReArcStatus status) {
+        if (!status) {
+          TemplateURLService* urls = rearc::States().at(id)->service();
+          TemplateURL* url = urls->GetTemplateURLForId(engine_id);
+          if (!url) {
+            status = REARC_NOT_FOUND;
+          } else if (urls->is_default_search_managed() ||
+                     !urls->CanMakeDefault(url)) {
+            status = REARC_INVALID_STATE;
+          } else {
+            urls->SetUserSelectedDefaultSearchProvider(url);
+          }
+        }
+        rearc::ABIPost(base::BindOnce(completion, context, status, false));
+      },
+      profile_id, engine_id, completion, context));
+}
