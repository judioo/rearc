new file mode 100644
index 0000000000..411d1c2854
--- /dev/null
+++ b/chrome/browser/rearc_bridge/attachment_lease.cc
@@ -0,0 +1,289 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/attachment_lease.h"
+
+#include <utility>
+#include <vector>
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "chrome/browser/rearc_bridge/web_contents_view_delegate_mac.h"
+#include "content/public/browser/web_contents.h"
+
+namespace rearc {
+
+namespace {
+
+AttachmentEventSink*& GetAttachmentEventSinkSlot() {
+  // A plain static: the slot is trivially initialized and never torn down.
+  static AttachmentEventSink* sink = nullptr;
+  return sink;
+}
+
+// Answers content's GetNativeWindow() consults (via tab/006's
+// ReArcWebContentsViewDelegate) with the host's window. One per lease;
+// destroyed with it after ClearReArcNativeWindowProvider.
+class LeaseWindowProvider : public ReArcNativeWindowProvider {
+ public:
+  explicit LeaseWindowProvider(ReArcContentHostRef host)
+      : host_(reinterpret_cast<uintptr_t>(host)) {}
+
+  gfx::NativeWindow GetAttachedNativeWindow() override {
+    return ReArcContentHostGetWindow(
+        reinterpret_cast<ReArcContentHostRef>(host_));
+  }
+
+ private:
+  // Borrowed: owned by the Lease, which outlives the provider registration
+  // (cleared before destruction). Stored as an integer so the class carries
+  // no raw pointer members.
+  uintptr_t host_ = 0;
+};
+
+}  // namespace
+
+struct AttachmentLeaseRegistry::Lease {
+  uint64_t attachment_id = 0;
+  uint64_t tab_id = 0;
+  // Engine-retained host (ReArcContentHostCreate/Release). Stored as an
+  // integer so the struct carries no raw pointer members.
+  uintptr_t host = 0;
+  std::unique_ptr<LeaseWindowProvider> provider;
+  // Weak, auto-nulling handle to the WebContentsView container (R8's stable
+  // anchor). Never dereferenced after invalidation.
+  gfx::NativeView content;
+  double width_dip = 0.0;
+  double height_dip = 0.0;
+  double scale_hint = 1.0;
+  bool visible = false;
+
+  ReArcContentHostRef host_ref() const {
+    return reinterpret_cast<ReArcContentHostRef>(host);
+  }
+};
+
+const char* LeaseInvalidatedReasonName(LeaseInvalidatedReason reason) {
+  switch (reason) {
+    case LeaseInvalidatedReason::kTabClosed:
+      return "tab_closed";
+    case LeaseInvalidatedReason::kWindowClosed:
+      return "window_closed";
+    case LeaseInvalidatedReason::kContentReplaced:
+      return "content_replaced";
+    case LeaseInvalidatedReason::kEngineStopped:
+      return "engine_stopped";
+  }
+}
+
+void SetAttachmentEventSink(AttachmentEventSink* sink) {
+  CHECK(pthread_main_np());
+  GetAttachmentEventSinkSlot() = sink;
+}
+
+// static
+AttachmentLeaseRegistry& AttachmentLeaseRegistry::Get() {
+  CHECK(pthread_main_np());
+  static base::NoDestructor<AttachmentLeaseRegistry> registry;
+  return *registry;
+}
+
+AttachmentLeaseRegistry::AttachmentLeaseRegistry() = default;
+AttachmentLeaseRegistry::~AttachmentLeaseRegistry() = default;
+
+AttachResult AttachmentLeaseRegistry::AttachView(uint64_t tab_id,
+                                                 double width_dip,
+                                                 double height_dip,
+                                                 double scale_hint) {
+  CHECK(pthread_main_np());
+  AttachResult result;
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || !session->web_contents()) {
+    result.error = AttachError::kTabNotFound;
+    return result;
+  }
+  if (leases_.contains(tab_id)) {
+    // §6: at most one live attachment per tab.
+    result.error = AttachError::kAlreadyAttached;
+    return result;
+  }
+
+  content::WebContents* contents = session->web_contents();
+  auto lease = std::make_unique<Lease>();
+  lease->attachment_id = next_attachment_id_++;
+  lease->tab_id = tab_id;
+  lease->host =
+      reinterpret_cast<uintptr_t>(ReArcContentHostCreate());
+  // R8: anchor on the WebContentsView container.
+  lease->content = contents->GetNativeView();
+  lease->width_dip = width_dip;
+  lease->height_dip = height_dip;
+  lease->scale_hint = scale_hint;
+  lease->visible = false;
+
+  ReArcContentHostAttachContent(lease->host_ref(), lease->content);
+  ReArcContentHostSetSizeDip(lease->host_ref(), width_dip, height_dip,
+                             scale_hint);
+  // §6: attachments start hidden — the host was created hidden and no
+  // WasShown is issued until the first SetViewVisible(true).
+  ReArcContentHostSetHidden(lease->host_ref(), true);
+
+  lease->provider =
+      std::make_unique<LeaseWindowProvider>(lease->host_ref());
+  SetReArcNativeWindowProvider(contents, lease->provider.get());
+
+  result.attachment_id = lease->attachment_id;
+  result.host_view = ReArcContentHostGetView(lease->host_ref());
+  leases_.emplace(tab_id, std::move(lease));
+  return result;
+}
+
+bool AttachmentLeaseRegistry::DetachView(uint64_t tab_id,
+                                         uint64_t attachment_id) {
+  CHECK(pthread_main_np());
+  Lease* lease = FindLease(tab_id, attachment_id);
+  if (!lease) {
+    // §6: expired ids fail stale_attachment (day-one: plain false; the
+    // transport slice maps it onto the wire error).
+    VLOG(1) << "rearc: DetachView for stale attachment tab_id=" << tab_id
+            << " attachment_id=" << attachment_id;
+    return false;
+  }
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  content::WebContents* contents = session ? session->web_contents() : nullptr;
+  if (lease->visible && contents) {
+    contents->WasHidden();
+  }
+  if (contents) {
+    ClearReArcNativeWindowProvider(contents, lease->provider.get());
+  }
+  // §6: detach empties the host on the main thread, then the reply
+  // invalidates the id — no event.
+  ReArcContentHostEmptyContent(lease->host_ref());
+  ReArcContentHostRelease(lease->host_ref());
+  leases_.erase(tab_id);
+  return true;
+}
+
+bool AttachmentLeaseRegistry::ResizeView(uint64_t tab_id,
+                                         uint64_t attachment_id,
+                                         double width_dip,
+                                         double height_dip,
+                                         double scale_hint) {
+  CHECK(pthread_main_np());
+  Lease* lease = FindLease(tab_id, attachment_id);
+  if (!lease) {
+    VLOG(1) << "rearc: ResizeView for stale attachment tab_id=" << tab_id
+            << " attachment_id=" << attachment_id;
+    return false;
+  }
+  lease->width_dip = width_dip;
+  lease->height_dip = height_dip;
+  lease->scale_hint = scale_hint;
+  ReArcContentHostSetSizeDip(lease->host_ref(), width_dip, height_dip,
+                             scale_hint);
+  return true;
+}
+
+bool AttachmentLeaseRegistry::SetViewVisible(uint64_t tab_id,
+                                             uint64_t attachment_id,
+                                             bool visible) {
+  CHECK(pthread_main_np());
+  Lease* lease = FindLease(tab_id, attachment_id);
+  if (!lease) {
+    VLOG(1) << "rearc: SetViewVisible for stale attachment tab_id=" << tab_id
+            << " attachment_id=" << attachment_id;
+    return false;
+  }
+  if (lease->visible == visible) {
+    return true;
+  }
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  content::WebContents* contents = session ? session->web_contents() : nullptr;
+  ReArcContentHostSetHidden(lease->host_ref(), !visible);
+  if (contents) {
+    // §6 / web_contents.h:1043 guidance: visibility transitions drive
+    // WasShown/WasHidden, only on actual transitions.
+    if (visible) {
+      contents->WasShown();
+    } else {
+      contents->WasHidden();
+    }
+  }
+  lease->visible = visible;
+  return true;
+}
+
+uint64_t AttachmentLeaseRegistry::AttachmentIdForTab(uint64_t tab_id) const {
+  CHECK(pthread_main_np());
+  auto it = leases_.find(tab_id);
+  return it == leases_.end() ? 0 : it->second->attachment_id;
+}
+
+void AttachmentLeaseRegistry::InvalidateLeasesForTab(
+    uint64_t tab_id,
+    LeaseInvalidatedReason reason) {
+  CHECK(pthread_main_np());
+  auto it = leases_.find(tab_id);
+  if (it == leases_.end()) {
+    return;
+  }
+  Lease* lease = it->second.get();
+  const uint64_t attachment_id = lease->attachment_id;
+
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  content::WebContents* contents = session ? session->web_contents() : nullptr;
+  if (lease->visible && contents) {
+    contents->WasHidden();
+  }
+  if (contents) {
+    ClearReArcNativeWindowProvider(contents, lease->provider.get());
+  }
+  // §6 engine-initiated invalidation: the host is ALREADY emptied before the
+  // event; the shell may retain the empty NSView until it dismantles its
+  // scaffolding; the engine releases only its own retain; the id dies now.
+  ReArcContentHostEmptyContent(lease->host_ref());
+  ReArcContentHostRelease(lease->host_ref());
+  leases_.erase(it);
+
+  AttachmentEventSink* sink = GetAttachmentEventSinkSlot();
+  if (sink) {
+    sink->OnLeaseInvalidated(tab_id, attachment_id, reason);
+  } else {
+    VLOG(1) << "rearc: no AttachmentEventSink; lease invalidated tab_id="
+            << tab_id << " attachment_id=" << attachment_id << " reason="
+            << LeaseInvalidatedReasonName(reason);
+  }
+}
+
+void AttachmentLeaseRegistry::InvalidateAllLeases(
+    LeaseInvalidatedReason reason) {
+  CHECK(pthread_main_np());
+  // Copy the ids first: each invalidation erases from the map.
+  std::vector<uint64_t> tab_ids;
+  tab_ids.reserve(leases_.size());
+  for (const auto& [tab_id, lease] : leases_) {
+    tab_ids.push_back(tab_id);
+  }
+  for (uint64_t tab_id : tab_ids) {
+    InvalidateLeasesForTab(tab_id, reason);
+  }
+}
+
+AttachmentLeaseRegistry::Lease* AttachmentLeaseRegistry::FindLease(
+    uint64_t tab_id,
+    uint64_t attachment_id) {
+  auto it = leases_.find(tab_id);
+  if (it == leases_.end() || it->second->attachment_id != attachment_id) {
+    return nullptr;
+  }
+  return it->second.get();
+}
+
+}  // namespace rearc
