@@ -0,0 +1,80 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_CONTENT_HOST_MAC_H_
+#define CHROME_BROWSER_REARC_BRIDGE_CONTENT_HOST_MAC_H_
+
+#include "ui/gfx/native_ui_types.h"
+
+namespace rearc {
+
+// Native content host (P-TAB-001 slice S4) — the engine side of IPC-CONTRACT
+// §6's view.attach / view.detach / view.resize / view.invalidate verbs.
+//
+// A host is an NSView subclass instance (ReArcContentHostView, defined in the
+// .mm) that owns exactly one content view: the WebContentsView container of
+// an attached tab, anchored via WebContents::GetNativeView() — R8's stable
+// anchor, never GetContentNativeView()/RWHVMac. This header is a pure C++
+// surface (opaque handle + gfx::NativeView/NativeWindow values, both of
+// which are C++ classes usable outside ObjC TUs); every AppKit touch lives
+// in content_host_mac.mm.
+//
+// Ownership: Create retains the NSView on the engine's behalf
+// (CFBridgingRetain); Release drops THAT retain only. Per IPC-CONTRACT §6,
+// after an engine-initiated invalidation the shell may retain the emptied
+// NSView until it dismantles its scaffolding — Release never destroys a
+// view the shell still holds.
+//
+// All calls are main thread (Chromium BrowserThread::UI) only.
+
+// Opaque retained handle to a ReArcContentHostView. Never dereferenced
+// outside content_host_mac.mm.
+using ReArcContentHostRef = void*;
+
+// Creates a hidden, empty host. The engine holds one retain; the shell
+// receives the view via ReArcContentHostGetView and retains it itself if it
+// embeds it.
+ReArcContentHostRef ReArcContentHostCreate();
+
+// Drops the engine's retain. `host` must not be used afterwards; the NSView
+// itself stays alive as long as the shell retains it.
+void ReArcContentHostRelease(ReArcContentHostRef host);
+
+// Parents `content` (a tab's WebContentsView container) inside the host,
+// pinned to the host's bounds by autoresizing. No layer touches: the host
+// is a plain NSView so compositing stays entirely on content's side. Any
+// previously attached content is removed first. A null `content` is
+// equivalent to ReArcContentHostEmptyContent.
+void ReArcContentHostAttachContent(ReArcContentHostRef host,
+                                   gfx::NativeView content);
+
+// Removes the hosted content view (IPC-CONTRACT §6 "empties the host").
+// Idempotent.
+void ReArcContentHostEmptyContent(ReArcContentHostRef host);
+
+// Sizes the host. IPC-CONTRACT §6: sizes arrive in DIP and are rounded to
+// points; `scale_hint` is a hint only (the display's backing scale factor
+// wins day-one; recorded for the transport slice's validation).
+void ReArcContentHostSetSizeDip(ReArcContentHostRef host,
+                                double width_dip,
+                                double height_dip,
+                                double scale_hint);
+
+// Hidden/shown. A fresh host starts hidden (§6); visibility transitions are
+// driven by the attachment lease in lockstep with WebContents::WasShown /
+// WasHidden.
+void ReArcContentHostSetHidden(ReArcContentHostRef host, bool hidden);
+
+// The NSWindow the host is currently in, or gfx::NativeWindow() when the
+// host is not in any window. Backs the S1 ReArcNativeWindowProvider seam.
+gfx::NativeWindow ReArcContentHostGetWindow(ReArcContentHostRef host);
+
+// The host NSView itself as an opaque handle (NSView*), for the shell's
+// in-process typed bridge to embed. The shell must retain it (and per §6,
+// no NSView pointer ever travels over data messages).
+void* ReArcContentHostGetView(ReArcContentHostRef host);
+
