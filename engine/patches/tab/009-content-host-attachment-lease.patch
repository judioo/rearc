@@ -0,0 +1,149 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_ATTACHMENT_LEASE_H_
+#define CHROME_BROWSER_REARC_BRIDGE_ATTACHMENT_LEASE_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+
+#include "chrome/browser/rearc_bridge/content_host_mac.h"
+
+namespace base {
+template <typename T>
+class NoDestructor;
+}  // namespace base
+
+namespace rearc {
+
+// Attachment lease registry (P-TAB-001 slice S4), implementing IPC-CONTRACT
+// §6's rules over the S1 ReArcNativeWindowProvider seam and the S4 native
+// host:
+//  * At most ONE live attachment per tab; a second view.attach fails
+//    already_attached. A lease never grants a second superview.
+//  * Attachments start hidden; WebContents::WasShown/WasHidden are called
+//    only on visibility transitions.
+//  * Shell-initiated view.detach empties the host on the main thread and
+//    invalidates the attachment id (the reply carries it) — NO event.
+//  * Engine-initiated invalidation (tab closed, window closed, content
+//    replaced, engine stopped) empties the host FIRST, releases the
+//    engine's retain, then reports view.invalidated; the shell may retain
+//    the emptied NSView until it dismantles its scaffolding; the id is
+//    dead immediately. Content replacement invalidates BEFORE the
+//    replacement and requires a fresh attach.
+//  * Expired ids fail stale_attachment.
+//  * The lease anchors on the WebContentsView container
+//    (WebContents::GetNativeView(), web_contents.h:1241) — never
+//    GetContentNativeView()/RWHVMac.
+//
+// All native ops are main-thread-only (Chromium BrowserThread::UI); every
+// entry point CHECKs.
+
+// IPC-CONTRACT §6 failure vocabulary for view.attach.
+enum class AttachError {
+  kNone,
+  kTabNotFound,
+  kAlreadyAttached,
+};
+
+// IPC-CONTRACT §6 view.invalidated `reason` enum. Wire names via
+// LeaseInvalidatedReasonName: "tab_closed", "window_closed",
+// "content_replaced", "engine_stopped".
+enum class LeaseInvalidatedReason {
+  kTabClosed,
+  kWindowClosed,
+  kContentReplaced,
+  kEngineStopped,
+};
+
+const char* LeaseInvalidatedReasonName(LeaseInvalidatedReason reason);
+
+struct AttachResult {
+  AttachError error = AttachError::kNone;
+  // Engine-allocated, monotonic from 1 (§1: E allocates attachment_id; 0 is
+  // invalid). 0 on failure.
+  uint64_t attachment_id = 0;
+  // The host NSView as an opaque handle for the shell's in-process typed
+  // bridge to embed (§6: no NSView over data messages). Null on failure.
+  ReArcContentHostRef host_view = nullptr;
+};
+
+// Sink for engine-initiated lease invalidations (view.invalidated). Main
+// thread only; the sink must outlive its registration.
+class AttachmentEventSink {
+ public:
+  virtual ~AttachmentEventSink() = default;
+  virtual void OnLeaseInvalidated(uint64_t tab_id,
+                                  uint64_t attachment_id,
+                                  LeaseInvalidatedReason reason) = 0;
+};
+
+void SetAttachmentEventSink(AttachmentEventSink* sink);
+
+class AttachmentLeaseRegistry {
+ public:
+  static AttachmentLeaseRegistry& Get();
+
+  AttachmentLeaseRegistry(const AttachmentLeaseRegistry&) = delete;
+  AttachmentLeaseRegistry& operator=(const AttachmentLeaseRegistry&) = delete;
+
+  // view.attach. Registers the S1 native-window provider for the tab's
+  // WebContents so content's GetNativeWindow() consults resolve to the
+  // host's window. Starts hidden; no WasShown until the first
+  // SetViewVisible(true).
+  AttachResult AttachView(uint64_t tab_id,
+                          double width_dip,
+                          double height_dip,
+                          double scale_hint);
+
+  // view.detach (shell-initiated): empties the host on the main thread,
+  // drops the provider and the engine's retain, invalidates the id. No
+  // event is emitted (§6). False for unknown/stale ids.
+  bool DetachView(uint64_t tab_id, uint64_t attachment_id);
+
+  // view.resize: DIP in, points rounded inside the host; scale is a hint.
+  // False for unknown/stale ids.
+  bool ResizeView(uint64_t tab_id,
+                  uint64_t attachment_id,
+                  double width_dip,
+                  double height_dip,
+                  double scale_hint);
+
+  // Visibility transitions drive WasShown/WasHidden on the WebContents —
+  // only on actual transitions. False for unknown/stale ids.
+  bool SetViewVisible(uint64_t tab_id, uint64_t attachment_id, bool visible);
+
+  // 0 when the tab has no live attachment.
+  uint64_t AttachmentIdForTab(uint64_t tab_id) const;
+
+  // Engine-initiated invalidation of one tab's lease (§6): empties the host
+  // first, releases the engine's retain, then reports view.invalidated with
+  // `reason`. No-op when the tab has no live attachment. S7's content
+  // replacement calls this with kContentReplaced BEFORE swapping the
+  // WebContents; S6's close pipeline calls it with kTabClosed before
+  // destruction; engine teardown uses kEngineStopped. kWindowClosed is for
+  // the shell window lifecycle integration.
+  void InvalidateLeasesForTab(uint64_t tab_id, LeaseInvalidatedReason reason);
+
+  // Engine-stopped teardown: invalidates every live lease with `reason`.
+  void InvalidateAllLeases(LeaseInvalidatedReason reason);
+
+ private:
+  friend class base::NoDestructor<AttachmentLeaseRegistry>;
+  AttachmentLeaseRegistry();
+  ~AttachmentLeaseRegistry();
+
+  // Defined in the .cc (keeps WebContents-facing types out of this header).
+  struct Lease;
+  Lease* FindLease(uint64_t tab_id, uint64_t attachment_id);
+
+  uint64_t next_attachment_id_ = 1;
+  // tab_id -> lease (at most one per tab, §6).
+  std::map<uint64_t, std::unique_ptr<Lease>> leases_;
+};
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_ATTACHMENT_LEASE_H_
