+
+// The engine-side host view for one attached tab (IPC-CONTRACT §6). Plain
+// NSView — deliberately layerless: compositing stays on content's side and
+// the host never interposes a CALayer between the shell's hierarchy and the
+// WebContentsView container. File-scoped at global scope (ObjC declarations
+// may not appear inside a C++ namespace).
+@interface ReArcContentHostView : NSView {
+ @private
+  // Strong: while attached, the host is the content view's owner on the
+  // engine side. Emptied on detach/invalidate BEFORE the engine releases
+  // its own retain, per §6's "engine has already emptied the host" rule.
+  NSView* _contentView;
+  // Recorded day-one for the transport slice's validation; the display's
+  // backing scale factor wins for rendering.
+  double _scaleHint;
+}
+
+- (void)attachContent:(NSView*)content;
+- (void)setSizeDip:(NSSize)size scaleHint:(double)scaleHint;
+
+@end
+
+@implementation ReArcContentHostView
+
+- (instancetype)init {
+  self = [super initWithFrame:NSZeroRect];
+  if (self) {
+    _contentView = nil;
+    _scaleHint = 1.0;
+    // IPC-CONTRACT §6: attachments start hidden.
+    [self setHidden:YES];
+  }
+  return self;
+}
+
+- (void)attachContent:(NSView*)content {
+  if (_contentView == content) {
+    return;
+  }
+  [_contentView removeFromSuperview];
+  _contentView = content;
+  if (content) {
+    [content setFrame:[self bounds]];
+    [content setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+    [self addSubview:content];
+  }
+}
+
+- (void)setSizeDip:(NSSize)size scaleHint:(double)scaleHint {
+  _scaleHint = scaleHint > 0.0 ? scaleHint : 1.0;
+  // §6: DIP are rounded to points; scale is a hint.
+  [self setFrameSize:NSMakeSize(std::round(size.width),
+                                std::round(size.height))];
+}
+
+@end
+
+namespace rearc {
+namespace {
+
+ReArcContentHostView* AsHostView(ReArcContentHostRef host) {
+  DCHECK(host);
+  return (__bridge ReArcContentHostView*)host;
+}
+
+}  // namespace
+
+ReArcContentHostRef ReArcContentHostCreate() {
+  CHECK(pthread_main_np());
+  ReArcContentHostView* view = [[ReArcContentHostView alloc] init];
+  // Engine-side retain crossing into the pure-C++ world as an opaque handle.
+  return (ReArcContentHostRef)CFBridgingRetain(view);
+}
+
+void ReArcContentHostRelease(ReArcContentHostRef host) {
+  CHECK(pthread_main_np());
+  if (!host) {
+    return;
+  }
+  // Drops only the engine's retain; a shell-retained view stays alive.
+  CFBridgingRelease(host);
+}
+
+void ReArcContentHostAttachContent(ReArcContentHostRef host,
+                                   gfx::NativeView content) {
+  CHECK(pthread_main_np());
+  [AsHostView(host) attachContent:content.GetNativeNSView()];
+}
+
+void ReArcContentHostEmptyContent(ReArcContentHostRef host) {
+  CHECK(pthread_main_np());
+  [AsHostView(host) attachContent:nil];
+}
+
+void ReArcContentHostSetSizeDip(ReArcContentHostRef host,
+                                double width_dip,
+                                double height_dip,
+                                double scale_hint) {
+  CHECK(pthread_main_np());
+  [AsHostView(host) setSizeDip:NSMakeSize(width_dip, height_dip)
+                     scaleHint:scale_hint];
+}
+
+void ReArcContentHostSetHidden(ReArcContentHostRef host, bool hidden) {
+  CHECK(pthread_main_np());
+  [AsHostView(host) setHidden:hidden];
+}
+
+gfx::NativeWindow ReArcContentHostGetWindow(ReArcContentHostRef host) {
+  CHECK(pthread_main_np());
+  return gfx::NativeWindow([AsHostView(host) window]);
+}
+
+void* ReArcContentHostGetView(ReArcContentHostRef host) {
+  CHECK(pthread_main_np());
+  return (__bridge void*)AsHostView(host);
+}
+
+}  // namespace rearc
