+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_ENGINE_MODE_H_
+#define CHROME_BROWSER_REARC_BRIDGE_ENGINE_MODE_H_
+
+namespace rearc {
+
+// Ambient engine-mode predicate (P-TAB-001 slice S1).
+//
+// Returns true when the engine runs embedded under the ReArc shell, i.e. when
+// a lifecycle host is installed (P-APP-001, patch app/002). Content consults
+// ChromeContentBrowserClient::GetWebContentsViewDelegate synchronously inside
+// WebContents::Create (content/browser/web_contents/web_contents_impl.cc
+// :4537) and at four later call sites (:3476/:3629/:3662/:3775 — inner-
+// WebContents attach/detach and view recreation), so the mode decision cannot
+// be per-tab or per-call-site: it must be an ambient, process-wide predicate.
+// ReArc never creates Chrome Browser windows, so a process-wide mode loses
+// nothing.
+//
+// Deviation from the P-TAB-001-SLICES sketch (recorded in that document's
+// drift log): the plan called for an explicit std::atomic<bool> plus
+// SetEngineEmbeddedMode(bool) driven from rearc_engine_entry_mac.mm. That
+// file is created by patch app/002 and is frozen by the series-mechanics
+// invariant (later patches may never modify files created by earlier
+// patches), so no legal setter site exists. The predicate is therefore
+// derived from the same source of truth P-APP-001 already gates on:
+// GetEngineLifecycleHost() != nullptr. Semantics are identical to the planned
+// flag (host installed at entry => embedded; absent => standalone) and stock
+// behavior is preserved bit-identically when no host is installed.
+//
+// Main thread only (Chromium BrowserThread::UI), matching the lifecycle
+// host's threading contract.
+bool IsEngineEmbeddedMode();
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_ENGINE_MODE_H_
diff --git a/chrome/browser/rearc_bridge/web_contents_view_delegate_mac.h b/chrome/browser/rearc_bridge/web_contents_view_delegate_mac.h
new file mode 100644
index 0000000000..f28a3fe9d2
--- /dev/null
+++ b/chrome/browser/rearc_bridge/web_contents_view_delegate_mac.h
@@ -0,0 +1,61 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_WEB_CONTENTS_VIEW_DELEGATE_MAC_H_
+#define CHROME_BROWSER_REARC_BRIDGE_WEB_CONTENTS_VIEW_DELEGATE_MAC_H_
+
+#include <memory>
+
+#include "ui/gfx/native_ui_types.h"
+
+namespace content {
+class WebContents;
+class WebContentsViewDelegate;
+}  // namespace content
+
+namespace rearc {
+
+// Provider seam for the S4 attachment lease (P-TAB-001 slice S1 scaffolding).
+//
+// ReArcWebContentsViewDelegate::GetNativeWindow() answers through the
+// provider registered for its WebContents. Slice S1 deliberately registers
+// nothing, so GetNativeWindow() returns gfx::NativeWindow() — content's
+// documented "not in any window" state. Slice S4 (attachment lease) registers
+// one provider per attached tab, additively, without modifying this file
+// (series-mechanics invariant: later patches never edit earlier patches'
+// files).
+class ReArcNativeWindowProvider {
+ public:
+  virtual ~ReArcNativeWindowProvider() = default;
+
+  // Returns the NSWindow the WebContents is currently attached to, or
+  // gfx::NativeWindow() when unattached.
+  virtual gfx::NativeWindow GetAttachedNativeWindow() = 0;
+};
+
+// Registers (or replaces) the native-window provider for `web_contents`.
+// Main thread only; the provider must outlive its registration and be cleared
+// (ClearReArcNativeWindowProvider) before it is destroyed. The registration
+// is also dropped automatically when the WebContents' view delegate is
+// destroyed, so provider teardown only needs to happen before the *provider*
+// dies, not before the WebContents.
+void SetReArcNativeWindowProvider(content::WebContents* web_contents,
+                                  ReArcNativeWindowProvider* provider);
+
+// Clears the provider registration for `web_contents`, but only if
+// `provider` is the currently registered provider (guards against clearing a
+// replacement). Main thread only.
+void ClearReArcNativeWindowProvider(content::WebContents* web_contents,
+                                    ReArcNativeWindowProvider* provider);
+
+// Factory for the embedded-mode WebContentsViewDelegate, called from
+// ChromeContentBrowserClient::GetWebContentsViewDelegate when
+// rearc::IsEngineEmbeddedMode() is true (patch tab/006's upstream hunk).
+// Consulted synchronously inside WebContents::Create, on the main thread.
+std::unique_ptr<content::WebContentsViewDelegate>
+CreateReArcWebContentsViewDelegate(content::WebContents* web_contents);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_WEB_CONTENTS_VIEW_DELEGATE_MAC_H_
diff --git a/chrome/browser/rearc_bridge/web_contents_view_delegate_mac.mm b/chrome/browser/rearc_bridge/web_contents_view_delegate_mac.mm
new file mode 100644
index 0000000000..7ee793ecd2
--- /dev/null
+++ b/chrome/browser/rearc_bridge/web_contents_view_delegate_mac.mm
@@ -0,0 +1,119 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/web_contents_view_delegate_mac.h"
+
+#include <pthread.h>
+
+#include <map>
+#include <optional>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/callback.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "content/public/browser/web_contents_view_delegate.h"
+#include "content/public/common/drop_data.h"
+
+namespace rearc {
+
+namespace {
+
+// Main-thread only: registrations happen during tab attach/detach and reads
+// happen from content's view-delegate call sites, all on BrowserThread::UI.
+// The delegate erases its own entry on destruction, so keys never outlive
+// their WebContents.
+std::map<content::WebContents*, raw_ptr<ReArcNativeWindowProvider>>
+    g_native_window_providers;
+
+// Embedded-mode view delegate (P-TAB-001 slice S1). Replaces the stock
+// desktop delegate (chrome/browser/ui/views/tab_contents/
+// chrome_web_contents_view_delegate_views.cc), which is unusable browser-
+// lessly: it resolves GlobalBrowserCollection::FindBrowserWithTab() — always
+// null in registry mode — and its context-menu path is Views-based.
+//
+// Day-one behavior (upgraded by later slices without modifying this file —
+// the S4 lease plugs in through the provider seam above):
+//  - GetNativeWindow(): answers through the registered provider; nil until
+//    S4 wires the attachment lease. Nil is content's documented "not in any
+//    window" state and must stay consistent with TabSession's start-hidden
+//    visibility policy.
+//  - ShowContextMenu(): suppressed — the stock Cocoa menu must never appear
+//    in the shell. The shell-side menu channel (IPC-CONTRACT §6 typed side
+//    channel) arrives with a later slice; until then the policy is "fallback
+//    dismiss" per the slice plan.
+//  - OnPerformingDrop(): aborted with std::nullopt. The content:: default
+//    *performs* the drop (runs the callback with the drop data), which is
+//    wrong day-one; aborting still completes the callback — cancel through
+//    upstream callbacks, never hang (R7).
+//  - Focus methods (StoreFocus/RestoreFocus/ResetStoredFocus/Focus/
+//    TakeFocus): content defaults day-one; AppKit first-responder routing
+//    through the lease's host view arrives with S4.
+//  - GetDelegateForHost(): content default (nil) — responder-chain extras,
+//    not required for presentation; audit before enabling.
+//  - GetDragDestDelegate(): content default (nullptr) — bookmark-handler
+//    interception is a Chrome-browser feature, out of scope.
+class ReArcWebContentsViewDelegate : public content::WebContentsViewDelegate {
+ public:
+  explicit ReArcWebContentsViewDelegate(content::WebContents* web_contents)
+      : web_contents_(web_contents) {}
+  ReArcWebContentsViewDelegate(const ReArcWebContentsViewDelegate&) = delete;
+  ReArcWebContentsViewDelegate& operator=(const ReArcWebContentsViewDelegate&) =
+      delete;
+
+  ~ReArcWebContentsViewDelegate() override {
+    g_native_window_providers.erase(web_contents_);
+  }
+
+  // content::WebContentsViewDelegate:
+  gfx::NativeWindow GetNativeWindow() override {
+    auto it = g_native_window_providers.find(web_contents_);
+    if (it != g_native_window_providers.end() && it->second) {
+      return it->second->GetAttachedNativeWindow();
+    }
+    return gfx::NativeWindow();
+  }
+
+  void ShowContextMenu(content::RenderFrameHost& render_frame_host,
+                       const content::ContextMenuParams& params) override {
+    VLOG(1) << "ReArc bridge: context menu suppressed (no shell menu channel "
+               "yet).";
+  }
+
+  void OnPerformingDrop(const content::DropData& drop_data,
+                        DropCompletionCallback callback) override {
+    VLOG(1) << "ReArc bridge: drop aborted (no shell drop policy yet).";
+    std::move(callback).Run(std::nullopt);
+  }
+
+ private:
+  // Owned by content; the delegate is destroyed with the WebContents' view,
+  // so the owner always outlives this pointer.
+  raw_ptr<content::WebContents> web_contents_;
+};
+
+}  // namespace
+
+void SetReArcNativeWindowProvider(content::WebContents* web_contents,
+                                  ReArcNativeWindowProvider* provider) {
+  CHECK(pthread_main_np());
+  g_native_window_providers[web_contents] = provider;
+}
+
+void ClearReArcNativeWindowProvider(content::WebContents* web_contents,
+                                    ReArcNativeWindowProvider* provider) {
+  CHECK(pthread_main_np());
+  auto it = g_native_window_providers.find(web_contents);
+  if (it != g_native_window_providers.end() && it->second == provider) {
+    g_native_window_providers.erase(it);
+  }
+}
+
+std::unique_ptr<content::WebContentsViewDelegate>
+CreateReArcWebContentsViewDelegate(content::WebContents* web_contents) {
+  return std::make_unique<ReArcWebContentsViewDelegate>(web_contents);
+}
+
+}  // namespace rearc
