new file mode 100644
index 0000000000..5322e1fec8
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_http_auth.cc
@@ -0,0 +1,79 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_http_auth.h"
+#include <pthread.h>
+#include <cstring>
+#include <map>
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+namespace rearc {
+namespace {
+class Handler;
+ReArcHttpAuthCallback host = nullptr;
+void* context = nullptr;
+uint64_t epoch = 0,next_id = 1;
+auto& Pending() { static base::NoDestructor<std::map<uint64_t,base::WeakPtr<Handler>>> p; return *p; }
+class Handler : public LoginHandler {
+ public:
+  Handler(const net::AuthChallengeInfo& info,content::WebContents* c,content::LoginDelegate::LoginAuthRequiredCallback done)
+    : LoginHandler(info,c,std::move(done)) {}
+  ~Handler() override { Withdraw(); }
+  uint64_t tab() const { return event_.tab_id; }
+  void Reply(bool cancel,std::u16string user,std::u16string password) {
+    Pending().erase(event_.request_id);event_.request_id=0;
+    if (cancel) CancelAuth(false); else SetAuth(user,password);
+  }
+  void Cancel() { Withdraw(); CancelAuth(false); }
+ private:
+  bool BuildViewImpl(const std::u16string&,const std::u16string&,LoginModelData*) override {
+    if (!host || Pending().size() >= 64) return false;
+    for (auto id : TabRegistry::Get().SessionIds()) {
+      auto* s = TabRegistry::Get().FindSession(id);
+      if (s->web_contents() != web_contents() || s->close_state() != TabSession::CloseState::kOpen) continue;
+      event_ = {s->profile_id(),id,s->content_generation(),next_id++,0,auth_info().is_proxy,nullptr,nullptr,nullptr};
+      challenger_ = auth_info().challenger.Serialize();scheme_=auth_info().scheme;realm_=auth_info().realm;
+      Pending().emplace(event_.request_id,weak_.GetWeakPtr());Publish(0);return true;
+    }
+    return false;
+  }
+  void CloseDialog() override { Withdraw(); }
+  void Withdraw() {
+    if (!event_.request_id) return;
+    Publish(1);Pending().erase(event_.request_id);event_.request_id=0;
+  }
+  void Publish(uint32_t phase) {
+    auto e=event_;e.phase=phase;
+    ABIPost(base::BindOnce([](uint64_t expected,ReArcHttpAuthEvent e,std::string challenger,std::string scheme,std::string realm){
+      if(!host||expected!=epoch||(!e.phase&&!Pending().contains(e.request_id)))return;
+      e.challenger=challenger.c_str();e.scheme=scheme.c_str();e.realm=realm.c_str();host(context,&e);
+    },epoch,e,challenger_,scheme_,realm_));
+  }
+  ReArcHttpAuthEvent event_{};
+  std::string challenger_,scheme_,realm_;
+  base::WeakPtrFactory<Handler> weak_{this};
+};
+}
+std::unique_ptr<LoginHandler> CreateHostLoginHandler(const net::AuthChallengeInfo& info,content::WebContents* c,content::LoginDelegate::LoginAuthRequiredCallback done) {
+  return std::make_unique<Handler>(info,c,std::move(done));
+}
+void ABICancelHttpAuth(uint64_t tab) {
+  auto pending=Pending();for(auto& [id,h]:pending)if(h&&h->tab()==tab)h->Cancel();
+}
+}
+void ReArcEngineSetHttpAuthCallback(ReArcHttpAuthCallback cb,void* ctx) {
+  CHECK(pthread_main_np());auto pending=rearc::Pending();for(auto&[id,h]:pending)if(h)h->Cancel();
+  ++rearc::epoch;rearc::host=cb;rearc::context=ctx;
+}
+ReArcStatus ReArcHttpAuthRespond(uint64_t id,bool cancel,const char* username,const char* password) {
+  CHECK(pthread_main_np());
+  if (!cancel && (!username || !password || strnlen(username,4097)>4096 || strnlen(password,4097)>4096 || !base::IsStringUTF8(username) || !base::IsStringUTF8(password)))return REARC_INVALID_ARGUMENT;
+  auto it=rearc::Pending().find(id);if(it==rearc::Pending().end()||!it->second)return REARC_NOT_FOUND;
+  it->second->Reply(cancel,cancel?u"":base::UTF8ToUTF16(username),cancel?u"":base::UTF8ToUTF16(password));return REARC_OK;
+}
