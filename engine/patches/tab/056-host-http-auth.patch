+// HTTP Basic/Digest challenges (http_auth, ABI 1.38). phase 0 requested,
+// 1 withdrawn. All strings borrowed during callback. No credentials emitted.
+// Without a callback, cancel. Callback replacement, navigation/handler teardown,
+// tab/profile close and shutdown withdraw. Credentials are copied on Respond.
+typedef struct ReArcHttpAuthEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase;
+  bool is_proxy;
+  const char* challenger;
+  const char* scheme;
+  const char* realm;
+} ReArcHttpAuthEvent;
+typedef void (*ReArcHttpAuthCallback)(void*, const ReArcHttpAuthEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetHttpAuthCallback(ReArcHttpAuthCallback, void* context);
+// cancel=true ignores username/password; otherwise valid UTF-8 <=4096 bytes
+// each, including empty strings. Repeated/stale request_id => not_found.
+REARC_ENGINE_EXPORT ReArcStatus ReArcHttpAuthRespond(uint64_t request_id, bool cancel, const char* username, const char* password);
+
 // Password leak detection (password_leak_detection, ABI 1.35): Chromium's
 // profile.password_manager_leak_detection pref, default on as in Chrome. When
 // on, a successfully submitted sign-in's credential is checked against
