 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // changes bits: URL=1, title=2, loading=4, progress=8, crashed=16,
@@ -441,6 +441,27 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcDownloadAction(uint64_t profile_id,
                                                     uint32_t download_id,
                                                     uint32_t action);
 
+// JavaScript dialogs (javascript_dialogs, ABI 1.18). Register before tabs.
+// phase: 0 request, 1 cancelled (navigation/close/replacement/unregistration).
+// kind: 0 alert, 1 confirm, 2 prompt, 3 beforeunload. Strings borrowed.
+// No callback: conservative cancel, including beforeunload veto.
+typedef struct ReArcJavaScriptDialogEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase, kind;
+  const char* message;
+  const char* default_text;
+  const char* origin;
+  bool is_reload;
+} ReArcJavaScriptDialogEvent;
+typedef void (*ReArcJavaScriptDialogCallback)(
+    void* context, const ReArcJavaScriptDialogEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetJavaScriptDialogCallback(
+    ReArcJavaScriptDialogCallback callback, void* context);
+// Single use; stale/cancelled IDs -> not_found. text null means empty;
+// UTF-8 <=64 KiB. Beforeunload accept continues, false vetoes.
+REARC_ENGINE_EXPORT ReArcStatus ReArcJavaScriptDialogRespond(
+    uint64_t request_id, bool accept, const char* text);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
