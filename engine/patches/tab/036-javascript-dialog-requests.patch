 namespace rearc {
 namespace {
-
-class ReArcJavaScriptDialogManager
-    : public content::JavaScriptDialogManager,
-      public content::WebContentsUserData<ReArcJavaScriptDialogManager> {
+class DialogManager;
+ReArcJavaScriptDialogCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t host_epoch = 0, next_id = 1;
+auto& Pending() {
+  static base::NoDestructor<std::map<uint64_t, base::WeakPtr<DialogManager>>> map;
+  return *map;
+}
+class DialogManager : public content::JavaScriptDialogManager,
+                      public content::WebContentsObserver,
+                      public content::WebContentsUserData<DialogManager> {
  public:
-  ~ReArcJavaScriptDialogManager() override = default;
-
-  void RunJavaScriptDialog(content::WebContents* web_contents,
-                           content::RenderFrameHost* render_frame_host,
-                           content::JavaScriptDialogType dialog_type,
-                           const std::u16string& message_text,
-                           const std::u16string& default_prompt_text,
-                           DialogClosedCallback callback,
-                           bool* did_suppress_message) override {
-    CHECK(pthread_main_np());
-    // We complete the callback ourselves. Setting this true as well would
-    // ask WebContentsImpl to fake a second response after we return.
-    *did_suppress_message = false;
-    std::move(callback).Run(false, std::u16string());
+  ~DialogManager() override { Cancel(); }
+  void RunJavaScriptDialog(content::WebContents*, content::RenderFrameHost* frame,
+      content::JavaScriptDialogType kind, const std::u16string& message,
+      const std::u16string& text, DialogClosedCallback callback,
+      bool* suppressed) override {
+    *suppressed = false;
+    Start(frame, static_cast<uint32_t>(kind), message, text, false, std::move(callback));
   }
-
-  void RunBeforeUnloadDialog(content::WebContents* web_contents,
-                             content::RenderFrameHost* render_frame_host,
-                             bool is_reload,
-                             DialogClosedCallback callback) override {
-    CHECK(pthread_main_np());
-    VLOG(1)
-        << "rearc: beforeunload confirmation cancelled (native UI unavailable)";
-    // false is the upstream dialog result for stay/cancel, including reload.
-    // No session destruction or close reply here: S6 owns the close pipeline.
-    std::move(callback).Run(false, std::u16string());
+  void RunBeforeUnloadDialog(content::WebContents*, content::RenderFrameHost* frame,
+      bool reload, DialogClosedCallback callback) override {
+    Start(frame, 3, u"", u"", reload, std::move(callback));
   }
-
-  bool HandleJavaScriptDialog(content::WebContents* web_contents,
-                              bool accept,
-                              const std::u16string* prompt_override) override {
-    CHECK(pthread_main_np());
-    return false;
+  bool HandleJavaScriptDialog(content::WebContents*, bool accept,
+      const std::u16string* text) override {
+    if (!id_) return false;
+    Finish(accept, text ? *text : base::UTF8ToUTF16(text_));
+    return true;
   }
-
-  void CancelDialogs(content::WebContents* web_contents,
-                     bool reset_state) override {
-    CHECK(pthread_main_np());
-    // Every callback completes synchronously; no active or pending UI exists.
+  void CancelDialogs(content::WebContents*, bool) override { Cancel(); }
+  void DidStartNavigation(content::NavigationHandle* h) override {
+    if (h->IsInPrimaryMainFrame() && !h->IsSameDocument()) Cancel();
+  }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (id_ && frame->GetGlobalId() == frame_) Cancel();
+  }
+  void WebContentsDestroyed() override { Cancel(); }
+  void Cancel() {
+    if (!id_) return;
+    Publish(1);
+    Finish(false, u"");
+  }
+  void Finish(bool accept, const std::u16string& text) {
+    Pending().erase(id_);
+    id_ = 0;
+    auto callback = std::move(callback_);
+    // Clear identity before Chromium can reenter with the next request.
+    std::move(callback).Run(accept, text);
   }
-
  private:
-  friend class content::WebContentsUserData<ReArcJavaScriptDialogManager>;
-  explicit ReArcJavaScriptDialogManager(content::WebContents* contents)
-      : content::WebContentsUserData<ReArcJavaScriptDialogManager>(*contents) {}
+  friend class content::WebContentsUserData<DialogManager>;
+  explicit DialogManager(content::WebContents* c)
+      : content::WebContentsObserver(c), content::WebContentsUserData<DialogManager>(*c) {}
+  void Start(content::RenderFrameHost* frame, uint32_t kind,
+      const std::u16string& message, const std::u16string& text, bool reload,
+      DialogClosedCallback callback) {
+    CHECK(pthread_main_np());
+    Cancel();
+    TabSession* session = nullptr;
+    for (auto id : TabRegistry::Get().SessionIds()) {
+      auto* candidate = TabRegistry::Get().FindSession(id);
+      if (candidate->web_contents() == web_contents()) { session = candidate; break; }
+    }
+    if (!host || !session) { std::move(callback).Run(false, u""); return; }
+    id_ = next_id++;
+    event_ = {session->profile_id(), session->tab_id(), session->content_generation(),
+              id_, 0, kind, nullptr, nullptr, nullptr, reload};
+    message_ = base::UTF16ToUTF8(message);
+    text_ = base::UTF16ToUTF8(text);
+    origin_ = frame->GetLastCommittedOrigin().Serialize();
+    frame_ = frame->GetGlobalId();
+    callback_ = std::move(callback);
+    Pending().emplace(id_, weak_.GetWeakPtr());
+    Publish(0);
+  }
+  void Publish(uint32_t phase) {
+    auto event = event_; event.phase = phase;
+    ABIPost(base::BindOnce([](uint64_t epoch, ReArcJavaScriptDialogEvent e,
+        std::string message, std::string text, std::string origin) {
+      if (!host || epoch != host_epoch || (!e.phase && !Pending().contains(e.request_id))) return;
+      e.message = message.c_str(); e.default_text = text.c_str(); e.origin = origin.c_str();
+      host(host_context, &e);
+    }, host_epoch, event, message_, text_, origin_));
+  }
+  uint64_t id_ = 0;
+  ReArcJavaScriptDialogEvent event_{};
+  std::string message_, text_, origin_;
+  content::GlobalRenderFrameHostId frame_;
+  DialogClosedCallback callback_;
+  base::WeakPtrFactory<DialogManager> weak_{this};
   WEB_CONTENTS_USER_DATA_KEY_DECL();
 };
-
-WEB_CONTENTS_USER_DATA_KEY_IMPL(ReArcJavaScriptDialogManager);
-
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DialogManager);
 }  // namespace
-
-content::JavaScriptDialogManager* GetReArcJavaScriptDialogManager(
-    content::WebContents* web_contents) {
+content::JavaScriptDialogManager* GetReArcJavaScriptDialogManager(content::WebContents* c) {
   CHECK(pthread_main_np());
-  CHECK(web_contents);
-  return ReArcJavaScriptDialogManager::GetOrCreateForWebContents(web_contents);
+  return DialogManager::GetOrCreateForWebContents(c);
+}
+void ABICancelJavaScriptDialogs(uint64_t tab) {
+  if (auto* s = TabRegistry::Get().FindSession(tab)) {
+    if (auto* m = DialogManager::FromWebContents(s->web_contents())) m->Cancel();
+  }
 }
-
 }  // namespace rearc
+void ReArcEngineSetJavaScriptDialogCallback(ReArcJavaScriptDialogCallback cb, void* ctx) {
+  CHECK(pthread_main_np());
+  // A replacement must not inherit another host's outstanding requests.
+  auto pending = rearc::Pending();
+  for (auto& [id, manager] : pending) if (manager) manager->Cancel();
+  ++rearc::host_epoch;
+  rearc::host = cb; rearc::host_context = ctx;
+}
+ReArcStatus ReArcJavaScriptDialogRespond(uint64_t id, bool accept, const char* text) {
+  CHECK(pthread_main_np());
+  std::string value = text ? text : "";
+  if (value.size() > 65536 || !base::IsStringUTF8(value)) return REARC_INVALID_ARGUMENT;
+  auto it = rearc::Pending().find(id);
+  if (it == rearc::Pending().end() || !it->second) return REARC_NOT_FOUND;
+  it->second->Finish(accept, base::UTF8ToUTF16(value));
+  return REARC_OK;
+}
