+// Printing (printing, ABI 1.28). Registry tabs never show Chromium's print
+// preview or system print dialog. window.print() (source 0) and other page
+// print requests (source 1) complete immediately for the page (beforeprint/
+// afterprint fire) and post a request event; the host prints a PDF from
+// ReArcTabPrintToPDF with NSPrintOperation, or saves it ("Save as PDF").
+// Without a callback page requests are completed silently. Chromium's
+// renderer throttling of repeated script prints applies.
+typedef struct ReArcPrintRequestEvent {
+  uint64_t profile_id, tab_id, content_generation;
+  uint32_t source;
+} ReArcPrintRequestEvent;
+typedef void (*ReArcPrintCallback)(void* context,
+                                   const ReArcPrintRequestEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetPrintCallback(
+    ReArcPrintCallback callback, void* context);
+// Null options: Chromium defaults (Letter portrait, ~0.4in margins, scale 1,
+// no background/header/footer). Sizes in inches; 0 paper size/scale and a
+// negative margin select the default. scale 0.1..2. page_ranges: null/empty
+// for all, else e.g. "1-3,5" (ASCII, <=4096 bytes). header_footer prints
+// Chromium's date/title/URL/page-number template.
+typedef struct ReArcPrintOptions {
+  bool landscape, print_background, header_footer, prefer_css_page_size;
+  double scale, paper_width_in, paper_height_in;
+  double margin_top_in, margin_bottom_in, margin_left_in, margin_right_in;
+  const char* page_ranges;
+} ReArcPrintOptions;
+// Callback owns +1 PDF bytes; free with ReArcBufferFree (also when stale).
+// Error: null/0. 256 MiB bound (too_large). Invalid/out-of-range page ranges:
+// invalid_argument. Navigation, discard and close cancel. One job per tab.
+typedef void (*ReArcPdfCallback)(void* context, ReArcStatus status,
+                                 uint64_t tab_id, uint64_t content_generation,
+                                 uint8_t* data, size_t size);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabPrintToPDF(
+    uint64_t tab_id, const ReArcPrintOptions* options,
+    ReArcPdfCallback completion, void* context);
+
 
 // Register a +0 NSWindow* before attachment; engine retains until Closed/Run
 // returns. Duplicate/zero IDs rejected. Closing a window keeps its tabs alive.
