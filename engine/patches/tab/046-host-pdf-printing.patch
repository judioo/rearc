new file mode 100644
index 0000000000..7f0ac819a2
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_print.cc
@@ -0,0 +1,216 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_print.h"
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <optional>
+#include <string>
+#include <variant>
+
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/printing/print_view_manager.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "components/printing/browser/print_to_pdf/pdf_print_result.h"
+#include "components/printing/browser/print_to_pdf/pdf_print_utils.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace rearc {
+namespace {
+ReArcPrintCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+constexpr size_t kMaxPdfBytes = 256u * 1024 * 1024;
+TabSession* SessionFor(content::WebContents* contents) {
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    auto* session = TabRegistry::Get().FindSession(id);
+    if (session && session->web_contents() == contents) return session;
+  }
+  return nullptr;
+}
+// One PDF job per tab. Navigation, discard and close cancel observation;
+// a late PdfPrintJob reply for a cancelled job is ignored.
+class PdfJob : public content::WebContentsObserver,
+               public content::WebContentsUserData<PdfJob> {
+ public:
+  ~PdfJob() override { Finish(REARC_CANCELLED, nullptr); }
+  bool busy() const { return callback_; }
+  void Start(TabSession& session, printing::mojom::PrintPagesParamsPtr params,
+             std::string ranges, ReArcPdfCallback callback, void* context) {
+    tab_id_ = session.tab_id();
+    generation_ = session.content_generation();
+    callback_ = callback;
+    context_ = context;
+    ++token_;
+    frame_ = web_contents()->GetPrimaryMainFrame()->GetGlobalId();
+    printing::PrintViewManager::FromWebContents(web_contents())
+        ->PrintToPdf(web_contents()->GetPrimaryMainFrame(), ranges,
+                     std::move(params),
+                     base::BindOnce(&PdfJob::Done, weak_.GetWeakPtr(), token_));
+  }
+  void Finish(ReArcStatus status, scoped_refptr<base::RefCountedMemory> data) {
+    if (!callback_) return;
+    auto callback = callback_;
+    void* context = context_;
+    callback_ = nullptr;
+    context_ = nullptr;
+    ++token_;
+    ABIPost(base::BindOnce(
+        [](ReArcPdfCallback callback, void* context, ReArcStatus status,
+           uint64_t tab, uint64_t generation,
+           scoped_refptr<base::RefCountedMemory> data) {
+          uint8_t* bytes = nullptr;
+          size_t size = 0;
+          if (!status && data) {
+            size = data->size();
+            bytes = static_cast<uint8_t*>(malloc(size));
+            if (!bytes) {
+              status = REARC_INTERNAL;
+              size = 0;
+            } else {
+              memcpy(bytes, data->data(), size);
+            }
+          }
+          callback(context, status, tab, generation, bytes, size);
+        },
+        callback, context, status, tab_id_, generation_, std::move(data)));
+  }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      Finish(REARC_CANCELLED, nullptr);
+    }
+  }
+  void AboutToBeDiscarded(content::WebContents*) override {
+    Finish(REARC_CANCELLED, nullptr);
+  }
+  void WebContentsDestroyed() override { Finish(REARC_CANCELLED, nullptr); }
+
+ private:
+  friend class content::WebContentsUserData<PdfJob>;
+  explicit PdfJob(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<PdfJob>(*contents) {}
+  void Done(uint64_t token, print_to_pdf::PdfPrintResult result,
+            scoped_refptr<base::RefCountedMemory> data) {
+    if (token != token_) return;
+    using Result = print_to_pdf::PdfPrintResult;
+    ReArcStatus status = REARC_OK;
+    switch (result) {
+      case Result::kPrintSuccess:
+        if (!data || !data->size()) status = REARC_INTERNAL;
+        else if (data->size() > kMaxPdfBytes) status = REARC_TOO_LARGE;
+        break;
+      case Result::kPageRangeSyntaxError:
+      case Result::kPageRangeInvalidRange:
+      case Result::kPageCountExceeded:
+        status = REARC_INVALID_ARGUMENT;
+        break;
+      case Result::kPrintingInProgress:
+        status = REARC_BUSY;
+        break;
+      default:
+        // PdfPrintJob fails from RenderFrameDeleted: that is teardown.
+        status = REARC_INTERNAL;
+        if (web_contents()->IsBeingDestroyed() ||
+            !content::RenderFrameHost::FromID(frame_) ||
+            !content::RenderFrameHost::FromID(frame_)->IsRenderFrameLive()) {
+          status = REARC_CANCELLED;
+        }
+        break;
+    }
+    Finish(status, status ? nullptr : std::move(data));
+  }
+  uint64_t tab_id_ = 0, generation_ = 0, token_ = 0;
+  content::GlobalRenderFrameHostId frame_;
+  ReArcPdfCallback callback_ = nullptr;
+  raw_ptr<void> context_ = nullptr;
+  base::WeakPtrFactory<PdfJob> weak_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PdfJob);
+std::optional<double> Positive(double value) {
+  return value > 0 ? std::optional<double>(value) : std::nullopt;
+}
+std::optional<double> Margin(double value) {
+  return value >= 0 ? std::optional<double>(value) : std::nullopt;
+}
+}  // namespace
+
+void RequestHostPrint(content::WebContents* contents, uint32_t source) {
+  CHECK(pthread_main_np());
+  TabSession* session = SessionFor(contents);
+  if (!host || !session) return;
+  ReArcPrintRequestEvent event{session->profile_id(), session->tab_id(),
+                               session->content_generation(), source};
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, ReArcPrintRequestEvent event) {
+        if (host && expected == epoch) host(host_context, &event);
+      },
+      epoch, event));
+}
+}  // namespace rearc
+
+void ReArcEngineSetPrintCallback(ReArcPrintCallback callback, void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+}
+
+ReArcStatus ReArcTabPrintToPDF(uint64_t tab_id,
+                               const ReArcPrintOptions* options,
+                               ReArcPdfCallback completion, void* context) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) return status;
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  content::WebContents* contents = session->web_contents();
+  if (!printing::PrintViewManager::FromWebContents(contents)) {
+    return REARC_UNSUPPORTED;
+  }
+  ReArcPrintOptions o{};
+  o.margin_top_in = o.margin_bottom_in = o.margin_left_in = o.margin_right_in =
+      -1;
+  if (options) o = *options;
+  std::string ranges = o.page_ranges ? o.page_ranges : "";
+  if (ranges.size() > 4096 || !base::IsStringASCII(ranges) ||
+      (o.scale && (o.scale < 0.1 || o.scale > 2)) || o.paper_width_in < 0 ||
+      o.paper_height_in < 0 || o.paper_width_in > 200 ||
+      o.paper_height_in > 200) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (contents->WasDiscarded() || contents->IsCrashed() ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    return REARC_INVALID_STATE;
+  }
+  auto* job = rearc::PdfJob::GetOrCreateForWebContents(contents);
+  if (job->busy()) return REARC_BUSY;
+  auto params = print_to_pdf::GetPrintPagesParams(
+      contents->GetPrimaryMainFrame()->GetLastCommittedURL(), o.landscape,
+      o.header_footer, o.print_background, rearc::Positive(o.scale),
+      rearc::Positive(o.paper_width_in), rearc::Positive(o.paper_height_in),
+      rearc::Margin(o.margin_top_in), rearc::Margin(o.margin_bottom_in),
+      rearc::Margin(o.margin_left_in), rearc::Margin(o.margin_right_in),
+      std::nullopt, std::nullopt, o.prefer_css_page_size, std::nullopt,
+      std::nullopt);
+  if (std::holds_alternative<std::string>(params)) {
+    return REARC_INVALID_ARGUMENT;  // Margins exceed the paper, etc.
+  }
+  job->Start(*session,
+             std::move(std::get<printing::mojom::PrintPagesParamsPtr>(params)),
+             std::move(ranges), completion, context);
+  return REARC_OK;
+}
