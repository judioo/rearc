+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 28, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -311,6 +311,42 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcTabExitFullscreen(uint64_t tab_id);
