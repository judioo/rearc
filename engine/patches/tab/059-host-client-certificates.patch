+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 41, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -1002,6 +1002,35 @@ REARC_ENGINE_EXPORT void ReArcEngineSetHttpAuthCallback(ReArcHttpAuthCallback, v
 // each, including empty strings. Repeated/stale request_id => not_found.
 REARC_ENGINE_EXPORT ReArcStatus ReArcHttpAuthRespond(uint64_t request_id, bool cancel, const char* username, const char* password);
 
+// TLS client-certificate selection (client_certificates, ABI 1.41).
+// Borrowed display names and SHA-256 fingerprint of leaf DER (64 uppercase hex
+// digits); expiry_us is Unix microseconds. No private key or cert bytes cross
+// the ABI. Identity list is scoped to this request (0..256 entries).
+typedef struct ReArcClientCertificateIdentity {
+  const char* fingerprint;
+  const char* subject;
+  const char* issuer;
+  int64_t expiry_us;
+} ReArcClientCertificateIdentity;
+typedef struct ReArcClientCertificateEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase;  // 0 request, 1 withdrawn (also during key acquisition);
+                   // a host's own cancel is not echoed as a withdrawal.
+  const char* origin;  // HTTPS challenger including port, not the page URL.
+  const ReArcClientCertificateIdentity* identities;
+  size_t identity_count;
+} ReArcClientCertificateEvent;
+typedef void (*ReArcClientCertificateCallback)(void*, const ReArcClientCertificateEvent*);
+// Replacing/unregistering cancels requests. No callback aborts without UI.
+REARC_ENGINE_EXPORT void ReArcEngineSetClientCertificateCallback(ReArcClientCertificateCallback, void*);
+// nullptr fingerprint cancels (does NOT cache a no-certificate choice); the
+// ERR_SSL_CLIENT_AUTH_CERT_NEEDED error page is not auto-reloaded/re-asked.
+// A listed fingerprint selects, then acquires the private key asynchronously.
