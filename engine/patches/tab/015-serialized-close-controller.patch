index 0000000000..d4453d8f54
--- /dev/null
+++ b/chrome/browser/rearc_bridge/close_controller.cc
@@ -0,0 +1,258 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/close_controller.h"
+
+#include <pthread.h>
+
+#include <map>
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/rearc_bridge/attachment_lease.h"
+#include "chrome/browser/rearc_bridge/favicon_adapter.h"
+#include "chrome/browser/rearc_bridge/ipc_tab_events.h"
+#include "chrome/browser/rearc_bridge/media_adapter.h"
+#include "chrome/browser/rearc_bridge/rearc_javascript_dialog_manager.h"
+#include "chrome/browser/rearc_bridge/security_adapter.h"
+#include "chrome/browser/rearc_bridge/tab_observer.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "content/public/browser/javascript_dialog_manager.h"
+#include "content/public/browser/web_contents.h"
+
+namespace rearc {
+
+// Friend of TabRegistry: only the posted finalizer may remove a session.
+void FinalizeTabClose(uint64_t tab_id, uint64_t generation);
+
+namespace {
+
+enum class Phase { kBeforeUnload, kUnload, kCancelled, kFinalizing };
+
+struct PendingClose {
+  uint64_t generation = 0;
+  Phase phase = Phase::kBeforeUnload;
+  TabClosedReason reason = TabClosedReason::kShell;
+  bool teardown_started = false;
+  CloseCallback callback;
+  base::OneShotTimer deadline;
+};
+
+using PendingMap = std::map<uint64_t, std::unique_ptr<PendingClose>>;
+PendingMap& PendingCloses() {
+  static base::NoDestructor<PendingMap> pending;
+  return *pending;
+}
+
+PendingClose* FindPending(uint64_t tab_id, uint64_t generation) {
+  auto it = PendingCloses().find(tab_id);
+  return it != PendingCloses().end() && it->second->generation == generation
+             ? it->second.get()
+             : nullptr;
+}
+
+TabSession* MatchContents(uint64_t tab_id, content::WebContents* contents) {
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  return session && session->web_contents() == contents ? session : nullptr;
+}
+
+PendingClose& AddPending(TabSession& session,
+                         TabClosedReason reason,
+                         CloseCallback callback = {}) {
+  auto pending = std::make_unique<PendingClose>();
+  pending->generation = session.content_generation();
+  pending->reason = reason;
+  pending->callback = std::move(callback);
+  auto [it, inserted] =
+      PendingCloses().emplace(session.tab_id(), std::move(pending));
+  CHECK(inserted);
+  return *it->second;
+}
+
+void ScheduleDestruction(TabSession& session, PendingClose& pending) {
+  if (pending.phase == Phase::kFinalizing) {
+    return;
+  }
+  pending.phase = Phase::kFinalizing;
+  pending.deadline.Stop();
+  session.SetCloseState(TabSession::CloseState::kClosed);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&FinalizeTabClose, session.tab_id(), pending.generation));
+}
+
+void CloseDeadlineExpired(uint64_t tab_id, uint64_t generation) {
+  PendingClose* pending = FindPending(tab_id, generation);
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (pending && session && session->content_generation() == generation) {
+    VLOG(1) << "rearc: close deadline expired; force-closing unresponsive tab "
+            << tab_id;
+    ScheduleDestruction(*session, *pending);
+  }
+}
+
+void CompleteCancellation(uint64_t tab_id, uint64_t generation) {
+  PendingClose* pending = FindPending(tab_id, generation);
+  if (!pending || pending->phase != Phase::kCancelled) {
+    return;  // Force/shutdown won the race; its closed reply is authoritative.
+  }
+  CloseCallback callback = std::move(pending->callback);
+  PendingCloses().erase(tab_id);
+  VLOG(1) << "rearc: tab.close.reply cancelled tab_id=" << tab_id;
+  if (callback) {
+    std::move(callback).Run(CloseOutcome::kCancelled);
+  }
+}
+
+void RunClosePage(uint64_t tab_id, uint64_t generation) {
+  PendingClose* pending = FindPending(tab_id, generation);
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (pending && pending->phase == Phase::kUnload && session &&
+      session->content_generation() == generation) {
+    session->web_contents()->ClosePage();
+  }
+}
+
+}  // namespace
+
+CloseRequestResult RequestTabClose(uint64_t tab_id,
+                                   bool force,
+                                   CloseCallback callback) {
+  CHECK(pthread_main_np());
+  if (PendingCloses().contains(tab_id)) {
+    return CloseRequestResult::kBusy;
+  }
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || session->close_state() != TabSession::CloseState::kOpen) {
+    return CloseRequestResult::kTabNotFound;
+  }
+  PendingClose& pending =
+      AddPending(*session, TabClosedReason::kShell, std::move(callback));
+  if (force) {
+    ScheduleDestruction(*session, pending);
+  } else {
+    session->SetCloseState(TabSession::CloseState::kCloseRequested);
+    pending.deadline.Start(
+        FROM_HERE, base::Seconds(30),
+        base::BindOnce(&CloseDeadlineExpired, tab_id, pending.generation));
+    // false selects TAB_CLOSE rather than DISCARD. S5's dialog manager
+    // completes a requested confirmation false/stay, which reaches our veto.
+    session->web_contents()->DispatchBeforeUnload(/*auto_cancel=*/false);
+  }
+  return CloseRequestResult::kStarted;
+}
+
+void ForceCloseTab(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session) {
+    return;
+  }
+  PendingClose* pending = FindPending(tab_id, session->content_generation());
+  if (!pending) {
+    pending = &AddPending(*session, TabClosedReason::kEngine);
+  }
+  ScheduleDestruction(*session, *pending);
+}
+
+void TabBeforeUnloadFired(uint64_t tab_id,
+                          content::WebContents* contents,
+                          bool proceed,
+                          bool* proceed_to_fire_unload) {
+  CHECK(pthread_main_np());
+  // We own the explicit, posted ClosePage. Returning true here would cause
+  // RenderFrameHostManager::BeforeUnloadCompleted to fire it a second time.
+  *proceed_to_fire_unload = false;
+  TabSession* session = MatchContents(tab_id, contents);
+  PendingClose* pending =
+      session ? FindPending(tab_id, session->content_generation()) : nullptr;
+  if (!pending || pending->phase != Phase::kBeforeUnload) {
+    return;
+  }
+  if (!proceed) {
+    pending->phase = Phase::kCancelled;
+    pending->deadline.Stop();
+    session->SetCloseState(TabSession::CloseState::kOpen);
+    // Do not reenter a new DispatchBeforeUnload from this content callback.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CompleteCancellation, tab_id, pending->generation));
+    return;
+  }
+  pending->phase = Phase::kUnload;
+  session->SetCloseState(TabSession::CloseState::kUnloadPending);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RunClosePage, tab_id, pending->generation));
+}
+
+void TabCloseContents(uint64_t tab_id, content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  TabSession* session = MatchContents(tab_id, contents);
+  if (!session) {
+    return;
+  }
+  PendingClose* pending = FindPending(tab_id, session->content_generation());
+  if (!pending) {
+    // Renderer window.close has already passed content's eligibility checks
+    // and unload path. This is a tab close, distinct from shell window.closed
+    // (which only detaches/hides tabs).
+    pending = &AddPending(*session, TabClosedReason::kPage);
+  }
+  if (pending->phase != Phase::kCancelled) {
+    ScheduleDestruction(*session, *pending);
+  }
+}
+
+void FinalizeTabClose(uint64_t tab_id, uint64_t generation) {
+  CHECK(pthread_main_np());
+  PendingClose* pending = FindPending(tab_id, generation);
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!pending || pending->phase != Phase::kFinalizing ||
+      pending->teardown_started || !session ||
+      session->content_generation() != generation) {
+    return;
+  }
+  pending->teardown_started = true;
+  // This task runs after delegate/observer callbacks unwind. Detach the S3
+  // observer so destruction cannot produce a duplicate tab.closed, and stop
+  // S5 subscriptions/receivers before removing native children/content.
+  DetachTabObserver(tab_id);
+  DetachFaviconAdapter(tab_id);
+  DetachMediaAdapter(tab_id);
+  DetachSecurityAdapter(tab_id);
+  GetReArcJavaScriptDialogManager(session->web_contents())
+      ->CancelDialogs(session->web_contents(), /*reset_state=*/true);
+  AttachmentLeaseRegistry::Get().InvalidateLeasesForTab(
+      tab_id, LeaseInvalidatedReason::kTabClosed);
+  session->web_contents()->SetDelegate(nullptr);
+  TabRegistry::Get().DestroySessionNow(tab_id);
+}
+
+void DidDestroyTab(uint64_t tab_id, uint64_t content_generation) {
+  CHECK(pthread_main_np());
+  PendingClose* pending = FindPending(tab_id, content_generation);
+  CHECK(pending && pending->teardown_started);
+  const TabClosedReason reason = pending->reason;
+  CloseCallback callback = std::move(pending->callback);
+  PendingCloses().erase(tab_id);
+  TabEvent event;
+  event.kind = TabEventKind::kTabClosed;
+  event.tab_id = tab_id;
+  event.content_generation = content_generation;
+  event.closed_reason = reason;
+  EmitTabEvent(std::move(event));
+  VLOG(1) << "rearc: tab.close.reply closed tab_id=" << tab_id;
+  if (callback) {
+    std::move(callback).Run(CloseOutcome::kClosed);
+  }
+}
+
+}  // namespace rearc
