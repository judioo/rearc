+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_CLOSE_CONTROLLER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_CLOSE_CONTROLLER_H_
+
+#include <cstdint>
+
+#include "base/functional/callback.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace rearc {
+
+enum class CloseRequestResult { kStarted, kBusy, kTabNotFound };
+enum class CloseOutcome { kClosed, kCancelled };
+using CloseCallback = base::OnceCallback<void(CloseOutcome)>;
+
+// UI thread only. Exactly one pending request per tab, including forced
+// requests. On kStarted, callback runs once: closed AFTER tab.closed, or
+// cancelled after a beforeunload veto. Errors are returned synchronously and
+// do not invoke callback. Transport supplies correlation; no wire ABI here.
+// Unresponsive policy: content's built-in beforeunload/unload timeouts apply;
+// a 30-second total deadline forces cleanup if CloseContents never arrives.
+CloseRequestResult RequestTabClose(uint64_t tab_id,
+                                   bool force,
+                                   CloseCallback callback = {});
+
+// Registry/engine teardown supersedes any pending close, retaining its reply.
+// Even this path posts cleanup so delegate/observer callbacks unwind first.
+void ForceCloseTab(uint64_t tab_id);
+
+void TabBeforeUnloadFired(uint64_t tab_id,
+                          content::WebContents* contents,
+                          bool proceed,
+                          bool* proceed_to_fire_unload);
+void TabCloseContents(uint64_t tab_id, content::WebContents* contents);
+
+// Registry-only completion, after the unique_ptr has actually been destroyed.
+void DidDestroyTab(uint64_t tab_id, uint64_t content_generation);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_CLOSE_CONTROLLER_H_
