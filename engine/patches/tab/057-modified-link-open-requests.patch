+// Modifier/context-menu link opens (link_open_requests, ABI 1.39).
+// Separate event layout; ABI 1.36 extension requests are unchanged. HTTP(S)
+// OpenURLFromTab only: 1 foreground, 2 background, 4 window, 5 split view.
+// phase 0 requested, 1 withdrawn. opener_tab_id is bridge source/grouping
+// identity, not a script window.opener grant. Referrer is Chromium-sanitized;
+// referrer_policy is network::mojom::ReferrerPolicy at this pin, display only.
+// Strings borrowed during callback. Engine retains the full navigation params.
+typedef struct ReArcLinkOpenEvent {
+  uint64_t profile_id, opener_tab_id, content_generation, request_id;
+  uint32_t phase, disposition, referrer_policy;
+  bool user_gesture;
+  const char* url;
+  const char* referrer;
+} ReArcLinkOpenEvent;
+typedef void (*ReArcLinkOpenCallback)(void*, const ReArcLinkOpenEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetLinkOpenCallback(ReArcLinkOpenCallback, void* context);
+// Host creates about:blank in this profile/current space, reports its logical
+// window/active state with ReArcTabSetExtensionWindow, then replies. It must
+// return a distinct blank tab; active required for dispositions 1/4/5. 0 cancels.
+// Response performs the original Chromium navigation (including referrer).
+// No callback => refused. Pending requests cancel on source/profile close,
+// registration replacement or 30 s timeout. Explicit rel=opener is unsupported.
+REARC_ENGINE_EXPORT ReArcStatus ReArcLinkOpenRespond(uint64_t request_id, uint64_t tab_id);
+
 // Password leak detection (password_leak_detection, ABI 1.35): Chromium's
 // profile.password_manager_leak_detection pref, default on as in Chrome. When
 // on, a successfully submitted sign-in's credential is checked against
