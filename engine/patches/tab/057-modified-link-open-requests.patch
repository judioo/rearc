 #include "extensions/browser/extension_function.h"
@@ -32,10 +36,20 @@ int focused_window = 0;
 ReArcExtensionTabRequestCallback host = nullptr;
 void* context = nullptr;
 uint64_t epoch = 0, next_id = 1;
+ReArcLinkOpenCallback link_host = nullptr;
+void* link_context = nullptr;
+uint64_t link_epoch = 0;
+struct LinkNavigation {
+  explicit LinkNavigation(const content::OpenURLParams& p) : params(p) {}
+  content::OpenURLParams params;
+  uint64_t generation = 0;
+  base::OnceCallback<void(content::NavigationHandle&)> navigation_callback;
+};
 struct Request {
   ReArcExtensionTabRequest event{};
   std::string url, extension;
   base::OnceCallback<void(content::WebContents*)> done;
+  std::unique_ptr<LinkNavigation> link;
 };
 auto& Requests() { static base::NoDestructor<std::map<uint64_t, Request>> r; return *r; }
 bool Open(TabSession* s) {
@@ -48,17 +62,30 @@ bool Visible(ExtensionFunction* f, TabSession* s) {
   return Open(s) && States().contains(s->tab_id()) &&
     p->IsSameOrParent(candidate) && (p == candidate || f->include_incognito_information());
 }
-void Publish(uint64_t id, ReArcExtensionTabRequest e, std::string url, std::string extension) {
+void Publish(uint64_t id, const Request& r) {
+  if (r.link) {
+    const auto referrer = content::Referrer::SanitizeForRequest(r.link->params.url, r.link->params.referrer);
+    uint32_t disposition = r.link->params.disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB ? 2 :
+        r.link->params.disposition == WindowOpenDisposition::NEW_WINDOW ? 4 :
+        r.link->params.disposition == WindowOpenDisposition::NEW_SPLIT_VIEW ? 5 : 1;
+    ReArcLinkOpenEvent event{r.event.profile_id,r.event.opener_tab_id,r.link->generation,id,
+        r.event.phase,disposition,static_cast<uint32_t>(referrer.policy),r.link->params.user_gesture,nullptr,nullptr};
+    ABIPost(base::BindOnce([](uint64_t expected,ReArcLinkOpenEvent e,std::string url,std::string referrer) {
+      if (!link_host || expected != link_epoch || (!e.phase && !Requests().contains(e.request_id))) return;
+      e.url = url.c_str(); e.referrer = referrer.c_str(); link_host(link_context,&e);
+    },link_epoch,event,r.url,referrer.url.spec()));
+    return;
+  }
   ABIPost(base::BindOnce([](uint64_t expected, uint64_t id, ReArcExtensionTabRequest e, std::string u, std::string x) {
     if (!host || expected != epoch || (!e.phase && !Requests().contains(id))) return;
     e.url = u.c_str(); e.extension_id = x.c_str(); host(context, &e);
-  }, epoch, id, e, std::move(url), std::move(extension)));
+  }, epoch, id, r.event, r.url, r.extension));
 }
 void Cancel(uint64_t id) {
   auto it = Requests().find(id); if (it == Requests().end()) return;
   auto r = std::move(it->second); Requests().erase(it);
-  r.event.phase = 1; Publish(id, r.event, r.url, r.extension);
-  std::move(r.done).Run(nullptr);
+  r.event.phase = 1; Publish(id, r);
+  if (r.done) std::move(r.done).Run(nullptr);
 }
 }
 TabSession* ExtensionSession(content::WebContents* c) {
@@ -147,8 +174,27 @@ void RequestExtensionTab(Profile* p, const std::string& extension, const GURL& u
   uint64_t id = next_id++;
   Request r; r.event = {id,profile,tab,opener,window,kind,0,active,nullptr,nullptr};
   r.url = url.spec(); r.extension = extension; r.done = std::move(done);
-  auto event = r.event; Requests().emplace(id,std::move(r));
-  Publish(id,event,url.spec(),extension);
+  Requests().emplace(id,std::move(r));
+  Publish(id,Requests().at(id));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,base::BindOnce(&Cancel,id),base::Seconds(30));
+}
+void RequestLinkOpen(uint64_t source_id, content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)> callback) {
+  TabSession* s;
+  if (!link_host || ABICheckTab(source_id,&s) != REARC_OK || s->web_contents() != source ||
+      Requests().size() >= 64 || !params.url.SchemeIsHTTPOrHTTPS() || params.has_rel_opener ||
+      (!params.user_gesture && !params.started_from_context_menu)) return;
+  uint64_t id = next_id++;
+  Request r;
+  r.event = {id,s->profile_id(),0,source_id,0,4,0,
+      params.disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB,nullptr,nullptr};
+  r.url = params.url.spec();
+  r.link = std::make_unique<LinkNavigation>(params);
+  r.link->generation = s->content_generation();
+  r.link->navigation_callback = std::move(callback);
+  Requests().emplace(id,std::move(r));
+  Publish(id,Requests().at(id));
   base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,base::BindOnce(&Cancel,id),base::Seconds(30));
 }
 void ABICancelExtensionTabs(uint64_t tab, uint64_t profile) {
@@ -186,20 +232,46 @@ ReArcStatus ReArcTabGetExtensionState(uint64_t id, ReArcExtensionTabState* out)
 }
 void ReArcEngineSetExtensionTabRequestCallback(ReArcExtensionTabRequestCallback cb, void* ctx) {
   CHECK(pthread_main_np());
-  std::vector<uint64_t> ids; for (auto& [id,r] : rearc::Requests()) ids.push_back(id);
+  std::vector<uint64_t> ids; for (auto& [id,r] : rearc::Requests()) if (!r.link) ids.push_back(id);
   for (auto id : ids) rearc::Cancel(id);
   ++rearc::epoch; rearc::host = cb; rearc::context = ctx;
 }
-ReArcStatus ReArcExtensionTabRequestRespond(uint64_t id, uint64_t tab) {
-  CHECK(pthread_main_np()); auto it = rearc::Requests().find(id); if (it == rearc::Requests().end()) return REARC_NOT_FOUND;
+namespace {
+ReArcStatus RespondCreation(uint64_t id, uint64_t tab, bool link) {
+  CHECK(pthread_main_np()); auto it = rearc::Requests().find(id); if (it == rearc::Requests().end() || static_cast<bool>(it->second.link) != link) return REARC_NOT_FOUND;
   if (tab) {
     rearc::TabSession* s; if (auto status = rearc::ABICheckTab(tab,&s)) return status;
     auto state = rearc::States().find(tab);
     if (!rearc::ExtensionSession(s->web_contents()) || state == rearc::States().end()) return REARC_INVALID_STATE;
     const auto& e = it->second.event;
+    if (link && (tab == e.opener_tab_id ||
+        (!s->web_contents()->GetLastCommittedURL().is_empty() && !s->web_contents()->GetLastCommittedURL().IsAboutBlank()) ||
+        (!s->web_contents()->GetVisibleURL().is_empty() && !s->web_contents()->GetVisibleURL().IsAboutBlank()))) return REARC_INVALID_STATE;
     if (s->profile_id() != e.profile_id) return REARC_INVALID_ARGUMENT;
     if ((e.tab_id && e.tab_id != tab) || (e.window_id > 0 && e.window_id != state->second.window) || (e.active && !state->second.active)) return REARC_INVALID_STATE;
   }
+  if (tab && (link || it->second.event.kind != 3)) {
+    // The host's about:blank creation may still have a queued initial load.
+    // Retire it before starting the retained navigation, or it can win later.
+    if (auto status = ReArcTabStop(tab)) return status;
+  }
+  if (link) {
+    auto r = std::move(it->second);
+    rearc::Requests().erase(it);
+    if (!tab) return REARC_OK;
+    rearc::TabSession* source;
+    if (rearc::ABICheckTab(r.event.opener_tab_id,&source) != REARC_OK ||
+        source->content_generation() != r.link->generation) return REARC_INVALID_STATE;
+    auto* target = rearc::TabRegistry::Get().FindSession(tab);
+    content::NavigationController::LoadURLParams params(r.link->params);
+    // OpenURLParams identifies the source frame; the new target uses its own
+    // primary frame. Keep the initiator, referrer policy, body and headers.
+    params.frame_tree_node_id = content::FrameTreeNodeId();
+    params.should_replace_current_entry = false;
+    auto handle = target->web_contents()->GetController().LoadURLWithParams(params);
+    if (handle && r.link->navigation_callback) std::move(r.link->navigation_callback).Run(*handle);
+    return handle ? REARC_OK : REARC_INVALID_STATE;
+  }
   auto done = std::move(it->second.done);
   if (tab && it->second.event.kind != 3) {
     auto* s = rearc::TabRegistry::Get().FindSession(tab);
@@ -215,3 +287,18 @@ ReArcStatus ReArcExtensionTabRequestRespond(uint64_t id, uint64_t tab) {
     std::move(done).Run(rearc::Open(s) ? s->web_contents() : nullptr);
   }, std::move(done), tab)); return REARC_OK;
 }
+
+}  // namespace
+ReArcStatus ReArcExtensionTabRequestRespond(uint64_t id, uint64_t tab) {
+  return RespondCreation(id,tab,false);
+}
+void ReArcEngineSetLinkOpenCallback(ReArcLinkOpenCallback cb,void* ctx) {
+  CHECK(pthread_main_np());
+  std::vector<uint64_t> ids;
+  for (const auto& [id,r] : rearc::Requests()) if (r.link) ids.push_back(id);
+  for (auto id : ids) rearc::Cancel(id);
+  ++rearc::link_epoch; rearc::link_host = cb; rearc::link_context = ctx;
+}
+ReArcStatus ReArcLinkOpenRespond(uint64_t id,uint64_t tab) {
+  return RespondCreation(id,tab,true);
+}
