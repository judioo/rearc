+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_JAVASCRIPT_DIALOG_MANAGER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_JAVASCRIPT_DIALOG_MANAGER_H_
+
+namespace content {
+class JavaScriptDialogManager;
+class WebContents;
+}  // namespace content
+
+namespace rearc {
+
+// UI-thread, per-WebContents manager. Dismisses ordinary dialogs and vetoes
+// beforeunload prompts synchronously until native confirmation UI exists.
+content::JavaScriptDialogManager* GetReArcJavaScriptDialogManager(
+    content::WebContents* web_contents);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_JAVASCRIPT_DIALOG_MANAGER_H_
