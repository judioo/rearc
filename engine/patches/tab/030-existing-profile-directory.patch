+ReArcStatus OpenBridgeProfileDirectory(std::string directory,
+                                      bool require_existing,
+                                      ReArcProfileCallback completion,
+                                      void* context) {
+  auto& a = ABI::Get();
+  if (a.closing_profile) return REARC_BUSY;
+  // Validation must not turn a concurrent create-if-missing open into failure.
+  const std::string key = require_existing ? "@directory-" + directory : directory;
+  auto& requests = a.profile_opens[key];
+  requests.push_back({completion, context});
+  if (requests.size() > 1) return REARC_OK;
+  auto path = g_browser_process->profile_manager()->user_data_dir()
+                  .AppendASCII(directory);
+  auto open = base::BindOnce(
+      [](std::string key, base::FilePath path, bool validated,
+         ReArcStatus status) {
+        auto& a = ABI::Get();
+        if (!a.profile_opens.contains(key)) return;
+        if (status != REARC_OK) {
+          ABIPost(base::BindOnce([](std::string key, ReArcStatus status) {
+            ABI::Get().CompleteProfileOpen(std::move(key), 0, false, status);
+          }, std::move(key), status));
+          return;
+        }
+        if (validated) {
+          auto requests = std::move(a.profile_opens.at(key));
+          a.profile_opens.erase(key);
+          for (const auto& request : requests) {
+            OpenBridgeProfileDirectory(path.BaseName().value(), false,
+                                       request.callback, request.context);
+          }
+          return;
+        }
+        g_browser_process->profile_manager()->CreateProfileAsync(
+            path, base::BindOnce([](std::string key, Profile* profile) {
+              if (!ABI::Get().profile_opens.contains(key)) return;
+              const bool supported = !profile || profile->IsRegularProfile();
+              if (profile && supported) RegisterBridgeProfile(profile, false);
+              ABIPost(base::BindOnce([](std::string key, uint64_t id,
+                                       ReArcStatus failure) {
+                ABI::Get().CompleteProfileOpen(std::move(key), id, false, failure);
+              }, std::move(key), profile && supported ? BridgeProfileId(profile) : 0,
+                 supported ? REARC_INTERNAL : REARC_UNSUPPORTED));
+            }, std::move(key)));
+      }, key, path, require_existing);
+  if (require_existing) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce([](base::FilePath path) -> ReArcStatus {
+          // Exact on-disk spelling avoids duplicate contexts on case-folded disks.
+          base::FileEnumerator entries(path.DirName(), false,
+              base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES |
+                  base::FileEnumerator::SHOW_SYM_LINKS);
+          for (auto entry = entries.Next(); !entry.empty(); entry = entries.Next()) {
+            if (entry.BaseName() != path.BaseName()) continue;
+            if (base::IsLink(entry)) return REARC_INVALID_ARGUMENT;
+            return base::DirectoryExists(entry) ? REARC_OK : REARC_NOT_FOUND;
+          }
+          return REARC_NOT_FOUND;
+        }, path), std::move(open));
+  } else {
+    std::move(open).Run(REARC_OK);
+  }
+  return REARC_OK;
+}
