+ReArcStatus ReArcProfileOpenDirectory(const char* name,
+    ReArcProfileCallback completion, void* context) {
+  if (auto status = rearc::Available()) return status;
+  if (!name || !completion) return REARC_INVALID_ARGUMENT;
+  std::string directory(name);
+  if (directory.empty() || directory.size() > 128 ||
+      directory.front() == ' ' || directory.back() == ' ' ||
+      !std::ranges::all_of(directory, [](unsigned char c) {
+        return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '_' ||
+               c == '-' || c == ' ';
+      })) return REARC_INVALID_ARGUMENT;
+  return rearc::OpenBridgeProfileDirectory(
+      std::move(directory), true, completion, context);
+}
