@@ -273,7 +273,7 @@ void ContinueShutdown() {
       if (!TabRegistry::Get().FindSession(id)) {
         continue;
       }
-      auto result = RequestTabClose(
+      auto result = RequestTabCloseForShutdown(
           id, shutdown_force, base::BindOnce([](CloseOutcome outcome) {
             auto& a = Get();
             if (outcome == CloseOutcome::kCancelled) {
@@ -443,6 +443,7 @@ bool ReArcEngineHasFeature(const char* feature) {
   }
   return std::string(feature) == "native_view" ||
          std::string(feature) == "os_permission_shutdown" ||
+         std::string(feature) == "shutdown_pending_closes" ||
          std::string(feature) == "navigation" ||
          std::string(feature) == "navigation_extended" ||
          std::string(feature) == "rearc_safe_storage_branding" ||
@@ -569,13 +570,10 @@ ReArcStatus ReArcEngineShutdown(bool force,
   a.shutdown_tabs.clear();
   // Id allocation is monotonic, but the registry owns the authoritative set.
   for (uint64_t id : rearc::TabRegistry::Get().SessionIds()) {
-    auto* s = rearc::TabRegistry::Get().FindSession(id);
-    if (s->close_state() != rearc::TabSession::CloseState::kOpen) {
-      return REARC_BUSY;
-    }
     a.shutdown_tabs.push_back(id);
   }
-  if (a.live_tabs != a.shutdown_tabs.size()) return REARC_BUSY;
+  // Contents removed from the registry can still be in posted destruction.
+  // live_tabs keeps their profiles alive through their terminal replies.
   a.stopping = true;
   auto opens = std::move(a.profile_opens);
   a.profile_opens.clear();
