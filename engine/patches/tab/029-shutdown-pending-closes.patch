From 6201151b27f759f3e502614bc49894f8b0884382 Mon Sep 17 00:00:00 2001
From: ReArc Overlay <overlay@rearc.invalid>
Date: Tue, 3 Nov 2026 14:16:06 +0400
Subject: [PATCH] P-APP-001 wave 16: join pending tab closes during shutdown

Join existing close-controller requests without dropping their original replies. Normal shutdown honors veto and force promotes pending cleanup; retain live-content protection across deferred destruction. Keep ProfileClose lifecycle serialization and all old C layouts, advertising shutdown_pending_closes in ABI 1.12.

Last rebased: 2026-11-03 onto Chromium 156.0.8078.74 (d331de35ca).

Co-Authored-By: Codex <noreply@openai.com>
---
 .../browser/rearc_bridge/close_controller.cc  | 19 +++++++++++++++++++
 .../browser/rearc_bridge/close_controller.h   |  5 +++++
 .../browser/rearc_bridge/rearc_engine_abi.h   |  2 +-
 .../browser/rearc_bridge/rearc_engine_abi.mm  | 10 ++++------
 .../rearc_bridge/rearc_engine_entry_mac.mm    |  2 +-
 5 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/chrome/browser/rearc_bridge/close_controller.cc b/chrome/browser/rearc_bridge/close_controller.cc
index 0b7467ce12..7a2c3e6209 100644
--- a/chrome/browser/rearc_bridge/close_controller.cc
+++ b/chrome/browser/rearc_bridge/close_controller.cc
@@ -153,6 +153,25 @@ CloseRequestResult RequestTabClose(uint64_t tab_id,
   return CloseRequestResult::kStarted;
 }
 
+CloseRequestResult RequestTabCloseForShutdown(uint64_t tab_id,
+                                              bool force,
+                                              CloseCallback callback) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  PendingClose* pending =
+      session ? FindPending(tab_id, session->content_generation()) : nullptr;
+  if (!pending) {
+    return RequestTabClose(tab_id, force, std::move(callback));
+  }
+  pending->callback = base::BindOnce(
+      [](CloseCallback original, CloseCallback shutdown, CloseOutcome outcome) {
+        if (original) std::move(original).Run(outcome);
+        std::move(shutdown).Run(outcome);
+      }, std::move(pending->callback), std::move(callback));
+  if (force) ScheduleDestruction(*session, *pending);
+  return CloseRequestResult::kStarted;
+}
+
 void ForceCloseTab(uint64_t tab_id) {
   CHECK(pthread_main_np());
   TabSession* session = TabRegistry::Get().FindSession(tab_id);
diff --git a/chrome/browser/rearc_bridge/close_controller.h b/chrome/browser/rearc_bridge/close_controller.h
index 223c17083f..078d9675b3 100644
--- a/chrome/browser/rearc_bridge/close_controller.h
+++ b/chrome/browser/rearc_bridge/close_controller.h
@@ -29,6 +29,11 @@ CloseRequestResult RequestTabClose(uint64_t tab_id,
                                    bool force,
                                    CloseCallback callback = {});
 
+// Shutdown joins an existing close, retaining its reply; force promotes it.
+CloseRequestResult RequestTabCloseForShutdown(uint64_t tab_id,
+                                              bool force,
+                                              CloseCallback callback);
+
 // Registry/engine teardown supersedes any pending close, retaining its reply.
 // Even this path posts cleanup so delegate/observer callbacks unwind first.
 void ForceCloseTab(uint64_t tab_id);
