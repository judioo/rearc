diff --git a/chrome/browser/rearc_bridge/rearc_engine_abi.h b/chrome/browser/rearc_bridge/rearc_engine_abi.h
index 7309f8d47d..f038c260fa 100644
--- a/chrome/browser/rearc_bridge/rearc_engine_abi.h
+++ b/chrome/browser/rearc_bridge/rearc_engine_abi.h
@@ -42,7 +42,7 @@ enum {
   REARC_SCRIPT_ERROR = 17,
   REARC_TIMEOUT = 18
 };
-enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 58, REARC_MAX_BLOB_BYTES = 16777216 };
+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 59, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -399,6 +399,18 @@ typedef void (*ReArcFullscreenCallback)(void* context,
                                         const ReArcFullscreenEvent* event);
 REARC_ENGINE_EXPORT void ReArcEngineSetFullscreenCallback(
     ReArcFullscreenCallback callback, void* context);
+// ABI 1.59 (fullscreen_origin): the same events plus the serialized origin of
+// the frame that requested fullscreen (an iframe's own origin, "null" when
+// opaque), for a notice naming the site on every entry. It is the same on the
+// exit event. Setting either callback replaces the other registration.
+typedef struct ReArcFullscreenEvent2 {
+  ReArcFullscreenEvent event;
+  const char* origin;
+} ReArcFullscreenEvent2;
+typedef void (*ReArcFullscreenCallback2)(void* context,
+                                         const ReArcFullscreenEvent2* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetFullscreenCallback2(
+    ReArcFullscreenCallback2 callback, void* context);
 // Host-initiated exit (e.g. leaving native fullscreen). Not fullscreen:
 // invalid_state. The exit event (reason 1) follows, deferred.
 REARC_ENGINE_EXPORT ReArcStatus ReArcTabExitFullscreen(uint64_t tab_id);
