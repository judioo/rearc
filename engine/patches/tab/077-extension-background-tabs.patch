+// ABI 1.55, extension_background_tabs. As ReArcExtensionTabRequestRespond, but
+// an active request may be answered with a tab that is not its window's active
+// one: the host opened it in the background (an import's quiet install). The
+// extension's tab says active false.
+REARC_ENGINE_EXPORT ReArcStatus ReArcExtensionTabRequestRespondInBackground(uint64_t request_id, uint64_t tab_id);
 
