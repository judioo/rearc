+// Find in page (find_in_page, ABI 1.16) over Chromium's FindTabHelper.
+// options: forward=1, match_case=2; text is 1..16384 bytes of UTF-8. Start
+// always begins a new session (ending an active one with reason replaced) and
+// returns its nonzero session_id. Next continues it (forward or previous,
+// wrapping). Result events (reason 0) carry match_count, 1-based
+// active_ordinal (0 none) and final_update; ignore non-current sessions.
+// Every session ends with exactly one terminal event: reason 1 navigated
+// (primary cross-document commit), 2 closed (before tab.closed), 3 stopped,
+// 4 replaced; terminal events are final with match_count/active_ordinal -1.
+// stop action: 0 clear selection, 1 keep selection, 2 activate selection.
+enum { REARC_FIND_FORWARD = 1, REARC_FIND_MATCH_CASE = 2 };
+typedef struct ReArcFindEvent {
+  uint64_t profile_id, tab_id, content_generation, session_id;
+  int32_t match_count, active_ordinal;
+  bool final_update;
+  uint32_t reason;
+} ReArcFindEvent;
+typedef void (*ReArcFindCallback)(void* context, const ReArcFindEvent* event);
+// Null disables delivery, including already queued events.
+REARC_ENGINE_EXPORT void ReArcEngineSetFindCallback(ReArcFindCallback callback,
+                                                     void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabFindStart(uint64_t tab_id,
+                                                  const char* text,
+                                                  uint32_t options,
+                                                  uint64_t* session_id);
+// No active session: invalid_state.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabFindNext(uint64_t tab_id, bool forward);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabFindStop(uint64_t tab_id,
+                                                 uint32_t action);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
