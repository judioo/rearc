new file mode 100644
index 0000000000..ba2775e6d8
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_find_abi.cc
@@ -0,0 +1,253 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Wave 18b find in page: a thin adapter over Chromium's FindTabHelper. The
+// helper owns request/session filtering and the renderer protocol; the bridge
+// adds an ABI session ID and exactly one terminal event per session.
+
+#include <pthread.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_abi.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "components/find_in_page/find_notification_details.h"
+#include "components/find_in_page/find_result_observer.h"
+#include "components/find_in_page/find_tab_helper.h"
+#include "components/find_in_page/find_types.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace rearc {
+namespace {
+
+ReArcFindCallback find_callback = nullptr;
+void* find_context = nullptr;
+uint64_t next_session_id = 1;
+constexpr size_t kMaxFindBytes = 16384;
+
+enum Reason : uint32_t {
+  kResult = 0,
+  kNavigated = 1,
+  kClosed = 2,
+  kStopped = 3,
+  kReplaced = 4,
+};
+
+void Publish(ReArcFindEvent event) {
+  ABIPost(base::BindOnce(
+      [](ReArcFindEvent e) {
+        CHECK(pthread_main_np());
+        if (find_callback) {
+          find_callback(find_context, &e);
+        }
+      },
+      event));
+}
+
+class FindSession : public content::WebContentsObserver,
+                    public find_in_page::FindResultObserver {
+ public:
+  explicit FindSession(TabSession& s)
+      : content::WebContentsObserver(s.web_contents()),
+        profile_id_(s.profile_id()),
+        tab_id_(s.tab_id()),
+        generation_(s.content_generation()) {
+    helper_ = find_in_page::FindTabHelper::FromWebContents(s.web_contents());
+    CHECK(helper_);  // Attached with every browser-less tab (wave 18b A).
+    observation_.Observe(helper_);
+  }
+  ~FindSession() override { End(kClosed, find_in_page::SelectionAction::kClear); }
+
+  bool active() const { return session_id_ != 0; }
+  find_in_page::FindTabHelper* helper() const { return helper_; }
+
+  uint64_t Start(std::u16string text, bool forward, bool match_case) {
+    End(kReplaced, find_in_page::SelectionAction::kKeep);
+    session_id_ = next_session_id++;
+    text_ = std::move(text);
+    match_case_ = match_case;
+    // A prior StopFinding marks the helper aborted, so this is a new session.
+    helper_->StartFinding(text_, forward, match_case_, /*find_match=*/true);
+    return session_id_;
+  }
+  void Next(bool forward) {
+    helper_->StartFinding(text_, forward, match_case_, /*find_match=*/true);
+  }
+  void Stop(find_in_page::SelectionAction action) { End(kStopped, action); }
+
+  // find_in_page::FindResultObserver:
+  void OnFindResultAvailable(content::WebContents*) override {
+    if (!active()) {
+      return;
+    }
+    const auto& result = helper_->find_result();
+    Publish(Event(kResult, result.number_of_matches(),
+                  result.active_match_ordinal(), result.final_update()));
+  }
+  void OnFindTabHelperDestroyed(find_in_page::FindTabHelper*) override {
+    observation_.Reset();
+    helper_ = nullptr;
+    if (active()) {
+      Publish(Event(kClosed, -1, -1, true));
+      session_id_ = 0;
+    }
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    // Like Chromium's find bar: a new primary document ends the session.
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() &&
+        !handle->IsSameDocument()) {
+      End(kNavigated, find_in_page::SelectionAction::kClear);
+    }
+  }
+
+ private:
+  ReArcFindEvent Event(uint32_t reason, int matches, int ordinal, bool final) {
+    ReArcFindEvent e{};
+    e.profile_id = profile_id_;
+    e.tab_id = tab_id_;
+    e.content_generation = generation_;
+    e.session_id = session_id_;
+    e.match_count = matches;
+    e.active_ordinal = ordinal;
+    e.final_update = final;
+    e.reason = reason;
+    return e;
+  }
+  void End(uint32_t reason, find_in_page::SelectionAction action) {
+    if (!active()) {
+      return;
+    }
+    // Terminal event first: StopFinding resets the helper's last result.
+    Publish(Event(reason, -1, -1, true));
+    session_id_ = 0;
+    if (helper_) {
+      helper_->StopFinding(action);
+    }
+  }
+
+  const uint64_t profile_id_, tab_id_, generation_;
+  raw_ptr<find_in_page::FindTabHelper> helper_ = nullptr;
+  base::ScopedObservation<find_in_page::FindTabHelper,
+                          find_in_page::FindResultObserver>
+      observation_{this};
+  uint64_t session_id_ = 0;
+  std::u16string text_;
+  bool match_case_ = false;
+};
+
+auto& Finds() {
+  static base::NoDestructor<std::map<uint64_t, std::unique_ptr<FindSession>>>
+      finds;
+  return *finds;
+}
+
+ReArcStatus FindTab(uint64_t id, FindSession** find) {
+  TabSession* s;
+  if (auto status = ABICheckTab(id, &s)) {
+    return status;
+  }
+  auto it = Finds().find(id);
+  if (it == Finds().end() || !it->second->helper()) {
+    return REARC_UNSUPPORTED;
+  }
+  *find = it->second.get();
+  return REARC_OK;
+}
+
+}  // namespace
+
+void ABIAttachFind(uint64_t id) {
+  CHECK(pthread_main_np());
+  auto* s = TabRegistry::Get().FindSession(id);
+  if (s && find_in_page::FindTabHelper::FromWebContents(s->web_contents())) {
+    Finds().emplace(id, std::make_unique<FindSession>(*s));
+  }
+}
+void ABIDetachFind(uint64_t id) {
+  CHECK(pthread_main_np());
+  // Destruction delivers a close terminal event for an active session.
+  Finds().erase(id);
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetFindCallback(ReArcFindCallback callback, void* context) {
+  CHECK(pthread_main_np());
+  rearc::find_callback = callback;
+  rearc::find_context = context;
+}
+ReArcStatus ReArcTabFindStart(uint64_t id, const char* text, uint32_t options,
+                              uint64_t* session_id) {
+  if (session_id) {
+    *session_id = 0;
+  }
+  rearc::FindSession* find;
+  if (auto status = rearc::FindTab(id, &find)) {
+    return status;
+  }
+  if (!text || !session_id || (options & ~uint32_t{REARC_FIND_FORWARD | REARC_FIND_MATCH_CASE})) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  const std::string value(text);
+  if (value.empty() || value.size() > rearc::kMaxFindBytes ||
+      !base::IsStringUTF8(value)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  *session_id = find->Start(base::UTF8ToUTF16(value),
+                            options & REARC_FIND_FORWARD,
+                            options & REARC_FIND_MATCH_CASE);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabFindNext(uint64_t id, bool forward) {
+  rearc::FindSession* find;
+  if (auto status = rearc::FindTab(id, &find)) {
+    return status;
+  }
+  if (!find->active()) {
+    return REARC_INVALID_STATE;
+  }
+  find->Next(forward);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabFindStop(uint64_t id, uint32_t action) {
+  rearc::FindSession* find;
+  if (auto status = rearc::FindTab(id, &find)) {
+    return status;
+  }
+  find_in_page::SelectionAction selection;
+  switch (action) {
+    case 0:
+      selection = find_in_page::SelectionAction::kClear;
+      break;
+    case 1:
+      selection = find_in_page::SelectionAction::kKeep;
+      break;
+    case 2:
+      selection = find_in_page::SelectionAction::kActivate;
+      break;
+    default:
+      return REARC_INVALID_ARGUMENT;
+  }
+  if (!find->active()) {
+    return REARC_INVALID_STATE;
+  }
+  find->Stop(selection);
+  return REARC_OK;
+}
