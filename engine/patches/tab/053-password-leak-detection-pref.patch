+++ b/chrome/browser/rearc_bridge/rearc_password_leak_abi.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Wave 18f (password_leak_detection): Chromium's own leak detection pref.
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_abi.h"
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+#include "components/password_manager/core/common/password_manager_pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace {
+
+// Off-the-record profiles never run leak checks (LeakDetectionDelegate) and
+// their prefs are an overlay of the original's; they are not addressable.
+ReArcStatus FindProfile(uint64_t profile_id, PrefService** prefs) {
+  Profile* profile = rearc::FindBridgeProfile(profile_id);
+  if (!profile) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  if (profile->IsOffTheRecord()) {
+    return REARC_UNSUPPORTED;
+  }
+  *prefs = profile->GetPrefs();
+  return REARC_OK;
+}
+
+}  // namespace
+
+ReArcStatus ReArcProfileGetPasswordLeakDetection(uint64_t profile_id,
+                                                 bool* enabled,
+                                                 bool* managed) {
+  CHECK(pthread_main_np());
+  if (!enabled || !managed) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  PrefService* prefs = nullptr;
+  if (auto status = FindProfile(profile_id, &prefs)) {
+    return status;
+  }
+  *enabled = prefs->GetBoolean(
+      password_manager::prefs::kPasswordLeakDetectionEnabled);
+  *managed = prefs->IsManagedPreference(
+      password_manager::prefs::kPasswordLeakDetectionEnabled);
+  return REARC_OK;
+}
+
+ReArcStatus ReArcProfileSetPasswordLeakDetection(uint64_t profile_id,
+                                                 bool enabled) {
+  CHECK(pthread_main_np());
+  PrefService* prefs = nullptr;
+  if (auto status = FindProfile(profile_id, &prefs)) {
+    return status;
+  }
+  if (!prefs->IsUserModifiablePreference(
+          password_manager::prefs::kPasswordLeakDetectionEnabled)) {
+    return REARC_INVALID_STATE;  // Enterprise policy owns it.
+  }
+  prefs->SetBoolean(password_manager::prefs::kPasswordLeakDetectionEnabled,
+                    enabled);
+  return REARC_OK;
+}
