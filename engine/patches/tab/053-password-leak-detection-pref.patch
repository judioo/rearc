+// Password leak detection (password_leak_detection, ABI 1.35): Chromium's
+// profile.password_manager_leak_detection pref, default on as in Chrome. When
+// on, a successfully submitted sign-in's credential is checked against
+// Google's leak database by Chromium (a hashed, prefix-based request to
+// Google); a leak is not yet surfaced to the host. Persisted per profile.
+// managed: set by enterprise policy, and then Set returns invalid_state.
+// Off-the-record profiles never run leak checks: unsupported.
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileGetPasswordLeakDetection(
+    uint64_t profile_id, bool* enabled, bool* managed);
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileSetPasswordLeakDetection(
