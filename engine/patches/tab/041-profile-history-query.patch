 void UnregisterBridgeProfile(Profile* profile) {
   CHECK(pthread_main_np());
   // Before the profile (and its DownloadManager) can be destroyed.
+  ABICancelHistory(BridgeProfileId(profile));
   ABIDetachDownloads(BridgeProfileId(profile));
   if (BridgeProfileId(profile) == default_id) {
     default_id = 0;
