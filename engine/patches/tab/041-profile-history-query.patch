diff --git a/chrome/browser/rearc_bridge/rearc_history_abi.cc b/chrome/browser/rearc_bridge/rearc_history_abi.cc
new file mode 100644
index 0000000000..7e76265c6b
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_history_abi.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <pthread.h>
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/time/time.h"
+#include "chrome/browser/history/history_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+#include "components/history/core/browser/history_service.h"
+#include "components/history/core/browser/history_types.h"
+#include "url/gurl.h"
+
+namespace rearc {
+namespace {
+struct Request {
+  uint64_t profile_id;
+  ReArcHistoryCallback query = nullptr;
+  ReArcCompletion mutation = nullptr;
+  raw_ptr<void> context = nullptr;
+  base::CancelableTaskTracker tracker;
+};
+auto& Requests() {
+  static base::NoDestructor<std::map<uint64_t, std::unique_ptr<Request>>> requests;
+  return *requests;
+}
+uint64_t next_id = 1;
+struct Row {
+  std::string title, url;
+  int64_t time;
+  int32_t visits;
+};
+void Finish(uint64_t id, ReArcStatus status, std::vector<Row> rows = {}) {
+  auto it = Requests().find(id);
+  if (it == Requests().end()) return;
+  auto request = std::move(it->second);
+  Requests().erase(it);
+  ABIPost(base::BindOnce([](std::unique_ptr<Request> request, ReArcStatus status,
+                           std::vector<Row> rows) {
+    if (request->query) {
+      std::vector<ReArcHistoryEntry> entries;
+      for (const auto& row : rows)
+        entries.push_back({row.title.c_str(), row.url.c_str(), row.time, row.visits});
+      request->query(request->context.get(), status, request->profile_id,
+                     entries.empty() ? nullptr : entries.data(), entries.size());
+    } else {
+      request->mutation(request->context.get(), status, false);
+    }
+  }, std::move(request), status, std::move(rows)));
+}
+ReArcStatus Service(uint64_t profile_id, history::HistoryService** service) {
+  CHECK(pthread_main_np());
+  if (!ReArcEngineDefaultProfile()) return REARC_ENGINE_NOT_READY;
+  Profile* profile = FindBridgeProfile(profile_id);
+  if (!profile) return REARC_PROFILE_NOT_FOUND;
+  // Never ask the factory for OTR: EXPLICIT_ACCESS can resolve its original.
+  if (profile->IsOffTheRecord()) return REARC_UNSUPPORTED;
+  *service = HistoryServiceFactory::GetForProfile(profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!*service) return REARC_UNSUPPORTED;
+  return Requests().size() >= 64 ? REARC_BUSY : REARC_OK;
+}
+uint64_t Add(uint64_t profile, ReArcHistoryCallback query,
+             ReArcCompletion mutation, void* context) {
+  uint64_t id = next_id++;
+  auto request = std::make_unique<Request>();
+  request->profile_id = profile;
+  request->query = query;
+  request->mutation = mutation;
+  request->context = context;
+  Requests()[id] = std::move(request);
+  return id;
+}
+ReArcStatus Delete(uint64_t profile, const std::set<GURL>& urls,
+                   base::Time begin, base::Time end,
+                   ReArcCompletion completion, void* context) {
+  history::HistoryService* service;
+  if (auto status = Service(profile, &service)) return status;
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  uint64_t id = Add(profile, nullptr, completion, context);
+  if (!urls.empty()) {
+    service->DeleteURLs(std::vector<GURL>(urls.begin(), urls.end()));
+    // DeleteURLs has no reply. A bounded query on the same sequenced backend
+    // is a completion barrier, including deletion of URL metadata.
+    history::QueryOptions barrier;
+    barrier.max_count = 1;
+    service->QueryHistory(u"", barrier,
+        base::BindOnce([](uint64_t id, history::QueryResults) { Finish(id, REARC_OK); }, id),
+        &Requests().at(id)->tracker);
+  } else {
+    service->ExpireHistoryBetween({}, std::nullopt, begin, end, true,
+        base::BindOnce([](uint64_t id) { Finish(id, REARC_OK); }, id),
+        &Requests().at(id)->tracker);
+  }
+  return REARC_OK;
+}
+}  // namespace
+void ABICancelHistory(uint64_t profile_id) {
+  std::vector<uint64_t> ids;
+  for (const auto& [id, request] : Requests())
+    if (request->profile_id == profile_id) ids.push_back(id);
+  for (uint64_t id : ids) Finish(id, REARC_CANCELLED);
+}
+}  // namespace rearc
+
+ReArcStatus ReArcHistoryQuery(uint64_t profile, const char* text, uint32_t limit,
+                              ReArcHistoryCallback completion, void* context) {
+  history::HistoryService* service;
+  if (auto status = rearc::Service(profile, &service)) return status;
+  if (!completion || !text || !limit || limit > 1000) return REARC_INVALID_ARGUMENT;
+  std::string query(text);
+  if (query.size() > 4096 || !base::IsStringUTF8(query)) return REARC_INVALID_ARGUMENT;
+  uint64_t id = rearc::Add(profile, completion, nullptr, context);
+  history::QueryOptions options;
+  options.max_count = limit;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kExclude404s;
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  service->QueryHistory(base::UTF8ToUTF16(query), options,
+      base::BindOnce([](uint64_t id, history::QueryResults results) {
+        std::vector<rearc::Row> rows;
+        size_t bytes = 0;
+        for (const auto& result : results) {
+          rearc::Row row{base::UTF16ToUTF8(result.title()), result.url().spec(),
+              (result.visit_time() - base::Time::UnixEpoch()).InMicroseconds(),
+              result.visit_count()};
+          bytes += row.title.size() + row.url.size();
+          if (bytes > 8 * 1024 * 1024) { rearc::Finish(id, REARC_TOO_LARGE); return; }
+          rows.push_back(std::move(row));
+        }
+        rearc::Finish(id, REARC_OK, std::move(rows));
+      }, id), &rearc::Requests().at(id)->tracker);
+  return REARC_OK;
+}
+ReArcStatus ReArcHistoryDeleteURL(uint64_t profile, const char* value,
+                                  ReArcCompletion completion, void* context) {
+  CHECK(pthread_main_np());
+  if (!value || !base::IsStringUTF8(value) || std::string(value).size() > 65536)
+    return REARC_INVALID_URL;
+  GURL url(value);
+  if (!url.is_valid()) return REARC_INVALID_URL;
+  return rearc::Delete(profile, {url}, base::Time(), base::Time(), completion, context);
+}
+ReArcStatus ReArcHistoryDeleteRange(uint64_t profile, int64_t begin, int64_t end,
+                                    ReArcCompletion completion, void* context) {
+  CHECK(pthread_main_np());
+  // Bound to year 9999, avoiding saturated Time arithmetic on invalid input.
+  constexpr int64_t kMaxTime = 253402300799999999;
+  if (begin < 0 || end < 0 || begin > kMaxTime || end > kMaxTime ||
+      (end && end <= begin)) return REARC_INVALID_ARGUMENT;
+  return rearc::Delete(profile, {},
+      begin ? base::Time::UnixEpoch() + base::Microseconds(begin) : base::Time(),
+      end ? base::Time::UnixEpoch() + base::Microseconds(end) : base::Time(),
+      completion, context);
+}
