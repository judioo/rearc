+// HistoryService queries/deletions (history_query, ABI 1.23). No OTR access.
+// Empty text returns recent unique URLs, newest first. UTF-8 <=4096 bytes;
+// limit 1..1000. visit_time_us is microseconds since Unix epoch; visit_count
+// is Chromium's total URL visit count. Strings/rows are borrowed in callback.
+// Accepted calls complete once, deferred; profile release cancels observation
+// (deletion already dispatched can still take effect). At most 64 pending.
+typedef struct ReArcHistoryEntry {
+  const char* title;
+  const char* url;
+  int64_t visit_time_us;
+  int32_t visit_count;
+} ReArcHistoryEntry;
+typedef void (*ReArcHistoryCallback)(void* context, ReArcStatus status,
+                                    uint64_t profile_id,
+                                    const ReArcHistoryEntry* entries,
+                                    size_t count);
+REARC_ENGINE_EXPORT ReArcStatus ReArcHistoryQuery(
+    uint64_t profile_id, const char* text, uint32_t limit,
+    ReArcHistoryCallback completion, void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcHistoryDeleteURL(
+    uint64_t profile_id, const char* url, ReArcCompletion completion,
+    void* context);
+// [begin_us,end_us), Unix microseconds, nonnegative; zero endpoint means
+// unbounded in that direction. Nonzero end must be greater than begin.
+REARC_ENGINE_EXPORT ReArcStatus ReArcHistoryDeleteRange(
+    uint64_t profile_id, int64_t begin_us, int64_t end_us,
+    ReArcCompletion completion, void* context);
+
 // ABI 1.15 (history_recording, password_autofill): every tab carries Chromium's
 // HistoryTabHelper (non-OTR profiles), autofill client and
 // ChromePasswordManagerClient. Visits reach HistoryService/chrome://history;
