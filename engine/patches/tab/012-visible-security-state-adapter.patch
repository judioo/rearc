+#ifndef CHROME_BROWSER_REARC_BRIDGE_SECURITY_ADAPTER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_SECURITY_ADAPTER_H_
+
+#include <cstdint>
+
+namespace rearc {
+
+// UI thread only, dormant until called after tab.created. Uses Chrome's
+// visible-security-state machinery; uninitialized state is always unknown.
+void AttachSecurityAdapter(uint64_t tab_id);
+void DetachSecurityAdapter(uint64_t tab_id);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_SECURITY_ADAPTER_H_
