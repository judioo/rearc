+// Moves a tab to group (-1: none). An emptied group is removed. Events are
+// sent unless the tab is closing (its onRemoved stands for the change).
+void SetGroup(uint64_t id, int group, bool events) {
+  auto it = States().find(id); if (it == States().end() || it->second.group == group) return;
+  int old = it->second.group; it->second.group = group;
+  auto* s = TabRegistry::Get().FindSession(id); if (!s) return;
+  if (events) TabUpdated(s->web_contents(), {"groupId"});
+  if (old < 0) return;
+  for (const auto& [other, state] : States()) if (state.group == old) return;
+  BroadcastGroup(s->web_contents()->GetBrowserContext(), extensions::events::TAB_GROUPS_ON_REMOVED, groups::OnRemoved::kEventName, old);
+  Groups().erase(old);
+}
