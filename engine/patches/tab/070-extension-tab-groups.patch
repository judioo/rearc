+  int group = group_id.value_or(0);
+  if (!group_id) {
+    std::set<groups::Color> used;
+    for (const auto& [id, g] : Groups()) used.insert(g.color);
+    groups::Color color = groups::Color::kGrey;
+    for (auto c : {groups::Color::kGrey, groups::Color::kBlue, groups::Color::kRed, groups::Color::kYellow, groups::Color::kGreen,
