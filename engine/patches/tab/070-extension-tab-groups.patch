+    Groups()[group] = {window, BridgeProfileId(Profile::FromBrowserContext(contents->GetBrowserContext())), "", color, false};
+    BroadcastGroup(contents->GetBrowserContext(), extensions::events::TAB_GROUPS_ON_CREATED, groups::OnCreated::kEventName, group);
+  }
+  for (auto tab : tabs) SetGroup(tab, group, true);
