+void BroadcastGroup(content::BrowserContext* browser_context, extensions::events::HistogramValue histogram, const std::string& name, int id) {
+  auto it = Groups().find(id); if (it == Groups().end()) return;
+  base::ListValue args; args.Append(GroupObject(id, it->second).ToValue());
+  Broadcast(browser_context, histogram, name, std::move(args));
