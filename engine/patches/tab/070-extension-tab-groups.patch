+// The tab is looked up again when the event reaches each extension, as
+// TabsEventRouter does, but by ID: a lazy listener may run after the tab closed.
+void BroadcastTab(content::WebContents* c, extensions::events::HistogramValue histogram, const std::string& name, std::set<std::string> keys) {
+  auto event = std::make_unique<extensions::Event>(histogram, name, base::ListValue(), c->GetBrowserContext());
+  event->user_gesture = extensions::EventRouter::UserGestureState::kNotEnabled;
+  event->will_dispatch_callback = base::BindRepeating([](int id, const std::set<std::string>& keys, bool created,
+      content::BrowserContext* browser_context, extensions::mojom::ContextType target, const extensions::Extension* extension,
+      const base::DictValue*, std::optional<base::ListValue>& args, extensions::mojom::EventFilteringInfoPtr&, bool*) {
+    content::WebContents* c = nullptr;
+    if (!extensions::ExtensionTabUtil::GetTabById(id, browser_context, true, &c) || !c) return false;
+    auto tab = extensions::ExtensionTabUtil::CreateTabObject(c,
+        extensions::ExtensionTabUtil::GetScrubTabBehavior(extension, target, c), extension).ToValue();
+    args.emplace();
+    if (created) { args->Append(std::move(tab)); return true; }
+    base::DictValue changed;
+    for (const auto& key : keys) if (const auto* value = tab.Find(key)) changed.Set(key, value->Clone());
+    args->Append(id); args->Append(std::move(changed)); args->Append(std::move(tab));
+    return true;
+  }, extensions::ExtensionTabUtil::GetTabId(c), std::move(keys), histogram == extensions::events::TABS_ON_CREATED);
+  if (auto* router = extensions::EventRouter::Get(c->GetBrowserContext())) router->BroadcastEvent(std::move(event));
+}
+void TabUpdated(content::WebContents* c, std::set<std::string> keys) {
+  BroadcastTab(c, extensions::events::TABS_ON_UPDATED, extensions::api::tabs::OnUpdated::kEventName, std::move(keys));
+}
+// tabs.onUpdated for registry tabs in a logical window, after
+// TabsEventRouter::TabEntry: status on commit and on the first stop after it.
+class TabEvents : public content::WebContentsObserver {
+ public:
+  explicit TabEvents(content::WebContents* c) : WebContentsObserver(c), url_(c->GetURL()) {}
+  void NavigationEntryCommitted(const content::LoadCommittedDetails&) override { waiting_ = true; Changed({"status"}); }
+  void DidStopLoading() override { if (!waiting_) return; waiting_ = false; Changed({"status"}); }
+  void TitleWasSet(content::NavigationEntry*) override { TabUpdated(web_contents(), {"title"}); }
+  void DidUpdateAudioMutingState(bool) override { TabUpdated(web_contents(), {"mutedInfo"}); }
+ private:
+  void Changed(std::set<std::string> keys) {
+    if (web_contents()->GetURL() != url_) { url_ = web_contents()->GetURL(); keys.insert("url"); }
+    TabUpdated(web_contents(), std::move(keys));
+  }
+  GURL url_;
+  bool waiting_ = false;
+};
+auto& Observers() { static base::NoDestructor<std::map<uint64_t, std::unique_ptr<TabEvents>>> o; return *o; }
