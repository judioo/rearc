+      base::BindOnce([](decltype(respond) respond, scoped_refptr<ExtensionFunction> f, int window,
+          base::OnceCallback<void(std::optional<base::DictValue>, std::string)> done, content::WebContents* c) {
+        if (!c) { std::move(done).Run(std::nullopt, "Shell activation cancelled."); return; }
+        respond(f, window, std::move(done));
+      }, respond, base::WrapRefCounted(f), window, std::move(done)));
