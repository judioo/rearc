+}
+bool UngroupExtensionTabs(ExtensionFunction* f, const std::vector<int>& ids, std::string* error) {
+  std::vector<uint64_t> tabs;
+  if (!MappedTabs(f, ids, &tabs, error)) return false;
+  for (auto tab : tabs) SetGroup(tab, -1, true);
+  return true;
+}
+std::optional<groups::TabGroup> GetExtensionGroup(ExtensionFunction* f, int id, std::string* error) {
+  auto it = Groups().find(id);
+  if (it == Groups().end() || !VisibleGroup(f, id)) { *error = GroupNotFound(id); return std::nullopt; }
+  return GroupObject(id, it->second);
+}
+base::ListValue QueryExtensionGroups(ExtensionFunction* f, const groups::Query::Params::QueryInfo& q) {
+  base::ListValue result;
+  int current = q.window_id && *q.window_id == -2 ? CurrentWindow(f) : 0;
+  for (const auto& [id, g] : Groups()) {
+    if (!VisibleGroup(f, id) || (q.collapsed && *q.collapsed != g.collapsed) ||
+        (q.color != groups::Color::kNone && q.color != g.color) || (q.shared && *q.shared) ||
+        (q.window_id && (*q.window_id == -2 ? g.window != current : *q.window_id >= 0 && *q.window_id != g.window)) ||
+        (q.title && !base::MatchPattern(g.title, *q.title))) continue;
+    result.Append(GroupObject(id, g).ToValue());
+  }
+  return result;
+}
+std::optional<groups::TabGroup> UpdateExtensionGroup(ExtensionFunction* f, int id, const groups::Update::Params::UpdateProperties& u, std::string* error) {
+  auto group = GetExtensionGroup(f, id, error); if (!group) return std::nullopt;
+  auto& g = Groups().at(id);
+  const Group before = g;
+  if (u.collapsed) g.collapsed = *u.collapsed;
+  if (u.color != groups::Color::kNone) g.color = u.color;
+  if (u.title) g.title = *u.title;
+  if (g.collapsed != before.collapsed || g.color != before.color || g.title != before.title)
+    BroadcastGroup(f->browser_context(), extensions::events::TAB_GROUPS_ON_UPDATED, groups::OnUpdated::kEventName, id);
+  return GroupObject(id, g);
+}
+void UpdateExtensionWindow(ExtensionFunction* f, int window, const extensions::api::windows::Update::Params::UpdateInfo& u,
+    base::OnceCallback<void(std::optional<base::DictValue>, std::string)> done) {
+  if (u.left || u.top || u.width || u.height ||
+      (u.state != extensions::api::windows::WindowState::kNone && u.state != extensions::api::windows::WindowState::kNormal)) {
+    std::move(done).Run(std::nullopt, "Shell windows have no geometry or state."); return;
+  }
+  auto values = QueryExtensionWindows(f, window, false);
+  if (values.empty()) { std::move(done).Run(std::nullopt, "No matching shell window."); return; }
+  window = *values[0].GetDict().FindInt("id");
+  auto respond = [](scoped_refptr<ExtensionFunction> f, int window, base::OnceCallback<void(std::optional<base::DictValue>, std::string)> done) {
+    auto values = QueryExtensionWindows(f.get(), window, false);
+    if (values.empty()) std::move(done).Run(std::nullopt, "No matching shell window.");
+    else std::move(done).Run(std::move(values[0]).TakeDict(), "");
+  };
