index 0000000000..44eeda32c0
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_context_menu.cc
@@ -0,0 +1,270 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_context_menu.h"
+
+#include <pthread.h>
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "content/public/browser/context_menu_params.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/common/referrer.h"
+#include "third_party/blink/public/common/context_menu_data/edit_flags.h"
+#include "third_party/blink/public/common/loader/network_utils.h"
+#include "third_party/blink/public/mojom/context_menu/context_menu.mojom.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+namespace rearc {
+namespace {
+class Menu;
+ReArcContextMenuCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+auto& Pending() {
+  static base::NoDestructor<std::map<uint64_t, base::WeakPtr<Menu>>> map;
+  return *map;
+}
+class Menu : public content::WebContentsObserver,
+             public content::WebContentsUserData<Menu> {
+ public:
+  ~Menu() override { End(true); }
+  void Start(TabSession& s,
+             content::RenderFrameHost& frame,
+             const content::ContextMenuParams& params) {
+    End(true);
+    if (!host) {
+      return;
+    }
+    id_ = next_id++;
+    params_ = params;
+    frame_ = frame.GetWeakDocumentPtr();
+    event_ = {s.profile_id(),
+              s.tab_id(),
+              s.content_generation(),
+              id_,
+              0,
+              static_cast<uint32_t>(params.media_type),
+              static_cast<uint32_t>(params.edit_flags),
+              params.x,
+              params.y,
+              params.is_editable,
+              params.has_image_contents,
+              nullptr,
+              nullptr,
+              nullptr,
+              nullptr,
+              nullptr};
+    Pending().emplace(id_, weak_.GetWeakPtr());
+    web_contents()->SetShowingContextMenu(true);
+    Publish(0);
+  }
+  void End(bool cancel, const GURL& followed = GURL()) {
+    if (!id_) {
+      return;
+    }
+    if (cancel) {
+      Publish(1);
+    }
+    Pending().erase(id_);
+    id_ = 0;
+    params_.reset();
+    web_contents()->SetShowingContextMenu(false);
+    web_contents()->NotifyContextMenuClosed(followed);
+  }
+  ReArcStatus Command(uint32_t action) {
+    auto* frame = frame_.AsRenderFrameHostIfValid();
+    if (!frame) {
+      End(true);
+      return REARC_NOT_FOUND;
+    }
+    const auto p = *params_;
+    auto* c = web_contents();
+    uint64_t tab = event_.tab_id;
+    if (action > 12) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    if (action == 8) {
+      return REARC_UNSUPPORTED;
+    }
+    uint32_t flag = action == 2   ? blink::ContextMenuDataEditFlags::kCanCopy
+                    : action == 3 ? blink::ContextMenuDataEditFlags::kCanPaste
+                    : action == 4 ? blink::ContextMenuDataEditFlags::kCanCut
+                    : action == 5
+                        ? blink::ContextMenuDataEditFlags::kCanSelectAll
+                        : 0;
+    if (flag && !(p.edit_flags & flag)) {
+      return REARC_INVALID_STATE;
+    }
+    if ((action < 2 && p.link_url.is_empty()) ||
+        ((action == 6 || action == 7) && !p.has_image_contents)) {
+      return REARC_INVALID_STATE;
+    }
+    if (action == 0) {
+      auto status = ABIValidateNavigationURL(p.link_url);
+      if (status) {
+        return status;
+      }
+      End(false, p.link_url);
+      return ReArcTabNavigate(tab, p.link_url.spec().c_str(), 1);
+    }
+    if (action == 9 && !c->GetController().CanGoBack()) {
+      return REARC_INVALID_STATE;
+    }
+    if (action == 10 && !c->GetController().CanGoForward()) {
+      return REARC_INVALID_STATE;
+    }
+    End(false);
+    switch (action) {
+      case 1: {
+        ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+        writer.WriteText(base::UTF8ToUTF16(p.unfiltered_link_url.spec()));
+        break;
+      }
+      case 2:
+        c->Copy();
+        break;
+      case 3:
+        c->Paste();
+        break;
+      case 4:
+        c->Cut();
+        break;
+      case 5:
+        c->SelectAll();
+        break;
+      case 6:
+        if (p.src_url.is_empty() ||
+            p.media_type == blink::mojom::ContextMenuDataMediaType::kCanvas) {
+          frame->SaveImageAt(p.x, p.y);
+        } else {
+          c->SaveFrameWithHeaders(
+              p.src_url,
+              content::Referrer::SanitizeForRequest(
+                  p.src_url, content::Referrer(p.frame_url, p.referrer_policy)),
+              "Accept: " +
+                  std::string(blink::network_utils::ImageAcceptHeader()) +
+                  "\r\n",
+              p.suggested_filename, frame, !p.is_image_media_plugin_document);
+        }
+        break;
+      case 7:
+        frame->CopyImageAt(p.x, p.y);
+        break;
+      case 9:
+        return ReArcTabGoBack(tab);
+      case 10:
+        return ReArcTabGoForward(tab);
+      case 11:
+        return ReArcTabReload(tab, false);
+      case 12:
+        break;
+      default:
+        return REARC_INVALID_ARGUMENT;
+    }
+    return REARC_OK;
+  }
+  void DidStartNavigation(content::NavigationHandle* h) override {
+    if (h->IsInPrimaryMainFrame() && !h->IsSameDocument()) {
+      End(true);
+    }
+  }
+  void DidFinishNavigation(content::NavigationHandle*) override {
+    if (id_ && !frame_.AsRenderFrameHostIfValid()) {
+      End(true);
+    }
+  }
+  void WebContentsDestroyed() override { End(true); }
+  void RenderFrameDeleted(content::RenderFrameHost*) override {
+    if (id_ && !frame_.AsRenderFrameHostIfValid()) {
+      End(true);
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<Menu>;
+  explicit Menu(content::WebContents* c)
+      : content::WebContentsObserver(c),
+        content::WebContentsUserData<Menu>(*c) {}
+  void Publish(uint32_t phase) {
+    auto event = event_;
+    event.phase = phase;
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, ReArcContextMenuEvent e,
+           content::ContextMenuParams p) {
+          if (!host || expected != epoch ||
+              (!e.phase && !Pending().contains(e.request_id))) {
+            return;
+          }
+          auto selection = base::UTF16ToUTF8(p.selection_text);
+          e.link_url = p.link_url.spec().c_str();
+          e.src_url = p.src_url.spec().c_str();
+          e.selection_text = selection.c_str();
+          e.page_url = p.page_url.spec().c_str();
+          e.frame_url = p.frame_url.spec().c_str();
+          host(host_context, &e);
+        },
+        epoch, event, *params_));
+  }
+  uint64_t id_ = 0;
+  ReArcContextMenuEvent event_{};
+  std::optional<content::ContextMenuParams> params_;
+  content::WeakDocumentPtr frame_;
+  base::WeakPtrFactory<Menu> weak_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Menu);
+}  // namespace
+void ShowHostContextMenu(content::WebContents* c,
+                         content::RenderFrameHost& f,
+                         const content::ContextMenuParams& p) {
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id);
+    if (s->web_contents() == c) {
+      Menu::GetOrCreateForWebContents(c)->Start(*s, f, p);
+      return;
+    }
+  }
+}
+void ABICancelContextMenu(uint64_t tab) {
+  if (auto* s = TabRegistry::Get().FindSession(tab)) {
+    if (auto* m = Menu::FromWebContents(s->web_contents())) {
+      m->End(true);
+    }
+  }
+}
+}  // namespace rearc
+void ReArcEngineSetContextMenuCallback(ReArcContextMenuCallback cb, void* ctx) {
+  CHECK(pthread_main_np());
+  auto pending = rearc::Pending();
+  for (auto& [id, m] : pending) {
+    if (m) {
+      m->End(true);
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = cb;
+  rearc::host_context = ctx;
+}
+ReArcStatus ReArcContextMenuCommand(uint64_t id, uint32_t action) {
+  CHECK(pthread_main_np());
+  auto it = rearc::Pending().find(id);
+  if (it == rearc::Pending().end() || !it->second) {
+    return REARC_NOT_FOUND;
+  }
+  return it->second->Command(action);
+}
