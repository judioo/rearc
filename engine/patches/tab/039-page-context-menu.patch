+// Page context menus (context_menu, ABI 1.21). phase 0 request, 1 cancelled.
+// Coordinates are Chromium RenderView-local DIP, media_type is Blink's
+// ContextMenuDataMediaType, edit_flags are Blink context_menu_data/edit_flags.
+// URLs/selection are page data. Shell supplies all menu UI. New menu,
+// navigation, frame destruction, close or callback replacement invalidate IDs.
+typedef struct ReArcContextMenuEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase, media_type, edit_flags;
+  int32_t x, y;
+  bool is_editable, has_image_contents;
+  const char* link_url;
+  const char* src_url;
+  const char* selection_text;
+  const char* page_url;
+  const char* frame_url;
+} ReArcContextMenuEvent;
+typedef void (*ReArcContextMenuCallback)(void*, const ReArcContextMenuEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetContextMenuCallback(
+    ReArcContextMenuCallback callback, void* context);
+// action: 0 open link in this tab, 1 copy link, 2 copy, 3 paste, 4 cut,
+// 5 select all, 6 save image (Chromium download), 7 copy image,
+// 8 inspect (unsupported: browser-less DevTools frontend not wired),
+// 9 back, 10 forward, 11 reload, 12 dismiss. Success consumes the ID.
+// Invalid/disabled/unsupported actions leave it pending. Shell can Create a
+// separate tab using link_url for its open-in-new-tab menu item.
+REARC_ENGINE_EXPORT ReArcStatus ReArcContextMenuCommand(
+    uint64_t request_id, uint32_t action);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
