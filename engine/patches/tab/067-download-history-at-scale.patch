+void DownloadHistory::PrepareHistoryLoad(
+    std::vector<history::DownloadRow> rows) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::DownloadManager* manager = notifier_.GetManager();
+  if (!manager) {
+    return;
+  }
+  // Rows the in-progress DB still holds become items: CreateDownloadItem
+  // reconciles the two databases.
+  std::set<std::string> in_progress_guids;
+  download::SimpleDownloadManager::DownloadVector in_progress;
+  manager->GetUninitializedActiveDownloadsIfAny(&in_progress);
+  for (download::DownloadItem* item : in_progress) {
+    in_progress_guids.insert(item->GetGuid());
+  }
+  const LoadPolicyData* policy = GetLoadPolicy(manager->GetBrowserContext());
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&DownloadHistory::PrepareHistoryRows, std::move(rows),
+                     policy ? policy->live_limit : 0,
+                     std::move(in_progress_guids)),
+      base::BindOnce(&DownloadHistory::LoadPreparedHistory,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void DownloadHistory::LoadPreparedHistory(std::unique_ptr<PreparedLoad> load) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!notifier_.GetManager()) {
+    return;
+  }
+  for (uint32_t id : load->skipped) {
+    ScheduleRemoveDownload(id);
+  }
+  history_row_count_ = load->total;
+  if (!load->archived.empty()) {
+    archived_rows_ =
+        base::MakeRefCounted<ArchivedRows>(std::move(load->archived));
+  }
+  pending_load_ = std::move(load);
+  LoadHistorySlice();
+}
+
+void DownloadHistory::LoadHistorySlice() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!notifier_.GetManager() || !pending_load_) {
+    return;
+  }
+  const base::TimeTicks deadline =
+      base::TimeTicks::Now() + kHistoryLoadSliceBudget;
+  PreparedLoad& load = *pending_load_;
+  while (load.next < load.live.size()) {
+    if (LoadHistoryRow(load.live[load.next++], base::FilePath())) {
+      ++load.created;
     }
+    if (!notifier_.GetManager()) {
+      return;
+    }
+    if (load.next < load.live.size() && base::TimeTicks::Now() >= deadline) {
+      content::GetUIThreadTaskRunner({})->PostTask(
+          FROM_HERE, base::BindOnce(&DownloadHistory::LoadHistorySlice,
+                                    weak_ptr_factory_.GetWeakPtr()));
+      return;
+    }
+  }
+  live_row_count_ = load.created;
+  // A long history's rows take tens of milliseconds to free.
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::TaskPriority::BEST_EFFORT},
+      base::DoNothingWithBoundArgs(std::move(pending_load_)));
+  FinishHistoryLoad();
+}
