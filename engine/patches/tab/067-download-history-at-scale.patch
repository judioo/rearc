+size_t DownloadHistory::RemoveArchivedRows(
+    const std::set<std::string>& guids) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!archived_rows_ || guids.empty()) {
+    return 0;
+  }
+  // Published rows are immutable: a removal publishes a new vector.
+  std::vector<ArchivedRow> kept;
+  IdSet removed;
+  for (const ArchivedRow& row : archived_rows_->data) {
+    if (guids.contains(row.guid)) {
+      removed.insert(row.id);
+    } else {
+      kept.push_back(row);
+    }
+  }
+  if (removed.empty()) {
+    return 0;
+  }
+  archived_rows_ = kept.empty()
+                       ? nullptr
+                       : base::MakeRefCounted<ArchivedRows>(std::move(kept));
+  history_->RemoveDownloads(removed);
+  for (Observer& observer : observers_) {
+    observer.OnDownloadsRemoved(removed);
+  }
+  return removed.size();
+}
