+// A tab a non-forced shutdown closes on its own, before the rest: its page
+// may ask "Leave site?" (a beforeunload handler in any live frame), or a
+// close of it is already in flight and the shutdown joins it. Stay then
+// keeps the engine running before any other page has unloaded.
+bool ShutdownClosesAlone(TabSession& session) {
+  if (session.close_state() != TabSession::CloseState::kOpen) {
+    return true;
+  }
+  bool asks = false;
+  session.web_contents()->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&asks](content::RenderFrameHost* frame) {
+        asks |= frame->IsRenderFrameLive() &&
+                frame->GetSuddenTerminationDisablerState(
+                    blink::mojom::SuddenTerminationDisablerType::
+                        kBeforeUnloadHandler);
+      });
+  return asks;
+}
