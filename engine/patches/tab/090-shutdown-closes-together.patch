+  // No page can keep the engine running now, so every other tab closes in
+  // this one task, as Chrome's browser shutdown closes its windows
+  // (browser_shutdown::OnShutdownStarting, TabStripModel::CloseWebContentses):
+  // a renderer whose pages are all closing and have no unload, pagehide or
+  // visibilitychange handler ends at once, and those pages are destroyed
+  // without a renderer round trip. Pages with such a handler run it, all in
+  // parallel, within content's unload timeout. A forced shutdown runs none.
+  void CloseShutdownBatch() {
+    std::vector<uint64_t> batch = std::exchange(shutdown_batch, {});
+    base::flat_map<content::RenderProcessHost*, size_t> processes;
+    for (uint64_t id : batch) {
+      TabSession* session = TabRegistry::Get().FindSession(id);
+      if (!session) {
+        continue;
+      }
+      content::WebContents* contents = session->web_contents();
+      if (shutdown_force || !contents->NeedToFireBeforeUnloadOrUnloadEvents()) {
+        ++processes[contents->GetPrimaryMainFrame()->GetProcess()];
+      }
+    }
+    for (const auto& [process, pages] : processes) {
+      process->FastShutdownIfPossible(pages,
+                                      /*skip_unload_handlers=*/shutdown_force);
+    }
+    for (uint64_t id : batch) {
+      TabSession* session = TabRegistry::Get().FindSession(id);
+      if (!session) {
+        continue;
+      }
+      content::WebContents* contents = session->web_contents();
+      bool unloads =
+          !shutdown_force && contents->NeedToFireBeforeUnloadOrUnloadEvents();
+      // A page the renderer gave a beforeunload handler after the browser
+      // last heard of it can still say Stay; that ends this shutdown.
+      RequestTabCloseForShutdown(
+          id, !unloads,
+          base::BindOnce(
+              [](uint64_t generation, CloseOutcome outcome) {
+                if (outcome == CloseOutcome::kCancelled) {
+                  Get().CancelShutdown(generation);
+                }
+              },
+              shutdown_generation));
+    }
+  }
+
+  // A page said Stay: the engine runs on and the host's quit is undone.
+  // Tabs that had already closed stay closed.
+  void CancelShutdown(uint64_t generation) {
+    if (!stopping || generation != shutdown_generation) {
+      return;  // An earlier Stay already ended this shutdown.
+    }
+    stopping = false;
+    shutdown_batch.clear();
+    auto completion = shutdown_completion;
+    shutdown_completion = nullptr;
+    ABIPost(base::BindOnce(completion, shutdown_context.get(), REARC_OK, true));
+  }
+
   void FinishShutdown() {
     if (!ready) {
       return;
@@ -1077,6 +1188,8 @@ ReArcStatus ReArcEngineShutdown(bool force,
