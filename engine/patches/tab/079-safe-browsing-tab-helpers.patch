   REARC_TIMEOUT = 18
 };
-enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 56, REARC_MAX_BLOB_BYTES = 16777216 };
+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 57, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -121,6 +121,14 @@ ReArcEngineConfigure(uint32_t abi_version,
 // ReArcEngineAllowTestSwitches (after Configure, before Run) for its own
 // self-test. Debug engines pass every switch through for engine tests.
 REARC_ENGINE_EXPORT ReArcStatus ReArcEngineAllowTestSwitches(void);
+// ABI 1.57 (safe_browsing_tab_helpers): registry tabs get Chromium's Safe
+// Browsing tab helpers (navigation observer, async checks, client-side
+// phishing detection, password reuse, triggers, safety tips). True when this
+// engine can actually protect: Safe Browsing is compiled in and the build has
+// a real Google API key (google_api_key GN arg), not the "dummytoken"
+// placeholder Google rejects. False before ready. The profile's protection
+// level is a separate preference; show it only when this is true.
+REARC_ENGINE_EXPORT bool ReArcEngineSafeBrowsingAvailable(void);
 REARC_ENGINE_EXPORT int ReArcEngineRun(int argc, const char* const* argv);
 REARC_ENGINE_EXPORT ReArcStatus ReArcEngineShutdown(bool force,
                                                     ReArcCompletion completion,
