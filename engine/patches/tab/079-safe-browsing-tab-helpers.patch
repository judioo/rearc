+
 namespace rearc {
 namespace {
 
@@ -84,6 +102,11 @@ void AttachBrowserlessTabHelpers(content::WebContents* contents) {
     // usage bookkeeping and the store are Chromium's.
     ChromePasswordManagerClient::CreateForWebContents(contents);
   }
+#if BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+  // ABI 1.57: password reuse warnings, as TabHelpers attaches it after the
+  // password manager client.
+  ChromePasswordReuseDetectionManagerClient::CreateForWebContents(contents);
+#endif
   // Stock policy: no history helper for off-the-record profiles, nor for
   // extension popups and side panels (ExtensionViewHost contents record no
   // history).
@@ -98,6 +121,35 @@ void AttachBrowserlessTabHelpers(content::WebContents* contents) {
   }
   find_in_page::FindTabHelper::CreateForWebContents(contents);
   permissions::PermissionRequestManager::CreateForWebContents(contents);
+#if BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+  // ABI 1.57 (safe_browsing_tab_helpers): Safe Browsing's tab helpers in
+  // TabHelpers::AttachTabHelpers order. The navigation observer builds the
+  // referrer chains download and phishing checks send. ClientSideDetectionHost
+  // (created by SafeBrowsingTabObserver) observes PermissionRequestManager,
+  // AsyncCheckTracker and the ContentAutofillClient's managers in its
+  // constructor, so those exist first.
+  safe_browsing::SafeBrowsingNavigationObserver::MaybeCreateForWebContents(
+      contents, HostContentSettingsMapFactory::GetForProfile(profile),
+      safe_browsing::SafeBrowsingNavigationObserverManagerFactory::
+          GetForBrowserContext(profile),
+      profile->GetPrefs(), g_browser_process->safe_browsing_service(),
+      enterprise_connectors::IsReferrerChainNeededForEnterprise(profile));
+  if (g_browser_process->safe_browsing_service()) {
+    safe_browsing::AsyncCheckTracker::CreateForWebContents(
+        contents, g_browser_process->safe_browsing_service()->ui_manager(),
+        safe_browsing::AsyncCheckTracker::
+            IsPlatformEligibleForSyncCheckerCheckAllowlist());
+  }
+  safe_browsing::SafeBrowsingTabObserver::CreateForWebContents(
+      contents,
+      std::make_unique<safe_browsing::ChromeSafeBrowsingTabObserverDelegate>());
+  safe_browsing::TriggerCreator::MaybeCreateTriggersForWebContents(profile,
+                                                                   contents);
+#endif
+  // Lookalike reputation checks. Without a Browser window the safety tip
+  // bubble is not shown (ShowSafetyTipDialog returns), as for other
+  // browser-less contents.
+  SafetyTipWebContentsObserver::CreateForWebContents(contents);
   // Wave 18e: PDF generation for host printing. PrintViewManager's preview
   // and system-dialog paths are routed to the host for registry tabs.
   printing::InitializePrintingForWebContents(contents);
diff --git a/chrome/browser/rearc_bridge/rearc_engine_abi.h b/chrome/browser/rearc_bridge/rearc_engine_abi.h
