+         std::string(feature) == "safe_browsing_tab_helpers" ||
          std::string(feature) == "history_recording" ||
          std::string(feature) == "history_query" ||
          std::string(feature) == "search_autocomplete" ||
@@ -920,6 +926,21 @@ int ReArcEngineRun(int argc, const char* const* argv) {
   }
   return result;
 }
+bool ReArcEngineSafeBrowsingAvailable(void) {
+  CHECK([NSThread isMainThread]);
+  auto& a = ABI::Get();
+  if (!a.ready || a.stopping) {
+    return false;
+  }
+#if BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+  // List updates and hash lookups carry google_apis::GetAPIKey(); Google
+  // rejects the "dummytoken" placeholder an engine built without a key sends.
+  return g_browser_process->safe_browsing_service() &&
+         google_apis::HasAPIKeyConfigured();
+#else
+  return false;
+#endif
+}
 uint64_t ReArcEngineDefaultProfile(void) {
   CHECK([NSThread isMainThread]);
   return ABI::Get().ready && !ABI::Get().stopping
