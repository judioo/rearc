+namespace rearc {
+namespace {
+
+using extensions::SidePanelService;
+using PanelOptions = extensions::api::side_panel::PanelOptions;
+
+ReArcSidePanelCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+
+enum : uint32_t { kOpenRequested = 0, kCloseRequested = 1, kOptionsChanged = 2 };
+
+void Post(uint32_t kind,
+          uint64_t profile_id,
+          uint64_t tab_id,
+          int32_t window_id,
+          const std::string& extension_id,
+          uint64_t panel_tab_id = 0) {
+  if (!host || !profile_id) {
+    return;
+  }
+  ReArcSidePanelEvent event{profile_id, tab_id, panel_tab_id,
+                            window_id,  kind,   nullptr};
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, ReArcSidePanelEvent e, std::string id) {
+        if (!host || expected != epoch) {
+          return;
+        }
+        e.extension_id = id.c_str();
+        host(host_context, &e);
+      },
+      epoch, event, extension_id));
+}
+
+bool IsEnabled(const PanelOptions& options) {
+  return options.enabled.value_or(false) && options.path.has_value();
+}
+
+// As ExtensionSidePanelCoordinator: an http(s) URL, or a path in the extension.
+GURL PanelURL(const extensions::Extension& extension,
+              const PanelOptions& options) {
+  GURL absolute(*options.path);
+  return absolute.SchemeIsHTTPOrHTTPS()
+             ? absolute
+             : extension.ResolveExtensionURL(*options.path);
+}
+
+// A hosted panel's contents (view type side panel). contextual_tab is the
+// Chromium tab ID of a tab-specific panel; global panels have none.
+class Panel : public content::WebContentsUserData<Panel> {
+ public:
+  const std::string& extension_id() const { return extension_id_; }
+  std::optional<int> contextual_tab() const { return contextual_tab_; }
+  GURL url;
+  bool shown = false;
+  int window_id = 0;
+
+ private:
+  friend class content::WebContentsUserData<Panel>;
+  Panel(content::WebContents* contents,
+        std::string extension_id,
+        std::optional<int> contextual_tab,
+        GURL panel_url)
+      : content::WebContentsUserData<Panel>(*contents),
+        url(std::move(panel_url)),
+        extension_id_(std::move(extension_id)),
+        contextual_tab_(contextual_tab) {}
+  std::string extension_id_;
+  std::optional<int> contextual_tab_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Panel);
+
+// Enabled extension, visible to this (possibly OTR) context.
+const extensions::Extension* PanelExtension(content::BrowserContext* context,
+                                            const std::string& id) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          id);
+  if (!extension || (context->IsOffTheRecord() &&
+                     !extensions::util::IsIncognitoEnabled(id, context))) {
+    return nullptr;
+  }
+  return extension;
+}
+
+bool HasSidePanelPermission(const extensions::Extension& extension) {
+  return extension.permissions_data()->HasAPIPermission(
+      extensions::mojom::APIPermissionID::kSidePanel);
+}
+
+ReArcStatus CheckPageTab(uint64_t tab_id, TabSession** session) {
+  if (auto status = ABICheckTab(tab_id, session)) {
+    return status;
+  }
+  return extensions::GetViewType((*session)->web_contents()) ==
+                 extensions::mojom::ViewType::kTabContents
+             ? REARC_OK
+             : REARC_UNSUPPORTED;
+}
+
+int32_t LogicalWindow(uint64_t tab_id) {
+  ReArcExtensionTabState state{};
+  return tab_id && ReArcTabGetExtensionState(tab_id, &state) == REARC_OK
+             ? state.window_id
+             : 0;
+}
+
+TabSession* SessionOf(content::WebContents* contents) {
+  return contents ? ExtensionSession(contents) : nullptr;
+}
+
+// Options changes navigate or retire shown panels, then tell the host.
+class Watcher : public SidePanelService::Observer {
+ public:
+  explicit Watcher(content::BrowserContext* context) : context_(context) {}
+  void Observe(SidePanelService* service) {
+    if (!observation_.IsObserving()) {
+      observation_.Observe(service);
+    }
+  }
+
+  void OnPanelOptionsChanged(const extensions::ExtensionId& extension_id,
+                             const PanelOptions& updated) override {
+    auto* service = SidePanelService::Get(context_);
+    auto& registry = TabRegistry::Get();
+    for (uint64_t id : registry.SessionIds()) {
+      TabSession* session = registry.FindSession(id);
+      Panel* panel = session ? Panel::FromWebContents(session->web_contents())
+                             : nullptr;
+      if (!panel || panel->extension_id() != extension_id ||
+          panel->contextual_tab() != updated.tab_id ||
+          session->close_state() != TabSession::CloseState::kOpen) {
+        continue;
+      }
+      content::WebContents* contents = session->web_contents();
+      const extensions::Extension* extension =
+          PanelExtension(contents->GetBrowserContext(), extension_id);
+      if (!extension || !service) {
+        continue;
+      }
+      PanelOptions options =
+          service->GetOptions(*extension, panel->contextual_tab());
+      if (!IsEnabled(options)) {
+        Post(kCloseRequested, session->profile_id(), 0, panel->window_id,
+             extension_id, id);
+        continue;
+      }
+      GURL url = PanelURL(*extension, options);
+      if (url != panel->url) {
+        panel->url = url;
+        contents->GetController().LoadURL(url, content::Referrer(),
+                                          ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                          std::string());
+      }
+    }
+    Profile* profile = Profile::FromBrowserContext(context_);
+    uint64_t tab = 0;
+    if (updated.tab_id) {
+      TabSession* session = SessionOf(FindBrowserlessExtensionTab(
+          *updated.tab_id, profile, /*include_incognito=*/true));
+      if (!session) {
+        return;  // Not a registry tab.
+      }
+      tab = session->tab_id();
+    }
+    Post(kOptionsChanged, BridgeProfileId(profile), tab, 0, extension_id);
+  }
+  void OnSidePanelServiceShutdown() override { observation_.Reset(); }
+
+ private:
+  raw_ptr<content::BrowserContext> context_;
+  base::ScopedObservation<SidePanelService, SidePanelService::Observer>
+      observation_{this};
+};
+
+// One watcher per service (OTR contexts share their original's service). An
+// entry outlives its service's shutdown, unobserved, and is reused.
+void Watch(content::BrowserContext* context) {
+  SidePanelService* service = SidePanelService::Get(context);
+  if (!service) {
+    return;
+  }
+  static base::NoDestructor<
+      std::map<SidePanelService*, std::unique_ptr<Watcher>>>
+      watchers;
+  auto& watcher = (*watchers)[service];
+  if (!watcher) {
+    Profile* original =
+        Profile::FromBrowserContext(context)->GetOriginalProfile();
+    watcher = std::make_unique<Watcher>(original);
+  }
+  watcher->Observe(service);
+}
+
+// Resolves a page tab and its extension for the info/open calls.
+ReArcStatus Resolve(uint64_t tab_id,
+                    const char* extension_id,
+                    TabSession** session,
+                    const extensions::Extension** extension,
+                    SidePanelService** service,
+                    int* chromium_tab) {
+  if (auto status = CheckPageTab(tab_id, session)) {
+    return status;
+  }
+  if (!extension_id || !crx_file::id_util::IdIsValid(extension_id)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  content::WebContents* contents = (*session)->web_contents();
+  *extension = PanelExtension(contents->GetBrowserContext(), extension_id);
+  if (!*extension) {
+    return REARC_NOT_FOUND;
+  }
+  *service = SidePanelService::Get(contents->GetBrowserContext());
+  if (!*service) {
+    return REARC_UNSUPPORTED;
+  }
+  *chromium_tab = sessions::SessionTabHelper::IdForTab(contents).id();
+  return REARC_OK;
+}
+
+// The page tabs of a logical window in `profile` (or its OTR profile).
+uint64_t WindowTab(Profile* profile,
+                   bool include_incognito,
+                   int32_t window_id,
+                   bool* found) {
+  *found = false;
+  uint64_t active = 0;
+  auto& registry = TabRegistry::Get();
+  for (uint64_t id : registry.SessionIds()) {
+    TabSession* session = registry.FindSession(id);
+    if (!session || session->close_state() != TabSession::CloseState::kOpen) {
+      continue;
+    }
+    Profile* owner = Profile::FromBrowserContext(
+        session->web_contents()->GetBrowserContext());
+    if (owner != profile &&
+        !(include_incognito && profile->IsSameOrParent(owner))) {
+      continue;
+    }
+    ReArcExtensionTabState state{};
+    if (ReArcTabGetExtensionState(id, &state) != REARC_OK ||
+        state.window_id != window_id) {
+      continue;
+    }
+    *found = true;
+    if (state.active) {
+      active = id;
+    }
+  }
+  return active;
+}
+
+}  // namespace
+
+base::expected<bool, std::string> RequestHostSidePanel(
+    const extensions::Extension& extension,
+    content::BrowserContext* context,
+    std::optional<int> tab_id,
+    std::optional<int> window_id,
+    bool include_incognito,
+    bool open) {
+  CHECK(pthread_main_np());
+  Profile* profile = Profile::FromBrowserContext(context);
+  SidePanelService* service = SidePanelService::Get(context);
+  if (!service) {
+    return base::unexpected("Side panels are unavailable.");
+  }
+  if (tab_id) {
+    TabSession* session = SessionOf(
+        FindBrowserlessExtensionTab(*tab_id, profile, include_incognito));
+    if (!session) {
+      return base::unexpected(extensions::ErrorUtils::FormatErrorMessage(
+          extensions::kTabNotFoundError, base::ToString(*tab_id)));
+    }
+    const int32_t window = LogicalWindow(session->tab_id());
+    if (!host) {
+      return base::unexpected(
+          base::StringPrintf("No browser window for tabId: %d", *tab_id));
+    }
+    if (window_id && *window_id != window) {
+      return base::unexpected(
+          "The specified tab does not belong to the specified window.");
+    }
+    if (open && !IsEnabled(service->GetOptions(extension, *tab_id))) {
+      return base::unexpected(
+          base::StringPrintf("No active side panel for tabId: %d", *tab_id));
+    }
+    if (!open &&
+        !IsEnabled(service->GetSpecificOptionsForTab(extension, *tab_id))) {
+      return base::unexpected(base::StringPrintf(
+          "No active tab-specific side panel for tabId: %d", *tab_id));
+    }
+    Post(open ? kOpenRequested : kCloseRequested, session->profile_id(),
+         session->tab_id(), window, extension.id());
+    return true;
+  }
+  CHECK(window_id);
+  int32_t window = *window_id;
+  if (window == extension_misc::kCurrentWindowId) {
+    // The focused logical window, as tabs.query's currentWindow resolves it.
+    TabSession* current = SessionOf(ActiveExtensionContents(profile));
+    window = current ? LogicalWindow(current->tab_id()) : 0;
+  }
+  bool found = false;
+  const uint64_t active =
+      window > 0 ? WindowTab(profile, include_incognito, window, &found) : 0;
+  if (!found) {
+    return base::unexpected(extensions::ErrorUtils::FormatErrorMessage(
+        extensions::ExtensionTabUtil::kWindowNotFoundError,
+        base::ToString(*window_id)));
+  }
+  if (!host) {
+    return base::unexpected(
+        base::StringPrintf("No browser window for windowId: %d", window));
+  }
+  if (!IsEnabled(service->GetOptions(extension, std::nullopt))) {
+    return base::unexpected(
+        base::StringPrintf("No active side panel for windowId: %d", window));
+  }
+  Post(open ? kOpenRequested : kCloseRequested, BridgeProfileId(profile),
+       active, window, extension.id());
+  return true;
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetSidePanelCallback(ReArcSidePanelCallback cb, void* ctx) {
+  CHECK(pthread_main_np());
+  ++rearc::epoch;
+  rearc::host = cb;
+  rearc::host_context = ctx;
+}
+
+ReArcStatus ReArcTabGetSidePanel(uint64_t tab_id,
+                                 const char* extension_id,
+                                 ReArcSidePanelInfo* info) {
+  CHECK(pthread_main_np());
+  if (info) {
+    *info = {};
+  }
+  rearc::TabSession* session;
+  const extensions::Extension* extension;
+  extensions::SidePanelService* service;
+  int chromium_tab;
+  if (auto status = rearc::Resolve(tab_id, extension_id, &session, &extension,
+                                   &service, &chromium_tab)) {
+    return status;
+  }
+  if (!info) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (!rearc::HasSidePanelPermission(*extension)) {
+    return REARC_OK;
+  }
+  info->available =
+      rearc::IsEnabled(service->GetOptions(*extension, chromium_tab));
+  info->contextual = rearc::IsEnabled(
+      service->GetSpecificOptionsForTab(*extension, chromium_tab));
+  info->open_on_action_click = service->OpenSidePanelOnIconClick(extension->id());
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabOpenSidePanel(uint64_t tab_id,
+                                  const char* extension_id,
+                                  bool* contextual,
+                                  uint64_t* panel_tab_id) {
+  CHECK(pthread_main_np());
+  if (contextual) {
+    *contextual = false;
+  }
+  if (panel_tab_id) {
+    *panel_tab_id = 0;
+  }
+  rearc::TabSession* session;
+  const extensions::Extension* extension;
+  extensions::SidePanelService* service;
+  int chromium_tab;
+  if (auto status = rearc::Resolve(tab_id, extension_id, &session, &extension,
+                                   &service, &chromium_tab)) {
+    return status;
+  }
+  if (!contextual || !panel_tab_id) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  const bool for_tab = rearc::IsEnabled(
+      service->GetSpecificOptionsForTab(*extension, chromium_tab));
+  rearc::PanelOptions options = service->GetOptions(
+      *extension, for_tab ? std::optional<int>(chromium_tab) : std::nullopt);
+  if (!rearc::HasSidePanelPermission(*extension) ||
+      !rearc::IsEnabled(options)) {
+    return REARC_INVALID_STATE;
+  }
+  const GURL url = rearc::PanelURL(*extension, options);
+  Profile* profile =
+      Profile::FromBrowserContext(session->web_contents()->GetBrowserContext());
+  // Spanning-mode extensions run in the original profile, as their popups do.
+  Profile* panel_profile =
+      profile->IsOffTheRecord() &&
+              !extensions::IncognitoInfo::IsSplitMode(extension)
+          ? profile->GetOriginalProfile()
+          : profile;
+  if (!url.is_valid() || !rearc::BridgeProfileId(panel_profile)) {
+    return REARC_INVALID_STATE;
+  }
+  rearc::Watch(panel_profile);
+  content::WebContents::CreateParams params(
+      panel_profile, content::SiteInstance::CreateForURL(panel_profile, url));
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> panel =
+      content::WebContents::Create(params);
+  // Before adoption: helpers attach by view type (no tab identity/history).
+  extensions::SetViewType(panel.get(),
+                          extensions::mojom::ViewType::kExtensionSidePanel);
+  rearc::Panel::CreateForWebContents(
+      panel.get(), extension->id(),
+      for_tab ? std::optional<int>(chromium_tab) : std::nullopt, url);
+  content::WebContents* raw = panel.get();
+  rearc::TabSession::CreateArgs args;
+  args.browser_context = panel_profile;
+  args.space_id = session->space_id();
+  args.order_index = session->order_index();
+  const uint64_t id =
+      rearc::TabRegistry::Get().AdoptSession(args, std::move(panel));
+  rearc::TabEvent event;
+  event.kind = rearc::TabEventKind::kTabCreated;
+  event.tab_id = id;
+  event.space_id = args.space_id;
+  event.opener_tab_id = tab_id;
+  event.disposition = rearc::TabDisposition::kPopup;
+  event.url = url.spec();
+  rearc::EmitTabEvent(std::move(event));
+  if (!rearc::TabRegistry::Get().FindSession(id)) {
+    return REARC_INTERNAL;
+  }
+  rearc::ABIInitializeTab(id);
+  raw->GetController().LoadURL(url, content::Referrer(),
+                               ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                               std::string());
+  *contextual = for_tab;
+  *panel_tab_id = id;
+  return REARC_OK;
+}
+
+ReArcStatus ReArcSidePanelSetShown(uint64_t panel_tab_id,
+                                   uint64_t owner_tab_id,
+                                   bool shown) {
+  CHECK(pthread_main_np());
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(panel_tab_id, &session)) {
+    return status;
+  }
+  rearc::Panel* panel = rearc::Panel::FromWebContents(session->web_contents());
+  if (!panel) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  rearc::TabSession* owner = nullptr;
+  if (owner_tab_id) {
+    if (auto status = rearc::CheckPageTab(owner_tab_id, &owner)) {
+      return status;
+    }
+  } else if (shown) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (shown == panel->shown) {
+    if (shown) {
+      panel->window_id = rearc::LogicalWindow(owner_tab_id);
+    }
+    return REARC_OK;
+  }
+  auto* service =
+      extensions::SidePanelService::Get(session->web_contents()->GetBrowserContext());
+  if (!service) {
+    return REARC_UNSUPPORTED;
+  }
+  panel->shown = shown;
+  if (shown) {
+    panel->window_id = rearc::LogicalWindow(owner_tab_id);
+    service->DispatchOnOpenedEvent(panel->extension_id(), panel->window_id,
+                                   panel->contextual_tab(), panel->url.path());
+  } else {
+    service->DispatchOnClosedEvent(panel->extension_id(), panel->window_id,
+                                   panel->contextual_tab(), panel->url.path());
+  }
+  return REARC_OK;
+}
