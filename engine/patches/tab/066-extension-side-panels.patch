+// Extension side panels (extension_side_panels, ABI 1.47). chrome.sidePanel
+// without Chrome's side panel UI: the host shows a panel beside the page as a
+// hosted registry tab. Options are Chromium's SidePanelService: the manifest's
+// side_panel.default_path, sidePanel.setOptions (global, or per tab with tabId)
+// and setPanelBehavior. tab_id arguments are page tabs (popups, panels and
+// other views: unsupported); extension_id must be enabled for the tab's
+// profile (OTR: incognito-enabled), else not_found. UI thread only.
+// available: enabled with a path for the tab (its own options, else the
+// global ones). contextual: the tab has its own enabled options, so its panel
+// belongs to that tab; a global panel may stay shown across the tabs of a
+// window. open_on_action_click: setPanelBehavior; a toolbar click then
+// returns run result 2. No sidePanel permission: all false.
+typedef struct ReArcSidePanelInfo {
+  bool available, contextual, open_on_action_click;
+} ReArcSidePanelInfo;
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetSidePanel(
+    uint64_t tab_id, const char* extension_id, ReArcSidePanelInfo* info);
+// Creates the panel for tab_id's options: panel_tab_id is a new registry tab
+// (created event disposition 3, opener tab_id, as action popups) loading the
+// panel URL with view type side panel, in the extension's profile (spanning
+// extensions: the original profile). Attach, size and close it like a tab;
+// window.close() in the panel closes it (tab closed reason 1). Not available
+// for the tab: invalid_state. contextual reports the scope it was made for.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabOpenSidePanel(uint64_t tab_id,
+                                                      const char* extension_id,
+                                                      bool* contextual,
+                                                      uint64_t* panel_tab_id);
+// The host showed (shown=true) or hid a panel beside owner_tab_id (the page
+// tab of the window it is shown in; 0 is allowed when hiding). Dispatches
+// sidePanel.onOpened / onClosed once per change, with the owner's logical
+// window (ReArcTabSetExtensionWindow) and, for contextual panels, its tab.
+// Not a panel: invalid_argument.
+REARC_ENGINE_EXPORT ReArcStatus ReArcSidePanelSetShown(uint64_t panel_tab_id,
+                                                       uint64_t owner_tab_id,
+                                                       bool shown);
+// kind: 0 open requested (sidePanel.open with a user gesture; tab_id the
+// bridge tab, 0 for windowId alone; window_id the logical window, 0 if the
+// tab has none), 1 close requested (sidePanel.close for that tab or window,
+// or panel_tab_id was disabled by setOptions; the engine closes nothing), 2
+// options changed (tab_id 0: global): re-check shown panels with
+// ReArcTabGetSidePanel. A shown panel whose path changed has already been
+// navigated. Without a callback sidePanel.open/close fail as if there were no
+// window. Posted on main; extension_id borrowed for the callback.
+typedef struct ReArcSidePanelEvent {
+  uint64_t profile_id, tab_id, panel_tab_id;
+  int32_t window_id;
+  uint32_t kind;
+  const char* extension_id;
+} ReArcSidePanelEvent;
+typedef void (*ReArcSidePanelCallback)(void* context,
+                                       const ReArcSidePanelEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetSidePanelCallback(
+    ReArcSidePanelCallback callback, void* context);
+
 // Local card/address offers (autofill_save_prompts, ABI 1.37).
