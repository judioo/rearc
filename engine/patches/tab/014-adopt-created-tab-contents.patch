+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/tab_adoption.h"
+
+#include <pthread.h>
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "chrome/browser/rearc_bridge/ipc_tab_events.h"
+#include "chrome/browser/rearc_bridge/tab_observer.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace rearc {
+
+content::WebContents* AdoptNewTabContents(
+    uint64_t source_tab_id,
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> contents,
+    WindowOpenDisposition disposition,
+    bool user_gesture,
+    bool* was_blocked) {
+  CHECK(pthread_main_np());
+  if (was_blocked) {
+    *was_blocked = true;
+  }
+  TabSession* parent = TabRegistry::Get().FindSession(source_tab_id);
+  if (!parent || parent->web_contents() != source || !contents ||
+      parent->close_state() != TabSession::CloseState::kOpen ||
+      contents->IsBeingDestroyed() || !user_gesture ||
+      contents->GetBrowserContext() != source->GetBrowserContext()) {
+    VLOG(1) << "rearc: tab adoption rejected (source/context/gesture)";
+    return nullptr;
+  }
+
+  TabDisposition placement;
+  switch (disposition) {
+    case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+      placement = TabDisposition::kForegroundTab;
+      break;
+    case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+      placement = TabDisposition::kBackgroundTab;
+      break;
+    case WindowOpenDisposition::NEW_POPUP:
+      placement = TabDisposition::kPopup;
+      break;
+    default:
+      VLOG(1) << "rearc: tab adoption rejected disposition "
+              << static_cast<int>(disposition);
+      return nullptr;
+  }
+
+  TabSession::CreateArgs args;
+  args.browser_context = source->GetBrowserContext();
+  args.space_id = parent->space_id();
+  // Placement/order is a shell decision; do not overflow an adjacent index.
+  args.order_index = parent->order_index();
+  const bool has_opener = contents->GetOpener() != nullptr;
+  auto weak_contents = contents->GetWeakPtr();
+  const uint64_t tab_id =
+      TabRegistry::Get().AdoptSession(args, std::move(contents));
+  if (was_blocked) {
+    *was_blocked = false;
+  }
+
+  TabEvent event;
+  event.kind = TabEventKind::kTabCreated;
+  event.tab_id = tab_id;
+  event.space_id = args.space_id;
+  event.opener_tab_id = has_opener ? source_tab_id : 0;
+  event.disposition = placement;
+  event.url = weak_contents->GetVisibleURL().spec();
+  // As in S3, profile_id remains internal scaffolding until transport stamps
+  // the real profile ID. Never expose this event directly on the wire yet.
+  EmitTabEvent(std::move(event));
+  // A sink can synchronously request destruction; never attach after removal.
+  if (TabRegistry::Get().FindSession(tab_id)) {
+    AttachTabObserver(tab_id);
+    EmitInitialSnapshotEvent(tab_id);
+  }
+  return weak_contents.get();
+}
+
+}  // namespace rearc
