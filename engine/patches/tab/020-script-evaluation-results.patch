+          if (const auto* value = remote->Find("value")) {
+            auto json = base::WriteJson(*value);
+            if (json && json->size() <= REARC_MAX_BLOB_BYTES) {
+              self->FinishEvaluation(REARC_OK, std::move(*json), {}, {});
