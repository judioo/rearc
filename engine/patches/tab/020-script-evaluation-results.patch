+// Evaluate an expression in the current primary document; awaits Promises.
+// world: 0 isolated rearc.boost.<boost_id> (null => editor), 1 main world
+// (boost_id must be null). IDs follow ReArcScript.id rules. No user activation.
+// timeout_ms: 1..30000, includes context lookup; <=1 MiB UTF-8 source.
+// One evaluation per tab. Navigation/close cancels; timeout ends observation,
+// not JS side effects. Successful JSON (undefined => null) and error JSON are
+// borrowed for callback duration; copy immediately, never BufferFree them.
+// Errors: status plus {code,message,details?}; success has null error_json.
+// Unsupported on file/WebUI. Completion always carries the captured generation.
+typedef void (*ReArcScriptCallback)(void* context,
+                                    ReArcStatus status,
+                                    uint64_t tab_id,
+                                    uint64_t content_generation,
+                                    const char* json,
+                                    const char* error_json);
+REARC_ENGINE_EXPORT ReArcStatus
+ReArcTabEvaluateScript(uint64_t tab_id,
+                        const char* source,
+                        uint32_t world,
+                        const char* boost_id,
+                        uint32_t timeout_ms,
+                        ReArcScriptCallback completion,
+                        void* context);
+
