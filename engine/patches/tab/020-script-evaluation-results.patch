+    Send("Runtime.evaluate", std::move(params), base::BindOnce(
+        [](base::WeakPtr<PageServices> self, uint64_t request,
+           ReArcStatus status, base::DictValue result) {
+          if (!self || !self->EvaluationCurrent(request)) return;
+          if (status) {
+            self->FinishEvaluation(status, {}, "protocol", "Evaluation protocol failure", std::move(result));
+            return;
+          }
+          if (auto* exception = result.FindDict("exceptionDetails")) {
+            self->FinishEvaluation(REARC_SCRIPT_ERROR, {}, "exception", "JavaScript exception", exception->Clone());
+            return;
+          }
+          const auto* remote = result.FindDict("result");
+          if (!remote) {
+            self->FinishEvaluation(REARC_INTERNAL, {}, "protocol", "Missing evaluation result");
+            return;
