@@ -0,0 +1,304 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Wave 18b downloads: Chromium's DownloadManager (via AllDownloadItemNotifier)
+// is the source of truth; the bridge maps item state transitions to events
+// and forwards actions to DownloadItem / ChromeDownloadManagerDelegate.
+
+#include <pthread.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/download/download_prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_abi.h"
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "chrome/common/pref_names.h"
+#include "components/download/content/public/all_download_item_notifier.h"
+#include "components/download/public/common/download_item.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/download_item_utils.h"
+#include "content/public/browser/download_manager.h"
+
+namespace rearc {
+namespace {
+
+ReArcDownloadCallback download_callback = nullptr;
+void* download_context = nullptr;
+
+enum Kind : uint32_t {
+  kCreated = 0,
+  kUpdated = 1,
+  kCompleted = 2,
+  kInterrupted = 3,
+  kCancelled = 4,
+  kRemoved = 5,
+};
+
+struct Snapshot {
+  uint32_t kind;
+  uint64_t profile_id, tab_id;
+  uint32_t download_id;
+  std::string guid, url, target_path, mime_type;
+  int64_t received_bytes, total_bytes;
+  uint32_t state, danger_type, interrupt_reason;
+  bool paused, can_resume;
+};
+
+uint64_t TabIdFor(download::DownloadItem* item) {
+  content::WebContents* contents =
+      content::DownloadItemUtils::GetWebContents(item);
+  if (!contents) {
+    return 0;
+  }
+  auto& registry = TabRegistry::Get();
+  for (uint64_t id : registry.SessionIds()) {
+    TabSession* session = registry.FindSession(id);
+    if (session && session->web_contents() == contents) {
+      return id;
+    }
+  }
+  return 0;
+}
+
+void Publish(uint32_t kind, uint64_t profile_id, download::DownloadItem* item) {
+  Snapshot s{kind, profile_id, TabIdFor(item), item->GetId(),
+             item->GetGuid(), item->GetURL().spec(),
+             item->GetTargetFilePath().value(), item->GetMimeType(),
+             item->GetReceivedBytes(), item->GetTotalBytes(),
+             static_cast<uint32_t>(item->GetState()),
+             static_cast<uint32_t>(item->GetDangerType()),
+             static_cast<uint32_t>(item->GetLastReason()), item->IsPaused(),
+             item->CanResume()};
+  ABIPost(base::BindOnce(
+      [](Snapshot s) {
+        CHECK(pthread_main_np());
+        if (!download_callback) {
+          return;
+        }
+        ReArcDownloadEvent e{};
+        e.kind = s.kind;
+        e.profile_id = s.profile_id;
+        e.download_id = s.download_id;
+        e.tab_id = s.tab_id;
+        e.guid = s.guid.c_str();
+        e.url = s.url.c_str();
+        e.target_path = s.target_path.c_str();
+        e.mime_type = s.mime_type.c_str();
+        e.received_bytes = s.received_bytes;
+        e.total_bytes = s.total_bytes;
+        e.state = s.state;
+        e.danger_type = s.danger_type;
+        e.interrupt_reason = s.interrupt_reason;
+        e.paused = s.paused;
+        e.can_resume = s.can_resume;
+        download_callback(download_context, &e);
+      },
+      std::move(s)));
+}
+
+class ProfileDownloads : public download::AllDownloadItemNotifier::Observer {
+ public:
+  ProfileDownloads(Profile* profile, uint64_t profile_id)
+      : profile_id_(profile_id), notifier_(profile->GetDownloadManager(), this) {}
+
+  content::DownloadManager* manager() const { return notifier_.GetManager(); }
+
+  // download::AllDownloadItemNotifier::Observer:
+  void OnDownloadCreated(content::DownloadManager*,
+                         download::DownloadItem* item) override {
+    if (item->IsTransient()) {
+      return;
+    }
+    states_[item->GetId()] = item->GetState();
+    Publish(kCreated, profile_id_, item);
+  }
+  void OnDownloadUpdated(content::DownloadManager*,
+                         download::DownloadItem* item) override {
+    auto it = states_.find(item->GetId());
+    if (it == states_.end()) {
+      return;
+    }
+    const auto state = item->GetState();
+    uint32_t kind = kUpdated;
+    if (state != it->second) {
+      switch (state) {
+        case download::DownloadItem::COMPLETE:
+          kind = kCompleted;
+          break;
+        case download::DownloadItem::CANCELLED:
+          kind = kCancelled;
+          break;
+        case download::DownloadItem::INTERRUPTED:
+          kind = kInterrupted;
+          break;
+        default:
+          break;
+      }
+      it->second = state;
+    }
+    Publish(kind, profile_id_, item);
+  }
+  void OnDownloadRemoved(content::DownloadManager*,
+                         download::DownloadItem* item) override {
+    if (states_.erase(item->GetId())) {
+      Publish(kRemoved, profile_id_, item);
+    }
+  }
+  void OnDownloadDestroyed(content::DownloadManager*,
+                           download::DownloadItem* item) override {
+    states_.erase(item->GetId());
+  }
+
+  // Null when unknown, transient or already removed.
+  download::DownloadItem* Find(uint32_t id) {
+    if (!states_.contains(id) || !manager()) {
+      return nullptr;
+    }
+    return manager()->GetDownload(id);
+  }
+
+ private:
+  const uint64_t profile_id_;
+  std::map<uint32_t, download::DownloadItem::DownloadState> states_;
+  download::AllDownloadItemNotifier notifier_;
+};
+
+auto& Downloads() {
+  static base::NoDestructor<std::map<uint64_t, std::unique_ptr<ProfileDownloads>>>
+      downloads;
+  return *downloads;
+}
+
+ReArcStatus Available() {
+  // Any accepted tab call implies a ready, non-stopping engine.
+  return ReArcEngineDefaultProfile() ? REARC_OK : REARC_ENGINE_NOT_READY;
+}
+
+}  // namespace
+
+void ABIAttachDownloads(Profile* profile, uint64_t profile_id) {
+  CHECK(pthread_main_np());
+  Downloads()[profile_id] = std::make_unique<ProfileDownloads>(profile, profile_id);
+}
+void ABIDetachDownloads(uint64_t profile_id) {
+  CHECK(pthread_main_np());
+  Downloads().erase(profile_id);
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetDownloadCallback(ReArcDownloadCallback callback,
+                                    void* context) {
+  CHECK(pthread_main_np());
+  rearc::download_callback = callback;
+  rearc::download_context = context;
+}
+ReArcStatus ReArcDownloadSetPolicy(uint64_t profile_id,
+                                   const char* directory,
+                                   uint32_t prompt) {
+  CHECK(pthread_main_np());
+  if (auto status = rearc::Available()) {
+    return status;
+  }
+  Profile* profile = rearc::FindBridgeProfile(profile_id);
+  if (!profile) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  if (prompt > 1) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  base::FilePath path;
+  if (directory) {
+    const std::string value(directory);
+    path = base::FilePath(value);
+    if (value.empty() || value.size() > 4096 || !base::IsStringUTF8(value) ||
+        !path.IsAbsolute() || path.ReferencesParent()) {
+      return REARC_INVALID_ARGUMENT;
+    }
+  }
+  // Chromium's file picker is the later file-chooser concern.
+  if (prompt == 1) {
+    return REARC_UNSUPPORTED;
+  }
+  DownloadPrefs* prefs = DownloadPrefs::FromBrowserContext(profile);
+  if (!prefs) {
+    return REARC_INTERNAL;
+  }
+  if (directory) {
+    // Chromium creates a missing directory on first use; unwritable targets
+    // cancel rather than prompting in embedded mode.
+    prefs->SetDownloadPath(path);
+  }
+  profile->GetPrefs()->SetBoolean(prefs::kPromptForDownload, false);
+  return REARC_OK;
+}
+ReArcStatus ReArcDownloadAction(uint64_t profile_id,
+                                uint32_t download_id,
+                                uint32_t action) {
+  CHECK(pthread_main_np());
+  if (auto status = rearc::Available()) {
+    return status;
+  }
+  auto it = rearc::Downloads().find(profile_id);
+  if (it == rearc::Downloads().end()) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  if (action > 5) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  download::DownloadItem* item = it->second->Find(download_id);
+  if (!item) {
+    return REARC_NOT_FOUND;
+  }
+  const auto state = item->GetState();
+  switch (action) {
+    case 0:  // pause
+      if (state != download::DownloadItem::IN_PROGRESS || item->IsPaused()) {
+        return REARC_INVALID_STATE;
+      }
+      item->Pause();
+      return REARC_OK;
+    case 1:  // resume
+      if (!item->CanResume()) {
+        return REARC_INVALID_STATE;
+      }
+      item->Resume(/*user_resume=*/true);
+      return REARC_OK;
+    case 2:  // cancel
+      if (item->IsDone()) {
+        return REARC_INVALID_STATE;
+      }
+      item->Cancel(/*user_cancel=*/true);
+      return REARC_OK;
+    case 3:  // open with the platform handler (embedded mode)
+      if (state != download::DownloadItem::COMPLETE ||
+          !item->CanOpenDownload()) {
+        return REARC_INVALID_STATE;
+      }
+      item->OpenDownload();
+      return REARC_OK;
+    case 4:  // reveal in Finder
+      if (item->GetTargetFilePath().empty()) {
+        return REARC_INVALID_STATE;
+      }
+      item->ShowDownloadInShell();
+      return REARC_OK;
+    case 5:  // remove from Chromium's list/history (cancels if in progress)
+      item->Remove();
+      return REARC_OK;
+  }
+  return REARC_INVALID_ARGUMENT;
+}
