+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 17, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // changes bits: URL=1, title=2, loading=4, progress=8, crashed=16,
@@ -396,6 +396,51 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcTabFindNext(uint64_t tab_id, bool forward);
 REARC_ENGINE_EXPORT ReArcStatus ReArcTabFindStop(uint64_t tab_id,
                                                  uint32_t action);
 
+// Downloads (downloads, ABI 1.17). Chromium's DownloadManager stays the source
+// of truth (history, chrome://downloads, safety checks). Events cover every
+// non-transient item of each live bridge profile, including items restored
+// from history at profile load (kind 0 with their current state).
+// kind: 0 created, 1 updated, 2 completed, 3 interrupted, 4 cancelled,
+// 5 removed. state: 0 in_progress, 1 complete, 2 cancelled, 3 interrupted.
+// download_id is Chromium's per-profile item ID; tab_id is the initiating live
+// bridge tab or 0. total_bytes 0 means unknown. danger_type and
+// interrupt_reason are Chromium's download::DownloadDangerType and
+// DownloadInterruptReason values (0 = none). target_path is empty until
+// Chromium determines it.
+typedef struct ReArcDownloadEvent {
+  uint32_t kind;
+  uint64_t profile_id;
+  uint32_t download_id;
+  uint64_t tab_id;
+  const char* guid;
+  const char* url;
+  const char* target_path;
+  const char* mime_type;
+  int64_t received_bytes, total_bytes;
+  uint32_t state, danger_type, interrupt_reason;
+  bool paused, can_resume;
+} ReArcDownloadEvent;
+typedef void (*ReArcDownloadCallback)(void* context,
+                                      const ReArcDownloadEvent* event);
+// Null disables delivery, including already queued events.
+REARC_ENGINE_EXPORT void ReArcEngineSetDownloadCallback(
+    ReArcDownloadCallback callback, void* context);
+// directory: absolute UTF-8 path without '..' (null keeps Chromium's current
+// default); persisted in the profile's Chromium download prefs. prompt: 0 save
+// without asking (the only mode in 1.17); 1 Chromium's location picker is
+// unsupported until the file chooser ABI. Embedded mode never shows Chromium's
+// picker or opens a Chrome window: confirmations Chromium would ask for are
+// accepted at the suggested path (preference/save-as) or cancelled.
+REARC_ENGINE_EXPORT ReArcStatus ReArcDownloadSetPolicy(uint64_t profile_id,
+                                                       const char* directory,
+                                                       uint32_t prompt);
+// action: 0 pause, 1 resume, 2 cancel, 3 open (platform handler), 4 reveal in
+// Finder, 5 remove from Chromium's list (cancels an active item). Unknown or
+// removed item: not_found; action not valid in the item's state: invalid_state.
+REARC_ENGINE_EXPORT ReArcStatus ReArcDownloadAction(uint64_t profile_id,
+                                                    uint32_t download_id,
+                                                    uint32_t action);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
