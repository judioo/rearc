+// Media session actions (pip_embedded, ABI 1.43): the tab's current
+// Chromium media-session actions as REARC_MEDIA_ACTION_* bits; 0 without a
+// session. A media service event follows every change of these bits.
+enum {
+  REARC_MEDIA_ACTION_PLAY = 1u << 0,
+  REARC_MEDIA_ACTION_PAUSE = 1u << 1,
+  REARC_MEDIA_ACTION_PREVIOUS_TRACK = 1u << 2,
+  REARC_MEDIA_ACTION_NEXT_TRACK = 1u << 3,
+  REARC_MEDIA_ACTION_SEEK = 1u << 4,
+  REARC_MEDIA_ACTION_PICTURE_IN_PICTURE = 1u << 5,
+  REARC_MEDIA_ACTION_SKIP_AD = 1u << 6
+};
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetMediaActions(uint64_t tab_id,
+                                                        uint32_t* actions);
+// Embedded video Picture-in-Picture (pip_embedded, ABI 1.43). With a callback
+// set, a registry tab's video PiP (page request or ReArcTabSetPictureInPicture)
+// renders into an engine-owned layer-backed NSView handed to the host instead
+// of Chromium's floating window; without one, tab/048's window is used. The
+// video keeps its native frame rate while its tab is hidden, and only while
+// the view is in a visible window. One overlay exists per tab's controller;
+// Chromium keeps one PiP session process-wide.
+// kind: 0 created (view is +1; release with ReArcViewRelease after closed),
+// 1 shown (session started), 2 hidden (session ended; the view stays valid
+// for a later shown), 3 closed (overlay destroyed; never another event),
+// 4 natural size (width/height, video pixels), 5 state (playback 0 playing,
+// 1 paused, 2 ended; buttons; muted), 6 position (seconds; duration < 0 for
+// live; rate 0 paused), 7 source title (borrowed), 8 first CALayer tree
+// update after shown.
+// The host places the view and reports its screen rect with SetBounds; the
+// renderer sizes the video to it. Events arrive on the main thread.
+enum {
+  REARC_VIDEO_OVERLAY_BUTTON_PLAY_PAUSE = 1u << 0,
+  REARC_VIDEO_OVERLAY_BUTTON_NEXT_TRACK = 1u << 1,
+  REARC_VIDEO_OVERLAY_BUTTON_PREVIOUS_TRACK = 1u << 2,
+  REARC_VIDEO_OVERLAY_BUTTON_SKIP_AD = 1u << 3,
+  REARC_VIDEO_OVERLAY_BUTTON_MICROPHONE = 1u << 4,
+  REARC_VIDEO_OVERLAY_BUTTON_CAMERA = 1u << 5,
+  REARC_VIDEO_OVERLAY_BUTTON_HANG_UP = 1u << 6
+};
+typedef struct ReArcVideoOverlayEvent {
+  uint64_t profile_id, tab_id, content_generation, overlay_id;
+  uint32_t kind;
+  void* view;
+  double width, height;
+  uint32_t playback, buttons;
+  bool muted, microphone_muted, camera_on;
+  double duration, position, rate;
+  const char* title;
+} ReArcVideoOverlayEvent;
+typedef void (*ReArcVideoOverlayCallback)(void* context,
+                                          const ReArcVideoOverlayEvent* event);
+// Replacing or clearing the callback ends a shown session first.
+REARC_ENGINE_EXPORT void ReArcEngineSetVideoOverlayCallback(
+    ReArcVideoOverlayCallback callback, void* context);
+// action: 0 toggle play/pause, 1 next track, 2 previous track, 3 skip ad,
+// 4 toggle microphone, 5 toggle camera, 6 hang up, 7 back to tab (ends the
+// session; PiP phase 2 follows), 8 close, 9 close and pause, 10 play,
+// 11 pause, 12 mute, 13 unmute. Unknown overlay: not_found; not shown:
+// invalid_state.
+REARC_ENGINE_EXPORT ReArcStatus ReArcVideoOverlayAction(uint64_t overlay_id,
+                                                        uint32_t action);
+REARC_ENGINE_EXPORT ReArcStatus ReArcVideoOverlaySeek(uint64_t overlay_id,
+                                                      double seconds);
+// The view's rect in screen points (y down from the primary display's top).
+REARC_ENGINE_EXPORT ReArcStatus ReArcVideoOverlaySetBounds(uint64_t overlay_id,
+                                                           double x,
+                                                           double y,
+                                                           double width,
+                                                           double height);
+// Reads back the centre pixel of the view's composited output (the video
+// as the view shows it; tests, diagnostics). The callback runs once on the
+// main thread: OK with 0xRRGGBBAA, invalid_state when the session ends or the
+// view is not drawing, timeout after 5 s. Not shown: invalid_state, no call.
+typedef void (*ReArcVideoOverlayPixelCallback)(void* context,
+                                               ReArcStatus status,
+                                               uint32_t rgba);
+REARC_ENGINE_EXPORT ReArcStatus ReArcVideoOverlayReadPixel(
+    uint64_t overlay_id, ReArcVideoOverlayPixelCallback callback, void* context);
 // Output is +1 malloc PNG, free with ReArcBufferFree. Bound to tab/profile.
 REARC_ENGINE_EXPORT ReArcStatus ReArcFaviconGet(uint64_t tab_id,
                                                 const char* icon_ref,
