 #include <pthread.h>
 
@@ -89,11 +90,39 @@ class MediaAdapter : public content::WebContentsObserver,
   void MediaSessionActionsChanged(
       const std::vector<MediaSessionAction>& actions) override {
     const bool pip = CanEnterPictureInPicture();
+    const uint32_t bits = ActionBits();
     actions_ = actions;
-    if (pip != CanEnterPictureInPicture()) {
+    // Hosts read the bits with ReArcTabGetMediaActions (wave 32) on the
+    // event that follows a change.
+    if (pip != CanEnterPictureInPicture() || bits != ActionBits()) {
       Publish();
     }
   }
+  uint32_t ActionBits() const {
+    if (!controllable_) return 0;
+    uint32_t bits = 0;
+    for (auto action : actions_) {
+      switch (action) {
+        case MediaSessionAction::kPlay: bits |= REARC_MEDIA_ACTION_PLAY; break;
+        case MediaSessionAction::kPause: bits |= REARC_MEDIA_ACTION_PAUSE; break;
+        case MediaSessionAction::kPreviousTrack:
+          bits |= REARC_MEDIA_ACTION_PREVIOUS_TRACK;
+          break;
+        case MediaSessionAction::kNextTrack:
+          bits |= REARC_MEDIA_ACTION_NEXT_TRACK;
+          break;
+        case MediaSessionAction::kSeekTo:
+          bits |= REARC_MEDIA_ACTION_SEEK;
+          break;
+        case MediaSessionAction::kEnterPictureInPicture:
+          bits |= REARC_MEDIA_ACTION_PICTURE_IN_PICTURE;
+          break;
+        case MediaSessionAction::kSkipAd: bits |= REARC_MEDIA_ACTION_SKIP_AD; break;
+        default: break;
+      }
+    }
+    return bits;
+  }
   bool CanEnterPictureInPicture() const {
     return std::find(actions_.begin(), actions_.end(),
                      MediaSessionAction::kEnterPictureInPicture) !=
@@ -244,6 +273,14 @@ MediaCommandResult MediaSetPlayback(uint64_t tab_id,
                  : MediaCommandResult::kInvalidState;
 }
 
+uint32_t MediaActionBits(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  auto* adapter =
+      session ? MediaAdapter::FromWebContents(session->web_contents()) : nullptr;
+  return adapter ? adapter->ActionBits() : 0;
+}
+
 bool MediaCanEnterPictureInPicture(uint64_t tab_id) {
   CHECK(pthread_main_np());
   auto* session = TabRegistry::Get().FindSession(tab_id);
