+void ReArcEngineSetVideoOverlayCallback(ReArcVideoOverlayCallback callback,
+                                        void* context) {
+  CHECK(pthread_main_np());
+  // The replaced host can no longer show the video it was handed.
+  for (auto& [id, overlay] : rearc::Overlays()) {
+    if (overlay->shown()) {
+      rearc::ExitHostPictureInPicture();
+      break;
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+}
+
+ReArcStatus ReArcVideoOverlayAction(uint64_t overlay_id, uint32_t action) {
+  CHECK(pthread_main_np());
+  auto it = rearc::Overlays().find(overlay_id);
+  return it == rearc::Overlays().end() ? REARC_NOT_FOUND
+                                       : it->second->Action(action);
+}
+
+ReArcStatus ReArcVideoOverlaySeek(uint64_t overlay_id, double seconds) {
+  CHECK(pthread_main_np());
+  auto it = rearc::Overlays().find(overlay_id);
+  return it == rearc::Overlays().end() ? REARC_NOT_FOUND
+                                       : it->second->Seek(seconds);
+}
+
+ReArcStatus ReArcVideoOverlaySetBounds(uint64_t overlay_id,
+                                       double x,
+                                       double y,
+                                       double width,
+                                       double height) {
+  CHECK(pthread_main_np());
+  auto it = rearc::Overlays().find(overlay_id);
+  if (it == rearc::Overlays().end()) return REARC_NOT_FOUND;
+  if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(width) ||
+      !std::isfinite(height) || width < 1 || height < 1 || width > 16384 ||
+      height > 16384) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  it->second->SetScreenBounds(
+      gfx::Rect(std::round(x), std::round(y), std::round(width),
+                std::round(height)),
+      true);
+  return REARC_OK;
+}
+
+ReArcStatus ReArcVideoOverlayReadPixel(uint64_t overlay_id,
+                                      ReArcVideoOverlayPixelCallback callback,
+                                      void* context) {
+  CHECK(pthread_main_np());
+  if (!callback) return REARC_INVALID_ARGUMENT;
+  auto it = rearc::Overlays().find(overlay_id);
+  if (it == rearc::Overlays().end()) return REARC_NOT_FOUND;
+  return it->second->ReadPixel(callback, context);
+}
