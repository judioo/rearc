+    UnregisterVideoSink();
+    [view_ clearOwner];
+    compositor_->widget()->ResetNSView();
+    compositor_->compositor()->SetRootLayer(nullptr);
+    compositor_.reset();
+    tree_.reset();
+    video_.reset();
+    root_.reset();
+    ReArcVideoOverlayEvent closed = base_;
+    closed.kind = 3;
+    Emit(closed);
