+class HostVideoOverlay : public content::VideoOverlayWindow,
+                         public ui::AcceleratedWidgetMacNSView {
+ public:
+  HostVideoOverlay(content::VideoPictureInPictureWindowController* controller,
+                   const ReArcPictureInPictureEvent& ids)
+      : controller_(controller), id_(next_overlay_id++) {
+    base_ = {ids.profile_id, ids.tab_id, ids.content_generation, id_};
+    view_ = [[ReArcVideoOverlayView alloc] initWithOwner:this];
+    CALayer* background = [CALayer layer];
+    background.backgroundColor = [[NSColor blackColor] CGColor];
+    tree_ = std::make_unique<ui::DisplayCALayerTree>(background);
+    [view_ setLayer:background];
+    [view_ setWantsLayer:YES];
+
+    compositor_ = std::make_unique<ui::RecyclableCompositorMac>(
+        content::GetContextFactory());
+    root_ = std::make_unique<ui::LayerSolidColor>();
+    root_->SetName("ReArcVideoOverlay:Root");
+    root_->SetColor(SkColors::kBlack);
+    video_ = std::make_unique<ui::LayerSurface>();
+    video_->SetName("ReArcVideoOverlay:Video");
+    video_->SetFallbackBackgroundColor(SkColors::kBlack);
+    root_->Add(video_.get());
+    compositor_->compositor()->SetRootLayer(root_.get());
+    compositor_->compositor()->SetBackgroundColor(SK_ColorBLACK);
+    compositor_->widget()->SetNSView(this);
+    Overlays()[id_] = this;
+
+    ReArcVideoOverlayEvent created = base_;
+    created.kind = 0;
+    Emit(created, /*with_view=*/true);
+  }
