+  // The view moved, resized, changed scale or visibility.
+  void UpdateGeometry() {
+    NSWindow* window = [view_ window];
+    const NSSize size = [view_ bounds].size;
+    // Window visibility is not required: a host may order its window in after
+    // parenting the view, which no view notification reports. Hosts take the
+    // view out of windows they hide.
+    const bool drawing = shown_ && window &&
+                         ![view_ isHiddenOrHasHiddenAncestor] &&
+                         size.width >= 1 && size.height >= 1;
+    if (!drawing) {
+      if (!suspended_) {
+        compositor_->compositor()->SetVisible(false);
+        compositor_->Suspend();
+        suspended_ = true;
+      }
+      return;
+    }
+    const float scale = [window backingScaleFactor];
+    const display::Display display =
+        display::Screen::Get()->GetDisplayNearestView(gfx::NativeView(view_));
+    const gfx::Size dip(std::round(size.width), std::round(size.height));
+    compositor_->UpdateSurface(
+        gfx::ToRoundedSize(gfx::ConvertSizeToPixels(dip, scale)), scale,
+        display.GetColorSpaces(), display.id(), display.display_frequency());
+    root_->SetBounds(gfx::Rect(dip));
+    LayoutVideo();
+    if (suspended_) {
+      compositor_->compositor()->SetVisible(true);
+      compositor_->Unsuspend();
+      suspended_ = false;
+    }
+    // Hosts that do not report bounds still get a usable size.
+    if (!host_bounds_) {
+      NSRect screen =
+          [window convertRectToScreen:[view_ convertRect:[view_ bounds]
+                                                  toView:nil]];
+      SetScreenBounds(gfx::ScreenRectFromNSRect(screen), false);
+    }
+  }
+
+  void SetScreenBounds(const gfx::Rect& bounds, bool from_host) {
+    host_bounds_ = host_bounds_ || from_host;
+    if (bounds.IsEmpty() || bounds == bounds_) return;
+    bounds_ = bounds;
+    // Sizes the renderer's PiP video to the view (only while shown).
+    controller_->UpdateLayerBounds();
+  }
+
+  ReArcStatus Action(uint32_t action) {
+    if (action > 13) return REARC_INVALID_ARGUMENT;
+    if (!shown_) return REARC_INVALID_STATE;
+    using UiBehavior = PictureInPictureWindowManager::UiBehavior;
+    auto* manager = PictureInPictureWindowManager::GetInstance();
+    switch (action) {
+      case 0: controller_->TogglePlayPause(); break;
+      case 1: controller_->NextTrack(); break;
+      case 2: controller_->PreviousTrack(); break;
+      case 3: controller_->SkipAd(); break;
+      case 4: controller_->ToggleMicrophone(); break;
+      case 5: controller_->ToggleCamera(); break;
+      case 6: controller_->HangUp(); break;
+      case 7:
+        if (!manager->ExitPictureInPictureViaWindowUi(
+                UiBehavior::kCloseWindowAndFocusOpener)) {
+          controller_->CloseAndFocusInitiator();
+        }
+        break;
+      case 8:
+      case 9: {
+        const bool pause = action == 9;
+        if (!manager->ExitPictureInPictureViaWindowUi(
+                pause ? UiBehavior::kCloseWindowAndPauseVideo
+                      : UiBehavior::kCloseWindowOnly)) {
+          controller_->Close(pause);
+        }
+        break;
+      }
+      case 10: controller_->Play(); break;
+      case 11: controller_->Pause(); break;
+      case 12:
+      case 13: controller_->RequestMute(action == 12); break;
+    }
+    return REARC_OK;
+  }
+
+  ReArcStatus Seek(double seconds) {
+    if (!shown_) return REARC_INVALID_STATE;
+    if (!std::isfinite(seconds) || seconds < 0) return REARC_INVALID_ARGUMENT;
+    controller_->SeekTo(base::Seconds(seconds));
+    return REARC_OK;
+  }
+
+  bool shown() const { return shown_; }
+
+  // A copy of the composited view: what it shows, embedded video included.
+  ReArcStatus ReadPixel(ReArcVideoOverlayPixelCallback callback,
+                        void* context) {
+    if (!shown_ || suspended_) return REARC_INVALID_STATE;
+    struct Pending {
+      ReArcVideoOverlayPixelCallback callback;
+      uintptr_t context;  // The host's, passed back untouched.
+      bool done = false;
+      void Finish(ReArcStatus status, uint32_t rgba) {
+        if (done) return;
+        done = true;
+        callback(reinterpret_cast<void*>(context), status, rgba);
+      }
+    };
+    auto pending = base::MakeRefCounted<base::RefCountedData<Pending>>(
+        Pending{callback, reinterpret_cast<uintptr_t>(context)});
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(
+            [](scoped_refptr<base::RefCountedData<Pending>> pending,
+               std::unique_ptr<viz::CopyOutputResult> result) {
+              if (!result || result->IsEmpty()) {
+                pending->data.Finish(REARC_INVALID_STATE, 0);
+                return;
+              }
+              auto access = result->ScopedAccessSkBitmap();
+              const SkBitmap& bitmap = access.bitmap();
+              if (bitmap.drawsNothing()) {
+                pending->data.Finish(REARC_INVALID_STATE, 0);
+                return;
+              }
+              const SkColor c =
+                  bitmap.getColor(bitmap.width() / 2, bitmap.height() / 2);
+              pending->data.Finish(
+                  REARC_OK, (uint32_t(SkColorGetR(c)) << 24) |
+                                (uint32_t(SkColorGetG(c)) << 16) |
+                                (uint32_t(SkColorGetB(c)) << 8) |
+                                SkColorGetA(c));
+            },
+            pending));
+    request->set_result_task_runner(
+        base::SingleThreadTaskRunner::GetCurrentDefault());
+    root_->RequestCopyOfOutput(std::move(request));
+    compositor_->compositor()->ScheduleFullRedraw();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](scoped_refptr<base::RefCountedData<Pending>> pending) {
+              pending->data.Finish(REARC_TIMEOUT, 0);
+            },
+            pending),
+        base::Seconds(5));
+    return REARC_OK;
+  }
+
+ private:
+  void SetButton(uint32_t bit, bool visible) {
+    state_.buttons = visible ? state_.buttons | bit : state_.buttons & ~bit;
+    StateChanged();
+  }
+  // One state event per task, however many setters ran in it.
+  void StateChanged() {
+    if (state_pending_) return;
+    state_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&HostVideoOverlay::FlushState,
+                                  weak_.GetWeakPtr()));
+  }
+  void FlushState() {
+    state_pending_ = false;
+    // Chromium re-sends the same state on most media session updates.
+    if (emitted_state_ && *emitted_state_ == state_) return;
+    emitted_state_ = state_;
+    ReArcVideoOverlayEvent event = base_;
+    event.kind = 5;
+    event.playback = state_.playback;
+    event.buttons = state_.buttons;
+    event.muted = state_.muted;
+    event.microphone_muted = state_.microphone_muted;
+    event.camera_on = state_.camera_on;
+    Emit(event);
+  }
+  // Aspect-fit inside the view, letterboxed in black.
+  void LayoutVideo() {
+    const gfx::Size area = root_->bounds().size();
+    gfx::Rect rect(area);
+    if (!natural_size_.IsEmpty() && !area.IsEmpty()) {
+      const double aspect =
+          double(natural_size_.width()) / natural_size_.height();
+      const double width = std::min<double>(area.width(), area.height() * aspect);
+      const double height = width / aspect;
+      rect = gfx::Rect(std::round((area.width() - width) / 2),
+                       std::round((area.height() - height) / 2),
+                       std::round(width), std::round(height));
+    }
+    video_->SetBounds(rect);
+    if (surface_id_.is_valid()) {
+      video_->SetSurfaceSize(rect.size());
+    }
+  }
+  void UnregisterVideoSink() {
+    if (registered_sink_.is_valid() && compositor_) {
+      compositor_->compositor()->RemoveChildFrameSink(registered_sink_);
+    }
+    registered_sink_ = viz::FrameSinkId();
+  }
+  void Emit(ReArcVideoOverlayEvent event,
+            bool with_view = false,
+            std::string title = std::string()) {
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, ReArcVideoOverlayEvent event,
+           ReArcVideoOverlayView* view, std::string title) {
+          if (!host || expected != epoch) return;
+          if (view) {
+            event.view = const_cast<void*>(CFBridgingRetain(view));
+          }
+          event.title = title.c_str();
+          host(host_context, &event);
+        },
+        epoch, event, with_view ? view_ : nil, std::move(title)));
+  }
+
+  struct State {
+    uint32_t playback = 0, buttons = 0;
+    bool muted = false, microphone_muted = false, camera_on = false;
+    bool operator==(const State&) const = default;
+  };
+
+  const raw_ptr<content::VideoPictureInPictureWindowController> controller_;
+  const uint64_t id_;
+  ReArcVideoOverlayEvent base_{};
+  ReArcVideoOverlayView* __strong view_ = nil;
+  std::unique_ptr<ui::DisplayCALayerTree> tree_;
+  std::unique_ptr<ui::RecyclableCompositorMac> compositor_;
+  std::unique_ptr<ui::LayerSolidColor> root_;
+  std::unique_ptr<ui::LayerSurface> video_;
+  viz::SurfaceId surface_id_;
+  viz::FrameSinkId registered_sink_;
+  gfx::Size natural_size_;
+  gfx::Rect bounds_{0, 0, 320, 180};
+  State state_;
+  std::optional<State> emitted_state_;
+  bool shown_ = false, suspended_ = true, host_bounds_ = false;
+  bool first_frame_pending_ = false, state_pending_ = false;
+  base::WeakPtrFactory<HostVideoOverlay> weak_{this};
+};
