+std::unique_ptr<content::VideoOverlayWindow> CreateHostVideoOverlay(
+    content::VideoPictureInPictureWindowController* controller) {
+  CHECK(pthread_main_np());
+  ReArcPictureInPictureEvent ids{};
+  if (!host || !controller->GetWebContents() ||
+      !HostPictureInPictureIds(controller->GetWebContents(), &ids)) {
+    return nullptr;
+  }
+  return std::make_unique<HostVideoOverlay>(controller, ids);
+}
