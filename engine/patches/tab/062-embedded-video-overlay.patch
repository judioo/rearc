+@implementation ReArcVideoOverlayView
+- (instancetype)initWithOwner:(rearc::HostVideoOverlay*)owner {
+  if ((self = [super initWithFrame:NSMakeRect(0, 0, 320, 180)])) {
+    _owner = owner;
+  }
+  return self;
+}
+- (void)clearOwner {
+  _owner = nullptr;
+}
+- (BOOL)isFlipped {
+  return YES;
+}
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  NSNotificationCenter* center = [NSNotificationCenter defaultCenter];
+  [center removeObserver:self];
+  if (NSWindow* window = [self window]) {
+    for (NSNotificationName name in @[
+           NSWindowDidChangeOcclusionStateNotification,
+           NSWindowDidChangeBackingPropertiesNotification,
+           NSWindowDidMoveNotification, NSWindowDidChangeScreenNotification
+         ]) {
+      [center addObserver:self
+                 selector:@selector(windowChanged:)
+                     name:name
+                   object:window];
+    }
+  }
+  [self geometryChanged];
+}
+- (void)windowChanged:(NSNotification*)notification {
+  [self geometryChanged];
+}
+- (void)setFrameSize:(NSSize)size {
+  [super setFrameSize:size];
+  [self geometryChanged];
+}
+- (void)viewDidHide {
+  [super viewDidHide];
+  [self geometryChanged];
+}
+- (void)viewDidUnhide {
+  [super viewDidUnhide];
+  [self geometryChanged];
+}
+- (void)dealloc {
+  [[NSNotificationCenter defaultCenter] removeObserver:self];
+}
+- (void)geometryChanged {
+  if (_owner) {
+    _owner->UpdateGeometry();
+  }
+}
+@end
