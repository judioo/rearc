+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 63, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -159,7 +159,7 @@ ReArcEngineSetEarlyWindowCallback(ReArcEarlyWindowCallback callback,
 // Each OTR call creates a unique in-memory profile under a persistent parent.
 typedef void (*ReArcProfileCallback)(void* context, ReArcStatus status,
                                      uint64_t profile_id, bool off_the_record);
-// ABI 1.53, extension_bulk_install. Calling either function affirms that the
+// ABI 1.53, extension_bulk_install. Calling an install function affirms that the
 // host obtained consent for these extensions. Main thread, persistent profiles
 // only. At most one operation per profile; at most three store installs at once.
 // Each input receives exactly one deferred callback, in completion order. The
@@ -187,8 +187,9 @@ typedef struct ReArcExtensionInstallSource {
 REARC_ENGINE_EXPORT ReArcStatus ReArcProfileInstallExtensionSources(
     uint64_t profile_id, const ReArcExtensionInstallSource* sources,
     uint32_t count, ReArcExtensionInstallCallback callback, void* context);
-REARC_ENGINE_EXPORT ReArcStatus ReArcProfileLoadUnpackedExtension(uint64_t profile_id,
-    const char* path, ReArcExtensionInstallCallback callback, void* context);
+// ABI 1.63 removes 1.53's ReArcProfileLoadUnpackedExtension: an import no
+// longer loads unpacked extensions (chrome://extensions "Load unpacked" stays).
+// Hosts resolve it with dlsym and must treat its absence as unsupported.
 
 REARC_ENGINE_EXPORT ReArcStatus ReArcProfileOpen(
     const char* name, ReArcProfileCallback completion, void* context);
