+// Local card/address offers (autofill_save_prompts, ABI 1.37).
+// phase 0 request, 1 withdrawn; kind 0 local card, 1 address (update supplied).
+// summary is Chromium data for display: card network/last four/expiration/name,
+// or address/name/email. No full card number or CVC crosses this channel.
+// Respond action 0 accept unchanged, 1 decline, 2 ignore/dismiss. Lifecycle
+// cancellation and absent callback ignore. No account migration/cloud save UI.
+typedef struct ReArcAutofillSaveEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase, kind;
+  bool update;
+  const char* origin;
+  const char* summary;
+} ReArcAutofillSaveEvent;
+typedef void (*ReArcAutofillSaveCallback)(void*, const ReArcAutofillSaveEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetAutofillSaveCallback(ReArcAutofillSaveCallback, void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutofillSaveRespond(uint64_t request_id, uint32_t action);
+
