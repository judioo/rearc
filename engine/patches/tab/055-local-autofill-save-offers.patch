+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_autofill_save.h"
+#include <pthread.h>
+#include <map>
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "components/autofill/core/browser/data_model/addresses/autofill_profile.h"
+#include "components/autofill/core/browser/data_model/payments/credit_card.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/origin.h"
+namespace rearc {
+namespace {
+class Offer;
+ReArcAutofillSaveCallback host = nullptr;
+void* context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+auto& Pending() { static base::NoDestructor<std::map<uint64_t,base::WeakPtr<Offer>>> p; return *p; }
+class Offer : public content::WebContentsObserver, public content::WebContentsUserData<Offer> {
+ public:
+  ~Offer() override { Cancel(); }
+  void Start(TabSession& s, uint32_t kind, bool update, std::string summary, base::OnceCallback<void(uint32_t)> done) {
+    Cancel(); allow_submission_ = true; done_ = std::move(done); summary_ = std::move(summary);
+    origin_ = url::Origin::Create(web_contents()->GetLastCommittedURL()).Serialize();
+    event_ = {s.profile_id(),s.tab_id(),s.content_generation(),next_id++,0,kind,update,nullptr,nullptr};
+    Pending().emplace(event_.request_id,weak_.GetWeakPtr()); Publish(0);
+  }
+  void Respond(uint32_t action) {
+    Pending().erase(event_.request_id); event_.request_id = 0;
+    auto done = std::move(done_); std::move(done).Run(action);
+  }
+  void Cancel() { if (event_.request_id) { Publish(1); Respond(2); } }
+  void DidStartNavigation(content::NavigationHandle* h) override {
+    if (!h->IsInPrimaryMainFrame() || h->IsSameDocument()) return;
+    // Form import can offer before the submission navigation starts. Keep the
+    // offer through that navigation, as Chromium's save bubble does.
+    if (allow_submission_ && h->IsFormSubmission()) { allow_submission_ = false; return; }
+    Cancel();
+  }
+  void WebContentsDestroyed() override { Cancel(); }
+ private:
+  friend class content::WebContentsUserData<Offer>;
+  explicit Offer(content::WebContents* c) : content::WebContentsObserver(c),content::WebContentsUserData<Offer>(*c) {}
+  void Publish(uint32_t phase) {
+    auto e = event_; e.phase = phase;
+    ABIPost(base::BindOnce([](uint64_t expected,ReArcAutofillSaveEvent e,std::string origin,std::string summary) {
+      if (!host || expected != epoch || (!e.phase && !Pending().contains(e.request_id))) return;
+      e.origin = origin.c_str(); e.summary = summary.c_str(); host(context,&e);
+    },epoch,e,origin_,summary_));
+  }
+  bool allow_submission_ = false;
+  ReArcAutofillSaveEvent event_{};
+  std::string origin_,summary_;
+  base::OnceCallback<void(uint32_t)> done_;
+  base::WeakPtrFactory<Offer> weak_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Offer);
+void Start(content::WebContents* c,uint32_t kind,bool update,std::u16string summary,base::OnceCallback<void(uint32_t)> done) {
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id);
+    if (s->web_contents() == c && s->close_state() == TabSession::CloseState::kOpen && host && Pending().size() < 64) {
+      Offer::GetOrCreateForWebContents(c)->Start(*s,kind,update,base::UTF16ToUTF8(summary),std::move(done)); return;
+    }
+  }
+  ABIPost(base::BindOnce(std::move(done),2));
+}
+}
+void OfferHostCardSave(content::WebContents* c,const autofill::CreditCard& card,autofill::payments::PaymentsAutofillClient::LocalSaveCardPromptCallback done) {
+  Start(c,0,false,card.NetworkAndLastFourDigits()+u"\n"+card.ExpirationDateForDisplay()+u"\n"+card.GetRawInfo(autofill::CREDIT_CARD_NAME_FULL),
+    base::BindOnce([](autofill::payments::PaymentsAutofillClient::LocalSaveCardPromptCallback done,uint32_t action) {
+      using Decision = autofill::payments::PaymentsAutofillClient::SaveCardOfferUserDecision;
+      std::move(done).Run(action == 0 ? Decision::kAccepted : action == 1 ? Decision::kDeclined : Decision::kIgnored);
+    },std::move(done)));
+}
+void OfferHostAddressSave(content::WebContents* c,const autofill::AutofillProfile& profile,bool update,autofill::AutofillClient::AddressProfileSavePromptCallback done) {
+  std::u16string summary;
+  for (auto field : {autofill::NAME_FULL,autofill::ADDRESS_HOME_STREET_ADDRESS,autofill::ADDRESS_HOME_CITY,autofill::ADDRESS_HOME_STATE,autofill::ADDRESS_HOME_ZIP,autofill::ADDRESS_HOME_COUNTRY,autofill::EMAIL_ADDRESS,autofill::PHONE_HOME_WHOLE_NUMBER}) {
+    auto text = profile.GetInfo(field,"en-US"); if (!text.empty()) { if (!summary.empty()) summary += u"\n"; summary += text; }
+  }
+  Start(c,1,update,std::move(summary),base::BindOnce([](autofill::AutofillClient::AddressProfileSavePromptCallback done,uint32_t action) {
+    using Decision = autofill::AutofillClient::AddressPromptUserDecision;
+    std::move(done).Run(action == 0 ? Decision::kAccepted : action == 1 ? Decision::kDeclined : Decision::kIgnored,std::nullopt);
+  },std::move(done)));
+}
+void ABICancelAutofillSave(uint64_t tab) {
+  if (auto* s = TabRegistry::Get().FindSession(tab)) if (auto* o = Offer::FromWebContents(s->web_contents())) o->Cancel();
+}
+}
+void ReArcEngineSetAutofillSaveCallback(ReArcAutofillSaveCallback cb,void* ctx) {
+  CHECK(pthread_main_np()); auto pending = rearc::Pending();
+  for (auto& [id,o] : pending) if (o) o->Cancel();
+  ++rearc::epoch; rearc::host = cb; rearc::context = ctx;
+}
+ReArcStatus ReArcAutofillSaveRespond(uint64_t id,uint32_t action) {
+  CHECK(pthread_main_np()); if (action > 2) return REARC_INVALID_ARGUMENT;
+  auto it = rearc::Pending().find(id); if (it == rearc::Pending().end() || !it->second) return REARC_NOT_FOUND;
+  it->second->Respond(action); return REARC_OK;
+}
