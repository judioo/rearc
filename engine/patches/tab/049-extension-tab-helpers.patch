@@ -16,6 +18,9 @@ namespace rearc {
 // (ContentAutofillDriverFactory), ChromePasswordManagerClient
 // (ContentPasswordManagerDriverFactory), HistoryTabHelper for non-OTR
 // profiles, FindTabHelper and the download NavigationMonitor observer.
+// Wave 18f adds the extension tab helpers (TabHelper, its ScriptExecutor,
+// ExtensionActionRunner and ActiveTabPermissionGranter, a SessionTabHelper
