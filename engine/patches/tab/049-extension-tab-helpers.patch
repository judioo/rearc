index dd919b9675..17dece6560 100644
--- a/chrome/browser/extensions/extension_tab_util.cc
+++ b/chrome/browser/extensions/extension_tab_util.cc
@@ -3,6 +3,9 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/extensions/extension_tab_util.h"
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/rearc_bridge/browserless_tab_helpers.h"
+#endif
 
 #include <stddef.h>
 
@@ -672,6 +675,18 @@ bool ExtensionTabUtil::GetTabById(int tab_id,
     }
   }
 
+#if BUILDFLAG(IS_MAC)
+  // ReArc wave 18f: browser-less registry tabs have no WindowController either;
+  // like prerendered tabs below, they resolve to contents only.
+  if (WebContents* registry_contents = rearc::FindBrowserlessExtensionTab(
+          tab_id, profile, include_incognito)) {
+    if (out_contents) {
+      *out_contents = registry_contents;
+    }
+    return true;
+  }
+#endif
+
   // Prerendering tab is not visible and it cannot be in `TabStripModel`, if the
   // tab id exists as a prerendering tab, and the API will returns
   // `api::tabs::TAB_INDEX_NONE` for `out_tab_index` and a valid `WebContents`.
