index 48a21d3163..995429f95c 100644
--- a/chrome/browser/rearc_bridge/browserless_tab_helpers.cc
+++ b/chrome/browser/rearc_bridge/browserless_tab_helpers.cc
@@ -9,6 +9,8 @@
 #include <memory>
 
 #include "base/check.h"
+#include "chrome/browser/extensions/api/web_navigation/web_navigation_tab_observer.h"  // nogncheck
+#include "chrome/browser/extensions/tab_helper.h"  // nogncheck
 #include "chrome/browser/history/history_tab_helper.h"
 #include "chrome/browser/password_manager/chrome_password_manager_client.h"
 #include "chrome/browser/printing/printing_init.h"
@@ -22,8 +24,12 @@
 #include "components/find_in_page/find_tab_helper.h"
 #include "components/zoom/zoom_controller.h"
 #include "components/permissions/permission_request_manager.h"
+#include "components/sessions/content/session_tab_helper.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_contents_user_data.h"
+#include "extensions/browser/extension_web_contents_observer.h"
+#include "extensions/browser/view_type_utils.h"
+#include "extensions/common/mojom/view_type.mojom.h"
 
 namespace rearc {
 namespace {
@@ -87,6 +93,61 @@ void AttachBrowserlessTabHelpers(content::WebContents* contents) {
   // Wave 18e: PDF generation for host printing. PrintViewManager's preview
   // and system-dialog paths are routed to the host for registry tabs.
   printing::InitializePrintingForWebContents(contents);
+
+  // Wave 18f: Chromium's extension tab helpers, as TabHelpers attaches them.
+  // Extension popups hosted as registry contents (kExtensionPopup) keep their
+  // view type and get no tab identity, like ExtensionViewHost contents.
+  if (extensions::GetViewType(contents) ==
+      extensions::mojom::ViewType::kInvalid) {
+    extensions::SetViewType(contents,
+                            extensions::mojom::ViewType::kTabContents);
+  }
+  if (extensions::GetViewType(contents) ==
+      extensions::mojom::ViewType::kTabContents) {
+    // The extension tab ID, without a SessionService delegate: registry tabs
+    // are not part of Chromium's window session state.
+    if (!sessions::SessionTabHelper::FromWebContents(contents)) {
+      sessions::SessionTabHelper::CreateForWebContents(
+          contents, sessions::SessionTabHelper::DelegateLookup());
+      if (auto* observer =
+              extensions::ExtensionWebContentsObserver::GetForWebContents(
+                  contents)) {
+        observer->ListenToWindowIdChangesFrom(
+            sessions::SessionTabHelper::FromWebContents(contents));
+      }
+    }
+    extensions::WebNavigationTabObserver::CreateForWebContents(contents);
+    extensions::TabHelper::CreateForWebContents(contents);
+  }
+}
+
+content::WebContents* FindBrowserlessExtensionTab(int extension_tab_id,
+                                                  Profile* profile,
+                                                  bool include_incognito) {
+  CHECK(pthread_main_np());
+  if (!profile) {
+    return nullptr;
+  }
+  auto& registry = TabRegistry::Get();
+  for (uint64_t id : registry.SessionIds()) {
+    TabSession* session = registry.FindSession(id);
+    if (!session || session->close_state() != TabSession::CloseState::kOpen) {
+      continue;
+    }
+    content::WebContents* contents = session->web_contents();
+    Profile* owner = Profile::FromBrowserContext(contents->GetBrowserContext());
+    if (owner != profile &&
+        !(include_incognito && profile->IsSameOrParent(owner))) {
+      continue;
+    }
+    if (extensions::GetViewType(contents) ==
+            extensions::mojom::ViewType::kTabContents &&
+        sessions::SessionTabHelper::IdForTab(contents).id() ==
+            extension_tab_id) {
+      return contents;
+    }
+  }
+  return nullptr;
 }
 
 bool IsBrowserlessTabContents(const content::WebContents* contents) {
