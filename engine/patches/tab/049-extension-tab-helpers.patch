 // TabHelpers::AttachTabHelpers and TabFeatures are deliberately not used:
 // both assume a TabStripModel/TabInterface and attach prompt UI helpers
 // (PermissionRequestManager, ManagePasswordsUIController, TabDialogs) whose
@@ -29,6 +34,14 @@ void AttachBrowserlessTabHelpers(content::WebContents* contents);
 // as the browser-less equivalent. Main thread only.
 bool IsBrowserlessTabContents(const content::WebContents* contents);
 
+// Wave 18f: the open registry tab whose extension tab ID (SessionTabHelper)
+// is `extension_tab_id`, in `profile` or, with `include_incognito`, one of
+// its off-the-record profiles. Registry tabs have no WindowController; callers
+// get contents only, as for Chromium's prerendered tabs. Main thread only.
+content::WebContents* FindBrowserlessExtensionTab(int extension_tab_id,
+                                                  Profile* profile,
+                                                  bool include_incognito);
+
 }  // namespace rearc
 
 #endif  // CHROME_BROWSER_REARC_BRIDGE_BROWSERLESS_TAB_HELPERS_H_
