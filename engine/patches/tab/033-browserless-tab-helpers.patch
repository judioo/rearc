@@ -0,0 +1,101 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/browserless_tab_helpers.h"
+
+#include <pthread.h>
+
+#include <memory>
+
+#include "base/check.h"
+#include "chrome/browser/history/history_tab_helper.h"
+#include "chrome/browser/password_manager/chrome_password_manager_client.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_key.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/ui/autofill/autofill_client_provider.h"
+#include "chrome/browser/ui/autofill/autofill_client_provider_factory.h"
+#include "components/download/content/factory/navigation_monitor_factory.h"
+#include "components/download/content/public/download_navigation_observer.h"
+#include "components/find_in_page/find_tab_helper.h"
+#include "components/zoom/zoom_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace rearc {
+namespace {
+
+// Adoption marker plus owner of helpers that TabFeatures holds as plain
+// members on desktop (no WebContentsUserData of their own).
+class BrowserlessTabHelpers
+    : public content::WebContentsUserData<BrowserlessTabHelpers> {
+ public:
+  ~BrowserlessTabHelpers() override = default;
+
+ private:
+  friend class content::WebContentsUserData<BrowserlessTabHelpers>;
+  explicit BrowserlessTabHelpers(content::WebContents* contents)
+      : content::WebContentsUserData<BrowserlessTabHelpers>(*contents),
+        download_navigation_observer_(
+            std::make_unique<download::DownloadNavigationObserver>(
+                contents,
+                download::NavigationMonitorFactory::GetForKey(
+                    Profile::FromBrowserContext(contents->GetBrowserContext())
+                        ->GetProfileKey()))) {}
+
+  std::unique_ptr<download::DownloadNavigationObserver>
+      download_navigation_observer_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BrowserlessTabHelpers);
+
+}  // namespace
+
+void AttachBrowserlessTabHelpers(content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  CHECK(contents);
+  if (BrowserlessTabHelpers::FromWebContents(contents)) {
+    return;
+  }
+  BrowserlessTabHelpers::CreateForWebContents(contents);
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+
+  // Same relative order as TabHelpers::AttachTabHelpers: ChromeAutofillClient
+  // may observe ZoomController, and ChromePasswordManagerClient observes the
+  // ContentAutofillClient's managers.
+  zoom::ZoomController::CreateForWebContents(contents);
+  autofill::AutofillClientProvider& autofill_provider =
+      autofill::AutofillClientProviderFactory::GetForProfile(profile);
+  autofill_provider.CreateClientForWebContents(contents);
+  if (!autofill_provider.uses_platform_autofill()) {
+    // Save/update prompts return false without a PasswordsClientUIDelegate
+    // (ManagePasswordsUIController is not attached); filling, credential
+    // usage bookkeeping and the store are Chromium's.
+    ChromePasswordManagerClient::CreateForWebContents(contents);
+  }
+  // Stock policy: no history helper for off-the-record profiles.
+  if (!profile->IsOffTheRecord()) {
+    HistoryTabHelper::GetOrCreateForWebContents(contents);
+  }
+  find_in_page::FindTabHelper::CreateForWebContents(contents);
+}
+
+bool IsBrowserlessTabContents(const content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  if (!contents) {
+    return false;
+  }
+  auto& registry = TabRegistry::Get();
+  for (uint64_t id : registry.SessionIds()) {
+    TabSession* session = registry.FindSession(id);
+    if (session && session->web_contents() == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace rearc
