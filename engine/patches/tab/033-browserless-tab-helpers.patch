+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_BROWSERLESS_TAB_HELPERS_H_
+#define CHROME_BROWSER_REARC_BRIDGE_BROWSERLESS_TAB_HELPERS_H_
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace rearc {
+
+// Attaches the audited subset of Chromium tab helpers a browser-less tab
+// needs (wave 18b): ZoomController, the profile's autofill client
+// (ContentAutofillDriverFactory), ChromePasswordManagerClient
+// (ContentPasswordManagerDriverFactory), HistoryTabHelper for non-OTR
+// profiles, FindTabHelper and the download NavigationMonitor observer.
+// TabHelpers::AttachTabHelpers and TabFeatures are deliberately not used:
+// both assume a TabStripModel/TabInterface and attach prompt UI helpers
+// (PermissionRequestManager, ManagePasswordsUIController, TabDialogs) whose
+// browser-less surfaces are separate concerns. Idempotent; main thread only.
+// Call before the first navigation so renderer driver bindings find their
+// factories.
+void AttachBrowserlessTabHelpers(content::WebContents* contents);
+
+// True when `contents` is owned by a live bridge TabSession. Chromium helpers
+// that require a Browser to identify a real tab (HistoryTabHelper) use this
+// as the browser-less equivalent. Main thread only.
+bool IsBrowserlessTabContents(const content::WebContents* contents);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_BROWSERLESS_TAB_HELPERS_H_
