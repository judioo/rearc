@@ -749,6 +750,22 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetZoomFactor(uint64_t tab_id,
 REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetZoomFactor(uint64_t tab_id,
                                                       double factor);
 
+// Page theme colour (page_theme_color, ABI 1.51): the current document's
+// <meta name="theme-color"> as Chromium resolves it (WebContents::
+// GetThemeColor; media queries and the last matching tag apply). argb is
+// 0xAARRGGBB, opaque in practice; has_color false means the page declares
+// none. Posted only when it changes, and once per new document, so a host can
+// key it by document; the initial state is posted when the tab's services
+// attach. Null callback disables delivery.
+typedef struct ReArcThemeColorEvent {
+  ReArcDocumentIdentity document;
+  bool has_color;
+  uint32_t argb;
+} ReArcThemeColorEvent;
+typedef void (*ReArcThemeColorCallback)(void* context, const ReArcThemeColorEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetThemeColorCallback(ReArcThemeColorCallback callback, void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetThemeColor(uint64_t tab_id, bool* has_color, uint32_t* argb);
+
 // Installed boost and explicitly evaluated isolated worlds get
 // rearcPostMessage(JSON.stringify(value)). Never injected into the main world.
 // Top-frame http(s) only; valid UTF-8 RFC JSON <=64 KiB, <=60 attempts/sec/tab,
