@@ -265,6 +268,7 @@ class PageServices : public content::DevToolsAgentHostClient,
     zoom_->SetShowsNotificationBubble(false);
     zoom_->AddObserver(this);
     PublishZoom();
+    PublishThemeColor();
   }
   ~PageServices() override {
     CHECK(pthread_main_np());
@@ -288,6 +292,20 @@ class PageServices : public content::DevToolsAgentHostClient,
   void OnZoomChanged(const zoom::ZoomController::ZoomChangedEventData&) override {
     PublishZoom();
   }
+  // ABI 1.51: the page's <meta name="theme-color">, posted only when it
+  // changes (a new document without one changes it to none).
+  std::optional<SkColor> theme_color() const { return web_contents()->GetThemeColor(); }
+  void DidChangeThemeColor() override { PublishThemeColor(); }
+  void PublishThemeColor() {
+    const auto color = theme_color();
+    if (theme_color_published_ && published_theme_color_ == color) return;
+    theme_color_published_ = true;
+    published_theme_color_ = color;
+    ReArcThemeColorEvent event{document(), color.has_value(), color.value_or(0)};
+    ABIPost(base::BindOnce([](base::WeakPtr<PageServices> self, ReArcThemeColorEvent e) {
+      if (self && self->Current() && theme_color_callback) theme_color_callback(theme_color_context, &e);
+    }, weak_factory_.GetWeakPtr(), event));
+  }
   void PublishZoom() {
     ReArcZoomEvent event{document(), zoom_factor()};
     ABIPost(base::BindOnce([](base::WeakPtr<PageServices> self, ReArcZoomEvent e) {
@@ -348,7 +366,12 @@ class PageServices : public content::DevToolsAgentHostClient,
   void DidFinishNavigation(content::NavigationHandle* handle) override {
     if (handle->IsInPrimaryMainFrame() && handle->HasCommitted()) {
       navigation_id_ = static_cast<uint64_t>(handle->GetNavigationId());
-      if (!handle->IsSameDocument()) ++document_generation_;
+      if (!handle->IsSameDocument()) {
+        ++document_generation_;
+        // The host keys colours by document; repeat an unchanged one for it.
+        theme_color_published_ = false;
+        PublishThemeColor();
+      }
     }
   }
   ReArcDocumentIdentity document() const {
@@ -946,16 +969,20 @@ class PageServices : public content::DevToolsAgentHostClient,
       FinishSnapshot(status ? status : REARC_CANCELLED, {});
       return;
     }
+    // Scope 2 (ABI 1.51): the visible viewport's top 4 CSS px, where a
+    // sticky header sits after a scroll, for the host's toolbar colour.
+    const bool top_edge = scope == 2;
+    const bool full_page = scope == 1;
     const auto* dimensions =
-        result.FindDict(scope ? "cssContentSize" : "cssVisualViewport");
+        result.FindDict(full_page ? "cssContentSize" : "cssVisualViewport");
     if (!dimensions) {
       FinishSnapshot(REARC_UNSUPPORTED, {});
       return;
     }
     const double width =
-        dimensions->FindDouble(scope ? "width" : "clientWidth").value_or(0);
-    const double height =
-        dimensions->FindDouble(scope ? "height" : "clientHeight").value_or(0);
+        dimensions->FindDouble(full_page ? "width" : "clientWidth").value_or(0);
+    const double height = top_edge ? 4 :
+        dimensions->FindDouble(full_page ? "height" : "clientHeight").value_or(0);
     if (!std::isfinite(width) || !std::isfinite(height) || width <= 0 ||
         height <= 0 || width > 16384 || height > 16384 ||
         width * height > 64000000) {
@@ -965,8 +992,15 @@ class PageServices : public content::DevToolsAgentHostClient,
     base::DictValue params;
     params.Set("format", "png");
     params.Set("fromSurface", true);
-    params.Set("captureBeyondViewport", scope != 0);
-    if (scope) {
+    params.Set("captureBeyondViewport", full_page);
+    if (top_edge) {
+      params.Set("clip", base::DictValue()
+                             .Set("x", dimensions->FindDouble("pageX").value_or(0))
+                             .Set("y", dimensions->FindDouble("pageY").value_or(0))
+                             .Set("width", width)
+                             .Set("height", height)
+                             .Set("scale", 1));
+    } else if (full_page) {
       params.Set("clip", base::DictValue()
                              .Set("x", 0)
                              .Set("y", 0)
@@ -1030,6 +1064,8 @@ class PageServices : public content::DevToolsAgentHostClient,
   }
 
   raw_ptr<zoom::ZoomController> zoom_ = nullptr;
