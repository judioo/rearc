@@ -1404,6 +1441,23 @@ void ReArcEngineSetZoomCallback(ReArcZoomCallback callback, void* context) {
   rearc::zoom_callback = callback;
   rearc::zoom_context = context;
 }
+void ReArcEngineSetThemeColorCallback(ReArcThemeColorCallback callback, void* context) {
+  CHECK(pthread_main_np());
+  rearc::theme_color_callback = callback;
+  rearc::theme_color_context = context;
+}
+ReArcStatus ReArcTabGetThemeColor(uint64_t id, bool* has_color, uint32_t* argb) {
+  CHECK(pthread_main_np());
+  if (!has_color || !argb) return REARC_INVALID_ARGUMENT;
+  *has_color = false;
+  *argb = 0;
+  rearc::PageServices* page;
+  if (auto status = rearc::FindPage(id, &page)) return status;
+  const auto color = page->theme_color();
+  *has_color = color.has_value();
+  *argb = color.value_or(0);
+  return REARC_OK;
+}
 ReArcStatus ReArcTabGetZoomFactor(uint64_t id, double* factor) {
   CHECK(pthread_main_np());
   if (!factor) return REARC_INVALID_ARGUMENT;
