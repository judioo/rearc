+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 4, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // changes bits: URL=1, title=2, loading=4, progress=8, crashed=16,
@@ -115,7 +115,9 @@ REARC_ENGINE_EXPORT uint64_t ReArcEngineDefaultProfile(void);
 
 // v1 admits only the startup profile. IDs are engine allocated, never reused.
 // space_id is a nonzero shell label. New tabs stage hidden; attach separately.
-// null URL means about:blank. Trusted browser-initiated navigation admits
+// null URL keeps the initial empty about:blank document without a synthetic
+// navigation. Explicit creation URLs are queued; an immediate Navigate
+// supersedes that queued destination. Trusted browser-initiated navigation admits
 // http(s), data, file, chrome://settings, chrome://version, exact about:blank
 // and view-source:http(s)/file. Other chrome hosts require helper audits.
 // Other schemes (including javascript, blob, chrome-untrusted) are rejected.
