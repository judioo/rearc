+// HTML fullscreen (html_fullscreen, ABI 1.27). Element.requestFullscreen()
+// in a presented tab enters Chromium tab fullscreen; the event asks the host
+// to make the window fullscreen (and hide its chrome) around that view. The
+// page sees fullscreen once granted; the host resizes the view as usual.
+// Without a callback, page requests are refused. Escape exits, as do the
+// page, navigation, hiding the view, close and callback replacement.
+// phase: 0 entered, 1 exited. reason (exit only): 0 page/engine, 1 host,
+// 2 escape key, 3 closed, 4 hidden. display_id: page-requested screen (Chromium
+// display ID, -1 none). Events are deferred and borrowed for the callback.
+typedef struct ReArcFullscreenEvent {
+  uint64_t profile_id, tab_id, content_generation;
+  uint32_t phase, reason;
+  int64_t display_id;
+} ReArcFullscreenEvent;
+typedef void (*ReArcFullscreenCallback)(void* context,
+                                        const ReArcFullscreenEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetFullscreenCallback(
+    ReArcFullscreenCallback callback, void* context);
+// Host-initiated exit (e.g. leaving native fullscreen). Not fullscreen:
+// invalid_state. The exit event (reason 1) follows, deferred.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabExitFullscreen(uint64_t tab_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetFullscreenState(uint64_t tab_id,
+                                                           bool* fullscreen);
+
 
 // Register a +0 NSWindow* before attachment; engine retains until Closed/Run
 // returns. Duplicate/zero IDs rejected. Closing a window keeps its tabs alive.
