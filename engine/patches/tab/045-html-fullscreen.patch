new file mode 100644
index 0000000000..a9a5abef6e
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_fullscreen.cc
@@ -0,0 +1,174 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_fullscreen.h"
+
+#include <pthread.h>
+
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_view_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace rearc {
+namespace {
+ReArcFullscreenCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+enum Reason : uint32_t { kPage = 0, kHost = 1, kEscape = 2, kClosed = 3, kHidden = 4 };
+class State : public content::WebContentsObserver,
+              public content::WebContentsUserData<State> {
+ public:
+  bool fullscreen() const { return fullscreen_; }
+  void Enter(uint64_t tab_id, int64_t display_id) {
+    // Identity is captured now: the session can be gone by the close event.
+    TabSession* session = TabRegistry::Get().FindSession(tab_id);
+    event_ = {session ? session->profile_id() : 0, tab_id,
+              session ? session->content_generation() : 0, 0, 0, display_id};
+    fullscreen_ = true;
+    Publish(0, 0, display_id);
+    Synchronize();
+  }
+  void Exited() {
+    if (!fullscreen_) return;
+    fullscreen_ = false;
+    Publish(1, reason_, event_.display_id);
+    reason_ = kPage;
+    Synchronize();
+  }
+  void Exit(Reason reason) {
+    if (!fullscreen_) return;
+    reason_ = reason;
+    // Content calls back into ExitFullscreenModeForTab, then resynchronizes.
+    web_contents()->ExitFullscreen(false);
+    if (fullscreen_) {
+      Exited();  // Defensive: never leave the host believing we're fullscreen.
+    }
+  }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    // Chrome leaves tab fullscreen when a tab stops being presented. Close
+    // invalidates the lease (hiding the view) before destroying contents.
+    if (visibility != content::Visibility::HIDDEN) return;
+    TabSession* session = TabRegistry::Get().FindSession(event_.tab_id);
+    Exit(session && session->close_state() == TabSession::CloseState::kOpen
+             ? kHidden
+             : kClosed);
+  }
+  void WebContentsDestroyed() override {
+    if (fullscreen_) {
+      reason_ = kClosed;
+      Exited();
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<State>;
+  explicit State(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<State>(*contents) {}
+  void Synchronize() {
+    if (auto* frame = web_contents()->GetPrimaryMainFrame()) {
+      frame->GetRenderViewHost()->GetWidget()->SynchronizeVisualProperties();
+    }
+  }
+  void Publish(uint32_t phase, uint32_t reason, int64_t display_id) {
+    ReArcFullscreenEvent event = event_;
+    event.phase = phase;
+    event.reason = reason;
+    event.display_id = display_id;
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, ReArcFullscreenEvent event) {
+          if (host && expected == epoch) host(host_context, &event);
+        },
+        epoch, event));
+  }
+  ReArcFullscreenEvent event_{};
+  bool fullscreen_ = false;
+  Reason reason_ = kPage;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(State);
+std::vector<State*> FullscreenStates() {
+  std::vector<State*> states;
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    if (auto* session = TabRegistry::Get().FindSession(id)) {
+      if (auto* state = State::FromWebContents(session->web_contents());
+          state && state->fullscreen()) {
+        states.push_back(state);
+      }
+    }
+  }
+  return states;
+}
+}  // namespace
+
+bool CanEnterHostFullscreen(uint64_t tab_id, content::RenderFrameHost* frame) {
+  CHECK(pthread_main_np());
+  auto* contents = content::WebContents::FromRenderFrameHost(frame);
+  // The host must render the transition; never fullscreen an unpresented tab.
+  return host && contents && ABIHasVisibilityIntent(tab_id) &&
+         contents->GetVisibility() != content::Visibility::HIDDEN;
+}
+void EnterHostFullscreen(uint64_t tab_id, content::RenderFrameHost* frame,
+                         int64_t display_id) {
+  auto* contents = content::WebContents::FromRenderFrameHost(frame);
+  State::GetOrCreateForWebContents(contents)->Enter(tab_id, display_id);
+}
+void ExitHostFullscreen(content::WebContents* contents) {
+  if (auto* state = State::FromWebContents(contents)) state->Exited();
+}
+bool IsHostFullscreen(const content::WebContents* contents) {
+  auto* state =
+      State::FromWebContents(const_cast<content::WebContents*>(contents));
+  return state && state->fullscreen();
+}
+bool HandleHostFullscreenKey(content::WebContents* contents,
+                             const input::NativeWebKeyboardEvent& event) {
+  auto* state = State::FromWebContents(contents);
+  if (!state || !state->fullscreen() ||
+      event.windows_key_code != ui::VKEY_ESCAPE ||
+      event.GetType() != input::NativeWebKeyboardEvent::Type::kRawKeyDown) {
+    return false;
+  }
+  state->Exit(kEscape);
+  return true;
+}
+}  // namespace rearc
+
+void ReArcEngineSetFullscreenCallback(ReArcFullscreenCallback callback,
+                                      void* context) {
+  CHECK(pthread_main_np());
+  // The replaced host can no longer render fullscreen: leave it everywhere.
+  for (auto* state : rearc::FullscreenStates()) state->Exit(rearc::kHost);
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+}
+ReArcStatus ReArcTabExitFullscreen(uint64_t tab_id) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) return status;
+  auto* state = rearc::State::FromWebContents(session->web_contents());
+  if (!state || !state->fullscreen()) return REARC_INVALID_STATE;
+  state->Exit(rearc::kHost);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabGetFullscreenState(uint64_t tab_id, bool* fullscreen) {
+  if (fullscreen) *fullscreen = false;
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) return status;
+  if (!fullscreen) return REARC_INVALID_ARGUMENT;
+  *fullscreen = rearc::IsHostFullscreen(session->web_contents());
+  return REARC_OK;
+}
