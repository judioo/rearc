@@ -137,7 +137,7 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcProfileClose(
 // HistoryTabHelper (non-OTR profiles), autofill client and
 // ChromePasswordManagerClient. Visits reach HistoryService/chrome://history;
 // saved credentials fill and usage updates reach the password store. No
-// save/update prompt surface: new credentials are not saved without one.
+// save/update offers require the password_prompts callback (ABI 1.22).
 // IDs are engine allocated, never reused. Any live profile is admitted.
 // space_id is a nonzero shell label. New tabs stage hidden; attach separately.
 // null URL keeps the initial empty about:blank document without a synthetic
@@ -533,6 +533,25 @@ REARC_ENGINE_EXPORT void ReArcEngineSetContextMenuCallback(
 REARC_ENGINE_EXPORT ReArcStatus ReArcContextMenuCommand(
     uint64_t request_id, uint32_t action);
 
+// Password offers (password_prompts, ABI 1.22). ChromePasswordManagerClient
+// owns detection; PasswordFormManagerForUI owns saving/blocklisting. Passwords
+// never cross this ABI. phase: 0 offer, 1 cancelled. update distinguishes
+// save/update. Origin is the submitted form's origin, not a redirect target.
+typedef struct ReArcPasswordPromptEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase;
+  bool update;
+  const char* origin;
+  const char* username;
+} ReArcPasswordPromptEvent;
+typedef void (*ReArcPasswordPromptCallback)(void*, const ReArcPasswordPromptEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetPasswordPromptCallback(
+    ReArcPasswordPromptCallback callback, void* context);
+// action: 0 save/update, 1 never (blocklist site), 2 dismiss. Single use.
+// Navigation after the offer, close and callback replacement cancel it.
+REARC_ENGINE_EXPORT ReArcStatus ReArcPasswordPromptRespond(
+    uint64_t request_id, uint32_t action);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
