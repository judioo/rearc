diff --git a/chrome/browser/rearc_bridge/rearc_password_prompt.cc b/chrome/browser/rearc_bridge/rearc_password_prompt.cc
new file mode 100644
index 0000000000..dfbb863e9a
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_password_prompt.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_password_prompt.h"
+
+#include <pthread.h>
+
+#include <map>
+#include <string>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "components/password_manager/core/browser/password_form_manager_for_ui.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/origin.h"
+namespace rearc {
+namespace {
+class Offer;
+ReArcPasswordPromptCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+auto& Pending() {
+  static base::NoDestructor<std::map<uint64_t, base::WeakPtr<Offer>>> map;
+  return *map;
+}
+class Offer : public content::WebContentsObserver,
+              public content::WebContentsUserData<Offer> {
+ public:
+  ~Offer() override { Cancel(); }
+  void Start(TabSession& s,
+             std::unique_ptr<password_manager::PasswordFormManagerForUI> form,
+             bool update) {
+    Cancel();
+    form_ = std::move(form);
+    id_ = next_id++;
+    event_ = {
+        s.profile_id(), s.tab_id(), s.content_generation(), id_, 0, update,
+        nullptr,        nullptr};
+    origin_ = url::Origin::Create(form_->GetURL()).Serialize();
+    username_ =
+        base::UTF16ToUTF8(form_->GetPendingCredentials().username_value);
+    Pending().emplace(id_, weak_.GetWeakPtr());
+    Publish(0);
+  }
+  void Respond(uint32_t action) {
+    auto form = std::move(form_);
+    bool update = event_.update;
+    Pending().erase(id_);
+    id_ = 0;
+    if (action == 0) {
+      form->Save();
+    } else if (action == 1) {
+      form->OnNeverClicked();
+    } else {
+      form->OnNoInteraction(update);
+    }
+  }
+  void Cancel() {
+    if (!id_) {
+      return;
+    }
+    Publish(1);
+    Respond(2);
+  }
+  void DidStartNavigation(content::NavigationHandle* h) override {
+    if (h->IsInPrimaryMainFrame() && !h->IsSameDocument()) {
+      Cancel();
+    }
+  }
+  void WebContentsDestroyed() override { Cancel(); }
+
+ private:
+  friend class content::WebContentsUserData<Offer>;
+  explicit Offer(content::WebContents* c)
+      : content::WebContentsObserver(c),
+        content::WebContentsUserData<Offer>(*c) {}
+  void Publish(uint32_t phase) {
+    auto event = event_;
+    event.phase = phase;
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, ReArcPasswordPromptEvent e, std::string origin,
+           std::string username) {
+          if (!host || expected != epoch ||
+              (!e.phase && !Pending().contains(e.request_id))) {
+            return;
+          }
+          e.origin = origin.c_str();
+          e.username = username.c_str();
+          host(host_context, &e);
+        },
+        epoch, event, origin_, username_));
+  }
+  uint64_t id_ = 0;
+  ReArcPasswordPromptEvent event_{};
+  std::string origin_, username_;
+  std::unique_ptr<password_manager::PasswordFormManagerForUI> form_;
+  base::WeakPtrFactory<Offer> weak_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Offer);
+}  // namespace
+bool OfferHostPasswordPrompt(
+    content::WebContents* contents,
+    std::unique_ptr<password_manager::PasswordFormManagerForUI> form,
+    bool update) {
+  if (!host || form->IsBlocklisted()) {
+    return false;
+  }
+  for (auto id : TabRegistry::Get().SessionIds()) {
+    auto* s = TabRegistry::Get().FindSession(id);
+    if (s->web_contents() == contents) {
+      Offer::GetOrCreateForWebContents(contents)->Start(*s, std::move(form),
+                                                        update);
+      return true;
+    }
+  }
+  return false;
+}
+void ABICancelPasswords(uint64_t tab) {
+  if (auto* s = TabRegistry::Get().FindSession(tab)) {
+    if (auto* o = Offer::FromWebContents(s->web_contents())) {
+      o->Cancel();
+    }
+  }
+}
+}  // namespace rearc
+void ReArcEngineSetPasswordPromptCallback(ReArcPasswordPromptCallback cb,
+                                          void* ctx) {
+  CHECK(pthread_main_np());
+  auto pending = rearc::Pending();
+  for (auto& [id, o] : pending) {
+    if (o) {
+      o->Cancel();
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = cb;
+  rearc::host_context = ctx;
+}
+ReArcStatus ReArcPasswordPromptRespond(uint64_t id, uint32_t action) {
+  CHECK(pthread_main_np());
+  if (action > 2) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  auto it = rearc::Pending().find(id);
+  if (it == rearc::Pending().end() || !it->second) {
+    return REARC_NOT_FOUND;
+  }
+  it->second->Respond(action);
+  return REARC_OK;
+}
