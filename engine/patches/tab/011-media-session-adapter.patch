+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_MEDIA_ADAPTER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_MEDIA_ADAPTER_H_
+
+#include <cstdint>
+
+namespace rearc {
+
+// UI-thread seams, dormant until called after tab.created. Per-WebContents
+// MediaSession only; never the system's globally focused media controller.
+void AttachMediaAdapter(uint64_t tab_id);
+void DetachMediaAdapter(uint64_t tab_id);
+
+enum class MediaPlaybackAction { kPlay, kPause, kToggle };
+enum class MediaCommandResult { kAccepted, kInvalidState, kUnsupported };
+MediaCommandResult MediaSetPlayback(uint64_t tab_id,
+                                    MediaPlaybackAction action);
+MediaCommandResult MediaSetMuted(uint64_t tab_id, bool muted);
+
+// PiP control and artwork retrieval remain unadvertised. Events carry false
+// pip_available/pip_active until a tested native controller seam exists.
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_MEDIA_ADAPTER_H_
