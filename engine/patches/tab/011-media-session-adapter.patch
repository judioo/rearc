+    ]
+  }
+
   if (enable_dice_support || is_chromeos) {
     deps += [ "//chrome/browser/ui/webui/signin:batch_upload" ]
   }
diff --git a/chrome/browser/rearc_bridge/media_adapter.cc b/chrome/browser/rearc_bridge/media_adapter.cc
new file mode 100644
index 0000000000..21ddec0629
--- /dev/null
+++ b/chrome/browser/rearc_bridge/media_adapter.cc
@@ -0,0 +1,226 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/media_adapter.h"
+
+#include <pthread.h>
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/containers/flat_map.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/rearc_bridge/ipc_service_events.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/media_session/public/cpp/media_image.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/cpp/media_position.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace rearc {
+namespace {
+
+using media_session::mojom::MediaSessionAction;
+using media_session::mojom::MediaSessionInfo;
+
+class MediaAdapter : public content::WebContentsObserver,
+                     public content::WebContentsUserData<MediaAdapter>,
+                     public media_session::mojom::MediaSessionObserver {
+ public:
+  ~MediaAdapter() override = default;
+
+  void Publish() {
+    if (!web_contents()) {
+      return;
+    }
+    // Audibility and WebContents mute are independent of playback/session
+    // audio focus, and of the MediaSessionInfo's player mute field.
+    event_.audible = web_contents()->IsCurrentlyAudible();
+    event_.muted = web_contents()->IsAudioMuted();
+    EmitServiceEvent(event_);
+  }
+
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr info) override {
+    controllable_ = info && info->is_controllable;
+    if (!info) {
+      event_.playback = MediaPlayback::kUnknown;
+    } else if (info->state == MediaSessionInfo::SessionState::kInactive) {
+      event_.playback = MediaPlayback::kStopped;
+    } else {
+      switch (info->playback_state) {
+        case media_session::mojom::MediaPlaybackState::kPlaying:
+          event_.playback = MediaPlayback::kPlaying;
+          break;
+        case media_session::mojom::MediaPlaybackState::kPaused:
+          event_.playback = MediaPlayback::kPaused;
+          break;
+        default:
+          event_.playback = MediaPlayback::kUnknown;
+      }
+    }
+    Publish();
+  }
+
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& metadata) override {
+    // A present empty table explicitly clears metadata on the wire.
+    event_.has_metadata = true;
+    event_.media_title = metadata ? metadata->title : std::u16string();
+    event_.media_artist = metadata ? metadata->artist : std::u16string();
+    event_.media_album = metadata ? metadata->album : std::u16string();
+    Publish();
+  }
+
+  void MediaSessionActionsChanged(
+      const std::vector<MediaSessionAction>& actions) override {
+    actions_ = actions;
+  }
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>& images)
+      override {}
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& position) override {}
+
+  void OnAudioStateChanged(bool audible) override { Publish(); }
+  void DidUpdateAudioMutingState(bool muted) override { Publish(); }
+  void WebContentsDestroyed() override {
+    receiver_.reset();
+    Observe(nullptr);
+  }
+
+  MediaCommandResult SetPlayback(MediaPlaybackAction action) {
+    auto* session = TabRegistry::Get().FindSession(event_.tab_id);
+    if (!web_contents() || web_contents()->IsBeingDestroyed() || !session ||
+        session->content_generation() != event_.content_generation ||
+        !receiver_.is_bound() || !controllable_ ||
+        (event_.playback != MediaPlayback::kPlaying &&
+         event_.playback != MediaPlayback::kPaused)) {
+      return MediaCommandResult::kInvalidState;
+    }
+    auto* media = content::MediaSession::GetIfExists(web_contents());
+    if (!media) {
+      return MediaCommandResult::kInvalidState;
+    }
+    bool play;
+    switch (action) {
+      case MediaPlaybackAction::kPlay:
+        play = true;
+        break;
+      case MediaPlaybackAction::kPause:
+        play = false;
+        break;
+      case MediaPlaybackAction::kToggle:
+        play = event_.playback != MediaPlayback::kPlaying;
+        break;
+      default:
+        return MediaCommandResult::kUnsupported;
+    }
+    const auto required =
+        play ? MediaSessionAction::kPlay : MediaSessionAction::kPause;
+    if (std::find(actions_.begin(), actions_.end(), required) ==
+        actions_.end()) {
+      return MediaCommandResult::kUnsupported;
+    }
+    if (play) {
+      media->Resume(media_session::mojom::MediaSession::SuspendType::kUI);
+    } else {
+      media->Suspend(media_session::mojom::MediaSession::SuspendType::kUI);
+    }
+    return MediaCommandResult::kAccepted;
+  }
+
+ private:
+  friend class content::WebContentsUserData<MediaAdapter>;
+  MediaAdapter(content::WebContents* contents,
+               uint64_t tab_id,
+               uint64_t generation)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<MediaAdapter>(*contents) {
+    event_.kind = ServiceEventKind::kMediaStateChanged;
+    event_.tab_id = tab_id;
+    event_.content_generation = generation;
+    event_.has_metadata = true;
+    content::MediaSession::Get(contents)->AddObserver(
+        receiver_.BindNewPipeAndPassRemote());
+    // Unretained is scoped to the receiver, a member destroyed before this
+    // object's bases; closing it drops queued callbacks on detach/teardown.
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&MediaAdapter::OnDisconnected, base::Unretained(this)));
+  }
+
+  void OnDisconnected() {
+    receiver_.reset();
+    controllable_ = false;
+    actions_.clear();
+    event_.playback = MediaPlayback::kUnknown;
+    event_.media_title.clear();
+    event_.media_artist.clear();
+    event_.media_album.clear();
+    Publish();
+  }
+
+  ServiceEvent event_;
+  bool controllable_ = false;
+  std::vector<MediaSessionAction> actions_;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(MediaAdapter);
+
+}  // namespace
+
+void AttachMediaAdapter(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || !session->web_contents() ||
+      MediaAdapter::FromWebContents(session->web_contents())) {
+    return;
+  }
+  MediaAdapter::CreateForWebContents(session->web_contents(), tab_id,
+                                     session->content_generation());
+  MediaAdapter::FromWebContents(session->web_contents())->Publish();
+}
+
+void DetachMediaAdapter(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  if (auto* session = TabRegistry::Get().FindSession(tab_id)) {
+    session->web_contents()->RemoveUserData(MediaAdapter::UserDataKey());
+  }
+}
+
+MediaCommandResult MediaSetPlayback(uint64_t tab_id,
+                                    MediaPlaybackAction action) {
+  CHECK(pthread_main_np());
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session) {
+    return MediaCommandResult::kInvalidState;
+  }
+  auto* adapter = MediaAdapter::FromWebContents(session->web_contents());
+  return adapter ? adapter->SetPlayback(action)
+                 : MediaCommandResult::kInvalidState;
+}
+
+MediaCommandResult MediaSetMuted(uint64_t tab_id, bool muted) {
+  CHECK(pthread_main_np());
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || session->web_contents()->IsBeingDestroyed()) {
+    return MediaCommandResult::kInvalidState;
+  }
+  session->web_contents()->SetAudioMuted(muted);
+  return MediaCommandResult::kAccepted;
+}
+
+}  // namespace rearc
