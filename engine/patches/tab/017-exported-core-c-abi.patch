+  return std::string(feature) == "native_view" ||
+         std::string(feature) == "navigation";
+}
+const char* ReArcStatusName(ReArcStatus status) {
+  CHECK([NSThread isMainThread]);
+  static const char* const names[] = {"ok",
+                                      "tab_not_found",
+                                      "window_not_found",
+                                      "profile_not_found",
+                                      "not_found",
+                                      "invalid_url",
+                                      "invalid_argument",
+                                      "invalid_state",
+                                      "engine_not_ready",
+                                      "version_mismatch",
+                                      "unsupported",
+                                      "busy",
+                                      "already_attached",
+                                      "stale_attachment",
+                                      "too_large",
+                                      "cancelled",
+                                      "internal"};
+  return status >= 0 && status <= REARC_INTERNAL ? names[status] : "internal";
+}
+ReArcStatus ReArcEngineConfigure(uint32_t version,
+                                 const ReArcCallbacks* callbacks,
+                                 void* context) {
+  auto& a = ABI::Get();
+  if (version != REARC_ABI_VERSION) {
+    return REARC_VERSION_MISMATCH;
+  }
+  if (!callbacks || !callbacks->ready) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (a.configured || NSApp) {
+    return REARC_INVALID_STATE;
+  }
+  a.configured = true;
+  a.callbacks = *callbacks;
+  a.context = context;
+  ReArcEngineSetLifecycleCallbacks(&rearc::Terminate, &rearc::CancelTerminate,
+                                   nullptr);
+  rearc::SetEngineReadinessSink(&a);
+  rearc::SetTabEventSink(&a);
+  rearc::SetAttachmentEventSink(&a);
+  return REARC_OK;
+}
+int ReArcEngineRun(int argc, const char* const* argv) {
+  auto& a = ABI::Get();
+  if (!a.configured || a.ran || argc < 1 || !argv) {
+    return -REARC_INVALID_STATE;
+  }
+  std::vector<std::string> args;
+  bool profile = false;
+  for (int i = 0; i < argc; ++i) {
+    if (!argv[i]) {
+      return -REARC_INVALID_ARGUMENT;
+    }
+    std::string arg(argv[i]);
+    if (arg.starts_with("--type") || arg.starts_with("--headless") ||
+        arg == "--incognito" || arg == "--guest") {
+      return -REARC_UNSUPPORTED;
+    }
+    if (arg.starts_with("--profile-directory=")) {
+      profile = true;
+    }
+    args.push_back(arg);
+  }
+  args.push_back("--no-startup-window");
+  args.push_back("--no-first-run");
+  args.push_back("--no-default-browser-check");
+  if (!profile) {
+    args.push_back("--profile-directory=Default");
+  }
+  std::vector<const char*> pointers;
+  for (auto& arg : args) {
+    pointers.push_back(arg.c_str());
+  }
+  a.ran = true;
+  const int result =
+      ChromeMain(static_cast<int>(pointers.size()), pointers.data());
+  // The scheduler no longer exists. Flush any already captured deliveries
+  // directly, then deliver the terminal lifecycle result from this host frame.
+  a.ready = false;
+  a.Drain();
+  for (auto& [id, window] : a.windows) {
+    [[NSNotificationCenter defaultCenter] removeObserver:window.observer];
+  }
+  a.windows.clear();
+  if (a.shutdown_completion) {
+    auto completion = a.shutdown_completion;
+    a.shutdown_completion = nullptr;
+    completion(a.shutdown_context, result == 0 ? REARC_OK : REARC_INTERNAL,
+               false);
+  }
+  return result;
+}
+uint64_t ReArcEngineDefaultProfile(void) {
+  CHECK([NSThread isMainThread]);
+  return ABI::Get().ready ? rearc::DefaultBridgeProfileId() : 0;
+}
+ReArcStatus ReArcEngineShutdown(bool force,
+                                ReArcCompletion completion,
+                                void* context) {
+  auto& a = ABI::Get();
+  if (!completion) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (a.stopping) {
+    return REARC_BUSY;
+  }
+  if (!a.ready) {
+    return REARC_ENGINE_NOT_READY;
+  }
+  // Snapshot the bridge's live IDs without exposing pointers across tasks.
+  a.shutdown_tabs.clear();
+  // Id allocation is monotonic, but the registry owns the authoritative set.
+  for (uint64_t id : rearc::TabRegistry::Get().SessionIds()) {
+    auto* s = rearc::TabRegistry::Get().FindSession(id);
+    if (s->close_state() != rearc::TabSession::CloseState::kOpen) {
+      return REARC_BUSY;
+    }
+    a.shutdown_tabs.push_back(id);
+  }
+  a.stopping = true;
+  a.shutdown_index = 0;
+  a.shutdown_force = force;
+  a.shutdown_completion = completion;
+  a.shutdown_context = context;
+  a.ContinueShutdown();
+  return REARC_OK;
+}
+ReArcStatus ReArcTabCreate(uint64_t profile_id,
+                           uint64_t space_id,
+                           const char* value,
+                           uint64_t* tab_id) {
+  CHECK([NSThread isMainThread]);
+  if (tab_id) {
+    *tab_id = 0;
+  }
+  if (auto status = rearc::Available()) {
+    return status;
+  }
+  if (!space_id || !tab_id) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  auto* profile = rearc::FindBridgeProfile(profile_id);
+  if (!profile || profile_id != rearc::DefaultBridgeProfileId()) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  GURL url;
+  if (auto status = rearc::CheckURL(value ? value : "about:blank", &url)) {
+    return status;
+  }
+  rearc::TabSession::CreateArgs args;
+  args.browser_context = profile;
+  args.space_id = space_id;
+  *tab_id = rearc::TabRegistry::Get().CreateSession(args);
+  rearc::EmitTabCreatedEvent(*tab_id);
+  rearc::ABIInitializeTab(*tab_id);
+  return ReArcTabNavigate(*tab_id, url.spec().c_str(), 0);
+}
+ReArcStatus ReArcTabClose(uint64_t id,
+                          bool force,
+                          ReArcCompletion completion,
+                          void* context) {
+  CHECK([NSThread isMainThread]);
+  if (!completion) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (auto status = rearc::Available()) {
+    return status;
+  }
+  return rearc::CloseError(rearc::RequestTabClose(
+      id, force,
+      base::BindOnce(
+          [](ReArcCompletion done, void* ctx, rearc::CloseOutcome outcome) {
+            rearc::ABIPost(
+                base::BindOnce(done, ctx, REARC_OK,
+                               outcome == rearc::CloseOutcome::kCancelled));
+          },
+          completion, context)));
+}
+ReArcStatus ReArcTabNavigate(uint64_t id,
+                             const char* value,
+                             uint32_t transition) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  GURL url;
+  if (auto status = rearc::CheckURL(value, &url)) {
+    return status;
+  }
+  ui::PageTransition type;
+  switch (transition) {
+    case 0:
+      type = ui::PAGE_TRANSITION_TYPED;
+      break;
+    case 1:
+      type = ui::PAGE_TRANSITION_LINK;
+      break;
+    case 3:
+      type = ui::PAGE_TRANSITION_GENERATED;
+      break;
+    default:
+      return REARC_INVALID_ARGUMENT;
+  }
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = type;
+  s->web_contents()->GetController().LoadURLWithParams(params);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabReload(uint64_t id, bool ignore_cache) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  s->web_contents()->GetController().Reload(
+      ignore_cache ? content::ReloadType::BYPASSING_CACHE
+                   : content::ReloadType::NORMAL,
+      false);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabGoBack(uint64_t id) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  auto& c = s->web_contents()->GetController();
+  if (c.CanGoBack()) {
+    c.GoBack();
+  }
+  return REARC_OK;
+}
+ReArcStatus ReArcTabGoForward(uint64_t id) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  auto& c = s->web_contents()->GetController();
+  if (c.CanGoForward()) {
+    c.GoForward();
+  }
+  return REARC_OK;
+}
+ReArcStatus ReArcTabStop(uint64_t id) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  s->web_contents()->Stop();
+  return REARC_OK;
+}
+ReArcStatus ReArcTabRefreshState(uint64_t id) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  rearc::EmitInitialSnapshotEvent(id);
+  return REARC_OK;
+}
+ReArcStatus ReArcTabActivate(uint64_t id) {
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  auto& a = ABI::Get();
+  auto p = a.presentations.find(id);
+  if (p == a.presentations.end() || !p->second.intent) {
+    return REARC_INVALID_STATE;
+  }
+  auto w = a.windows.find(p->second.window_id);
+  if (w == a.windows.end() || !w->second.native.keyWindow ||
+      !w->second.native.visible || w->second.native.miniaturized) {
+    return REARC_INVALID_STATE;
+  }
+  s->web_contents()->Focus();
+  return REARC_OK;
+}
+ReArcStatus ReArcWindowRegister(uint64_t id, void* native) {
+  CHECK([NSThread isMainThread]);
+  if (auto status = rearc::Available()) {
+    return status;
+  }
+  NSWindow* window = (__bridge NSWindow*)native;
+  if (!id || !window || ![window isKindOfClass:[NSWindow class]]) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  auto& a = ABI::Get();
+  if (a.windows.contains(id)) {
+    return REARC_INVALID_STATE;
+  }
+  rearc::Window record;
+  record.native = window;
+  record.observer = [[NSNotificationCenter defaultCenter]
+      addObserverForName:nil
+                  object:window
+                   queue:nil
+              usingBlock:^(NSNotification* note) {
+                CHECK([NSThread isMainThread]);
+                if ([note.name isEqualToString:NSWindowWillCloseNotification]) {
+                  ReArcWindowClosed(id);
+                } else {
+                  ABI::Get().ReconcileWindow(id);
+                }
+              }];
+  a.windows.emplace(id, std::move(record));
+  return REARC_OK;
+}
+ReArcStatus ReArcWindowClosed(uint64_t id) {
+  CHECK([NSThread isMainThread]);
+  auto& a = ABI::Get();
+  auto it = a.windows.find(id);
+  if (it == a.windows.end()) {
+    return REARC_WINDOW_NOT_FOUND;
+  }
+  std::vector<uint64_t> tabs;
+  for (const auto& [tab, p] : a.presentations) {
+    if (p.window_id == id) {
+      tabs.push_back(tab);
+    }
+  }
+  for (auto tab : tabs) {
+    rearc::AttachmentLeaseRegistry::Get().InvalidateLeasesForTab(
+        tab, rearc::LeaseInvalidatedReason::kWindowClosed);
+  }
+  [[NSNotificationCenter defaultCenter] removeObserver:it->second.observer];
+  a.windows.erase(it);
+  return REARC_OK;
+}
+ReArcStatus ReArcViewAttach(uint64_t id,
+                            uint64_t window_id,
+                            double width,
+                            double height,
+                            double scale,
+                            ReArcAttachment* out) {
+  CHECK([NSThread isMainThread]);
+  if (out) {
+    *out = {};
+  }
+  rearc::TabSession* s;
+  if (auto status = rearc::ABICheckTab(id, &s)) {
+    return status;
+  }
+  if (!out || !rearc::ValidSize(width, height, scale)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (!ABI::Get().windows.contains(window_id)) {
+    return REARC_WINDOW_NOT_FOUND;
+  }
+  auto result = rearc::AttachmentLeaseRegistry::Get().AttachView(id, width,
+                                                                 height, scale);
+  if (result.error == rearc::AttachError::kAlreadyAttached) {
+    return REARC_ALREADY_ATTACHED;
+  }
+  if (result.error != rearc::AttachError::kNone) {
+    return REARC_TAB_NOT_FOUND;
+  }
+  out->attachment_id = result.attachment_id;
+  out->content_generation = s->content_generation();
+  out->native_view = const_cast<void*>(CFRetain(result.host_view));
+  ABI::Get().presentations.emplace(
+      id, rearc::Presentation{window_id, result.attachment_id});
+  return REARC_OK;
+}
+ReArcStatus ReArcViewDetach(uint64_t id, uint64_t lease) {
+  CHECK([NSThread isMainThread]);
+  if (!rearc::AttachmentLeaseRegistry::Get().DetachView(id, lease)) {
+    return REARC_STALE_ATTACHMENT;
+  }
+  ABI::Get().presentations.erase(id);
+  return REARC_OK;
+}
+ReArcStatus ReArcViewResize(uint64_t id,
+                            uint64_t lease,
+                            double w,
+                            double h,
+                            double scale) {
+  CHECK([NSThread isMainThread]);
+  if (!rearc::ValidSize(w, h, scale)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  return rearc::AttachmentLeaseRegistry::Get().ResizeView(id, lease, w, h,
+                                                          scale)
+             ? REARC_OK
+             : REARC_STALE_ATTACHMENT;
+}
+ReArcStatus ReArcViewSetVisible(uint64_t id, uint64_t lease, bool visible) {
+  CHECK([NSThread isMainThread]);
+  auto& a = ABI::Get();
+  auto p = a.presentations.find(id);
+  if (p == a.presentations.end() || p->second.attachment_id != lease) {
+    return REARC_STALE_ATTACHMENT;
+  }
+  NSWindow* window = a.windows.at(p->second.window_id).native;
+  auto* s = rearc::TabRegistry::Get().FindSession(id);
+  NSView* content =
+      s ? s->web_contents()->GetNativeView().GetNativeNSView() : nil;
+  if (visible && content.window != window) {
+    return REARC_INVALID_STATE;
+  }
+  p->second.intent = visible;
+  a.Reconcile(id);
+  return REARC_OK;
+}
+void ReArcViewRelease(void* view) {
+  CHECK([NSThread isMainThread]);
+  if (view) {
+    CFRelease(view);
+  }
+}
+void ReArcBufferFree(void* buffer) {
+  CHECK([NSThread isMainThread]);
+  free(buffer);
+}
