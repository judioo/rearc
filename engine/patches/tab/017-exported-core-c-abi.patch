diff --git a/chrome/browser/rearc_bridge/rearc_engine_abi.h b/chrome/browser/rearc_bridge/rearc_engine_abi.h
new file mode 100644
index 0000000000..b14109e4e2
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_engine_abi.h
@@ -0,0 +1,165 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_ABI_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_ABI_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "rearc_engine_entry_mac.h"
+
+// ABI 1. All functions, frees and callbacks are main-thread-only (CHECKed).
+// Configure once before NSApplication exists; Run blocks until teardown.
+// Events/completions are serialized Chromium UI tasks, never inline in a
+// mutation/delegate stack. Callback pointers/strings are borrowed for the
+// callback duration. Copy strings before returning. Inputs are borrowed only
+// for the call. No restart or framework unload is supported.
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef int32_t ReArcStatus;
+enum {
+  REARC_OK = 0,
+  REARC_TAB_NOT_FOUND = 1,
+  REARC_WINDOW_NOT_FOUND = 2,
+  REARC_PROFILE_NOT_FOUND = 3,
+  REARC_NOT_FOUND = 4,
+  REARC_INVALID_URL = 5,
+  REARC_INVALID_ARGUMENT = 6,
+  REARC_INVALID_STATE = 7,
+  REARC_ENGINE_NOT_READY = 8,
+  REARC_VERSION_MISMATCH = 9,
+  REARC_UNSUPPORTED = 10,
+  REARC_BUSY = 11,
+  REARC_ALREADY_ATTACHED = 12,
+  REARC_STALE_ATTACHMENT = 13,
+  REARC_TOO_LARGE = 14,
+  REARC_CANCELLED = 15,
+  REARC_INTERNAL = 16
+};
+enum { REARC_ABI_VERSION = 1, REARC_MAX_BLOB_BYTES = 16777216 };
+
+// kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
+// changes bits: URL=1, title=2, loading=4, progress=8, crashed=16,
+// can_go_back=32, can_go_forward=64. Other fields apply by kind.
+// disposition: 0 shell, 1 foreground_tab, 2 background_tab, 3 popup.
+// transition: 0 typed, 1 link, 2 reload, 3 generated, 4 other.
+// closed_reason: 0 shell, 1 page, 2 engine.
+typedef struct ReArcTabEvent {
+  uint32_t kind;
+  uint64_t profile_id, tab_id, content_generation, space_id, opener_tab_id;
+  uint32_t disposition, changes;
+  const char* url;
+  const char* title;
+  bool is_loading, is_crashed, can_go_back, can_go_forward;
+  double load_progress;
+  uint32_t closed_reason;
+  uint64_t navigation_id;
+  bool is_main_frame, is_same_document, is_error_page;
+  uint32_t transition, transition_flags;
+  int32_t error_code;
+  const char* error_text;
+} ReArcTabEvent;
+
+// reason: 0 tab_closed, 1 window_closed, 2 content_replaced, 3 engine_stopped.
+typedef struct ReArcViewEvent {
+  uint64_t profile_id, tab_id, content_generation, attachment_id;
+  uint32_t reason;
+} ReArcViewEvent;
+
+typedef struct ReArcCallbacks {
+  void (*ready)(void* context, uint64_t default_profile_id);
+  void (*tab_event)(void* context, const ReArcTabEvent* event);
+  void (*view_invalidated)(void* context, const ReArcViewEvent* event);
+  // Notification only: call Shutdown to quit. Never exits from Cocoa.
+  void (*terminate_requested)(void* context);
+} ReArcCallbacks;
+
+// Accepted async operations invoke completion exactly once. Synchronous
+// rejection invokes no completion. cancelled=true means a beforeunload veto.
+// Successful shutdown completes after Run returns, as the last callback.
+typedef void (*ReArcCompletion)(void* context,
+                                ReArcStatus status,
+                                bool cancelled);
+
+typedef struct ReArcAttachment {
+  uint64_t attachment_id, content_generation;
+  // +1 retained NSView*. Release with ReArcViewRelease after dismantling.
+  // Retain survives invalidation, which empties this stable wrapper first.
+  void* native_view;
+} ReArcAttachment;
+
+REARC_ENGINE_EXPORT uint32_t ReArcEngineABIVersion(void);
+REARC_ENGINE_EXPORT const char* ReArcEngineVersion(void);
+REARC_ENGINE_EXPORT bool ReArcEngineHasFeature(const char* feature);
+REARC_ENGINE_EXPORT const char* ReArcStatusName(ReArcStatus status);
+REARC_ENGINE_EXPORT ReArcStatus
+ReArcEngineConfigure(uint32_t abi_version,
+                     const ReArcCallbacks* callbacks,
+                     void* context);
+// For browser invocation only; helpers call upstream ChromeMain directly.
+// Adds --no-startup-window, --no-first-run, --no-default-browser-check and
+// --profile-directory=Default unless a profile directory was supplied.
+REARC_ENGINE_EXPORT int ReArcEngineRun(int argc, const char* const* argv);
+REARC_ENGINE_EXPORT ReArcStatus ReArcEngineShutdown(bool force,
+                                                    ReArcCompletion completion,
+                                                    void* context);
+REARC_ENGINE_EXPORT uint64_t ReArcEngineDefaultProfile(void);
+
+// v1 admits only the startup profile. IDs are engine allocated, never reused.
+// space_id is a nonzero shell label. New tabs stage hidden; attach separately.
+// null URL means about:blank. Allowed navigation: http(s), about:blank.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabCreate(uint64_t profile_id,
+                                               uint64_t space_id,
+                                               const char* url,
+                                               uint64_t* tab_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabClose(uint64_t tab_id,
+                                              bool force,
+                                              ReArcCompletion completion,
+                                              void* context);
+// transition: 0 typed, 1 link, 3 generated. Other values are rejected.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabNavigate(uint64_t tab_id,
+                                                 const char* url,
+                                                 uint32_t transition);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabReload(uint64_t tab_id,
+                                               bool ignore_cache);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGoBack(uint64_t tab_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGoForward(uint64_t tab_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabStop(uint64_t tab_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabRefreshState(uint64_t tab_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabActivate(uint64_t tab_id);
+
+// Register a +0 NSWindow* before attachment; engine retains until Closed/Run
+// returns. Duplicate/zero IDs rejected. Closing a window keeps its tabs alive.
+REARC_ENGINE_EXPORT ReArcStatus ReArcWindowRegister(uint64_t window_id,
+                                                    void* ns_window);
+REARC_ENGINE_EXPORT ReArcStatus ReArcWindowClosed(uint64_t window_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcViewAttach(uint64_t tab_id,
+                                                uint64_t window_id,
+                                                double width,
+                                                double height,
+                                                double scale,
+                                                ReArcAttachment* attachment);
+REARC_ENGINE_EXPORT ReArcStatus ReArcViewDetach(uint64_t tab_id,
+                                                uint64_t attachment_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcViewResize(uint64_t tab_id,
+                                                uint64_t attachment_id,
+                                                double width,
+                                                double height,
+                                                double scale);
+// Call after parenting the returned NSView. Window visibility/occlusion is
+// observed automatically. All presented split panes may be visible.
+REARC_ENGINE_EXPORT ReArcStatus ReArcViewSetVisible(uint64_t tab_id,
+                                                    uint64_t attachment_id,
+                                                    bool visible);
+REARC_ENGINE_EXPORT void ReArcViewRelease(void* native_view);
+// Frees engine-allocated binary results; never free borrowed callback strings.
+REARC_ENGINE_EXPORT void ReArcBufferFree(void* buffer);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_ABI_H_
