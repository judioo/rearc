+struct Window {
+  NSWindow* __strong native = nil;
+  id __strong observer = nil;
+};
+struct Presentation {
+  uint64_t window_id;
+  uint64_t attachment_id;
+  bool intent = false;
+};
+
+// NoDestructor keeps callback/ObjC storage alive through ChromeMain teardown.
+class ABI final : public EngineReadinessSink,
+                  public TabEventSink,
+                  public AttachmentEventSink {
+ public:
+  ReArcCallbacks callbacks{};
+  raw_ptr<void> context = nullptr;
+  bool configured = false, ran = false, ready = false, stopping = false;
+  bool draining = false, scheduled = false;
+  std::deque<base::OnceClosure> deliveries;
+  std::map<uint64_t, Window> windows;
+  std::map<uint64_t, Presentation> presentations;
+  size_t live_tabs = 0;
+  std::vector<uint64_t> shutdown_tabs;
+  size_t shutdown_index = 0;
+  bool shutdown_force = false;
+  ReArcCompletion shutdown_completion = nullptr;
+  raw_ptr<void> shutdown_context = nullptr;
+
+  static ABI& Get() {
+    CHECK([NSThread isMainThread]);
+    static base::NoDestructor<ABI> state;
+    return *state;
+  }
+
+  void Drain() {
+    CHECK([NSThread isMainThread]);
+    scheduled = false;
+    // Callbacks may enter a nested native loop; never interleave deliveries.
+    if (draining) {
+      return;
+    }
+    draining = true;
+    while (!deliveries.empty()) {
+      auto callback = std::move(deliveries.front());
+      deliveries.pop_front();
+      std::move(callback).Run();
+    }
+    draining = false;
+  }
+
+  void OnEngineReady() override {
+    CHECK([NSThread isMainThread]);
+    CHECK(DefaultBridgeProfileId());
+    AcquireShellKeepAlive();
+    ready = true;
+    ABIPost(base::BindOnce([] {
+      auto& a = Get();
+      if (a.callbacks.ready) {
+        a.callbacks.ready(a.context, DefaultBridgeProfileId());
+      }
+    }));
+  }
+
+  void OnTabEvent(const TabEvent& event) override {
+    CHECK([NSThread isMainThread]);
+    CHECK(event.profile_id);
+    if (event.kind == TabEventKind::kTabCreated) {
+      ++live_tabs;
+    }
+    ABIPost(base::BindOnce(
+        [](TabEvent e) {
+          auto& a = Get();
+          if (!a.callbacks.tab_event) {
+            return;
+          }
+          const std::string title = base::UTF16ToUTF8(e.title);
+          ReArcTabEvent c{};
+          c.kind = static_cast<uint32_t>(e.kind);
+          c.profile_id = e.profile_id;
+          c.tab_id = e.tab_id;
+          c.content_generation = e.content_generation;
+          c.space_id = e.space_id;
+          c.opener_tab_id = e.opener_tab_id;
+          c.disposition = static_cast<uint32_t>(e.disposition);
+          c.changes = e.has_url | (e.has_title << 1) | (e.has_is_loading << 2) |
+                      (e.has_load_progress << 3) | (e.has_is_crashed << 4) |
+                      (e.has_can_go_back << 5) | (e.has_can_go_forward << 6);
+          c.url = e.url.c_str();
+          c.title = title.c_str();
+          c.is_loading = e.is_loading;
+          c.is_crashed = e.is_crashed;
+          c.can_go_back = e.can_go_back;
+          c.can_go_forward = e.can_go_forward;
+          c.load_progress = e.load_progress;
+          c.closed_reason = static_cast<uint32_t>(e.closed_reason);
+          c.navigation_id = e.navigation_id;
+          c.is_main_frame = e.is_main_frame;
+          c.is_same_document = e.is_same_document;
+          c.is_error_page = e.is_error_page;
+          c.transition = static_cast<uint32_t>(e.transition);
+          c.transition_flags = e.transition_flags;
+          c.error_code = e.error_code;
+          c.error_text = e.error_text.c_str();
+          a.callbacks.tab_event(a.context, &c);
+        },
+        event));
+  }
+
+  void OnLeaseInvalidated(uint64_t id,
+                          uint64_t lease,
+                          LeaseInvalidatedReason reason) override {
+    CHECK([NSThread isMainThread]);
+    presentations.erase(id);
+    auto* s = TabRegistry::Get().FindSession(id);
+    CHECK(s);
+    ReArcViewEvent event{s->profile_id(), id, s->content_generation(), lease,
+                         static_cast<uint32_t>(reason)};
+    ABIPost(base::BindOnce(
+        [](ReArcViewEvent e) {
+          auto& a = Get();
+          if (a.callbacks.view_invalidated) {
+            a.callbacks.view_invalidated(a.context, &e);
+          }
+        },
+        event));
+  }
+
+  void Reconcile(uint64_t id) {
+    auto p = presentations.find(id);
+    if (p == presentations.end()) {
+      return;
+    }
+    auto w = windows.find(p->second.window_id);
+    if (w == windows.end()) {
+      return;
+    }
+    NSWindow* window = w->second.native;
+    const bool visible =
+        p->second.intent && window.visible && !window.miniaturized;
+    auto& leases = AttachmentLeaseRegistry::Get();
+    leases.SetViewVisible(id, p->second.attachment_id, visible);
+    leases.SetViewOccluded(
+        id, p->second.attachment_id,
+        !(window.occlusionState & NSWindowOcclusionStateVisible));
+  }
+
+  void ReconcileWindow(uint64_t id) {
+    // No C callback is delivered by this synchronous native reconciliation.
+    for (const auto& [tab_id, p] : presentations) {
+      if (p.window_id == id) {
+        Reconcile(tab_id);
+      }
+    }
+  }
+
+  void ContinueShutdown() {
+    // Sequential close allows cancellation without starting later unloads.
+    while (shutdown_index < shutdown_tabs.size()) {
+      uint64_t id = shutdown_tabs[shutdown_index++];
+      if (!TabRegistry::Get().FindSession(id)) {
+        continue;
+      }
+      auto result = RequestTabClose(
+          id, shutdown_force, base::BindOnce([](CloseOutcome outcome) {
+            auto& a = Get();
+            if (outcome == CloseOutcome::kCancelled) {
+              a.stopping = false;
+              auto completion = a.shutdown_completion;
+              a.shutdown_completion = nullptr;
+              ABIPost(base::BindOnce(completion, a.shutdown_context.get(),
+                                     REARC_OK, true));
+            } else {
+              a.ContinueShutdown();
+            }
+          }));
+      CHECK(result == CloseRequestResult::kStarted);
+      return;
+    }
+    // DidDestroyTab runs after the contents destructor and posts tab.closed.
+    // It calls FinishShutdown when the final live contents has gone away.
+    if (!live_tabs) {
+      FinishShutdown();
+    }
+  }
+
+  void FinishShutdown() {
+    if (!ready) {
+      return;
+    }
+    ready = false;
+    CHECK_EQ(live_tabs, 0u);
+    CHECK_EQ(TabRegistry::Get().session_count(), 0u);
+    ReleaseBridgeProfiles();
+    // Run this after queued terminal tab/view events and close replies.
+    ABIPost(base::BindOnce([] {
+      browser_shutdown::SetTryingToQuit(true);
+      chrome::OnAppExiting();
+      ReleaseShellKeepAlive();
+    }));
+  }
+};
+
+bool Terminate(void*) {
+  ABIPost(base::BindOnce([] {
+    auto& a = ABI::Get();
+    if (a.callbacks.terminate_requested) {
+      a.callbacks.terminate_requested(a.context);
+    }
+  }));
+  return true;
+}
+bool CancelTerminate(void*) {
+  return true;
+}
+
+ReArcStatus Available() {
+  auto& a = ABI::Get();
+  return a.ready && !a.stopping ? REARC_OK : REARC_ENGINE_NOT_READY;
+}
+ReArcStatus CheckURL(const char* value, GURL* url) {
+  if (!value || !base::IsStringUTF8(value)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  *url = GURL(value);
+  if (!url->is_valid() ||
+      !(url->SchemeIsHTTPOrHTTPS() || url->spec() == "about:blank")) {
+    return REARC_INVALID_URL;
+  }
+  return REARC_OK;
+}
+bool ValidSize(double w, double h, double scale) {
+  return std::isfinite(w) && std::isfinite(h) && std::isfinite(scale) &&
+         w >= 0 && h >= 0 && w <= 32768 && h <= 32768 && scale > 0 &&
+         scale <= 16;
+}
+ReArcStatus CloseError(CloseRequestResult r) {
+  switch (r) {
+    case CloseRequestResult::kStarted:
+      return REARC_OK;
+    case CloseRequestResult::kBusy:
+      return REARC_BUSY;
+    case CloseRequestResult::kTabNotFound:
+      return REARC_TAB_NOT_FOUND;
+  }
+}
+}  // namespace
+
+void ABIPost(base::OnceClosure callback) {
+  auto& a = ABI::Get();
+  a.deliveries.push_back(std::move(callback));
+  if (a.draining || a.scheduled) {
+    return;
+  }
+  a.scheduled = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([] { ABI::Get().Drain(); }));
+}
+ReArcStatus ABICheckTab(uint64_t id, TabSession** session) {
+  CHECK([NSThread isMainThread]);
+  auto status = Available();
+  if (status) {
+    return status;
+  }
+  *session = TabRegistry::Get().FindSession(id);
+  if (!*session) {
+    return REARC_TAB_NOT_FOUND;
+  }
+  return (*session)->close_state() == TabSession::CloseState::kOpen
+             ? REARC_OK
+             : REARC_INVALID_STATE;
+}
+void ABIInitializeTab(uint64_t id) {
+  CHECK([NSThread isMainThread]);
+  AttachTabObserver(id);
+  EmitInitialSnapshotEvent(id);
+  ABIAttachServices(id);
+}
+// Replaced by tab/018 with the services implementation.
+void ABIAttachServices(uint64_t) {}
+void ABIDetachServices(uint64_t) {}
+void ABITabDestroyed() {
+  auto& a = ABI::Get();
+  CHECK(a.live_tabs);
+  --a.live_tabs;
+  if (a.stopping && a.shutdown_index == a.shutdown_tabs.size() &&
+      !a.live_tabs) {
+    a.FinishShutdown();
+  }
+}
