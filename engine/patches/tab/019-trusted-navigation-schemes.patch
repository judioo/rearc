diff --git a/chrome/browser/rearc_bridge/rearc_engine_abi.mm b/chrome/browser/rearc_bridge/rearc_engine_abi.mm
index c8bdb88114..4a3cc73f2d 100644
--- a/chrome/browser/rearc_bridge/rearc_engine_abi.mm
+++ b/chrome/browser/rearc_bridge/rearc_engine_abi.mm
@@ -262,13 +262,30 @@ ReArcStatus Available() {
   auto& a = ABI::Get();
   return a.ready && !a.stopping ? REARC_OK : REARC_ENGINE_NOT_READY;
 }
+bool AllowedURL(const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  if (url.SchemeIsHTTPOrHTTPS() || url.SchemeIs("data") ||
+      url.SchemeIsFile() ||
+      (url.SchemeIs("chrome") &&
+       (url.host() == "settings" || url.host() == "version")) ||
+      url.spec() == "about:blank") {
+    return true;
+  }
+  if (url.SchemeIs("view-source")) {
+    const GURL inner(url.GetContent());
+    return inner.is_valid() &&
+           (inner.SchemeIsHTTPOrHTTPS() || inner.SchemeIsFile());
+  }
+  return false;
+}
 ReArcStatus CheckURL(const char* value, GURL* url) {
   if (!value || !base::IsStringUTF8(value)) {
     return REARC_INVALID_ARGUMENT;
   }
   *url = GURL(value);
-  if (!url->is_valid() ||
-      !(url->SchemeIsHTTPOrHTTPS() || url->spec() == "about:blank")) {
+  if (!AllowedURL(*url)) {
     return REARC_INVALID_URL;
   }
   return REARC_OK;
