diff --git a/chrome/browser/rearc_bridge/rearc_pip.cc b/chrome/browser/rearc_bridge/rearc_pip.cc
new file mode 100644
index 0000000000..99e49ad5ea
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_pip.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_pip.h"
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/picture_in_picture/picture_in_picture_window_manager.h"
+#include "chrome/browser/rearc_bridge/media_adapter.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace rearc {
+namespace {
+ReArcPictureInPictureCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+class State : public content::WebContentsObserver,
+              public content::WebContentsUserData<State> {
+ public:
+  void Bind(uint64_t tab_id) {
+    TabSession* session = TabRegistry::Get().FindSession(tab_id);
+    event_ = {session ? session->profile_id() : 0, tab_id,
+              session ? session->content_generation() : 0, 0};
+  }
+  bool TakeFocus() {
+    bool focus = focus_window_;
+    focus_window_ = false;
+    return focus;
+  }
+  void Publish(uint32_t phase) {
+    ReArcPictureInPictureEvent event = event_;
+    event.phase = phase;
+    ABIPost(base::BindOnce(
+        [](uint64_t expected, ReArcPictureInPictureEvent event) {
+          if (host && expected == epoch) host(host_context, &event);
+        },
+        epoch, event));
+  }
+  void MediaPictureInPictureChanged(bool active) override {
+    if (active == active_) return;
+    active_ = active;
+    Publish(active ? 0 : 1);
+    if (!active) {
+      // Back to tab closes the window, then activates the initiator in the
+      // same task: only that activation is a PiP focus request.
+      focus_window_ = true;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&State::EndFocusWindow,
+                                    weak_.GetWeakPtr()));
+    }
+  }
+  void WebContentsDestroyed() override {
+    if (active_) {
+      active_ = false;
+      Publish(1);
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<State>;
+  explicit State(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<State>(*contents) {}
+  void EndFocusWindow() { focus_window_ = false; }
+  ReArcPictureInPictureEvent event_{};
+  bool active_ = false, focus_window_ = false;
+  base::WeakPtrFactory<State> weak_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(State);
+}  // namespace
+
+bool HostPictureInPictureEnabled() {
+  return host;
+}
+content::PictureInPictureResult EnterHostPictureInPicture(
+    uint64_t tab_id, content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  // ABI <=1.29 behavior without a host callback: the page's request fails.
+  if (!host) return content::PictureInPictureResult::kNotSupported;
+  State::GetOrCreateForWebContents(contents)->Bind(tab_id);
+  return PictureInPictureWindowManager::GetInstance()
+      ->EnterVideoPictureInPicture(contents);
+}
+void ExitHostPictureInPicture() {
+  PictureInPictureWindowManager::GetInstance()->ExitPictureInPicture();
+}
+bool TakeHostPictureInPictureFocus(uint64_t tab_id) {
+  auto* session = TabRegistry::Get().FindSession(tab_id);
+  auto* state = session ? State::FromWebContents(session->web_contents())
+                        : nullptr;
+  if (!state || !state->TakeFocus()) return false;
+  state->Publish(2);
+  return true;
+}
+ReArcStatus SetHostPictureInPicture(uint64_t tab_id,
+                                    content::WebContents* contents,
+                                    bool active) {
+  if (!host) return REARC_UNSUPPORTED;
+  if (!active) {
+    if (!contents->HasPictureInPictureVideo()) return REARC_INVALID_STATE;
+    content::MediaSession::Get(contents)->ExitPictureInPicture();
+    return REARC_OK;
+  }
+  if (contents->HasPictureInPictureVideo()) return REARC_OK;
+  // Chromium's own availability (one eligible video player or a page
+  // 'enterpictureinpicture' handler), as Global Media Controls use it.
+  if (!MediaCanEnterPictureInPicture(tab_id)) return REARC_INVALID_STATE;
+  State::GetOrCreateForWebContents(contents)->Bind(tab_id);
+  content::MediaSession::Get(contents)->EnterPictureInPicture();
+  return REARC_OK;
+}
+}  // namespace rearc
+
+void ReArcEngineSetPictureInPictureCallback(
+    ReArcPictureInPictureCallback callback, void* context) {
+  CHECK(pthread_main_np());
+  // The replaced host can no longer own the window it was told about.
+  if (rearc::host) {
+    for (uint64_t id : rearc::TabRegistry::Get().SessionIds()) {
+      auto* session = rearc::TabRegistry::Get().FindSession(id);
+      if (session && session->web_contents()->HasPictureInPictureVideo()) {
+        rearc::ExitHostPictureInPicture();
+        break;
+      }
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+}
