-// PiP is unsupported at this pin's browser-less delegate integration.
+// Before ABI 1.30 (or without a picture_in_picture callback): unsupported.
+// With it: true asks Chromium's media session to put the tab's eligible video
+// in PiP (media event pip_available; else invalid_state; already in PiP: OK);
+// the entered event follows. false exits (not in PiP: invalid_state).
 REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetPictureInPicture(uint64_t tab_id,
                                                             bool active);
+// Video Picture-in-Picture (picture_in_picture, ABI 1.30). Registering a
+// callback enables Chromium's PictureInPictureWindowManager for registry tabs:
+// video.requestPictureInPicture() and ReArcTabSetPictureInPicture open
+// Chromium's floating overlay window (play/pause, back to tab, close). One
+// PiP window exists process-wide; a new one replaces it. Without a callback,
+// page requests fail as before. Media events then carry real pip_available /
+// pip_active. phase: 0 entered, 1 exited (page, window close, host, close,
+// navigation, replacement), 2 back-to-tab: present and focus the tab. Page
+// window.focus() is never surfaced. Document PiP stays unsupported.
+typedef struct ReArcPictureInPictureEvent {
+  uint64_t profile_id, tab_id, content_generation;
+  uint32_t phase;
+} ReArcPictureInPictureEvent;
+typedef void (*ReArcPictureInPictureCallback)(
+    void* context, const ReArcPictureInPictureEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetPictureInPictureCallback(
+    ReArcPictureInPictureCallback callback, void* context);
 // Output is +1 malloc PNG, free with ReArcBufferFree. Bound to tab/profile.
 REARC_ENGINE_EXPORT ReArcStatus ReArcFaviconGet(uint64_t tab_id,
                                                 const char* icon_ref,
