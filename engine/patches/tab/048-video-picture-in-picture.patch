     EmitServiceEvent(event_);
   }
 
@@ -84,8 +88,18 @@ class MediaAdapter : public content::WebContentsObserver,
 
   void MediaSessionActionsChanged(
       const std::vector<MediaSessionAction>& actions) override {
+    const bool pip = CanEnterPictureInPicture();
     actions_ = actions;
+    if (pip != CanEnterPictureInPicture()) {
+      Publish();
+    }
+  }
+  bool CanEnterPictureInPicture() const {
+    return std::find(actions_.begin(), actions_.end(),
+                     MediaSessionAction::kEnterPictureInPicture) !=
+           actions_.end();
   }
+  void MediaPictureInPictureChanged(bool) override { Publish(); }
   void MediaSessionImagesChanged(
       const base::flat_map<media_session::mojom::MediaSessionImageType,
                            std::vector<media_session::MediaImage>>& images)
@@ -230,6 +244,14 @@ MediaCommandResult MediaSetPlayback(uint64_t tab_id,
