+// Extension prompts (extension_install_prompts, ABI 1.32). Chromium's
+// extension install, re-enable and permission confirmations (Web Store,
+// CRX, chrome://extensions) and its uninstall confirmation are host requests;
+// Chromium's dialogs, its post-install Browser window/bubble and its error
+// infobar are never shown. Without a callback install prompts abort and
+// uninstall confirmations cancel. Register before tabs.
+// phase: 0 request, 1 cancelled (tab close, profile release, replacement or
+// Chromium withdrew it), 2 installed, 3 install failed (2/3 are notifications
+// with request_id 0). kind: Chromium InstallPromptData::PromptType (0 install,
+// 3 re-enable, 4 permissions, 5 external, 8 remote, 9 repair, 13/14 request,
+// 15 parent approval) or 100 uninstall. tab_id 0: not parented to a registry
+// tab (window-parented chrome://extensions dialogs, background installs).
+// title/labels/permissions are Chromium's localized strings; icon_png is a
+// borrowed PNG (may be null). error: phase 3 only.
+typedef struct ReArcExtensionPromptEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase, kind;
+  const char* extension_id;
+  const char* name;
+  const char* title;
+  const char* accept_label;
+  const char* cancel_label;
+  const char* const* permissions;
+  size_t permission_count;
+  const char* triggering_extension;
+  const char* error;
+  const uint8_t* icon_png;
+  size_t icon_png_size;
+} ReArcExtensionPromptEvent;
+typedef void (*ReArcExtensionPromptCallback)(void*,
+                                             const ReArcExtensionPromptEvent*);
+REARC_ENGINE_EXPORT void ReArcEngineSetExtensionPromptCallback(
+    ReArcExtensionPromptCallback callback, void* context);
+// action: 0 accept (install/enable/grant, or remove for kind 100), 1 cancel.
+// Single use; stale/cancelled IDs -> not_found.
+REARC_ENGINE_EXPORT ReArcStatus ReArcExtensionPromptRespond(
+    uint64_t request_id, uint32_t action);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
