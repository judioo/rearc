+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/extensions/extension_install_prompt_show_params.h"  // nogncheck
+#include "chrome/browser/extensions/extension_uninstall_dialog.h"  // nogncheck
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "extensions/browser/install_prompt_data.h"
+#include "extensions/browser/ui_util.h"
+#include "extensions/common/extension.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/strings/grit/ui_strings.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace rearc {
+namespace {
+
+constexpr uint32_t kUninstallKind = 100;
+
+ReArcExtensionPromptCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+
+// Owned copy of an event; pointers are filled in at delivery.
+struct Snapshot {
+  ReArcExtensionPromptEvent event{};
+  std::string extension_id, name, title, accept_label, cancel_label,
+      triggering_extension, error;
+  std::vector<std::string> permissions;
+  std::vector<uint8_t> icon;
+};
+
+std::vector<uint8_t> EncodeIcon(const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing()) {
+    return {};
+  }
+  return gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false)
+      .value_or(std::vector<uint8_t>());
+}
+
+void Publish(Snapshot snapshot, bool requires_pending);
+
+class Request;
+std::map<uint64_t, std::unique_ptr<Request>>& Pending() {
+  static base::NoDestructor<std::map<uint64_t, std::unique_ptr<Request>>> map;
+  return *map;
+}
+
+class HostUninstallDialog;
+
+// One pending host request. Install prompts own Chromium's DoneCallback and
+// prompt data; uninstall requests point back at their dialog.
+class Request : public content::WebContentsObserver {
+ public:
+  explicit Request(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+  void WebContentsDestroyed() override;
+
+  Snapshot snapshot;
+  ExtensionInstallPrompt::DoneCallback done;
+  std::unique_ptr<extensions::InstallPromptData> prompt;
+  std::unique_ptr<ExtensionInstallPromptShowParams> params;
+  base::WeakPtr<extensions::ExtensionUninstallDialog> uninstall;
+};
+
+std::unique_ptr<Request> Take(uint64_t id) {
+  auto it = Pending().find(id);
+  if (it == Pending().end()) {
+    return nullptr;
+  }
+  auto request = std::move(it->second);
+  Pending().erase(it);
+  return request;
+}
+
+void CloseUninstallLater(base::WeakPtr<extensions::ExtensionUninstallDialog> d,
+                         extensions::ExtensionUninstallDialog::CloseAction a) {
+  // The delegate usually destroys the dialog from OnDialogClosed; never do
+  // that inside the dialog's own Show/Close or a registry iteration.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&extensions::ExtensionUninstallDialog::OnDialogClosed,
+                     std::move(d), a));
+}
+
+// Cancellation: phase 1 event, then Chromium's abort/cancel result.
+void Cancel(uint64_t id) {
+  auto request = Take(id);
+  if (!request) {
+    return;
+  }
+  Snapshot snapshot = request->snapshot;
+  snapshot.event.phase = 1;
+  Publish(std::move(snapshot), false);
+  if (request->done) {
+    if (request->prompt) {
+      request->prompt->OnDialogCanceled();
+    }
+    std::move(request->done)
+        .Run(ExtensionInstallPrompt::DoneCallbackPayload(
+            ExtensionInstallPrompt::Result::ABORTED));
+  } else if (request->uninstall) {
+    CloseUninstallLater(
+        request->uninstall,
+        extensions::ExtensionUninstallDialog::CLOSE_ACTION_CANCELED);
+  }
+}
+
+void Request::WebContentsDestroyed() {
+  // `this` is destroyed by Cancel.
+  Cancel(snapshot.event.request_id);
+}
+
+void Publish(Snapshot snapshot, bool requires_pending) {
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, bool requires_pending, Snapshot s) {
+        if (!host || expected != epoch ||
+            (requires_pending && !Pending().contains(s.event.request_id))) {
+          return;
+        }
+        std::vector<const char*> permissions;
+        for (const auto& p : s.permissions) {
+          permissions.push_back(p.c_str());
+        }
+        ReArcExtensionPromptEvent e = s.event;
+        e.extension_id = s.extension_id.c_str();
+        e.name = s.name.c_str();
+        e.title = s.title.c_str();
+        e.accept_label = s.accept_label.c_str();
+        e.cancel_label = s.cancel_label.c_str();
+        e.permissions = permissions.empty() ? nullptr : permissions.data();
+        e.permission_count = permissions.size();
+        e.triggering_extension = s.triggering_extension.c_str();
+        e.error = s.error.c_str();
+        e.icon_png = s.icon.empty() ? nullptr : s.icon.data();
+        e.icon_png_size = s.icon.size();
+        host(host_context, &e);
+      },
+      epoch, requires_pending, std::move(snapshot)));
+}
+
+// Fills profile/tab identity. A prompt parented to a registry tab carries its
+// tab; window-parented and background prompts carry tab 0.
+void Identify(Snapshot& s, Profile* profile, content::WebContents* contents) {
+  s.event.profile_id = profile ? BridgeProfileId(profile) : 0;
+  if (!s.event.profile_id && profile) {
+    s.event.profile_id = BridgeProfileId(profile->GetOriginalProfile());
+  }
+  if (!contents) {
+    return;
+  }
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    TabSession* session = TabRegistry::Get().FindSession(id);
+    if (session && session->web_contents() == contents) {
+      s.event.tab_id = session->tab_id();
+      s.event.content_generation = session->content_generation();
+      s.event.profile_id = session->profile_id();
+      return;
+    }
+  }
+}
+
+uint64_t Enqueue(std::unique_ptr<Request> request) {
+  const uint64_t id = next_id++;
+  request->snapshot.event.request_id = id;
+  request->snapshot.event.phase = 0;
+  Snapshot snapshot = request->snapshot;
+  Pending().emplace(id, std::move(request));
+  Publish(std::move(snapshot), true);
+  return id;
+}
+
+class HostUninstallDialog : public extensions::ExtensionUninstallDialog {
+ public:
+  HostUninstallDialog(Profile* profile,
+                      gfx::NativeWindow parent,
+                      Delegate* delegate)
+      : extensions::ExtensionUninstallDialog(profile, parent, delegate),
+        profile_(profile) {}
+  ~HostUninstallDialog() override {
+    // Destroyed by its owner without a reply: withdraw the request.
+    if (id_ && Take(id_)) {
+      Snapshot snapshot;
+      snapshot.event = event_;
+      snapshot.event.phase = 1;
+      Publish(std::move(snapshot), false);
+    }
+  }
+
+ private:
+  void Show() override {
+    if (!host) {
+      CloseUninstallLater(AsWeakPtr(), CLOSE_ACTION_CANCELED);
+      return;
+    }
+    auto request = std::make_unique<Request>(nullptr);
+    Snapshot& s = request->snapshot;
+    s.event.kind = kUninstallKind;
+    Identify(s, profile_, nullptr);
+    s.extension_id = extension()->id();
+    s.name = extension()->name();
+    s.title = base::UTF16ToUTF8(l10n_util::GetStringFUTF16(
+        IDS_EXTENSION_PROMPT_UNINSTALL_TITLE,
+        extensions::ui_util::GetFixupExtensionNameForUIDisplay(
+            extension()->name())));
+    s.accept_label = base::UTF16ToUTF8(
+        l10n_util::GetStringUTF16(IDS_EXTENSION_PROMPT_UNINSTALL_BUTTON));
+    s.cancel_label =
+        base::UTF16ToUTF8(l10n_util::GetStringUTF16(IDS_APP_CANCEL));
+    if (triggering_extension()) {
+      s.triggering_extension = triggering_extension()->name();
+    }
+    if (const SkBitmap* bitmap = icon().bitmap()) {
+      s.icon = EncodeIcon(*bitmap);
+    }
+    request->uninstall = AsWeakPtr();
+    event_ = s.event;
+    id_ = Enqueue(std::move(request));
+  }
+  void Close() override {
+    if (id_) {
+      Cancel(std::exchange(id_, 0));
+    }
+  }
+
+  raw_ptr<Profile> profile_;
+  uint64_t id_ = 0;
+  ReArcExtensionPromptEvent event_{};
+};
+
+}  // namespace
+
+void ShowHostExtensionInstallPrompt(
+    std::unique_ptr<ExtensionInstallPromptShowParams> show_params,
+    ExtensionInstallPrompt::DoneCallback done_callback,
+    std::unique_ptr<extensions::InstallPromptData> prompt) {
+  CHECK(pthread_main_np());
+  if (!host || show_params->WasParentDestroyed()) {
+    // Conservative: never Chromium UI, never an implicit accept.
+    prompt->OnDialogCanceled();
+    std::move(done_callback)
+        .Run(ExtensionInstallPrompt::DoneCallbackPayload(
+            ExtensionInstallPrompt::Result::ABORTED));
+    return;
+  }
+  content::WebContents* contents = show_params->GetParentWebContents();
+  auto request = std::make_unique<Request>(contents);
+  Snapshot& s = request->snapshot;
+  s.event.kind = static_cast<uint32_t>(prompt->type());
+  Identify(s, show_params->profile(), contents);
+  if (const extensions::Extension* extension = prompt->extension()) {
+    s.extension_id = extension->id();
+    s.name = extension->name();
+  }
+  s.title = base::UTF16ToUTF8(prompt->GetDialogTitle());
+  s.accept_label = base::UTF16ToUTF8(prompt->GetAcceptButtonLabel());
+  s.cancel_label = base::UTF16ToUTF8(prompt->GetAbortButtonLabel());
+  for (size_t i = 0; i < prompt->GetPermissionCount(); ++i) {
+    s.permissions.push_back(base::UTF16ToUTF8(prompt->GetPermission(i)));
+  }
+  if (!prompt->icon().IsEmpty()) {
+    s.icon = EncodeIcon(*prompt->icon().ToSkBitmap());
+  }
+  request->done = std::move(done_callback);
+  request->prompt = std::move(prompt);
+  request->params = std::move(show_params);
+  Enqueue(std::move(request));
+}
+
+std::unique_ptr<extensions::ExtensionUninstallDialog>
+CreateHostExtensionUninstallDialog(
+    Profile* profile,
+    gfx::NativeWindow parent,
+    extensions::ExtensionUninstallDialog::Delegate* delegate) {
+  return std::make_unique<HostUninstallDialog>(profile, parent, delegate);
+}
+
+void NotifyHostExtensionInstalled(Profile* profile,
+                                  const extensions::Extension& extension,
+                                  const SkBitmap* icon) {
+  CHECK(pthread_main_np());
+  Snapshot s;
+  s.event.phase = 2;
+  s.event.kind = static_cast<uint32_t>(
+      extensions::InstallPromptData::INSTALL_PROMPT);
+  Identify(s, profile, nullptr);
+  s.extension_id = extension.id();
+  s.name = extension.name();
+  if (icon) {
+    s.icon = EncodeIcon(*icon);
+  }
+  Publish(std::move(s), false);
+}
+
+void NotifyHostExtensionInstallFailed(Profile* profile,
+                                      const std::string& extension_id,
+                                      const std::u16string& error) {
+  CHECK(pthread_main_np());
+  Snapshot s;
+  s.event.phase = 3;
+  s.event.kind = static_cast<uint32_t>(
+      extensions::InstallPromptData::INSTALL_PROMPT);
+  Identify(s, profile, nullptr);
+  s.extension_id = extension_id;
+  s.error = base::UTF16ToUTF8(error);
+  Publish(std::move(s), false);
+}
+
+void ABICancelExtensionPrompts(uint64_t tab_id, uint64_t profile_id) {
+  CHECK(pthread_main_np());
+  std::vector<uint64_t> ids;
+  for (const auto& [id, request] : Pending()) {
+    const auto& e = request->snapshot.event;
+    if ((tab_id && e.tab_id == tab_id) ||
+        (profile_id && e.profile_id == profile_id)) {
+      ids.push_back(id);
+    }
+  }
+  for (uint64_t id : ids) {
+    Cancel(id);
+  }
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetExtensionPromptCallback(ReArcExtensionPromptCallback cb,
+                                           void* ctx) {
+  CHECK(pthread_main_np());
+  std::vector<uint64_t> ids;
+  for (const auto& [id, request] : rearc::Pending()) {
+    ids.push_back(id);
+  }
+  for (uint64_t id : ids) {
+    rearc::Cancel(id);
+  }
+  ++rearc::epoch;
+  rearc::host = cb;
+  rearc::host_context = ctx;
+}
+
+ReArcStatus ReArcExtensionPromptRespond(uint64_t id, uint32_t action) {
+  CHECK(pthread_main_np());
+  if (action > 1) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  auto request = rearc::Take(id);
+  if (!request) {
+    return REARC_NOT_FOUND;
+  }
+  const bool accept = action == 0;
+  if (request->done) {
+    ExtensionInstallPrompt::Result result =
+        !accept ? ExtensionInstallPrompt::Result::USER_CANCELED
+        : request->prompt->ShouldWithheldPermissionsOnDialogAccept()
+            ? ExtensionInstallPrompt::Result::ACCEPTED_WITH_WITHHELD_PERMISSIONS
+            : ExtensionInstallPrompt::Result::ACCEPTED;
+    if (accept) {
+      request->prompt->OnDialogAccepted();
+    } else {
+      request->prompt->OnDialogCanceled();
+    }
+    std::move(request->done)
+        .Run(ExtensionInstallPrompt::DoneCallbackPayload(result));
+  } else if (request->uninstall) {
+    rearc::CloseUninstallLater(
+        request->uninstall,
+        accept ? extensions::ExtensionUninstallDialog::CLOSE_ACTION_UNINSTALL
+               : extensions::ExtensionUninstallDialog::CLOSE_ACTION_CANCELED);
+  }
+  return REARC_OK;
+}
