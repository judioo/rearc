+// Download event batches (download_event_batches, ABI 1.49). While a batch
+// callback is set, every download event goes to it instead of the per-event
+// callback, in the same order relative to each other and to every other host
+// callback: events queued back to back (a history slice's created events)
+// arrive in one call, at most 1024 per call. times[i] is events[i]'s item
+// start and end (microseconds since the Unix epoch; end 0 until it finishes),
+// so a restored item's dates need no ReArcDownloadGetTimes. Both arrays are
+// borrowed for the call. Null returns to per-event delivery; a queued batch
+// then goes to the per-event callback, one event at a time.
+typedef struct ReArcDownloadTimes {
+  int64_t start_time_us, end_time_us;
+} ReArcDownloadTimes;
+typedef void (*ReArcDownloadBatchCallback)(void* context,
+                                           const ReArcDownloadEvent* events,
+                                           const ReArcDownloadTimes* times,
+                                           uint32_t count);
+REARC_ENGINE_EXPORT void ReArcEngineSetDownloadBatchCallback(
+    ReArcDownloadBatchCallback callback, void* context);
