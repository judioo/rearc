-// ReArc: UI-thread work per slice of the initial load.
-constexpr base::TimeDelta kHistoryLoadSliceBudget = base::Milliseconds(8);
+// ReArc: UI-thread work per slice of the initial load. With the host's
+// delivery of the slice's events it fits a 120 Hz frame.
+constexpr base::TimeDelta kHistoryLoadSliceBudget = base::Milliseconds(4);
+// ReArc: the next slice is a delayed task, due after the host has taken the
+// slice's events (about half the slice's time), so the host's run loop runs
+// out of work between slices and commits a frame. An immediate task, or a
+// shorter delay that came due during the delivery, ran the slices and their
+// events back to back as one stall.
+constexpr base::TimeDelta kHistoryLoadSliceGap = base::Milliseconds(4);
 
