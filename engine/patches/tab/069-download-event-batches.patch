+// Borrows `s`'s strings.
+ReArcDownloadEvent EventFor(const Snapshot& s) {
+  ReArcDownloadEvent e{};
+  e.kind = s.kind;
+  e.profile_id = s.profile_id;
+  e.download_id = s.download_id;
+  e.tab_id = s.tab_id;
+  e.guid = s.guid.c_str();
+  e.url = s.url.c_str();
+  e.target_path = s.target_path.c_str();
+  e.mime_type = s.mime_type.c_str();
+  e.received_bytes = s.received_bytes;
+  e.total_bytes = s.total_bytes;
+  e.state = s.state;
+  e.danger_type = s.danger_type;
+  e.interrupt_reason = s.interrupt_reason;
+  e.paused = s.paused;
+  e.can_resume = s.can_resume;
+  return e;
+}
+
+int64_t UnixMicros(base::Time time) {
+  return time.is_null() ? 0 : (time - base::Time::UnixEpoch()).InMicroseconds();
+}
+
+// 1.49: events queued since this batch's delivery, appended while nothing
+// else has been posted after it, so order is unchanged.
+struct EventBatch : base::RefCounted<EventBatch> {
+  std::vector<Snapshot> events;
+  uint64_t posted = 0;  // ABIPostCount() once the delivery was queued
+
+ private:
+  friend class base::RefCounted<EventBatch>;
+  ~EventBatch() = default;
+};
+
+scoped_refptr<EventBatch>& OpenBatch() {
+  static base::NoDestructor<scoped_refptr<EventBatch>> batch;
+  return *batch;
+}
+
+void DeliverBatch(scoped_refptr<EventBatch> batch) {
+  CHECK(pthread_main_np());
+  if (OpenBatch() == batch) {
+    OpenBatch() = nullptr;
+  }
+  const std::vector<Snapshot> snapshots = std::move(batch->events);
+  if (batch_callback) {
+    std::vector<ReArcDownloadEvent> events;
+    std::vector<ReArcDownloadTimes> times;
+    events.reserve(snapshots.size());
+    times.reserve(snapshots.size());
+    for (const Snapshot& s : snapshots) {
+      events.push_back(EventFor(s));
+      times.push_back({s.start_time_us, s.end_time_us});
+    }
+    batch_callback(batch_context, events.data(), times.data(),
+                   static_cast<uint32_t>(events.size()));
+    return;
+  }
+  for (const Snapshot& s : snapshots) {
+    if (!download_callback) {
+      return;
+    }
+    const ReArcDownloadEvent e = EventFor(s);
+    download_callback(download_context, &e);
+  }
+}
+
