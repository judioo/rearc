-        e.state = s.state;
-        e.danger_type = s.danger_type;
-        e.interrupt_reason = s.interrupt_reason;
-        e.paused = s.paused;
-        e.can_resume = s.can_resume;
-        download_callback(download_context, &e);
-      },
-      std::move(s)));
+  if (!batch_callback) {
+    ABIPost(base::BindOnce(
+        [](Snapshot s) {
+          CHECK(pthread_main_np());
+          if (!download_callback) {
+            return;
+          }
+          const ReArcDownloadEvent e = EventFor(s);
+          download_callback(download_context, &e);
+        },
+        std::move(s)));
+    return;
+  }
+  s.start_time_us = UnixMicros(item->GetStartTime());
+  s.end_time_us = UnixMicros(item->GetEndTime());
+  scoped_refptr<EventBatch>& open = OpenBatch();
+  if (open && open->posted == ABIPostCount() &&
+      open->events.size() < kMaxEventsPerBatch) {
+    open->events.push_back(std::move(s));
+    return;
+  }
+  open = base::MakeRefCounted<EventBatch>();
+  open->events.push_back(std::move(s));
+  ABIPost(base::BindOnce(&DeliverBatch, open));
+  open->posted = ABIPostCount();
