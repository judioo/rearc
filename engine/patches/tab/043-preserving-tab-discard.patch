+#include <pthread.h>
+#include "base/check.h"
+#include "base/feature_list.h"
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/content_features.h"
+
+ReArcStatus ReArcTabGetDiscardState(uint64_t tab, bool* discarded) {
+  CHECK(pthread_main_np());
+  if (discarded) *discarded = false;
+  if (!discarded) return REARC_INVALID_ARGUMENT;
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab, &session)) return status;
+  *discarded = session->web_contents()->WasDiscarded();
+  return REARC_OK;
+}
+ReArcStatus ReArcTabDiscard(uint64_t tab) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab, &session)) return status;
+  // Run enables the preserving path in embedded mode. An explicit host
+  // --disable-features=WebContentsDiscard remains authoritative.
+  if (!base::FeatureList::IsEnabled(features::kWebContentsDiscard))
+    return REARC_UNSUPPORTED;
+  auto* contents = session->web_contents();
+  auto& controller = contents->GetController();
+  if (contents->WasDiscarded() || rearc::ABIHasVisibilityIntent(tab) ||
+      contents->GetVisibility() != content::Visibility::HIDDEN ||
+      contents->IsLoading() || controller.GetPendingEntry() ||
+      contents->HasUncommittedNavigationInPrimaryMainFrame() ||
+      !controller.GetLastCommittedEntry() || contents->IsCrashed() ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive() ||
+      contents->IsBeingCaptured() || contents->IsCurrentlyAudible() ||
+      contents->HasPictureInPictureVideo() || contents->HasPictureInPictureDocument() ||
+      contents->IsFullscreen() || contents->NeedToFireBeforeUnloadOrUnloadEvents())
+    return REARC_INVALID_STATE;
+  if (rearc::ABIDiscardServicesBusy(tab)) return REARC_BUSY;
+  // Never kill a RenderProcessHost: unrelated tabs may share its process.
+  // Preserving discard releases the document asynchronously and flushes BFCache
+  // while keeping navigation entries, helpers and the stable native container.
+  contents->Discard(base::DoNothing());
+  return contents->WasDiscarded() ? REARC_OK : REARC_BUSY;
+}
