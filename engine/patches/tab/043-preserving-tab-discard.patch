+void TabObserver::WasDiscarded() {
+  // NotifyWasDiscarded also runs when content rejects the operation.
+  if (!web_contents()->WasDiscarded()) return;
+  discarded_ = true;
+  TabEvent event;
+  event.kind = TabEventKind::kTabDiscarded;
+  event.tab_id = tab_id_;
+  event.url = web_contents()->GetVisibleURL().spec();
+  event.title = web_contents()->GetTitle();
+  EmitTabEvent(std::move(event));
+}
+void TabObserver::DidStartNavigation(content::NavigationHandle* handle) {
+  if (discarded_ && handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    discarded_ = false;
+    TabEvent event;
+    event.kind = TabEventKind::kTabDiscardCleared;
+    event.tab_id = tab_id_;
+    event.url = web_contents()->GetVisibleURL().spec();
+    event.title = web_contents()->GetTitle();
+    EmitTabEvent(std::move(event));
+  }
+}
