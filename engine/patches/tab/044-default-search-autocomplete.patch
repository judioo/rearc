+// Default search and autocomplete (search_autocomplete, ABI 1.26) over the
+// profile's TemplateURLService and Chromium's AutocompleteController. Calls
+// wait for the keyword service to load; callbacks are deferred, exactly once.
+// Text is non-empty UTF-8 <=4096 bytes. URLs use "%s" for the search terms,
+// with Chromium's other template parameters already resolved. OTR IDs read
+// their original's search engines but never its history/bookmarks/shortcuts
+// and never send remote suggest requests; SetDefaultProvider rejects OTR.
+typedef struct ReArcSearchProvider {
+  const char* name;
+  const char* keyword;
+  const char* search_url;
+  const char* suggest_url;  // Empty when the engine has none.
+  bool is_managed, is_prepopulated;
+} ReArcSearchProvider;
+typedef void (*ReArcSearchProviderCallback)(void* context, ReArcStatus status,
+                                            uint64_t profile_id,
+                                            const ReArcSearchProvider* provider);
+REARC_ENGINE_EXPORT ReArcStatus ReArcSearchGetDefaultProvider(
+    uint64_t profile_id, ReArcSearchProviderCallback completion, void* context);
+// name/keyword non-empty (keyword without whitespace); http(s) templates with
+// %s; suggest_url null/empty for none. is_* fields are ignored. Reuses an
+// identical engine or adds a user engine, then makes it default. Policy-managed
+// default search: invalid_state.
+REARC_ENGINE_EXPORT ReArcStatus ReArcSearchSetDefaultProvider(
+    uint64_t profile_id, const ReArcSearchProvider* provider,
+    ReArcCompletion completion, void* context);
+// kind: 0 none, 1 url (navigate), 2 search. match_type is Chromium's
+// AutocompleteMatchType. Uses synchronous providers only, no network.
+typedef struct ReArcInputClassification {
+  uint32_t kind, match_type;
+  const char* destination_url;
+} ReArcInputClassification;
+typedef void (*ReArcClassifyCallback)(void* context, ReArcStatus status,
+                                      uint64_t profile_id,
+                                      const ReArcInputClassification* result);
+REARC_ENGINE_EXPORT ReArcStatus ReArcSearchClassifyInput(
+    uint64_t profile_id, const char* text, ReArcClassifyCallback completion,
+    void* context);
+// One active query per profile. Start supersedes (and Stop ends) the previous
+// query: it receives one terminal result with status cancelled. A query gets
+// zero or more done=false updates, then exactly one done=true result (OK or
+// cancelled; profile release cancels). Ignore results for older query IDs.
+// options: 1 prevent inline autocompletion. Matches are Chromium's ranked
+// result (kind as above); strings/arrays are borrowed for the callback.
+typedef struct ReArcAutocompleteMatch {
+  uint32_t kind, match_type;
+  int32_t relevance;
+  bool allowed_to_be_default, deletable;
+  const char* contents;
+  const char* description;
+  const char* destination_url;
+  const char* fill_into_edit;
+  const char* inline_autocompletion;
+} ReArcAutocompleteMatch;
+typedef struct ReArcAutocompleteResult {
+  ReArcStatus status;
+  uint64_t profile_id, query_id;
+  bool done;
+  const ReArcAutocompleteMatch* matches;
+  size_t count;
+} ReArcAutocompleteResult;
+typedef void (*ReArcAutocompleteCallback)(
+    void* context, const ReArcAutocompleteResult* result);
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutocompleteStart(
+    uint64_t profile_id, const char* text, uint32_t options,
+    ReArcAutocompleteCallback completion, void* context, uint64_t* query_id);
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutocompleteStop(uint64_t profile_id);
+
 // ABI 1.15 (history_recording, password_autofill): every tab carries Chromium's
 // HistoryTabHelper (non-OTR profiles), autofill client and
 // ChromePasswordManagerClient. Visits reach HistoryService/chrome://history;
