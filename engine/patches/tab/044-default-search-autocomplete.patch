+namespace rearc {
+namespace {
+using Type = AutocompleteProvider::Type;
+using Done = base::OnceCallback<void(ReArcStatus)>;
+constexpr metrics::OmniboxEventProto::PageClassification kPage =
+    metrics::OmniboxEventProto::OTHER;
+// Local providers only, plus SearchProvider whose remote suggest request is
+// gated by Chromium (no OTR, suggest pref). No zero-suggest/document/ML/tabs.
+constexpr int kRegularProviders =
+    static_cast<int>(Type::kBookmark) | static_cast<int>(Type::kBuiltin) |
+    static_cast<int>(Type::kHistoryQuick) | static_cast<int>(Type::kHistoryUrl) |
+    static_cast<int>(Type::kSearch) | static_cast<int>(Type::kShortcuts) |
+    static_cast<int>(Type::kKeyword) | static_cast<int>(Type::kCalculator) |
+    static_cast<int>(Type::kHistoryFuzzy);
+// OTR: HistoryURLProvider supplies only what-you-typed with no history.
+constexpr int kPrivateProviders =
+    static_cast<int>(Type::kBuiltin) | static_cast<int>(Type::kHistoryUrl) |
+    static_cast<int>(Type::kSearch) | static_cast<int>(Type::kKeyword) |
+    static_cast<int>(Type::kCalculator);
+// Chromium resolves these to the original profile for OTR. As with
+// history_query, an OTR ID never reads its original's history/bookmarks.
+class PrivateClient : public ChromeAutocompleteProviderClient {
+ public:
+  using ChromeAutocompleteProviderClient::ChromeAutocompleteProviderClient;
+  history::HistoryService* GetHistoryService() override { return nullptr; }
+  history_clusters::HistoryClustersService* GetHistoryClustersService()
+      override {
+    return nullptr;
+  }
+  bookmarks::BookmarkModel* GetBookmarkModel() override { return nullptr; }
+  history::URLDatabase* GetInMemoryDatabase() override { return nullptr; }
+  InMemoryURLIndex* GetInMemoryURLIndex() override { return nullptr; }
+  scoped_refptr<ShortcutsBackend> GetShortcutsBackend() override {
+    return nullptr;
+  }
+  scoped_refptr<ShortcutsBackend> GetShortcutsBackendIfExists() override {
+    return nullptr;
+  }
+};
+std::unique_ptr<AutocompleteController> NewController(Profile* profile) {
+  const bool otr = profile->IsOffTheRecord();
+  std::unique_ptr<AutocompleteProviderClient> client;
+  if (otr) {
+    client = std::make_unique<PrivateClient>(profile);
+  } else {
+    client = std::make_unique<ChromeAutocompleteProviderClient>(profile);
+  }
+  return std::make_unique<AutocompleteController>(
+      std::move(client),
+      AutocompleteControllerConfig{
+          .provider_types = otr ? kPrivateProviders : kRegularProviders,
+          .disable_ml = true,
+          .show_iph_matches = false});
+}
+struct Row {
+  uint32_t kind, type;
+  int32_t relevance;
+  bool allowed_to_be_default, deletable;
+  std::string contents, description, destination, fill, inline_completion;
+};
+class State;
+auto& States() {
+  static base::NoDestructor<std::map<uint64_t, std::unique_ptr<State>>> states;
+  return *states;
+}
+size_t waiting_count = 0;
+uint64_t next_query = 1;
+uint32_t Kind(const AutocompleteMatch& match) {
+  return AutocompleteMatch::IsSearchType(match.type) ? 2 : 1;
+}
+class State : public AutocompleteController::Observer {
+ public:
+  State(uint64_t id, Profile* profile)
+      : id_(id), profile_(profile), scheme_(profile) {}
+  ~State() override {
+    // Profile release: every waiter and the active query complete cancelled.
+    Cancel();
+    auto waiting = std::move(waiting_);
+    waiting_count -= waiting.size();
+    for (auto& done : waiting) std::move(done).Run(REARC_CANCELLED);
+    if (controller_) controller_->RemoveObserver(this);
+    if (classifier_) classifier_->Shutdown();
+  }
+  Profile* profile() const { return profile_; }
+  TemplateURLService* service() const {
+    return TemplateURLServiceFactory::GetForProfile(profile_);
+  }
+  // Runs done(OK) now when keywords are loaded, else once loaded (deferred).
+  ReArcStatus WhenLoaded(Done done) {
+    TemplateURLService* urls = service();
+    if (!urls) return REARC_UNSUPPORTED;
+    if (urls->loaded()) {
+      std::move(done).Run(REARC_OK);
+      return REARC_OK;
+    }
+    if (waiting_count >= 64) return REARC_BUSY;
+    ++waiting_count;
+    waiting_.push_back(std::move(done));
+    if (!loaded_subscription_) {
+      loaded_subscription_ = urls->RegisterOnLoadedCallback(base::BindOnce(
+          [](uint64_t id) {
+            auto it = States().find(id);
+            if (it == States().end()) return;
+            State& s = *it->second;
+            s.loaded_subscription_ = {};
+            auto waiting = std::move(s.waiting_);
+            waiting_count -= waiting.size();
+            for (auto& done : waiting) std::move(done).Run(REARC_OK);
+          },
+          id_));
+      urls->Load();
+    }
+    return REARC_OK;
+  }
+  AutocompleteClassifier& classifier() {
+    if (!classifier_) {
+      classifier_ = std::make_unique<AutocompleteClassifier>(
+          NewController(profile_),
+          std::make_unique<ChromeAutocompleteSchemeClassifier>(profile_));
+    }
+    return *classifier_;
+  }
+  ReArcStatus Start(std::u16string text, uint32_t options,
+                    ReArcAutocompleteCallback callback, void* context,
+                    uint64_t* query_id) {
+    Cancel();
+    query_ = next_query++;
+    callback_ = callback;
+    context_ = context;
+    text_ = std::move(text);
+    options_ = options;
+    const uint64_t query = query_;
+    ReArcStatus status = WhenLoaded(base::BindOnce(
+        [](uint64_t id, uint64_t query, ReArcStatus status) {
+          auto it = States().find(id);
+          if (it == States().end() || it->second->query_ != query) return;
+          if (status) {
+            it->second->Finish(status, {});
+          } else {
+            it->second->Run();
+          }
+        },
+        id_, query));
+    if (status) {
+      // Synchronous rejection: no result is ever delivered for this ID.
+      query_ = 0;
+      callback_ = nullptr;
+      context_ = nullptr;
+      return status;
+    }
+    *query_id = query;
+    return REARC_OK;
+  }
+  // Ends the active query with exactly one cancelled terminal result.
+  void Cancel() {
+    if (!query_) return;
+    running_ = false;
+    if (controller_) controller_->Stop(AutocompleteStopReason::kClobbered);
+    Finish(REARC_CANCELLED, {});
+  }
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller, bool) override {
+    if (!running_ || controller != controller_.get()) return;
+    std::vector<Row> rows;
+    for (const AutocompleteMatch& match : controller->result()) {
+      rows.push_back({Kind(match), static_cast<uint32_t>(match.type),
+                      match.relevance, match.allowed_to_be_default_match,
+                      match.deletable, base::UTF16ToUTF8(match.contents),
+                      base::UTF16ToUTF8(match.description),
+                      match.destination_url.spec(),
+                      base::UTF16ToUTF8(match.fill_into_edit),
+                      base::UTF16ToUTF8(match.inline_autocompletion)});
+    }
+    if (controller->done()) {
+      running_ = false;
+      Finish(REARC_OK, std::move(rows));
+    } else {
+      Post(false, REARC_OK, std::move(rows));
+    }
+  }
+
+ private:
+  void Run() {
+    if (!controller_) {
+      controller_ = NewController(profile_);
+      controller_->AddObserver(this);
+    }
+    AutocompleteInput input(text_, kPage, scheme_);
+    input.set_prevent_inline_autocomplete(options_ & 1);
+    running_ = true;
+    controller_->Start(input);
+  }
+  void Finish(ReArcStatus status, std::vector<Row> rows) {
+    Post(true, status, std::move(rows));
+    query_ = 0;
+    callback_ = nullptr;
+    context_ = nullptr;
+  }
+  void Post(bool done, ReArcStatus status, std::vector<Row> rows) {
+    ABIPost(base::BindOnce(
+        [](uint64_t id, uint64_t query, bool done, ReArcStatus status,
+           ReArcAutocompleteCallback callback, void* context,
+           std::vector<Row> rows) {
+          // Intermediate results of a superseded/finished query are dropped;
+          // the terminal (done or cancelled) result is always delivered.
+          auto it = States().find(id);
+          if (!done && (it == States().end() || it->second->query_ != query))
+            return;
+          std::vector<ReArcAutocompleteMatch> matches;
+          for (const Row& row : rows) {
+            matches.push_back({row.kind, row.type, row.relevance,
+                               row.allowed_to_be_default, row.deletable,
+                               row.contents.c_str(), row.description.c_str(),
+                               row.destination.c_str(), row.fill.c_str(),
+                               row.inline_completion.c_str()});
+          }
+          ReArcAutocompleteResult result{status, id, query, done,
+                                         matches.empty() ? nullptr : matches.data(),
+                                         matches.size()};
+          callback(context, &result);
+        },
+        id_, query_, done, status, callback_, context_.get(), std::move(rows)));
+  }
+
+  const uint64_t id_;
+  raw_ptr<Profile> profile_;
+  ChromeAutocompleteSchemeClassifier scheme_;
+  base::CallbackListSubscription loaded_subscription_;
+  std::vector<Done> waiting_;
+  std::unique_ptr<AutocompleteController> controller_;
+  std::unique_ptr<AutocompleteClassifier> classifier_;
+  uint64_t query_ = 0;
+  bool running_ = false;
+  ReArcAutocompleteCallback callback_ = nullptr;
+  raw_ptr<void> context_ = nullptr;
+  std::u16string text_;
+  uint32_t options_ = 0;
+};
+ReArcStatus Lookup(uint64_t profile_id, State** state) {
+  CHECK(pthread_main_np());
+  if (!ReArcEngineDefaultProfile()) return REARC_ENGINE_NOT_READY;
+  Profile* profile = FindBridgeProfile(profile_id);
+  if (!profile) return REARC_PROFILE_NOT_FOUND;
+  auto& slot = States()[profile_id];
+  if (!slot) slot = std::make_unique<State>(profile_id, profile);
+  *state = slot.get();
+  return REARC_OK;
+}
+bool ValidText(const char* text, bool allow_empty) {
+  if (!text) return false;
+  std::string value(text);
+  return (allow_empty || !value.empty()) && value.size() <= 4096 &&
+         base::IsStringUTF8(value);
+}
+// A ready-to-use URL: Chromium parameters resolved, search terms as "%s".
+std::string Resolve(const TemplateURLRef& ref, const SearchTermsData& data) {
+  constexpr char kToken[] = "rearcsearchterms7f3a";
+  std::string url = ref.ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(u"rearcsearchterms7f3a"), data);
+  base::ReplaceSubstringsAfterOffset(&url, 0, kToken, "%s");
+  return url;
+}
+bool ValidTemplate(const char* value, bool allow_empty) {
+  if (!value) return allow_empty;
+  std::string url(value);
+  if (url.empty()) return allow_empty;
+  GURL parsed(url);
+  return url.size() <= 4096 && base::IsStringUTF8(url) && parsed.is_valid() &&
+         parsed.SchemeIsHTTPOrHTTPS() && url.find("%s") != std::string::npos;
+}
+}  // namespace
+void ABICancelSearch(uint64_t profile_id) {
+  CHECK(pthread_main_np());
+  // Destruction posts cancellation for waiters/queries, then drops services.
+  auto node = States().extract(profile_id);
+}
+}  // namespace rearc
+
+ReArcStatus ReArcSearchGetDefaultProvider(uint64_t profile_id,
+                                          ReArcSearchProviderCallback completion,
+                                          void* context) {
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  return state->WhenLoaded(base::BindOnce(
+      [](uint64_t id, ReArcSearchProviderCallback completion, void* context,
+         ReArcStatus status) {
+        std::string name, keyword, search, suggest;
+        bool managed = false, prepopulated = false;
+        if (!status) {
+          auto it = rearc::States().find(id);
+          TemplateURLService* urls = it->second->service();
+          const TemplateURL* url = urls->GetDefaultSearchProvider();
+          if (!url) {
+            status = REARC_NOT_FOUND;
+          } else {
+            name = base::UTF16ToUTF8(url->short_name());
+            keyword = base::UTF16ToUTF8(url->keyword());
+            search = rearc::Resolve(url->url_ref(), urls->search_terms_data());
+            if (!url->suggestions_url().empty()) {
+              suggest = rearc::Resolve(url->suggestions_url_ref(),
+                                       urls->search_terms_data());
+            }
+            managed = urls->is_default_search_managed();
+            prepopulated = url->prepopulate_id() > 0;
+          }
+        }
+        rearc::ABIPost(base::BindOnce(
+            [](uint64_t id, ReArcSearchProviderCallback completion,
+               void* context, ReArcStatus status, std::string name,
+               std::string keyword, std::string search, std::string suggest,
+               bool managed, bool prepopulated) {
+              ReArcSearchProvider provider{name.c_str(), keyword.c_str(),
+                                           search.c_str(), suggest.c_str(),
+                                           managed, prepopulated};
+              completion(context, status, id, status ? nullptr : &provider);
+            },
+            id, completion, context, status, std::move(name),
+            std::move(keyword), std::move(search), std::move(suggest), managed,
+            prepopulated));
+      },
+      profile_id, completion, context));
+}
+
+ReArcStatus ReArcSearchSetDefaultProvider(uint64_t profile_id,
+                                          const ReArcSearchProvider* provider,
+                                          ReArcCompletion completion,
+                                          void* context) {
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  // OTR shares (redirects to) its original's keywords; never mutate them.
+  if (state->profile()->IsOffTheRecord()) return REARC_UNSUPPORTED;
+  if (!completion || !provider || !provider->name || !provider->keyword ||
+      !rearc::ValidText(provider->name, false) ||
+      !rearc::ValidText(provider->keyword, false) ||
+      std::string(provider->keyword).find_first_of(" \t\r\n") !=
+          std::string::npos ||
+      !rearc::ValidTemplate(provider->search_url, false) ||
+      !rearc::ValidTemplate(provider->suggest_url, true)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  TemplateURLData data;
+  data.SetShortName(base::UTF8ToUTF16(provider->name));
+  data.SetKeyword(base::UTF8ToUTF16(provider->keyword));
+  data.SetURL(TemplateURLRef::DisplayURLToURLRef(
+      base::UTF8ToUTF16(provider->search_url)));
+  if (provider->suggest_url && *provider->suggest_url) {
+    data.suggestions_url = TemplateURLRef::DisplayURLToURLRef(
+        base::UTF8ToUTF16(provider->suggest_url));
+  }
+  data.safe_for_autoreplace = false;
+  return state->WhenLoaded(base::BindOnce(
+      [](uint64_t id, TemplateURLData data, ReArcCompletion completion,
+         void* context, ReArcStatus status) {
+        if (!status) {
+          TemplateURLService* urls = rearc::States().at(id)->service();
+          if (urls->is_default_search_managed()) {
+            status = REARC_INVALID_STATE;
+          } else {
+            // Reuse an identical engine; otherwise add a user engine.
+            TemplateURL* url = urls->GetTemplateURLForKeyword(data.keyword());
+            if (!url || url->url() != data.url() ||
+                url->suggestions_url() != data.suggestions_url ||
+                url->type() != TemplateURL::NORMAL) {
+              url = urls->Add(std::make_unique<TemplateURL>(data));
+            }
+            if (!url || !urls->CanMakeDefault(url)) {
+              status = REARC_INVALID_STATE;
+            } else {
+              urls->SetUserSelectedDefaultSearchProvider(url);
+            }
+          }
+        }
+        rearc::ABIPost(base::BindOnce(completion, context, status, false));
+      },
+      profile_id, std::move(data), completion, context));
+}
+
+ReArcStatus ReArcSearchClassifyInput(uint64_t profile_id, const char* text,
+                                     ReArcClassifyCallback completion,
+                                     void* context) {
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  if (!completion || !rearc::ValidText(text, false)) return REARC_INVALID_ARGUMENT;
+  return state->WhenLoaded(base::BindOnce(
+      [](uint64_t id, std::u16string text, ReArcClassifyCallback completion,
+         void* context, ReArcStatus status) {
+        uint32_t kind = 0, type = 0;
+        std::string destination;
+        if (!status) {
+          AutocompleteMatch match;
+          rearc::States().at(id)->classifier().Classify(
+              text, false, true, rearc::kPage, &match, nullptr);
+          if (match.destination_url.is_valid()) {
+            kind = rearc::Kind(match);
+            type = static_cast<uint32_t>(match.type);
+            destination = match.destination_url.spec();
+          }
+        }
+        rearc::ABIPost(base::BindOnce(
+            [](uint64_t id, ReArcClassifyCallback completion, void* context,
+               ReArcStatus status, uint32_t kind, uint32_t type,
+               std::string destination) {
+              ReArcInputClassification result{kind, type, destination.c_str()};
+              completion(context, status, id, status ? nullptr : &result);
+            },
+            id, completion, context, status, kind, type,
+            std::move(destination)));
+      },
+      profile_id, base::UTF8ToUTF16(text), completion, context));
+}
+
+ReArcStatus ReArcAutocompleteStart(uint64_t profile_id, const char* text,
+                                   uint32_t options,
+                                   ReArcAutocompleteCallback completion,
+                                   void* context, uint64_t* query_id) {
+  CHECK(pthread_main_np());
+  if (query_id) *query_id = 0;
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  if (!completion || !query_id || options & ~1u ||
+      !rearc::ValidText(text, false)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  return state->Start(base::UTF8ToUTF16(text), options, completion, context,
+                      query_id);
+}
+
+ReArcStatus ReArcAutocompleteStop(uint64_t profile_id) {
+  rearc::State* state;
+  if (auto status = rearc::Lookup(profile_id, &state)) return status;
+  state->Cancel();
+  return REARC_OK;
+}
