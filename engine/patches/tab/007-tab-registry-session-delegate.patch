+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/tab_session.h"
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "chrome/browser/rearc_bridge/tab_delegate.h"
+#include "content/public/browser/web_contents.h"
+
+namespace rearc {
+
+namespace {
+
+bool IsValidCloseTransition(TabSession::CloseState from,
+                            TabSession::CloseState to) {
+  switch (from) {
+    case TabSession::CloseState::kOpen:
+      // kClosed directly: forced teardown (TabRegistry::DestroySession)
+      // skips the beforeunload pipeline.
+      return to == TabSession::CloseState::kCloseRequested ||
+             to == TabSession::CloseState::kClosed;
+    case TabSession::CloseState::kCloseRequested:
+      // Back to kOpen: close vetoed (beforeunload or policy).
+      return to == TabSession::CloseState::kOpen ||
+             to == TabSession::CloseState::kUnloadPending ||
+             to == TabSession::CloseState::kClosed;
+    case TabSession::CloseState::kUnloadPending:
+      // Back to kOpen: unload cancelled mid-pipeline.
+      return to == TabSession::CloseState::kOpen ||
+             to == TabSession::CloseState::kClosed;
+    case TabSession::CloseState::kClosed:
+      return false;
+  }
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<TabSession> TabSession::Create(uint64_t tab_id,
+                                               const CreateArgs& args) {
+  CHECK(pthread_main_np());
+  CHECK(args.browser_context);
+  return std::unique_ptr<TabSession>(new TabSession(tab_id, args));
+}
+
+TabSession::TabSession(uint64_t tab_id, const CreateArgs& args)
+    : tab_id_(tab_id),
+      space_id_(args.space_id),
+      order_index_(args.order_index) {
+  delegate_ = std::make_unique<ReArcTabDelegate>(tab_id_);
+  content::WebContents::CreateParams params(args.browser_context);
+  web_contents_ = content::WebContents::Create(params);
+  web_contents_->SetDelegate(delegate_.get());
+
+  // Start hidden (P-TAB-001): a fresh WebContents is hidden by default and
+  // becomes visible only through the S4 attachment lease's explicit
+  // view.set_visible — never implicitly at creation.
+  //
+  // R6 helper policy: no TabHelpers::AttachTabHelpers (legacy, warns against
+  // desktop use), no TabFeatures, no PreventFeatureInitializationForTesting
+  // bypass. The whitelisted per-helper CreateForWebContents set is EMPTY
+  // day-one: the first candidate (CoreTabHelper) lives in
+  // //chrome/browser/ui/tab_contents/, and :core cannot dep on
+  // //chrome/browser/ui (layering runs ui → core), so the whitelist decision
+  // moves to the S5 service-adapter audits. Recorded in patch tab/007's
+  // header per the slice plan's "each recorded in the patch header" rule.
+}
+
+TabSession::~TabSession() = default;
+
+void TabSession::SetSpaceId(uint64_t space_id) {
+  CHECK(pthread_main_np());
+  space_id_ = space_id;
+}
+
+void TabSession::SetOrderIndex(int32_t order_index) {
+  CHECK(pthread_main_np());
+  order_index_ = order_index;
+}
+
+void TabSession::SetCloseState(CloseState next) {
+  CHECK(pthread_main_np());
+  CHECK(IsValidCloseTransition(close_state_, next))
+      << "ReArc bridge: tab " << tab_id_ << " illegal close transition "
+      << static_cast<int>(close_state_) << " -> " << static_cast<int>(next);
+  close_state_ = next;
+}
+
+void TabSession::NoteContentsReplaced() {
+  CHECK(pthread_main_np());
+  ++content_generation_;
+}
+
+}  // namespace rearc
