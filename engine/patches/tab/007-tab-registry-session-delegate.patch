+++ b/chrome/browser/rearc_bridge/tab_session.h
@@ -0,0 +1,112 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_TAB_SESSION_H_
+#define CHROME_BROWSER_REARC_BRIDGE_TAB_SESSION_H_
+
+#include <cstdint>
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace rearc {
+
+class ReArcTabDelegate;
+
+// One browser-less tab (P-TAB-001 slice S2). Owns exactly one
+// content::WebContents created directly via WebContents::Create — no
+// TabStripModel, no tabs::TabModel, no TabFeatures, no BrowserWindowInterface
+// adapter. The registry route never reaches TabFeatures' BrowserWindowInterface
+// CHECK (tab_features.cc:276); see P-TAB-001-SLICES §2 for the full decision
+// record.
+//
+// Identity is the engine-allocated, monotonic tab_id (IPC-CONTRACT §3). The
+// WebContents* is never exposed across the bridge/shell boundary — the
+// web_contents() accessor is strictly bridge-internal (TabRegistry and the
+// S3 observer / S4 lease / S6 adoption collaborators in this same target);
+// shell-facing identity is the opaque tab_id only.
+//
+// The S4 attachment lease is deliberately NOT a member: this file is frozen
+// once patch tab/007 lands (series-mechanics invariant), so S4 associates at
+// most one lease per tab through its own tab_id-keyed map in
+// attachment_lease.cc — same additive pattern as S1's native-window provider
+// seam.
+class TabSession {
+ public:
+  // Close-state machine skeleton. The real pipeline (DispatchBeforeUnload →
+  // honor veto → ClosePage → await CloseContents; forced-close path that
+  // still detaches native children and cancels observers) is S6's
+  // close_controller; S2 ships the states and guarded transitions only.
+  enum class CloseState {
+    kOpen,            // Normal operation.
+    kCloseRequested,  // tab.close received; beforeunload not yet dispatched.
+    kUnloadPending,   // beforeunload/unload pipeline running.
+    kClosed,          // Fully closed; destruction scheduled.
+  };
+
+  struct CreateArgs {
+    // Borrowed: the caller (via TabRegistry) guarantees the BrowserContext
+    // outlives the session — teardown ordering destroys all sessions before
+    // profile release (P-APP-001's DidEndMainMessageLoop finalization seam).
+    // Proper ScopedProfileKeepAlive wiring
+    // (chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h) lands
+    // with the embedded-startup integration wave; S2 records the dependency
+    // explicitly instead of faking a keepalive it cannot correctly own yet.
+    raw_ptr<content::BrowserContext> browser_context = nullptr;
+    uint64_t space_id = 0;    // Shell space membership (IPC-CONTRACT §3).
+    int32_t order_index = 0;  // Shell order metadata within the space.
+  };
+
+  // Main thread only. `args.browser_context` must be non-null.
+  static std::unique_ptr<TabSession> Create(uint64_t tab_id,
+                                            const CreateArgs& args);
+  ~TabSession();
+
+  TabSession(const TabSession&) = delete;
+  TabSession& operator=(const TabSession&) = delete;
+
+  uint64_t tab_id() const { return tab_id_; }
+
+  // Shell space/order metadata (IPC-CONTRACT §3 tab.move semantics; pure
+  // metadata day-one — membership never reparents a view by itself).
+  uint64_t space_id() const { return space_id_; }
+  void SetSpaceId(uint64_t space_id);
+  int32_t order_index() const { return order_index_; }
+  void SetOrderIndex(int32_t order_index);
+
+  CloseState close_state() const { return close_state_; }
+  // Advances the close state; CHECKs the transition is legal. Main thread
+  // only.
+  void SetCloseState(CloseState next);
+
+  // Monotonic per-tab generation, incremented whenever the WebContents is
+  // replaced (S6 adoption edge cases; S7 discard). Consumers (S3 event
+  // serialization, S4 lease) reject completions from a stale generation.
+  uint64_t content_generation() const { return content_generation_; }
+  void NoteContentsReplaced();
+
+  // Bridge-internal access — never crosses the shell/IPC boundary.
+  content::WebContents* web_contents() const { return web_contents_.get(); }
+
+ private:
+  TabSession(uint64_t tab_id, const CreateArgs& args);
+
+  const uint64_t tab_id_;
+  uint64_t space_id_;
+  int32_t order_index_;
+  CloseState close_state_ = CloseState::kOpen;
+  uint64_t content_generation_ = 1;
+
+  std::unique_ptr<ReArcTabDelegate> delegate_;
+  std::unique_ptr<content::WebContents> web_contents_;
+};
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_TAB_SESSION_H_
