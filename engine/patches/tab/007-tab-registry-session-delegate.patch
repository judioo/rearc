@@ -0,0 +1,131 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+
+#include <pthread.h>
+
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace rearc {
+
+// static
+TabRegistry& TabRegistry::Get() {
+  CHECK(pthread_main_np());
+  static base::NoDestructor<TabRegistry> registry;
+  return *registry;
+}
+
+void TabRegistry::PostCommand(Command command) {
+  CHECK(pthread_main_np());
+  pending_commands_.push_back(std::move(command));
+}
+
+void TabRegistry::DrainCommands() {
+  CHECK(pthread_main_np());
+  while (!pending_commands_.empty()) {
+    Command command = std::move(pending_commands_.front());
+    pending_commands_.pop_front();
+    ApplyCommand(command);
+  }
+}
+
+uint64_t TabRegistry::CreateSession(const TabSession::CreateArgs& args) {
+  CHECK(pthread_main_np());
+  const uint64_t tab_id = next_tab_id_++;
+  sessions_.emplace(tab_id, TabSession::Create(tab_id, args));
+  VLOG(1) << "ReArc bridge: created tab session " << tab_id << " (space "
+          << args.space_id << ", order " << args.order_index << ").";
+  return tab_id;
+}
+
+TabSession* TabRegistry::FindSession(uint64_t tab_id) const {
+  CHECK(pthread_main_np());
+  auto it = sessions_.find(tab_id);
+  return it == sessions_.end() ? nullptr : it->second.get();
+}
+
+bool TabRegistry::RequestClose(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = FindSession(tab_id);
+  if (!session || session->close_state() == TabSession::CloseState::kClosed) {
+    VLOG(1) << "ReArc bridge: close requested for unknown/closed tab "
+            << tab_id << ".";
+    return false;
+  }
+  if (session->close_state() == TabSession::CloseState::kOpen) {
+    session->SetCloseState(TabSession::CloseState::kCloseRequested);
+  }
+  // The real pipeline (DispatchBeforeUnload → honor veto → ClosePage → await
+  // CloseContents) is S6's close_controller; day-one this only records the
+  // request in the close-state machine.
+  VLOG(1) << "ReArc bridge: tab " << tab_id
+          << " close requested (S6 close pipeline pending).";
+  return true;
+}
+
+void TabRegistry::DestroySession(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  auto it = sessions_.find(tab_id);
+  if (it == sessions_.end()) {
+    VLOG(1) << "ReArc bridge: destroy requested for unknown tab " << tab_id
+            << ".";
+    return;
+  }
+  std::unique_ptr<TabSession> session = std::move(it->second);
+  sessions_.erase(it);
+  if (session->close_state() != TabSession::CloseState::kClosed) {
+    session->SetCloseState(TabSession::CloseState::kClosed);
+  }
+  // Deferred destruction: delegate/observer callbacks must unwind before the
+  // WebContents dies (P-TAB-001's destruction-from-callback prohibition).
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce([](std::unique_ptr<TabSession> doomed_session) {},
+                     std::move(session)));
+}
+
+void TabRegistry::DestroyAllSessions() {
+  CHECK(pthread_main_np());
+  // Pending commands reference sessions that are about to die; drop them —
+  // teardown is the final word on tab lifetime.
+  pending_commands_.clear();
+  std::vector<uint64_t> ids;
+  ids.reserve(sessions_.size());
+  for (const auto& [tab_id, session] : sessions_) {
+    ids.push_back(tab_id);
+  }
+  for (uint64_t tab_id : ids) {
+    DestroySession(tab_id);
+  }
+}
+
+void TabRegistry::ApplyCommand(const Command& command) {
+  switch (command.type) {
+    case Command::Type::kCreate: {
+      CHECK(command.browser_context);
+      TabSession::CreateArgs args;
+      args.browser_context = command.browser_context;
+      args.space_id = command.space_id;
+      args.order_index = command.order_index;
+      CreateSession(args);
+      return;
+    }
+    case Command::Type::kRequestClose:
+      RequestClose(command.tab_id);
+      return;
+    case Command::Type::kDestroy:
+      DestroySession(command.tab_id);
+      return;
+  }
+}
+
+}  // namespace rearc
