@@ -0,0 +1,160 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/tab_delegate.h"
+
+#include <utility>
+
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace rearc {
+
+ReArcTabDelegate::ReArcTabDelegate(uint64_t tab_id) : tab_id_(tab_id) {}
+
+ReArcTabDelegate::~ReArcTabDelegate() = default;
+
+content::WebContents* ReArcTabDelegate::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  switch (params.disposition) {
+    case WindowOpenDisposition::CURRENT_TAB: {
+      // Real same-tab routing from day one, following the minimal-embedder
+      // pattern (content/shell/browser/shell.cc:473-478): navigate through
+      // the controller — never OpenURL(), which would re-enter this
+      // delegate — complete the navigation-handle callback, return source.
+      base::WeakPtr<content::NavigationHandle> navigation_handle =
+          source->GetController().LoadURLWithParams(
+              content::NavigationController::LoadURLParams(params));
+      if (navigation_handle_callback && navigation_handle) {
+        std::move(navigation_handle_callback).Run(*navigation_handle);
+      }
+      return source;
+    }
+    case WindowOpenDisposition::NEW_POPUP:
+    case WindowOpenDisposition::NEW_WINDOW:
+    case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+    case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+    case WindowOpenDisposition::SINGLETON_TAB:
+      // Predictable rejection day-one: adoption of page-created contents
+      // (preserving opener, BrowserContext and disposition, with a valid
+      // native parent or deliberate hidden staging established before
+      // returning) is S6's tab_adoption. Returning nullptr tells content the
+      // URL was not opened; nothing hangs.
+      VLOG(1) << "ReArc bridge: tab " << tab_id_
+              << " denied OpenURLFromTab disposition "
+              << static_cast<int>(params.disposition) << " (" << params.url
+              << ") — S6 adoption pending.";
+      return nullptr;
+    default:
+      // OFF_THE_RECORD / SAVE_TO_DISK / IGNORE_ACTION / unknown: unsupported
+      // here; reject predictably.
+      VLOG(1) << "ReArc bridge: tab " << tab_id_
+              << " denied OpenURLFromTab unsupported disposition "
+              << static_cast<int>(params.disposition) << " (" << params.url
+              << ").";
+      return nullptr;
+  }
+}
+
+content::WebContents* ReArcTabDelegate::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // Predictable rejection day-one (S6 owns adoption — a later SwiftUI update
+  // is not synchronous reparenting). The moved-in WebContents is destroyed
+  // with this scope: an explicit, immediate rejection, not a leak or a hang.
+  // was_blocked is set honestly — no tab was created.
+  if (was_blocked) {
+    *was_blocked = true;
+  }
+  VLOG(1) << "ReArc bridge: tab " << tab_id_ << " rejected AddNewContents ("
+          << target_url << ", disposition " << static_cast<int>(disposition)
+          << ", user_gesture " << user_gesture
+          << ") — S6 adoption pending.";
+  return nullptr;
+}
+
+void ReArcTabDelegate::ActivateContents(content::WebContents* contents) {
+  // No focus stealing day-one: page-initiated activation (window.focus()) is
+  // not honored until S4's host view and S6's focus policy wire AppKit
+  // first-responder routing through the attachment lease.
+  VLOG(1) << "ReArc bridge: tab " << tab_id_
+          << " ActivateContents ignored (no focus-stealing policy).";
+}
+
+bool ReArcTabDelegate::IsContentsActive(content::WebContents* contents) {
+  // content's documented browser-less semantic — "WebContents outside a
+  // browser are always considered active" — restated explicitly so the
+  // day-one surface states the policy rather than inheriting it silently.
+  return true;
+}
+
+void ReArcTabDelegate::CloseContents(content::WebContents* source) {
+  // The shell owns tab lifetime; page-initiated close (window.close,
+  // ClosePage) must not destroy the session. P-TAB-001: "Window.close only
+  // detaches/hides tabs" — detachment lands with S6's close_controller. No
+  // upstream callback exists here, so nothing hangs.
+  VLOG(1) << "ReArc bridge: tab " << tab_id_
+          << " CloseContents ignored (shell owns tab lifetime; S6 close "
+             "controller pending).";
+}
+
+void ReArcTabDelegate::BeforeUnloadFired(content::WebContents* tab,
+                                         bool proceed,
+                                         bool* proceed_to_fire_unload) {
+  // Conservative cancel day-one (R7): veto the close by refusing to fire
+  // unload — the tab survives every close attempt until S6's close
+  // controller implements the real DispatchBeforeUnload → honor veto →
+  // ClosePage → await CloseContents pipeline. content's default would set
+  // *proceed_to_fire_unload = true (allow the close).
+  *proceed_to_fire_unload = false;
+  VLOG(1) << "ReArc bridge: tab " << tab_id_ << " BeforeUnloadFired(proceed="
+          << proceed << ") vetoed (S6 close controller pending).";
+}
+
+void ReArcTabDelegate::NavigationStateChanged(
+    content::WebContents* source,
+    content::InvalidateTypes changed_flags) {
+  // Deliberately quiet day-one (high-frequency notification): S3's
+  // tab_observer emits tab.updated events over the IPC surface; the delegate
+  // stays out of the event path.
+}
+
+void ReArcTabDelegate::LoadingStateChanged(content::WebContents* source,
+                                           bool should_show_loading_ui) {
+  // Deliberately quiet day-one: S3's observer surface owns loading events.
+}
+
+bool ReArcTabDelegate::TakeFocus(content::WebContents* source, bool reverse) {
+  // Not handled day-one: returning false lets content continue its default
+  // traversal. AppKit first-responder round-trip through the lease's host
+  // view arrives with S4.
+  return false;
+}
+
+content::JavaScriptDialogManager*
+ReArcTabDelegate::GetJavaScriptDialogManager(content::WebContents* source) {
+  // nullptr day-one = dialogs suppressed WITH completing callbacks (audited
+  // at pin: WebContentsImpl::RunBeforeUnloadConfirm resolves (false, true)
+  // with no manager installed; CancelDialogs is null-safe) — a hung callback
+  // would violate R7. The conservative-cancel native manager is S5's
+  // rearc_javascript_dialog_manager; per P-TAB-001, "returning null alone is
+  // not proof of that policy", so S5 must land before dialogs are considered
+  // handled.
+  return nullptr;
+}
+
+}  // namespace rearc
