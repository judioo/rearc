@@ -0,0 +1,109 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_TAB_REGISTRY_H_
+#define CHROME_BROWSER_REARC_BRIDGE_TAB_REGISTRY_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+
+namespace base {
+template <typename T>
+class NoDestructor;
+}  // namespace base
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace rearc {
+
+// Browser-less tab registry (P-TAB-001 slice S2; the centerpiece decision per
+// P-TAB-001-SLICES §2: registry, NOT a BrowserWindowInterface adapter — the
+// ~69-virtual fake window object is forbidden by R6).
+//
+// Owns: engine-side monotonic tab_id allocation (IPC-CONTRACT §3: "E
+// allocates tab_id"), the TabSession map, FIFO command application, and
+// teardown ordering (all sessions destroyed before profile release via
+// DestroyAllSessions, called from the P-APP-001 DidEndMainMessageLoop
+// finalization seam — wired in a later slice because the call site lives in
+// an earlier patch's frozen file).
+//
+// Main thread (Chromium BrowserThread::UI) only; every entry point CHECKs.
+class TabRegistry {
+ public:
+  // FIFO command envelope. Producers (S3's IPC layer) post; application is
+  // strictly in-order on the main thread. Day-one nothing posts yet — the
+  // queue and drain path ship now so the command-ordering contract is real
+  // from the start.
+  struct Command {
+    enum class Type { kCreate, kRequestClose, kDestroy };
+
+    Type type = Type::kCreate;
+    // kCreate fields (browser_context borrowed; see
+    // TabSession::CreateArgs::browser_context):
+    raw_ptr<content::BrowserContext> browser_context = nullptr;
+    uint64_t space_id = 0;
+    int32_t order_index = 0;
+    // kRequestClose / kDestroy field:
+    uint64_t tab_id = 0;
+  };
+
+  static TabRegistry& Get();
+
+  TabRegistry(const TabRegistry&) = delete;
+  TabRegistry& operator=(const TabRegistry&) = delete;
+
+  // Appends to the FIFO without applying. Main thread only.
+  void PostCommand(Command command);
+  // Applies every pending command in FIFO order. Main thread only.
+  void DrainCommands();
+
+  // Creates a session and returns its newly allocated tab_id. Main thread
+  // only.
+  uint64_t CreateSession(const TabSession::CreateArgs& args);
+
+  // Bridge-internal lookup; nullptr for unknown ids.
+  TabSession* FindSession(uint64_t tab_id) const;
+
+  // Advances the session's close-state skeleton to kCloseRequested (the real
+  // beforeunload/unload pipeline is S6). Idempotent for already-closing
+  // sessions; false for unknown or fully closed tabs.
+  bool RequestClose(uint64_t tab_id);
+
+  // Idempotent. Removes the session from the registry immediately but posts
+  // its destruction so delegate/observer callbacks unwind first (P-TAB-001's
+  // destruction-from-callback prohibition).
+  void DestroySession(uint64_t tab_id);
+
+  // Teardown-ordering primitive: clears pending commands and destroys every
+  // session (deferred as above). Must run before profile release during
+  // engine shutdown.
+  void DestroyAllSessions();
+
+  size_t session_count() const { return sessions_.size(); }
+
+ private:
+  friend class base::NoDestructor<TabRegistry>;
+
+  TabRegistry() = default;
+  ~TabRegistry() = default;
+
+  void ApplyCommand(const Command& command);
+
+  // Monotonic, engine-allocated per IPC-CONTRACT §3.
+  uint64_t next_tab_id_ = 1;
+  std::map<uint64_t, std::unique_ptr<TabSession>> sessions_;
+  std::deque<Command> pending_commands_;
+};
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_TAB_REGISTRY_H_
