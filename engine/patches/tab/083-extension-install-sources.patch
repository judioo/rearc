+// ABI 1.61 (extension_install_sources). As ReArcProfileInstallExtensions,
+// with the source browser's manifest.json text for each ID (at most 1 MiB).
+// When the store's current manifest requires permissions that warn beyond the
+// source's (Chromium's IsPrivilegeIncrease, the rule that disables such an
+// update in Chrome), or the source manifest does not parse, that install shows
+// Chromium's normal install prompt through the extension prompt channel (1.32,
+// kind install, profile only, tab 0) with the permission list; cancel or no
+// prompt callback ends it with result 3. Otherwise the import's consent stands.
+typedef struct ReArcExtensionInstallSource {
+  const char* id;
+  const char* manifest_json;
+} ReArcExtensionInstallSource;
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileInstallExtensionSources(
+    uint64_t profile_id, const ReArcExtensionInstallSource* sources,
+    uint32_t count, ReArcExtensionInstallCallback callback, void* context);
 REARC_ENGINE_EXPORT ReArcStatus ReArcProfileLoadUnpackedExtension(uint64_t profile_id,
     const char* path, ReArcExtensionInstallCallback callback, void* context);
 
