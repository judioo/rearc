+}  // namespace rearc
+
+ReArcStatus ReArcProfileInstallExtensions(uint64_t profile_id,
+    const char* const* ids, uint32_t count,
+    ReArcExtensionInstallCallback callback, void* context) {
+  CHECK([NSThread isMainThread]);
+  if (!ids || count > 512) return REARC_INVALID_ARGUMENT;
+  std::vector<std::pair<std::string, std::optional<std::string>>> items;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (!ids[i]) return REARC_INVALID_ARGUMENT;
+    items.emplace_back(ids[i], std::nullopt);
+  }
+  return rearc::StartExtensionInstalls(profile_id, std::move(items), callback,
+                                       context);
+}
+
+ReArcStatus ReArcProfileInstallExtensionSources(uint64_t profile_id,
+    const ReArcExtensionInstallSource* sources, uint32_t count,
+    ReArcExtensionInstallCallback callback, void* context) {
+  CHECK([NSThread isMainThread]);
+  if (!sources || count > 512) return REARC_INVALID_ARGUMENT;
+  std::vector<std::pair<std::string, std::optional<std::string>>> items;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (!sources[i].id || !sources[i].manifest_json ||
+        strlen(sources[i].manifest_json) > 1024 * 1024) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    items.emplace_back(sources[i].id, sources[i].manifest_json);
+  }
+  return rearc::StartExtensionInstalls(profile_id, std::move(items), callback,
+                                       context);
+}
 
