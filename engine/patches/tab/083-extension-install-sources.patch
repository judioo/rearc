@@ -463,8 +474,41 @@ void OnManifestParsed() override {
   bool CheckRequestorAlive() const override { return true; }
   bool ShouldShowPostInstallUI() const override { return false; }
   content::WebContents* GetWebContents() const override { return contents_.get(); }
+  // ABI 1.61: the import's consent covers what the source browser's copy
+  // was allowed. Chrome disables an update that asks for more until the user
+  // approves it (ChromeExtensionRegistrarDelegate, IsPrivilegeIncrease); so
+  // does this: the store manifest's required permissions against the source
+  // manifest's, with Chromium's rule. An unreadable source manifest prompts.
+  bool AsksForMore() {
+    if (!source_manifest_) {
+      return false;  // ReArcProfileInstallExtensions: consent by ID (1.53).
+    }
+    auto store = GetLocalizedExtensionForDisplay();
+    auto dict = base::JSONReader::ReadDict(*source_manifest_,
+                                           base::JSON_PARSE_RFC);
+    if (!store || !dict) {
+      return true;
+    }
+    std::u16string error;
+    auto source = extensions::Extension::Create(
+        base::FilePath(), extensions::mojom::ManifestLocation::kInternal,
+        *dict, extensions::Extension::FROM_WEBSTORE, id(), &error);
+    return !source ||
+           extensions::PermissionMessageProvider::Get()->IsPrivilegeIncrease(
+               extensions::PermissionsParser::GetRequiredPermissions(
+                   source.get()),
+               extensions::PermissionsParser::GetRequiredPermissions(
+                   store.get()),
+               store->GetType());
+  }
+  // A permission increase gets Chromium's normal install prompt, which
+  // tab/050 routes to the host with the permission list (no registry tab).
   std::unique_ptr<extensions::InstallPromptData> CreateInstallPrompt() const override {
-    return nullptr;
