+// Autofill suggestions (autofill_suggestions, ABI 1.34). Address, card,
+// IBAN, autocomplete, datalist and password suggestions of registry tabs are
+// rendered by the host; Chromium's popup is never shown (no callback: no
+// suggestions UI). Chromium still decides when to show/hide (focus loss,
+// navigation, typing) and does filling, previews and its 500 ms early-accept
+// guard. Keep the host popup non-activating: Chromium hides the suggestions
+// when the tab's view loses focus. Arrow keys/Enter/Tab/Escape in the field
+// are handled by the engine (phase 2 reports keyboard selection).
+// phase: 0 shown or updated (same request_id while open), 1 hidden (identity
+// and request_id only), 2 selection changed, 3 open settings_url (from
+// ReArcAutofillManage or a "Manage..." row; request_id may be 0). Password
+// rows carry the username and Chromium's masked label, never the password.
+// product: Chromium
+// FillingProduct (1 address, 2 credit card, 4 IBAN, 5 autocomplete,
+// 6 password, 12 datalist). x/y/width/height: the field in the tab view's
+// DIP coordinates (top-left origin). selected: row or -1.
+// Suggestion kind: 0 fill entry, 1 manage footer, 2 separator, 3 other
+// (type is Chromium's SuggestionType, advisory). icon: "", "account",
+// "email", "home", "work", "location", "globe", "key", "settings", "undo",
+// "delete", "edit", "password_manager", "card", "card_<network>" (amex,
+// diners, discover, elo, jcb, mastercard, mir, troy, unionpay, verve, visa),
+// "iban" or "other". Strings are page/profile data, borrowed.
+typedef struct ReArcAutofillSuggestion {
+  const char* value;
+  const char* minor;
+  const char* label;
+  const char* icon;
+  uint32_t kind, type;
+  bool acceptable;
+} ReArcAutofillSuggestion;
+typedef struct ReArcAutofillEvent {
+  uint64_t profile_id, tab_id, content_generation, request_id;
+  uint32_t phase, product;
+  double x, y, width, height;
+  int32_t selected;
+  const ReArcAutofillSuggestion* suggestions;
+  size_t suggestion_count;
+  const char* settings_url;
+} ReArcAutofillEvent;
+typedef void (*ReArcAutofillCallback)(void* context,
+                                      const ReArcAutofillEvent* event);
+// Replacement hides open suggestions (their events are not delivered).
+REARC_ENGINE_EXPORT void ReArcEngineSetAutofillCallback(
+    ReArcAutofillCallback callback, void* context);
+// Fills (or runs) an acceptable row. Within 550 ms of being shown: busy
+// (Chromium ignores early accepts); retry. Unknown/hidden: not_found.
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutofillAccept(uint64_t request_id,
+                                                    int32_t index);
+// Hover/highlight: previews a fill row in the page; -1 clears the preview.
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutofillSelect(uint64_t request_id,
+                                                    int32_t index);
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutofillDismiss(uint64_t request_id);
+// Hides the suggestions and posts phase 3 with the settings page for the
+// product (chrome://settings/contactInfo, /payments, /autofill or
+// chrome://password-manager/passwords); the host opens it as a tab.
+REARC_ENGINE_EXPORT ReArcStatus ReArcAutofillManage(uint64_t request_id);
