+
+namespace autofill {
+class AutofillPopupController;
+class AutofillPopupView;
+}  // namespace autofill
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace rearc {
+
+// Wave 18f (autofill_suggestions). The view of Chromium's
+// AutofillPopupControllerImpl for registry tabs: suggestions reach the host
+// as events, and the host's accept/select/dismiss calls go back through the
+// controller (Chromium's filling, previews, metrics and accept threshold).
+// Chromium's Views popup is never created; without a host callback no popup
+// is shown at all. Sub-popups are not supported.
+base::WeakPtr<autofill::AutofillPopupView> CreateHostAutofillPopupView(
+    base::WeakPtr<autofill::AutofillPopupController> controller);
+// Settings requests from a suggestion footer (ChromeAutofillClient and
+// ChromePasswordManagerClient): the host opens Chromium's settings page.
+void RequestHostAutofillSettings(content::WebContents* contents,
