new file mode 100644
index 0000000000..bbe92093ea
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_autofill_popup.cc
@@ -0,0 +1,507 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rearc_bridge/rearc_autofill_popup.h"
+
+#include <pthread.h>
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/ui/autofill/autofill_popup_controller.h"
+#include "chrome/browser/ui/autofill/autofill_popup_view.h"
+#include "components/autofill/core/browser/filling/filling_product.h"
+#include "components/autofill/core/browser/metrics/autofill_metrics.h"
+#include "components/autofill/core/browser/suggestions/suggestion.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace rearc {
+namespace {
+
+using autofill::FillingProduct;
+using autofill::Suggestion;
+using autofill::SuggestionType;
+
+ReArcAutofillCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+
+class HostView;
+std::map<uint64_t, base::WeakPtr<HostView>>& Pending() {
+  static base::NoDestructor<std::map<uint64_t, base::WeakPtr<HostView>>> map;
+  return *map;
+}
+
+const char* IconName(Suggestion::Icon icon) {
+  switch (icon) {
+    case Suggestion::Icon::kNoIcon:
+      return "";
+    case Suggestion::Icon::kHome:
+      return "home";
+    case Suggestion::Icon::kWork:
+      return "work";
+    case Suggestion::Icon::kAccount:
+      return "account";
+    case Suggestion::Icon::kEmail:
+      return "email";
+    case Suggestion::Icon::kGlobe:
+      return "globe";
+    case Suggestion::Icon::kKey:
+      return "key";
+    case Suggestion::Icon::kLocation:
+      return "location";
+    case Suggestion::Icon::kSettings:
+      return "settings";
+    case Suggestion::Icon::kUndo:
+      return "undo";
+    case Suggestion::Icon::kDelete:
+      return "delete";
+    case Suggestion::Icon::kEdit:
+      return "edit";
+    case Suggestion::Icon::kGooglePasswordManager:
+      return "password_manager";
+    case Suggestion::Icon::kCardGeneric:
+    case Suggestion::Icon::kCardGenericVector:
+      return "card";
+    case Suggestion::Icon::kCardAmericanExpress:
+      return "card_amex";
+    case Suggestion::Icon::kCardDiners:
+      return "card_diners";
+    case Suggestion::Icon::kCardDiscover:
+      return "card_discover";
+    case Suggestion::Icon::kCardElo:
+      return "card_elo";
+    case Suggestion::Icon::kCardJCB:
+      return "card_jcb";
+    case Suggestion::Icon::kCardMasterCard:
+      return "card_mastercard";
+    case Suggestion::Icon::kCardMir:
+      return "card_mir";
+    case Suggestion::Icon::kCardTroy:
+      return "card_troy";
+    case Suggestion::Icon::kCardUnionPay:
+      return "card_unionpay";
+    case Suggestion::Icon::kCardVerve:
+      return "card_verve";
+    case Suggestion::Icon::kCardVisa:
+      return "card_visa";
+    case Suggestion::Icon::kIban:
+      return "iban";
+    default:
+      return "other";
+  }
+}
+
+// 0 fill entry, 1 manage/settings footer, 2 separator, 3 other.
+uint32_t Kind(SuggestionType type) {
+  switch (type) {
+    case SuggestionType::kAutocompleteEntry:
+    case SuggestionType::kAddressEntry:
+    case SuggestionType::kAddressEntryOnTyping:
+    case SuggestionType::kAddressFieldByFieldFilling:
+    case SuggestionType::kDatalistEntry:
+    case SuggestionType::kPasswordEntry:
+    case SuggestionType::kBackupPasswordEntry:
+    case SuggestionType::kAccountStoragePasswordEntry:
+    case SuggestionType::kFillPassword:
+    case SuggestionType::kCreditCardEntry:
+    case SuggestionType::kVirtualCreditCardEntry:
+    case SuggestionType::kIbanEntry:
+      return 0;
+    case SuggestionType::kManageAddress:
+    case SuggestionType::kManageCreditCard:
+    case SuggestionType::kManageIban:
+    case SuggestionType::kManageOffers:
+    case SuggestionType::kAllSavedPasswordsEntry:
+      return 1;
+    case SuggestionType::kSeparator:
+      return 2;
+    default:
+      return 3;
+  }
+}
+
+const char* SettingsUrl(FillingProduct product) {
+  switch (product) {
+    case FillingProduct::kAddress:
+      return "chrome://settings/contactInfo";
+    case FillingProduct::kCreditCard:
+    case FillingProduct::kIban:
+    case FillingProduct::kMerchantPromoCode:
+      return "chrome://settings/payments";
+    case FillingProduct::kPassword:
+      return "chrome://password-manager/passwords";
+    default:
+      return "chrome://settings/autofill";
+  }
+}
+
+TabSession* SessionFor(const content::WebContents* contents) {
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    TabSession* session = TabRegistry::Get().FindSession(id);
+    if (session && session->web_contents() == contents) {
+      return session;
+    }
+  }
+  return nullptr;
+}
+
+struct Row {
+  std::string value, minor, label, icon;
+  uint32_t kind, type;
+  bool acceptable;
+};
+struct Snapshot {
+  ReArcAutofillEvent event{};
+  std::vector<Row> rows;
+  std::string settings_url;
+};
+
+void Deliver(Snapshot snapshot) {
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, Snapshot s) {
+        if (!host || expected != epoch) {
+          return;
+        }
+        std::vector<ReArcAutofillSuggestion> rows;
+        for (const auto& r : s.rows) {
+          rows.push_back({r.value.c_str(), r.minor.c_str(), r.label.c_str(),
+                          r.icon.c_str(), r.kind, r.type, r.acceptable});
+        }
+        ReArcAutofillEvent e = s.event;
+        e.suggestions = rows.empty() ? nullptr : rows.data();
+        e.suggestion_count = rows.size();
+        e.settings_url = s.settings_url.c_str();
+        host(host_context, &e);
+      },
+      epoch, std::move(snapshot)));
+}
+
+void Identify(ReArcAutofillEvent& e, content::WebContents* contents) {
+  if (TabSession* session = SessionFor(contents)) {
+    e.profile_id = session->profile_id();
+    e.tab_id = session->tab_id();
+    e.content_generation = session->content_generation();
+  }
+}
+
+class HostView : public autofill::AutofillPopupView {
+ public:
+  explicit HostView(base::WeakPtr<autofill::AutofillPopupController> controller)
+      : controller_(std::move(controller)) {}
+  ~HostView() override = default;
+
+  bool Show(autofill::AutoselectFirstSuggestion autoselect) override {
+    id_ = next_id++;
+    Pending().emplace(id_, weak_.GetWeakPtr());
+    shown_ = base::TimeTicks::Now();
+    Identify(identity_, controller_->GetWebContents());
+    if (autoselect.value()) {
+      Move(+1, /*publish=*/false);
+    }
+    Publish(0);
+    // Starts Chromium's early-accept barrier as a painted popup does.
+    controller_->OnPopupPainted();
+    return true;
+  }
+  void Hide() override {
+    Pending().erase(id_);
+    Publish(1);
+    delete this;
+  }
+  bool HandleKeyPressEvent(const input::NativeWebKeyboardEvent& event) override {
+    if (event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+      return false;
+    }
+    const bool other_modifiers =
+        event.GetModifiers() & (blink::WebInputEvent::kControlKey |
+                                blink::WebInputEvent::kAltKey |
+                                blink::WebInputEvent::kMetaKey);
+    switch (event.windows_key_code) {
+      case ui::VKEY_UP:
+        Move(-1, true);
+        return true;
+      case ui::VKEY_DOWN:
+        Move(+1, true);
+        return true;
+      case ui::VKEY_ESCAPE:
+        controller_->Hide(autofill::SuggestionHidingReason::kUserAborted);
+        return true;
+      case ui::VKEY_RETURN:
+        if (selected_ < 0) {
+          return false;
+        }
+        Accept(selected_,
+               autofill::AutofillMetrics::SuggestionAcceptedMethod::kKeyboard);
+        return true;
+      case ui::VKEY_TAB:
+        // As PopupViewViews: accept, but let the Tab move focus.
+        if (selected_ >= 0 && !other_modifiers) {
+          Accept(selected_,
+                 autofill::AutofillMetrics::SuggestionAcceptedMethod::kKeyboard);
+        }
+        return false;
+      default:
+        return false;
+    }
+  }
+  void OnSuggestionsChanged(bool) override {
+    if (selected_ >= controller_->GetLineCount()) {
+      selected_ = -1;
+    }
+    Publish(0);
+  }
+  bool OverlapsWithPictureInPictureWindow() const override { return false; }
+  void AxAnnounce(const std::u16string&) override {}
+  std::optional<int32_t> GetAxUniqueId() override { return std::nullopt; }
+  base::WeakPtr<autofill::AutofillPopupView> CreateSubPopupView(
+      base::WeakPtr<autofill::AutofillPopupController>) override {
+    return nullptr;
+  }
+  std::optional<size_t> GetIndexOfSubPopupAnchorSuggestion() const override {
+    return std::nullopt;
+  }
+  bool HasFocus() const override { return false; }
+  base::WeakPtr<autofill::AutofillPopupView> GetWeakPtr() override {
+    return weak_.GetWeakPtr();
+  }
+
+  // Host calls. `this` may be deleted by the controller during any of them.
+  ReArcStatus HostAccept(int index) {
+    if (!Acceptable(index)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    if (base::TimeTicks::Now() - shown_ <
+        autofill::AutofillSuggestionController::
+                kIgnoreEarlyClicksOnSuggestionsDuration +
+            base::Milliseconds(50)) {
+      return REARC_BUSY;
+    }
+    Accept(index, autofill::AutofillMetrics::SuggestionAcceptedMethod::kMouse);
+    return REARC_OK;
+  }
+  ReArcStatus HostSelect(int index) {
+    if (index < 0) {
+      selected_ = -1;
+      controller_->UnselectSuggestion();
+      return REARC_OK;
+    }
+    if (!Acceptable(index)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    selected_ = index;
+    controller_->SelectSuggestion(index);
+    return REARC_OK;
+  }
+  void HostDismiss() {
+    controller_->Hide(autofill::SuggestionHidingReason::kUserAborted);
+  }
+  void HostManage() {
+    Snapshot s;
+    s.event.phase = 3;
+    s.event.request_id = id_;
+    s.event.product = static_cast<uint32_t>(controller_->GetMainFillingProduct());
+    s.event.selected = -1;
+    s.settings_url = SettingsUrl(controller_->GetMainFillingProduct());
+    Identify(s.event, controller_->GetWebContents());
+    controller_->Hide(autofill::SuggestionHidingReason::kUserAborted);
+    Deliver(std::move(s));
+  }
+
+ private:
+  bool Acceptable(int index) const {
+    return index >= 0 && index < controller_->GetLineCount() &&
+           controller_->GetSuggestionAt(index).IsAcceptable() &&
+           controller_->GetSuggestionAt(index).type != SuggestionType::kSeparator;
+  }
+  void Move(int step, bool publish) {
+    const int count = controller_->GetLineCount();
+    int index = selected_;
+    for (int i = 0; i < count; ++i) {
+      index = index < 0 ? (step > 0 ? 0 : count - 1)
+                        : (index + step + count) % count;
+      if (Acceptable(index)) {
+        selected_ = index;
+        controller_->SelectSuggestion(index);
+        if (publish) {
+          Publish(2);
+        }
+        return;
+      }
+    }
+  }
+  void Accept(int index,
+              autofill::AutofillMetrics::SuggestionAcceptedMethod method) {
+    controller_->AcceptSuggestion(index, method, /*was_obscured=*/false);
+  }
+  void Publish(uint32_t phase) {
+    Snapshot s;
+    s.event = identity_;
+    s.event.phase = phase;
+    s.event.request_id = id_;
+    s.event.selected = selected_;
+    if (!controller_) {
+      Deliver(std::move(s));  // Controller teardown: hidden, identity only.
+      return;
+    }
+    content::WebContents* contents = controller_->GetWebContents();
+    s.event.product = static_cast<uint32_t>(controller_->GetMainFillingProduct());
+    // Chromium keeps the field in screen space; the host wants it relative
+    // to the tab's view.
+    gfx::RectF bounds = controller_->element_bounds();
+    bounds.Offset(-contents->GetContainerBounds().OffsetFromOrigin());
+    s.event.x = bounds.x();
+    s.event.y = bounds.y();
+    s.event.width = bounds.width();
+    s.event.height = bounds.height();
+    if (phase == 0) {
+      for (const Suggestion& suggestion : controller_->GetSuggestions()) {
+        Row row;
+        row.value = base::UTF16ToUTF8(suggestion.main_text.value);
+        if (!suggestion.minor_texts.empty()) {
+          row.minor = base::UTF16ToUTF8(suggestion.minor_texts[0].value);
+        }
+        if (!suggestion.labels.empty() && !suggestion.labels[0].empty()) {
+          row.label = base::UTF16ToUTF8(suggestion.labels[0][0].value);
+        }
+        row.icon = IconName(suggestion.icon);
+        row.kind = Kind(suggestion.type);
+        row.type = static_cast<uint32_t>(suggestion.type);
+        row.acceptable = suggestion.IsAcceptable() &&
+                         suggestion.type != SuggestionType::kSeparator;
+        s.rows.push_back(std::move(row));
+      }
+    }
+    Deliver(std::move(s));
+  }
+
+  base::WeakPtr<autofill::AutofillPopupController> controller_;
+  ReArcAutofillEvent identity_{};
+  uint64_t id_ = 0;
+  int selected_ = -1;
+  base::TimeTicks shown_;
+  base::WeakPtrFactory<HostView> weak_{this};
+};
+
+void Settings(content::WebContents* contents, const char* url,
+              FillingProduct product) {
+  if (!host) {
+    return;
+  }
+  Snapshot s;
+  s.event.phase = 3;
+  s.event.selected = -1;
+  s.event.product = static_cast<uint32_t>(product);
+  s.settings_url = url;
+  Identify(s.event, contents);
+  Deliver(std::move(s));
+}
+
+}  // namespace
+
+base::WeakPtr<autofill::AutofillPopupView> CreateHostAutofillPopupView(
+    base::WeakPtr<autofill::AutofillPopupController> controller) {
+  CHECK(pthread_main_np());
+  if (!host || !controller || !SessionFor(controller->GetWebContents())) {
+    return nullptr;  // Never Chromium's popup; no host, no suggestions UI.
+  }
+  return (new HostView(std::move(controller)))->GetWeakPtr();
+}
+
+void RequestHostAutofillSettings(content::WebContents* contents,
+                                 SuggestionType type) {
+  CHECK(pthread_main_np());
+  switch (type) {
+    case SuggestionType::kManageAddress:
+      Settings(contents, SettingsUrl(FillingProduct::kAddress),
+               FillingProduct::kAddress);
+      return;
+    case SuggestionType::kManageCreditCard:
+    case SuggestionType::kManageIban:
+    case SuggestionType::kManageOffers:
+      Settings(contents, SettingsUrl(FillingProduct::kCreditCard),
+               FillingProduct::kCreditCard);
+      return;
+    default:
+      Settings(contents, SettingsUrl(FillingProduct::kNone),
+               FillingProduct::kNone);
+      return;
+  }
+}
+
+void RequestHostPasswordSettings(content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  Settings(contents, SettingsUrl(FillingProduct::kPassword),
+           FillingProduct::kPassword);
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetAutofillCallback(ReArcAutofillCallback cb, void* ctx) {
+  CHECK(pthread_main_np());
+  std::vector<base::WeakPtr<rearc::HostView>> views;
+  for (auto& [id, view] : rearc::Pending()) {
+    views.push_back(view);
+  }
+  // Hidden events of the old registration are invalidated with it.
+  for (auto& view : views) {
+    if (view) {
+      view->HostDismiss();
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = cb;
+  rearc::host_context = ctx;
+}
+
+namespace {
+rearc::HostView* FindView(uint64_t id) {
+  auto it = rearc::Pending().find(id);
+  return it == rearc::Pending().end() ? nullptr : it->second.get();
+}
+}  // namespace
+
+ReArcStatus ReArcAutofillAccept(uint64_t request_id, int32_t index) {
+  CHECK(pthread_main_np());
+  rearc::HostView* view = FindView(request_id);
+  return view ? view->HostAccept(index) : REARC_NOT_FOUND;
+}
+
+ReArcStatus ReArcAutofillSelect(uint64_t request_id, int32_t index) {
+  CHECK(pthread_main_np());
+  rearc::HostView* view = FindView(request_id);
+  return view ? view->HostSelect(index) : REARC_NOT_FOUND;
+}
+
+ReArcStatus ReArcAutofillDismiss(uint64_t request_id) {
+  CHECK(pthread_main_np());
+  rearc::HostView* view = FindView(request_id);
+  if (!view) {
+    return REARC_NOT_FOUND;
+  }
+  view->HostDismiss();
+  return REARC_OK;
+}
+
+ReArcStatus ReArcAutofillManage(uint64_t request_id) {
+  CHECK(pthread_main_np());
+  rearc::HostView* view = FindView(request_id);
+  if (!view) {
+    return REARC_NOT_FOUND;
+  }
+  view->HostManage();
+  return REARC_OK;
+}
