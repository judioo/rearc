+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 24, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // changes bits: URL=1, title=2, loading=4, progress=8, crashed=16,
@@ -133,6 +133,21 @@ REARC_ENGINE_EXPORT ReArcStatus ReArcProfileCreateOffTheRecord(
 REARC_ENGINE_EXPORT ReArcStatus ReArcProfileClose(
     uint64_t profile_id, bool force, ReArcCompletion completion, void* context);
 
+// Warning actions (dangerous_downloads, ABI 1.24). Existing download event
+// danger_type and actions 0..5 retain their ABI 1.17 meaning/layout.
+typedef struct ReArcDownloadWarning {
+  uint32_t danger_type, insecure_status;
+  bool is_dangerous, is_insecure;
+} ReArcDownloadWarning;
+REARC_ENGINE_EXPORT ReArcStatus ReArcDownloadGetWarning(
+    uint64_t profile_id, uint32_t download_id, ReArcDownloadWarning* warning);
+// action: 0 keep, 1 discard. Only an unfinished dangerous/insecure item.
+// Keep validates insecure first, then danger on a subsequent explicit call if
+// still dangerous, exactly as chrome://downloads does. Discard removes the
+// item and its file through DownloadItem::Remove. No automatic opening.
+REARC_ENGINE_EXPORT ReArcStatus ReArcDownloadResolveDanger(
+    uint64_t profile_id, uint32_t download_id, uint32_t action);
+
 // HistoryService queries/deletions (history_query, ABI 1.23). No OTR access.
 // Empty text returns recent unique URLs, newest first. UTF-8 <=4096 bytes;
 // limit 1..1000. visit_time_us is microseconds since Unix epoch; visit_count
