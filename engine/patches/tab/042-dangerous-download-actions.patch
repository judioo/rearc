From 164051a14bee079c10359349f9d757c08cb24fb4 Mon Sep 17 00:00:00 2001
From: ReArc Overlay <overlay@rearc.invalid>
Date: Wed, 4 Nov 2026 10:39:16 +0400
Subject: [PATCH] P-TAB-001 wave 18d: expose explicit download warning keep and
 discard

Preserve ABI 1.17 events/actions and add warning snapshots plus keep/discard forwarding to Chromium validation and removal. Insecure validation precedes dangerous validation, matching the downloads page. ABI 1.24 / bridge 0.26.0; build p66 and native dangerous-content keep/discard plus legacy downloads pass.

Last rebased: 2026-11-04 onto Chromium 156.0.8078.74 (d331de35ca).

Co-Authored-By: Codex <noreply@openai.com>
---
 .../rearc_bridge/rearc_downloads_abi.cc       | 34 +++++++++++++++++++
 .../browser/rearc_bridge/rearc_engine_abi.h   | 17 +++++++++-
 .../browser/rearc_bridge/rearc_engine_abi.mm  |  1 +
 .../rearc_bridge/rearc_engine_entry_mac.mm    |  2 +-
 4 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/rearc_bridge/rearc_downloads_abi.cc b/chrome/browser/rearc_bridge/rearc_downloads_abi.cc
index 9f1ed6af9a..51d2320928 100644
--- a/chrome/browser/rearc_bridge/rearc_downloads_abi.cc
+++ b/chrome/browser/rearc_bridge/rearc_downloads_abi.cc
@@ -302,3 +302,37 @@ ReArcStatus ReArcDownloadAction(uint64_t profile_id,
   }
   return REARC_INVALID_ARGUMENT;
 }
+
+ReArcStatus ReArcDownloadGetWarning(uint64_t profile, uint32_t id,
+                                    ReArcDownloadWarning* warning) {
+  CHECK(pthread_main_np());
+  if (warning) *warning = {};
+  if (auto status = rearc::Available()) return status;
+  if (!warning) return REARC_INVALID_ARGUMENT;
+  auto it = rearc::Downloads().find(profile);
+  if (it == rearc::Downloads().end()) return REARC_PROFILE_NOT_FOUND;
+  auto* item = it->second->Find(id);
+  if (!item) return REARC_NOT_FOUND;
+  warning->danger_type = static_cast<uint32_t>(item->GetDangerType());
+  warning->insecure_status = static_cast<uint32_t>(item->GetInsecureDownloadStatus());
+  warning->is_dangerous = item->IsDangerous();
+  warning->is_insecure = item->IsInsecure();
+  return REARC_OK;
+}
+ReArcStatus ReArcDownloadResolveDanger(uint64_t profile, uint32_t id,
+                                       uint32_t action) {
+  CHECK(pthread_main_np());
+  if (auto status = rearc::Available()) return status;
+  if (action > 1) return REARC_INVALID_ARGUMENT;
+  auto it = rearc::Downloads().find(profile);
+  if (it == rearc::Downloads().end()) return REARC_PROFILE_NOT_FOUND;
+  auto* item = it->second->Find(id);
+  if (!item) return REARC_NOT_FOUND;
+  if (item->IsDone() || (!item->IsDangerous() && !item->IsInsecure()))
+    return REARC_INVALID_STATE;
+  // Validation/Remove can synchronously delete the item. Never access it again.
+  if (action == 1) item->Remove();
+  else if (item->IsInsecure()) item->ValidateInsecureDownload();
+  else item->ValidateDangerousDownload();
+  return REARC_OK;
+}
