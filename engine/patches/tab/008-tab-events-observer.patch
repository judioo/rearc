@@ -0,0 +1,76 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_TAB_OBSERVER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_TAB_OBSERVER_H_
+
+#include <cstdint>
+
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace content {
+class NavigationEntry;
+class NavigationHandle;
+class WebContents;
+}  // namespace content
+
+namespace rearc {
+
+// Per-session WebContentsObserver translating content-layer callbacks into
+// the rearc.ipc.v1 event vocabulary (P-TAB-001 slice S3). One observer per
+// TabSession, attached via AttachTabObserver after tab.created has been
+// emitted (§3: no event for a tab may precede tab.created).
+//
+// Emission rules (rearc.ipc.v1 §§3-4):
+//  * tab.updated carries only fields whose has_ flag is set (sparse changes).
+//  * navigation.* is emitted only for IsInPrimaryMainFrame() handles;
+//    committed vs failed splits on HasCommitted(). ERR_ABORTED still emits
+//    navigation.failed (it is a cancellation, not a silent drop).
+//  * tab.closed is emitted from WebContentsDestroyed — after the host views
+//    have been emptied by the S4 lease invalidation — and is always the
+//    final event for a tab. It races session teardown, so the observer
+//    carries the last-known content generation itself.
+//  * The observer self-detaches (posted task) after WebContentsDestroyed so
+//    destruction never happens inside a content callback.
+//
+// All calls are main thread (Chromium BrowserThread::UI) only.
+class TabObserver : public content::WebContentsObserver {
+ public:
+  TabObserver(content::WebContents* web_contents, uint64_t tab_id);
+  ~TabObserver() override;
+
+  TabObserver(const TabObserver&) = delete;
+  TabObserver& operator=(const TabObserver&) = delete;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void DidStartLoading() override;
+  void DidStopLoading() override;
+  void LoadProgressChanged(double progress) override;
+  void TitleWasSet(content::NavigationEntry* entry) override;
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override;
+  void WebContentsDestroyed() override;
+
+ private:
+  const uint64_t tab_id_;
+  // Last-known content generation, sampled at attach and after every emitted
+  // event, so tab.closed can be stamped even after the session is gone.
+  uint64_t last_known_generation_ = 0;
+
+  base::WeakPtrFactory<TabObserver> weak_factory_{this};
+};
+
+// Attaches a TabObserver to the session's WebContents. No-op (VLOG) for
+// unknown tab_ids. Call only after EmitTabCreatedEvent for the tab.
+void AttachTabObserver(uint64_t tab_id);
+
+// Detaches and destroys the session's observer, if any. Idempotent.
+void DetachTabObserver(uint64_t tab_id);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_TAB_OBSERVER_H_
