+namespace {
+const char kDestructionCompletion = 0;
+// SupportsUserData is destroyed after the BrowserContext/KeyedServices. Keep
+// the parent alive until the OTR destruction and its callback have unwound.
+class DestructionCompletion final : public base::SupportsUserData::Data {
+ public:
+  DestructionCompletion(std::unique_ptr<ScopedProfileKeepAlive> keep_alive,
+                        base::OnceClosure completion)
+      : keep_alive_(std::move(keep_alive)), completion_(std::move(completion)) {}
+  ~DestructionCompletion() override {
+    ABIPost(base::BindOnce(
+        [](std::unique_ptr<ScopedProfileKeepAlive>, base::OnceClosure done) {
+          std::move(done).Run();
+        }, std::move(keep_alive_), std::move(completion_)));
+  }
+ private:
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  base::OnceClosure completion_;
+};
+}  // namespace
+void ReleaseBridgeProfile(uint64_t id, base::OnceClosure completion) {
   CHECK(pthread_main_np());
-  default_id = 0;
-  Profiles().clear();
+  Profile* profile = FindBridgeProfile(id);
+  CHECK(profile);
+  CHECK(!BridgeProfileHasChildren(id));
+  if (profile->IsOffTheRecord()) {
+    profile->SetUserData(&kDestructionCompletion,
+        std::make_unique<DestructionCompletion>(
+            std::move(Profiles().at(profile).keep_alive), std::move(completion)));
+    UnregisterBridgeProfile(profile);
+    ProfileDestroyer::DestroyOTRProfileWhenAppropriate(profile);
+  } else {
+    UnregisterBridgeProfile(profile);
+    ABIPost(std::move(completion));
+  }
+}
+void ReleaseBridgeProfiles(base::OnceClosure completion) {
+  CHECK(pthread_main_np());
+  if (Profiles().empty()) {
+    ABIPost(std::move(completion));
+    return;
+  }
+  // Destroy all OTRs before any original, including delayed renderer cleanup.
+  Profile* next = Profiles().begin()->first;
+  for (const auto& [profile, entry] : Profiles()) {
+    if (profile->IsOffTheRecord()) {
+      next = profile;
+      break;
+    }
+  }
+  ReleaseBridgeProfile(BridgeProfileId(next),
+      base::BindOnce(&ReleaseBridgeProfiles, std::move(completion)));
 }
