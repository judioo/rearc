+ReArcStatus ReArcProfileOpen(const char* name, ReArcProfileCallback completion,
+                               void* context) {
+  if (auto status = rearc::Available()) return status;
+  if (!name || !completion) return REARC_INVALID_ARGUMENT;
+  std::string key(name);
+  if (key.empty() || key.size() > 64 ||
+      !std::ranges::all_of(key, [](unsigned char c) {
+        return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '_' || c == '-';
+      })) return REARC_INVALID_ARGUMENT;
+  auto& a = ABI::Get();
+  if (a.closing_profile) return REARC_BUSY;
+  auto& requests = a.profile_opens[key];
+  requests.push_back({completion, context});
+  if (requests.size() > 1) return REARC_OK;
+  auto* manager = g_browser_process->profile_manager();
+  // Hex keys preserve case-sensitive identity on case-insensitive macOS disks.
+  auto path = manager->user_data_dir().AppendASCII(
+      "ReArcProfile-" + base::HexEncode(key));
+  manager->CreateProfileAsync(path, base::BindOnce([](std::string key, Profile* p) {
+    auto& a = ABI::Get();
+    if (!a.profile_opens.contains(key)) return;
+    if (p) rearc::RegisterBridgeProfile(p, false);
+    rearc::ABIPost(base::BindOnce([](std::string key, uint64_t id) {
+      ABI::Get().CompleteProfileOpen(std::move(key), id, false);
+    }, std::move(key), p ? rearc::BridgeProfileId(p) : 0));
+  }, std::move(key)));
+  return REARC_OK;
+}
+ReArcStatus ReArcProfileCreateOffTheRecord(uint64_t parent_id,
+    ReArcProfileCallback completion, void* context) {
+  if (auto status = rearc::Available()) return status;
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  auto& a = ABI::Get();
+  if (a.closing_profile) return REARC_BUSY;
+  auto* parent = rearc::FindBridgeProfile(parent_id);
+  if (!parent) return REARC_PROFILE_NOT_FOUND;
+  if (parent->IsOffTheRecord()) return REARC_INVALID_ARGUMENT;
+  // No extension integration in the browser-less host: use non-primary OTR.
+  auto* profile = parent->GetOffTheRecordProfile(
+      Profile::OTRProfileID::CreateUnique("rearc.space"), true);
+  rearc::RegisterBridgeProfile(profile, false);
+  uint64_t id = rearc::BridgeProfileId(profile);
+  std::string key = "@otr-" + std::to_string(id);
+  a.profile_opens[key].push_back({completion, context});
+  rearc::ABIPost(base::BindOnce([](std::string key, uint64_t id) {
+    ABI::Get().CompleteProfileOpen(std::move(key), id, true);
+  }, std::move(key), id));
+  return REARC_OK;
+}
+ReArcStatus ReArcProfileClose(uint64_t id, bool force,
+                              ReArcCompletion completion, void* context) {
+  if (auto status = rearc::Available()) return status;
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  auto& a = ABI::Get();
+  if (!rearc::FindBridgeProfile(id)) return REARC_PROFILE_NOT_FOUND;
+  if (id == rearc::DefaultBridgeProfileId()) return REARC_INVALID_STATE;
+  if (a.closing_profile || !a.profile_opens.empty() ||
+      rearc::BridgeProfileHasChildren(id)) return REARC_BUSY;
+  a.profile_tabs.clear();
+  for (uint64_t tab : rearc::TabRegistry::Get().SessionIds()) {
+    auto* s = rearc::TabRegistry::Get().FindSession(tab);
+    if (s->profile_id() != id) continue;
+    if (s->close_state() != rearc::TabSession::CloseState::kOpen) return REARC_BUSY;
+    a.profile_tabs.push_back(tab);
+  }
+  // The registry removes sessions one task before their contents destructor.
+  // A reentrant lease invalidation callback must not release that context.
+  auto live = a.profile_live_tabs.find(id);
+  if (live != a.profile_live_tabs.end() && live->second != a.profile_tabs.size())
+    return REARC_BUSY;
+  a.closing_profile = id;
+  a.profile_waiting = false;
+  a.profile_index = 0;
+  a.profile_force = force;
+  a.profile_completion = completion;
+  a.profile_context = context;
+  // Defer even an empty persistent close; never callback inside this call.
+  rearc::ABIPost(base::BindOnce([] { ABI::Get().ContinueProfileClose(); }));
+  return REARC_OK;
+}
