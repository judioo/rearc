+ReArcStatus ReArcProfileInstallExtensions(uint64_t profile_id,
+    const char* const* ids, uint32_t count,
+    ReArcExtensionInstallCallback callback, void* context) {
+  CHECK([NSThread isMainThread]);
+  if (auto status = rearc::Available()) return status;
+  if (!ids || !count || count > 512 || !callback) return REARC_INVALID_ARGUMENT;
+  auto* profile = rearc::FindBridgeProfile(profile_id);
+  if (!profile) return REARC_PROFILE_NOT_FOUND;
+  if (profile->IsOffTheRecord()) return REARC_INVALID_ARGUMENT;
+  if (ABI::Get().closing_profile == profile_id ||
+      rearc::ExtensionInstallProfiles().contains(profile_id)) return REARC_BUSY;
+  std::set<std::string> seen;
+  auto batch = base::MakeRefCounted<rearc::ExtensionInstallBatch>();
+  for (uint32_t i = 0; i < count; ++i) {
+    if (!ids[i] || !crx_file::id_util::IdIsValid(ids[i]) ||
+        !seen.insert(ids[i]).second) return REARC_INVALID_ARGUMENT;
+    batch->ids.emplace_back(ids[i]);
+  }
+  batch->profile_id = profile_id;
+  batch->callback = callback;
+  batch->context = context;
+  rearc::ExtensionInstallProfiles().insert(profile_id);
+  rearc::ABIPost(base::BindOnce(&rearc::ExtensionInstallBatch::Pump, batch));
+  return REARC_OK;
+}
+
+ReArcStatus ReArcProfileLoadUnpackedExtension(uint64_t profile_id,
+    const char* path, ReArcExtensionInstallCallback callback, void* context) {
+  CHECK([NSThread isMainThread]);
+  if (auto status = rearc::Available()) return status;
+  if (!path || !base::FilePath(path).IsAbsolute() || !callback)
+    return REARC_INVALID_ARGUMENT;
+  auto* profile = rearc::FindBridgeProfile(profile_id);
+  if (!profile) return REARC_PROFILE_NOT_FOUND;
+  if (profile->IsOffTheRecord()) return REARC_INVALID_ARGUMENT;
+  if (ABI::Get().closing_profile == profile_id ||
+      rearc::ExtensionInstallProfiles().contains(profile_id)) return REARC_BUSY;
+  rearc::ExtensionInstallProfiles().insert(profile_id);
+  rearc::ABIPost(base::BindOnce([](uint64_t profile_id, base::FilePath path,
+      ReArcExtensionInstallCallback callback, void* context) {
+    auto installer = extensions::UnpackedInstaller::Create(
+        rearc::FindBridgeProfile(profile_id));
+    installer->set_completion_callback(base::BindOnce(
+        [](uint64_t profile_id, ReArcExtensionInstallCallback callback,
+           void* context, const extensions::Extension* extension,
+           const base::FilePath&, const std::u16string& error) {
+          std::string id = extension ? extension->id() : "";
+          rearc::ABIPost(base::BindOnce([](uint64_t profile_id,
+              ReArcExtensionInstallCallback callback, void* context,
+              std::string id, std::string error) {
+            rearc::ExtensionInstallProfiles().erase(profile_id);
+            callback(context, id.c_str(), error.empty() ? 0 : 3,
+                     error.c_str(), 1, 1);
+          }, profile_id, callback, context, id, base::UTF16ToUTF8(error)));
+        }, profile_id, callback, context));
+    installer->Load(path);
+  }, profile_id, base::FilePath(path), callback, context));
+  return REARC_OK;
+}
