+namespace {
+WebstoreInstaller::FailureReason StoreDownloadFailure(const DownloadItem* item) {
+  const auto* headers = item ? item->GetResponseHeaders().get() : nullptr;
+  const int status = headers ? headers->response_code() : 0;
+  // Store redirect requests return 204 when no installable item is available.
+  return status == 204 || status == 404 || status == 410
+      ? WebstoreInstaller::FAILURE_REASON_NOT_FOUND
+      : WebstoreInstaller::FAILURE_REASON_OTHER;
+}
+}  // namespace
