+struct ExtensionInstallBatch : base::RefCounted<ExtensionInstallBatch> {
+  uint64_t profile_id;
+  std::vector<std::string> ids;
+  size_t next = 0;
+  uint32_t completed = 0;
+  int active = 0;
+  ReArcExtensionInstallCallback callback;
+  raw_ptr<void> context;
+
+  void Finish(std::string id, int result, std::string reason) {
+    --active;
+    ++completed;
+    if (completed == ids.size()) ExtensionInstallProfiles().erase(profile_id);
+    // Deliver before pumping so callbacks are ordered and context has a clear
+    // terminal boundary. Reentrancy cannot start a second batch until terminal.
+    callback(context, id.c_str(), result, reason.c_str(), completed, ids.size());
+    Pump();
+  }
+  void Pump() {
+    auto* profile = FindBridgeProfile(profile_id);
+    while (active < 3 && next < ids.size()) {
+      std::string id = ids[next++];
+      ++active;
+      if (extensions::ExtensionRegistry::Get(profile)->GetExtensionById(
+              id, extensions::ExtensionRegistry::EVERYTHING)) {
+        ABIPost(base::BindOnce(&ExtensionInstallBatch::Finish,
+                              base::RetainedRef(this), id, 1, std::string()));
+        continue;
+      }
+      // The installer owns itself until completion. Capture a non-owning
+      // pointer only for inspecting its HTTP result inside that completion.
+      auto* installer = new ApprovedStoreInstaller(id, profile,
+          base::BindOnce([](scoped_refptr<ExtensionInstallBatch> batch,
+                            std::string id, bool success,
+                            const std::string& error,
+                            extensions::webstore_install::Result result) {
+            bool unavailable = result == extensions::webstore_install::BLOCKLISTED ||
+                result == extensions::webstore_install::BLOCKED_BY_POLICY ||
+                result == extensions::webstore_install::NOT_PERMITTED ||
+                result == extensions::webstore_install::INVALID_MANIFEST ||
+                result == extensions::webstore_install::REQUIREMENT_VIOLATIONS;
+            batch->StoreDone(std::move(id), success, error, unavailable, result == extensions::webstore_install::ITEM_NOT_FOUND);
+          }, base::WrapRefCounted(this), id));
+      installers[id] = installer;
+      installer->BeginInstall();
+    }
+  }
+  void StoreDone(std::string id, bool success, std::string error, bool unavailable, bool not_found) {
+    bool missing = not_found || installers.at(id)->missing();
+    installers.erase(id);
+    ABIPost(base::BindOnce(&ExtensionInstallBatch::Finish,
+        base::RetainedRef(this), std::move(id), success ? 0 : missing ? 2 : unavailable ? 4 : 3,
+        std::move(error)));
+  }
+  std::map<std::string, ApprovedStoreInstaller*> installers;
+};
 
