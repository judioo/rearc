+// ABI 1.53, extension_bulk_install. Calling either function affirms that the
+// host obtained consent for these extensions. Main thread, persistent profiles
+// only. At most one operation per profile; at most three store installs at once.
+// Each input receives exactly one deferred callback, in completion order. The
+// borrowed strings live through that callback. Non-OK return: no callbacks.
+// result: 0 installed, 1 already installed, 2 not in store, 3 failed,
+// 4 unavailable (unsupported manifest, blocklist or management policy).
+// completed is 1...total; completed == total ends the operation/context lifetime.
+typedef void (*ReArcExtensionInstallCallback)(void* context, const char* id,
+    int32_t result, const char* reason, uint32_t completed, uint32_t total);
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileInstallExtensions(uint64_t profile_id,
+    const char* const* ids, uint32_t count,
+    ReArcExtensionInstallCallback callback, void* context);
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileLoadUnpackedExtension(uint64_t profile_id,
+    const char* path, ReArcExtensionInstallCallback callback, void* context);
+
 REARC_ENGINE_EXPORT ReArcStatus ReArcProfileOpen(
     const char* name, ReArcProfileCallback completion, void* context);
 // Open an existing direct-child profile directory, e.g. "Default", in place.
