+// Metadata, signature, policy and blocklist checks remain Chromium's. The
+// shell's consent replaces only the install prompt and post-install bubble.
+class ApprovedStoreInstaller : public extensions::WebstoreStandaloneInstaller {
+ public:
+  ApprovedStoreInstaller(const std::string& id, Profile* profile, Callback done)
+      : WebstoreStandaloneInstaller(id, profile, std::move(done)),
+        contents_(content::WebContents::Create(
+            content::WebContents::CreateParams(profile))) {}
+ private:
+  ~ApprovedStoreInstaller() override = default;
+  void OnManifestParsed() override {
+    auto extension = GetLocalizedExtensionForDisplay();
+    if (!extension || extension->manifest_version() < 3) {
+      CompleteInstall(extensions::webstore_install::INVALID_MANIFEST,
+                      "This extension requires a retired manifest version.");
+      return;
+    }
+    auto* blocklist = extensions::ExtensionsBrowserClient::Get()->GetBlocklist(profile());
+    blocklist->IsBlocklisted(id(), base::BindOnce(
+        [](ApprovedStoreInstaller* self, scoped_refptr<const extensions::Extension> extension,
+           extensions::BlocklistState state) {
+          if (state != extensions::NOT_BLOCKLISTED && state != extensions::BLOCKLISTED_UNKNOWN) {
+            self->CompleteInstall(extensions::webstore_install::BLOCKLISTED,
+                                  "This extension is on Chromium's blocklist.");
+            return;
+          }
+          extensions::ExtensionSystem::Get(self->profile())->management_policy()->UserMayInstall(
+              extension, base::BindOnce([](ApprovedStoreInstaller* self,
+                  extensions::ManagementPolicy::Decision decision) {
+                if (!decision.allowed) {
+                  self->CompleteInstall(extensions::webstore_install::BLOCKED_BY_POLICY,
+                                        base::UTF16ToUTF8(decision.error));
+                } else {
+                  self->ProceedWithInstallPrompt();
+                }
+              }, base::Unretained(self)));
+        }, base::Unretained(this), extension));
+  }
+  bool CheckRequestorAlive() const override { return true; }
+  bool ShouldShowPostInstallUI() const override { return false; }
+  content::WebContents* GetWebContents() const override { return contents_.get(); }
+  std::unique_ptr<extensions::InstallPromptData> CreateInstallPrompt() const override {
+    return nullptr;
+  }
+  void OnWebstoreRequestFailureWithStatus(const std::string& id, int status) override {
+    if (status == 404 || status == 410) {
+      // Preserve Chromium's cleanup, including the metadata fetcher's lifetime.
+      missing_ = true;
+    }
+    static_cast<extensions::WebstoreDataFetcherDelegate*>(this)->OnWebstoreRequestFailure(id);
+  }
+ public:
+  bool missing() const { return missing_; }
+ private:
+  bool missing_ = false;
+  std::unique_ptr<content::WebContents> contents_;
+};
