     case AbiCall::kAutocompleteStart:
       os_signpost_interval_begin(log, id, "AutocompleteStart");
       break;
+    case AbiCall::kEarlyWindow:
+      os_signpost_interval_begin(log, id, "EarlyWindow");
+      break;
   }
 }
 
@@ -112,6 +115,9 @@ ScopedAbiInterval::~ScopedAbiInterval() {
     case AbiCall::kAutocompleteStart:
       os_signpost_interval_end(log, id, "AutocompleteStart");
       break;
+    case AbiCall::kEarlyWindow:
+      os_signpost_interval_end(log, id, "EarlyWindow");
+      break;
   }
 }
 
