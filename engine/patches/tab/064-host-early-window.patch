 chrome/app/framework.order                    |  1 +
 .../rearc_bridge/rearc_app_delegate_mac.h     |  5 ++++
 .../rearc_bridge/rearc_app_delegate_mac.mm    | 15 +++++++++++
 .../browser/rearc_bridge/rearc_engine_abi.h   | 21 ++++++++++++++-
 .../browser/rearc_bridge/rearc_engine_abi.mm  | 26 +++++++++++++++++++
 .../rearc_bridge/rearc_engine_entry_mac.mm    |  2 +-
 chrome/browser/rearc_bridge/rearc_perf.cc     |  6 +++++
 chrome/browser/rearc_bridge/rearc_perf.h      |  1 +
 9 files changed, 76 insertions(+), 2 deletions(-)

