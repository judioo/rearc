+// Dockable DevTools (devtools_docking, ABI 1.54). While a callback is set,
+// ReArcTabOpenDevTools opens frontends with can_dock=true, as Chrome's
+// DevToolsWindow does: the frontend offers Dock side and the device toolbar,
+// persists its side in the profile's DevTools preferences (currentDockState)
+// and reports its layout here on every setIsDocked and bounds change.
+// Docked (dock_side 1 right, 2 bottom, 3 left): the host lays in_tab_tab_id
+// (the frontend) over the whole content area and the inspected page above it
+// at the bounds, applying DevToolsContentsResizingStrategy (no bounds yet, or
+// an empty size off the origin: the full area; empty at the origin: hidden).
+// Undocked (0): the frontend goes in its own window; in_tab_tab_id is the
+// device-mode toolbox the frontend opens (0 until then), laid out the same
+// way. The toolbox is a registry tab created with opener = the frontend,
+// popup disposition; it closes with its frontend. Bounds are in DIP of the
+// in-tab view. Null callback: later opens are not dockable, no events.
+typedef struct ReArcDevToolsDockEvent {
+  uint64_t frontend_tab_id, target_tab_id, in_tab_tab_id;
+  uint32_t dock_side;
+  bool has_bounds;
+  int32_t x, y, width, height;
+} ReArcDevToolsDockEvent;
+typedef void (*ReArcDevToolsDockCallback)(void* context, const ReArcDevToolsDockEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetDevToolsDockCallback(ReArcDevToolsDockCallback callback, void* context);
+
