       // app. Same-document hash changes retain the same origin/bindings.
-      return url.GetWithoutRef() == GURL(kFrontend) ? PROCEED : CANCEL_AND_IGNORE;
+      auto* toolbox = HostedToolbox::FromWebContents(contents);
+      const GURL& app = toolbox ? toolbox->url : HostedFrontend::FromWebContents(contents)->url();
