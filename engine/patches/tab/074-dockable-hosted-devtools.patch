@@ -131,14 +221,64 @@ class FrontendNavigation : public content::NavigationThrottle {
 
 void ConfigureHostedDevToolsBindings(DevToolsUIBindings* bindings) {
   if (auto* hosted = HostedFrontend::FromWebContents(bindings->web_contents())) hosted->Configure(bindings);
+  // The toolbox is never attached: its frontend scripts it through the opener.
+  if (HostedToolbox::FromWebContents(bindings->web_contents())) {
+    bindings->SetHostedMode();
+    bindings->SetDelegate(new HostedDelegate(0, 0));
