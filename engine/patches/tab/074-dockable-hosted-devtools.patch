 WEB_CONTENTS_USER_DATA_KEY_IMPL(HostedFrontend);
 
+// The device-mode toolbox an undocked frontend opens (DevToolsWindow's
+// toolbox_web_contents_): the inspected page shows inside it in the host's
+// window. Marked at creation, before its bindings exist; adopted by the host.
+class HostedToolbox : public content::WebContentsUserData<HostedToolbox> {
+ public:
+  const uint64_t frontend;
+  const GURL url;
+  base::ScopedClosureRunner capture;
+ private:
+  friend class content::WebContentsUserData<HostedToolbox>;
+  HostedToolbox(content::WebContents* contents, uint64_t frontend, const GURL& url)
+      : content::WebContentsUserData<HostedToolbox>(*contents), frontend(frontend), url(url) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(HostedToolbox);
+
+HostedFrontend* FindFrontend(uint64_t id) {
+  auto* session = TabRegistry::Get().FindSession(id);
+  return session ? HostedFrontend::FromWebContents(session->web_contents()) : nullptr;
+}
+
+void PublishDock(HostedFrontend* hosted) {
+  if (!dock_callback) return;
+  ReArcDevToolsDockEvent event{};
+  event.frontend_tab_id = hosted->frontend();
+  event.target_tab_id = hosted->target();
+  if (hosted->docked) {
+    event.in_tab_tab_id = hosted->frontend();
+    // DevToolsWindow::SetInspectedPageBounds: the side is the profile's pref.
+    switch (DevToolsSettings::GetDockSide(Profile::FromBrowserContext(
+        hosted->web_contents()->GetBrowserContext()))) {
+      case devtools::DockSide::kRight: event.dock_side = 1; break;
+      case devtools::DockSide::kBottom: event.dock_side = 2; break;
+      case devtools::DockSide::kLeft: event.dock_side = 3; break;
+      case devtools::DockSide::kNone: event.dock_side = 1; break;
+    }
+  } else if (TabRegistry::Get().FindSession(hosted->toolbox)) {
+    event.in_tab_tab_id = hosted->toolbox;
+  }
+  event.has_bounds = hosted->has_bounds;
+  event.x = hosted->bounds.x();
+  event.y = hosted->bounds.y();
+  event.width = hosted->bounds.width();
+  event.height = hosted->bounds.height();
+  ABIPost(base::BindOnce([](ReArcDevToolsDockEvent e) {
+    if (dock_callback && FindFrontend(e.frontend_tab_id)) dock_callback(dock_context, &e);
+  }, event));
+}
+
+void SetDocked(uint64_t frontend, bool docked) {
+  if (auto* hosted = FindFrontend(frontend)) {
+    hosted->docked = docked;
+    PublishDock(hosted);
+  }
+}
+
+void SetPageBounds(uint64_t frontend, const gfx::Rect& bounds) {
+  auto* hosted = FindFrontend(frontend);
+  if (!hosted || (hosted->has_bounds && hosted->bounds == bounds)) return;
+  hosted->has_bounds = true;
+  hosted->bounds = bounds;
+  PublishDock(hosted);
+}
