 }
 
 bool IsHostedDevTools(const content::WebContents* contents) {
-  return contents && HostedFrontend::FromWebContents(contents);
+  return contents && (HostedFrontend::FromWebContents(contents) || HostedToolbox::FromWebContents(contents));
+}
+
+void HostedDevToolsContentsCreated(content::WebContents* source, const GURL& target_url,
+                                   content::WebContents* contents) {
+  auto* hosted = HostedFrontend::FromWebContents(source);
+  if (!hosted || hosted->url().spec().find(kCanDock) == std::string::npos) return;
+  // DevToolsWindow::WebContentsCreated: only the toolbox page of this very
+  // frontend (AdvancedApp opens its own URL with the page swapped).
+  std::string toolbox = hosted->url().spec();
+  toolbox.replace(toolbox.find("devtools_app.html"), strlen("devtools_app.html"), kToolboxPage);
+  if (target_url.GetWithoutRef() != GURL(toolbox)) return;
+  HostedToolbox::CreateForWebContents(contents, hosted->frontend(), GURL(toolbox));
+  // As DevToolsWindow: keep rendering while the page covers the toolbox.
+  HostedToolbox::FromWebContents(contents)->capture = contents->IncrementCapturerCount(
+      gfx::Size(), /*stay_hidden=*/false, /*stay_awake=*/false, /*is_activity=*/true);
+}
+
+bool AdoptHostedDevToolsToolbox(content::WebContents* source, std::unique_ptr<content::WebContents>& contents) {
+  auto* hosted = HostedFrontend::FromWebContents(source);
+  auto* toolbox = contents ? HostedToolbox::FromWebContents(contents.get()) : nullptr;
+  auto* frontend = TabRegistry::Get().FindSession(hosted ? hosted->frontend() : 0);
+  if (!toolbox || !frontend || toolbox->frontend != hosted->frontend()) return false;
+  // As DevToolsWindow::WebContentsCreated: a reloaded frontend's new toolbox replaces the old one.
+  ForceCloseTab(hosted->toolbox);
+  TabSession::CreateArgs args;
+  args.browser_context = source->GetBrowserContext();
+  args.space_id = frontend->space_id();
+  args.order_index = frontend->order_index();
+  const GURL url = toolbox->url;
+  hosted->toolbox = TabRegistry::Get().AdoptSession(args, std::move(contents));
+  TabEvent event;
+  event.kind = TabEventKind::kTabCreated;
+  event.tab_id = hosted->toolbox;
+  event.space_id = args.space_id;
+  event.opener_tab_id = hosted->frontend();
+  event.disposition = TabDisposition::kPopup;
+  event.url = url.spec();
+  EmitTabEvent(std::move(event));
+  ABIInitializeTab(hosted->toolbox);
+  PublishDock(hosted);
+  return true;
 }
 
