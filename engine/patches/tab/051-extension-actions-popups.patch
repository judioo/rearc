+// Extension toolbar actions and popups (extension_actions, ABI 1.33). The host
+// draws the toolbar: one entry per enabled extension with an action
+// (browser/page/action key), in ExtensionRegistry order, for one tab (OTR tabs:
+// incognito-enabled extensions only). title/badge/visibility/popup are the
+// tab's values (chrome.action per-tab state). badge_*_color are SkColor ARGB;
+// 0 means unset (Chromium's defaults). visible=false: disabled for this tab.
+// wants_to_run: blocked scripts/requests await a click (site access on click).
+// icon_png: the action icon at `scale` (16 DIP), possibly Chromium's
+// placeholder until the extension's icon loads (a kind 0 event follows).
+typedef struct ReArcExtensionAction {
+  const char* extension_id;
+  const char* name;
+  const char* title;
+  const char* badge_text;
+  uint32_t badge_text_color, badge_background_color;
+  bool visible, has_popup, wants_to_run;
+  const uint8_t* icon_png;
+  size_t icon_png_size;
+} ReArcExtensionAction;
+typedef struct ReArcExtensionActionList {
+  uint64_t profile_id, tab_id, content_generation;
+  const ReArcExtensionAction* actions;
+  size_t count;
+} ReArcExtensionActionList;
+typedef void (*ReArcExtensionActionsCallback)(
+    void* context, ReArcStatus status, const ReArcExtensionActionList* list);
+// Snapshot at call time, delivered deferred and borrowed. scale 1..4.
+// Popup contents and other non-tab views: unsupported.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetExtensionActions(
+    uint64_t tab_id, double scale, ReArcExtensionActionsCallback completion,
+    void* context);
+// kind: 0 changed (tab_id 0: profile-wide default state or icon), 1 added,
+// 2 removed, 3 popup resized (tab_id owner, popup_tab_id, width/height DIP the
+// popup's renderer asks for, within Chromium's 25x25..800x600 popup bounds).
+// Re-query with ReArcTabGetExtensionActions; events carry no state.
+typedef struct ReArcExtensionActionEvent {
+  uint64_t profile_id, tab_id;
+  uint32_t kind;
+  const char* extension_id;
+  uint64_t popup_tab_id;
+  int32_t width, height;
+} ReArcExtensionActionEvent;
+typedef void (*ReArcExtensionActionCallback)(
+    void* context, const ReArcExtensionActionEvent* event);
+REARC_ENGINE_EXPORT void ReArcEngineSetExtensionActionCallback(
+    ReArcExtensionActionCallback callback, void* context);
+// A toolbar click on the action for tab_id. Grants activeTab (and runs
+// blocked actions) as Chromium's toolbar does. result: 0 handled by the
+// extension (action.onClicked, granted run), 1 popup: popup_tab_id is a new
+// registry tab (created event disposition 3 popup, opener tab_id) loading the
+// popup page with view type popup; attach/present/close it like a tab, size
+// it from kind 3 events; window.close() closes it (tab closed reason 1).
+// 2 side panel requested (unsupported; nothing is shown).
+// Not visible for this tab: invalid_state. Unknown/no action: not_found.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabRunExtensionAction(
+    uint64_t tab_id, const char* extension_id, uint32_t* result,
+    uint64_t* popup_tab_id);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
