+namespace rearc {
+namespace {
+
+ReArcExtensionActionCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+
+enum : uint32_t { kChanged = 0, kAdded = 1, kRemoved = 2, kPopupResized = 3 };
+
+void Post(uint32_t kind,
+          content::BrowserContext* context,
+          uint64_t tab_id,
+          const std::string& extension_id,
+          uint64_t popup_tab_id = 0,
+          int32_t width = 0,
+          int32_t height = 0) {
+  const uint64_t profile_id =
+      context ? BridgeProfileId(Profile::FromBrowserContext(context)) : 0;
+  if (!host || !profile_id) {
+    return;
+  }
+  ReArcExtensionActionEvent event{profile_id,   tab_id, kind,  nullptr,
+                                  popup_tab_id, width,  height};
+  ABIPost(base::BindOnce(
+      [](uint64_t expected, ReArcExtensionActionEvent e, std::string id) {
+        if (!host || expected != epoch) {
+          return;
+        }
+        e.extension_id = id.c_str();
+        host(host_context, &e);
+      },
+      epoch, event, extension_id));
+}
+
+TabSession* SessionFor(const content::WebContents* contents) {
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    TabSession* session = TabRegistry::Get().FindSession(id);
+    if (session && session->web_contents() == contents) {
+      return session;
+    }
+  }
+  return nullptr;
+}
+
+// One icon factory per (context, extension); a loaded or changed default icon
+// is a profile-wide change.
+class Icon : public extensions::ExtensionActionIconFactory::Observer {
+ public:
+  Icon(content::BrowserContext* context,
+       const extensions::Extension* extension,
+       extensions::ExtensionAction* action)
+      : context_(context),
+        extension_id_(extension->id()),
+        factory_(extension, action, this) {}
+  void OnIconUpdated() override {
+    Post(kChanged, context_, 0, extension_id_);
+  }
+  extensions::ExtensionActionIconFactory& factory() { return factory_; }
+
+ private:
+  raw_ptr<content::BrowserContext> context_;
+  std::string extension_id_;
+  extensions::ExtensionActionIconFactory factory_;
+};
+
+using IconKey = std::pair<content::BrowserContext*, std::string>;
+std::map<IconKey, std::unique_ptr<Icon>>& Icons() {
+  static base::NoDestructor<std::map<IconKey, std::unique_ptr<Icon>>> icons;
+  return *icons;
+}
+
+class Watcher : public extensions::ExtensionActionDispatcher::Observer,
+                public extensions::ExtensionRegistryObserver {
+ public:
+  static Watcher& Get() {
+    static base::NoDestructor<Watcher> watcher;
+    return *watcher;
+  }
+  void Attach(Profile* profile) {
+    if (auto* registry = extensions::ExtensionRegistry::Get(profile);
+        registry && !registries_[registry]++) {
+      registry->AddObserver(this);
+    }
+    if (auto* dispatcher = extensions::ExtensionActionDispatcher::Get(profile);
+        dispatcher && !dispatchers_[dispatcher]++) {
+      dispatcher->AddObserver(this);
+    }
+  }
+  void Detach(Profile* profile) {
+    if (auto* registry = extensions::ExtensionRegistry::Get(profile)) {
+      if (auto it = registries_.find(registry);
+          it != registries_.end() && !--it->second) {
+        registry->RemoveObserver(this);
+        registries_.erase(it);
+      }
+    }
+    if (auto* dispatcher =
+            extensions::ExtensionActionDispatcher::Get(profile)) {
+      if (auto it = dispatchers_.find(dispatcher);
+          it != dispatchers_.end() && !--it->second) {
+        dispatcher->RemoveObserver(this);
+        dispatchers_.erase(it);
+      }
+    }
+    std::erase_if(Icons(), [profile](const auto& entry) {
+      return entry.first.first == profile;
+    });
+  }
+
+  // ExtensionActionDispatcher::Observer:
+  void OnExtensionActionUpdated(extensions::ExtensionAction* action,
+                                content::WebContents* contents,
+                                content::BrowserContext* context) override {
+    TabSession* session = contents ? SessionFor(contents) : nullptr;
+    if (contents && !session) {
+      return;  // Not a registry tab.
+    }
+    Post(kChanged, context, session ? session->tab_id() : 0,
+         action->extension_id());
+  }
+  void OnShuttingDown() override {
+    for (auto& [dispatcher, count] : dispatchers_) {
+      dispatcher->RemoveObserver(this);
+    }
+    dispatchers_.clear();
+  }
+
+  // ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* context,
+                         const extensions::Extension* extension) override {
+    if (extensions::ExtensionActionManager::Get(context)->GetExtensionAction(
+            *extension)) {
+      Post(kAdded, context, 0, extension->id());
+    }
+  }
+  void OnExtensionUnloaded(content::BrowserContext* context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason) override {
+    std::erase_if(Icons(), [&](const auto& entry) {
+      return entry.first.second == extension->id();
+    });
+    Post(kRemoved, context, 0, extension->id());
+  }
+  void OnShutdown(extensions::ExtensionRegistry* registry) override {
+    registry->RemoveObserver(this);
+    registries_.erase(registry);
+    Icons().clear();
+  }
+
+ private:
+  friend class base::NoDestructor<Watcher>;
+  Watcher() = default;
+  std::map<extensions::ExtensionRegistry*, int> registries_;
+  std::map<extensions::ExtensionActionDispatcher*, int> dispatchers_;
+};
+
+// Hosted action popup: the registry contents' renderer sizes itself within
+// Chromium's popup bounds, as ExtensionViewHost popups do.
+class Popup : public content::WebContentsObserver,
+              public content::WebContentsUserData<Popup> {
+ public:
+  uint64_t owner_tab_id() const { return owner_tab_id_; }
+  const std::string& extension_id() const { return extension_id_; }
+
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    EnableAutoResize(frame);
+  }
+  void RenderFrameHostChanged(content::RenderFrameHost*,
+                              content::RenderFrameHost* frame) override {
+    EnableAutoResize(frame);
+  }
+
+ private:
+  friend class content::WebContentsUserData<Popup>;
+  Popup(content::WebContents* contents,
+        uint64_t owner_tab_id,
+        std::string extension_id)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<Popup>(*contents),
+        owner_tab_id_(owner_tab_id),
+        extension_id_(std::move(extension_id)) {}
+  void EnableAutoResize(content::RenderFrameHost* frame) {
+    if (frame && frame->IsInPrimaryMainFrame() && frame->GetView()) {
+      frame->GetView()->EnableAutoResize(extensions::kExtensionPopupMinSize,
+                                         extensions::kExtensionPopupMaxSize);
+    }
+  }
+  uint64_t owner_tab_id_;
+  std::string extension_id_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Popup);
+
+// Enabled extension with an action, visible to this (possibly OTR) context.
+const extensions::Extension* ActionExtension(content::BrowserContext* context,
+                                             const std::string& id,
+                                             extensions::ExtensionAction** out) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          id);
+  if (!extension || (context->IsOffTheRecord() &&
+                     !extensions::util::IsIncognitoEnabled(id, context))) {
+    return nullptr;
+  }
+  *out = extensions::ExtensionActionManager::Get(context)->GetExtensionAction(
+      *extension);
+  return *out ? extension : nullptr;
+}
+
+std::vector<uint8_t> IconPng(content::BrowserContext* context,
+                             const extensions::Extension* extension,
+                             extensions::ExtensionAction* action,
+                             int tab_id,
+                             float scale) {
+  auto& icon = Icons()[{context, extension->id()}];
+  if (!icon) {
+    icon = std::make_unique<Icon>(context, extension, action);
+  }
+  gfx::Image image = icon->factory().GetIcon(tab_id);
+  if (image.IsEmpty()) {
+    return {};
+  }
+  const gfx::ImageSkiaRep& rep =
+      image.AsImageSkia().GetRepresentation(scale);
+  if (rep.is_null()) {
+    return {};
+  }
+  return gfx::PNGCodec::EncodeBGRASkBitmap(rep.GetBitmap(), false)
+      .value_or(std::vector<uint8_t>());
+}
+
+struct Entry {
+  std::string extension_id, name, title, badge;
+  uint32_t badge_text_color = 0, badge_background_color = 0;
+  bool visible = false, has_popup = false, wants_to_run = false;
+  std::vector<uint8_t> icon;
+};
+
+ReArcStatus CheckActionTab(uint64_t tab_id, TabSession** session) {
+  if (auto status = ABICheckTab(tab_id, session)) {
+    return status;
+  }
+  return extensions::GetViewType((*session)->web_contents()) ==
+                 extensions::mojom::ViewType::kTabContents
+             ? REARC_OK
+             : REARC_UNSUPPORTED;
+}
+
+}  // namespace
+
+void AttachExtensionActions(Profile* profile) {
+  CHECK(pthread_main_np());
+  Watcher::Get().Attach(profile);
+}
+
+void DetachExtensionActions(Profile* profile) {
+  CHECK(pthread_main_np());
+  Watcher::Get().Detach(profile);
+}
+
+void OnExtensionPopupResized(content::WebContents* contents,
+                             const gfx::Size& size) {
+  CHECK(pthread_main_np());
+  Popup* popup = Popup::FromWebContents(contents);
+  TabSession* session = SessionFor(contents);
+  if (!popup || !session) {
+    return;
+  }
+  Post(kPopupResized, contents->GetBrowserContext(), popup->owner_tab_id(),
+       popup->extension_id(), session->tab_id(), size.width(), size.height());
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetExtensionActionCallback(ReArcExtensionActionCallback cb,
+                                           void* ctx) {
+  CHECK(pthread_main_np());
+  ++rearc::epoch;
+  rearc::host = cb;
+  rearc::host_context = ctx;
+}
+
+ReArcStatus ReArcTabGetExtensionActions(uint64_t tab_id,
+                                        double scale,
+                                        ReArcExtensionActionsCallback done,
+                                        void* ctx) {
+  CHECK(pthread_main_np());
+  rearc::TabSession* session;
+  if (auto status = rearc::CheckActionTab(tab_id, &session)) {
+    return status;
+  }
+  if (!done || !(scale >= 1 && scale <= 4)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  content::WebContents* contents = session->web_contents();
+  content::BrowserContext* context = contents->GetBrowserContext();
+  const int action_tab = sessions::SessionTabHelper::IdForTab(contents).id();
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(contents);
+  std::vector<rearc::Entry> entries;
+  for (const auto& extension :
+       extensions::ExtensionRegistry::Get(context)->enabled_extensions()) {
+    extensions::ExtensionAction* action = nullptr;
+    if (!rearc::ActionExtension(context, extension->id(), &action)) {
+      continue;
+    }
+    rearc::Entry entry;
+    entry.extension_id = extension->id();
+    entry.name = extension->name();
+    entry.title = action->GetTitle(action_tab);
+    entry.badge = action->GetDisplayBadgeText(action_tab);
+    entry.badge_text_color = action->GetBadgeTextColor(action_tab);
+    entry.badge_background_color = action->GetBadgeBackgroundColor(action_tab);
+    entry.visible = action->GetIsVisible(action_tab);
+    entry.has_popup = action->HasPopup(action_tab);
+    entry.wants_to_run = runner && runner->WantsToRun(extension.get());
+    entry.icon = rearc::IconPng(context, extension.get(), action, action_tab,
+                                static_cast<float>(scale));
+    entries.push_back(std::move(entry));
+  }
+  rearc::ABIPost(base::BindOnce(
+      [](ReArcExtensionActionsCallback done, void* ctx, uint64_t profile_id,
+         uint64_t tab_id, uint64_t generation,
+         std::vector<rearc::Entry> entries) {
+        std::vector<ReArcExtensionAction> actions;
+        for (const auto& e : entries) {
+          actions.push_back({e.extension_id.c_str(), e.name.c_str(),
+                             e.title.c_str(), e.badge.c_str(),
+                             e.badge_text_color, e.badge_background_color,
+                             e.visible, e.has_popup, e.wants_to_run,
+                             e.icon.empty() ? nullptr : e.icon.data(),
+                             e.icon.size()});
+        }
+        ReArcExtensionActionList list{profile_id, tab_id, generation,
+                                      actions.empty() ? nullptr
+                                                      : actions.data(),
+                                      actions.size()};
+        done(ctx, REARC_OK, &list);
+      },
+      done, ctx, session->profile_id(), tab_id, session->content_generation(),
+      std::move(entries)));
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabRunExtensionAction(uint64_t tab_id,
+                                       const char* extension_id,
+                                       uint32_t* result,
+                                       uint64_t* popup_tab_id) {
+  CHECK(pthread_main_np());
+  if (result) {
+    *result = 0;
+  }
+  if (popup_tab_id) {
+    *popup_tab_id = 0;
+  }
+  rearc::TabSession* session;
+  if (auto status = rearc::CheckActionTab(tab_id, &session)) {
+    return status;
+  }
+  if (!result || !popup_tab_id || !extension_id ||
+      !crx_file::id_util::IdIsValid(extension_id)) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  content::WebContents* contents = session->web_contents();
+  content::BrowserContext* context = contents->GetBrowserContext();
+  extensions::ExtensionAction* action = nullptr;
+  const extensions::Extension* extension =
+      rearc::ActionExtension(context, extension_id, &action);
+  if (!extension) {
+    return REARC_NOT_FOUND;
+  }
+  const int action_tab = sessions::SessionTabHelper::IdForTab(contents).id();
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(contents);
+  if (!runner) {
+    return REARC_UNSUPPORTED;
+  }
+  if (!action->GetIsVisible(action_tab)) {
+    return REARC_INVALID_STATE;  // Disabled for this tab, as in the toolbar.
+  }
+  // Grants activeTab (and runs blocked actions) as a toolbar click does.
+  switch (runner->RunAction(extension, /*grant_tab_permissions=*/true)) {
+    case extensions::ExtensionAction::ShowAction::kNone:
+      return REARC_OK;
+    case extensions::ExtensionAction::ShowAction::kToggleSidePanel:
+      *result = 2;
+      return REARC_OK;
+    case extensions::ExtensionAction::ShowAction::kShowPopup:
+      break;
+  }
+  const GURL url = action->GetPopupUrl(action_tab);
+  Profile* profile = Profile::FromBrowserContext(context);
+  // Spanning-mode extensions run in the original profile, as
+  // ExtensionViewHostFactory's incognito popups do.
+  Profile* popup_profile =
+      profile->IsOffTheRecord() &&
+              !extensions::IncognitoInfo::IsSplitMode(extension)
+          ? profile->GetOriginalProfile()
+          : profile;
+  if (!url.is_valid() || !rearc::BridgeProfileId(popup_profile)) {
+    return REARC_INVALID_STATE;
+  }
+  content::WebContents::CreateParams params(
+      popup_profile, content::SiteInstance::CreateForURL(popup_profile, url));
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> popup =
+      content::WebContents::Create(params);
+  // Before adoption: helpers attach by view type (no tab identity/history).
+  extensions::SetViewType(popup.get(),
+                          extensions::mojom::ViewType::kExtensionPopup);
+  rearc::Popup::CreateForWebContents(popup.get(), tab_id, extension->id());
+  content::WebContents* raw = popup.get();
+  rearc::TabSession::CreateArgs args;
+  args.browser_context = popup_profile;
+  args.space_id = session->space_id();
+  args.order_index = session->order_index();
+  const uint64_t id = rearc::TabRegistry::Get().AdoptSession(args,
+                                                              std::move(popup));
+  rearc::TabEvent event;
+  event.kind = rearc::TabEventKind::kTabCreated;
+  event.tab_id = id;
+  event.space_id = args.space_id;
+  event.opener_tab_id = tab_id;
+  event.disposition = rearc::TabDisposition::kPopup;
+  event.url = url.spec();
+  rearc::EmitTabEvent(std::move(event));
+  if (!rearc::TabRegistry::Get().FindSession(id)) {
+    return REARC_INTERNAL;
+  }
+  rearc::ABIInitializeTab(id);
+  raw->GetController().LoadURL(url, content::Referrer(),
+                               ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                               std::string());
+  *result = 1;
+  *popup_tab_id = id;
+  return REARC_OK;
+}
