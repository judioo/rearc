+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/rearc_readiness.h"
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "base/logging.h"
+
+namespace rearc {
+
+namespace {
+
+// Main-thread only; registered before startup completes and read from the
+// PostBrowserStart seam on the same thread.
+EngineReadinessSink* g_engine_readiness_sink = nullptr;
+
+}  // namespace
+
+void SetEngineReadinessSink(EngineReadinessSink* sink) {
+  CHECK(pthread_main_np());
+  g_engine_readiness_sink = sink;
+}
+
+void SignalEngineReady() {
+  CHECK(pthread_main_np());
+  if (g_engine_readiness_sink) {
+    g_engine_readiness_sink->OnEngineReady();
+    return;
+  }
+  VLOG(1) << "ReArc bridge: engine ready; no readiness sink registered.";
+}
+
+}  // namespace rearc
