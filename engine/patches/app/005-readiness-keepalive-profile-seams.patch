+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_PROFILE_REGISTRY_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_PROFILE_REGISTRY_H_
+
+#include <cstddef>
+
+class Profile;
+
+namespace rearc {
+
+// Profile-registration seam (P-APP-001 sequence step 4: "Register the
+// default profile with the bridge"). Scaffolding only (patch app/005): the
+// registry records which profiles Chromium has brought up so later slices can
+// hang readiness gating, per-profile shell state and teardown ordering off
+// it. No real profile work happens here — no prefs, no KeyedServices, no
+// session-restore or startup-window interaction.
+//
+// Profile stays forward-declared on purpose: this header is consumed from
+// chrome_browser_main_mac.mm without dragging the full Profile definition
+// into the bridge's dependency surface. Handles are opaque; the registry
+// never dereferences them.
+void RegisterBridgeProfile(Profile* profile, bool is_initial_profile);
+void UnregisterBridgeProfile(Profile* profile);
+
+// Observability for later slices and tests.
+size_t GetRegisteredBridgeProfileCount();
+bool IsBridgeProfileRegistered(Profile* profile);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_PROFILE_REGISTRY_H_
