+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/rearc_keep_alive.h"
+
+#include <pthread.h>
+
+#include <memory>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "components/keep_alive_registry/keep_alive_types.h"
+#include "components/keep_alive_registry/scoped_keep_alive.h"
+
+namespace rearc {
+
+namespace {
+
+// Main-thread only. Held while the shell's lifetime is active; released as
+// part of bridge finalization in a later slice (P-APP-001 step 6), before
+// the upstream quit closure runs.
+std::unique_ptr<ScopedKeepAlive> g_shell_keep_alive;
+
+}  // namespace
+
+void AcquireShellKeepAlive() {
+  CHECK(pthread_main_np());
+  if (g_shell_keep_alive) {
+    return;
+  }
+  // Mirrors AppController's keepalive (app_controller_mac.mm), which this
+  // bridge replaces under the lifecycle host: browser-process restart means
+  // application relaunch (P-APP-001 step 7), so restart is DISABLED.
+  g_shell_keep_alive = std::make_unique<ScopedKeepAlive>(
+      KeepAliveOrigin::APP_CONTROLLER, KeepAliveRestartOption::DISABLED);
+  VLOG(1) << "ReArc bridge: shell keepalive acquired.";
+}
+
+void ReleaseShellKeepAlive() {
+  CHECK(pthread_main_np());
+  if (!g_shell_keep_alive) {
+    return;
+  }
+  g_shell_keep_alive.reset();
+  VLOG(1) << "ReArc bridge: shell keepalive released.";
+}
+
+bool HasShellKeepAlive() {
+  return g_shell_keep_alive != nullptr;
+}
+
+}  // namespace rearc
