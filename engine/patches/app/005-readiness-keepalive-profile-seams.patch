@@ -0,0 +1,45 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_READINESS_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_READINESS_H_
+
+namespace rearc {
+
+// Readiness seam (P-APP-001 sequence step 4: "Post ready/UI construction
+// after startup on Chromium UI"). Scaffolding only (patch app/005).
+//
+// This is a standalone sink interface rather than an extension of
+// EngineLifecycleHost so patch app/005 stays purely additive over app/002's
+// files: every patch in the series must individually pass
+// `git apply --check -R` against the fully applied tree, which forbids
+// editing an earlier patch's created files. The sink merges into the
+// lifecycle host C ABI surface in the wave that wires real shell integration
+// (framework.exports is deliberately untouched by app/005); until then no
+// sink can be registered from outside the engine and SignalEngineReady()
+// only logs.
+//
+// All calls happen on the main thread (Chromium BrowserThread::UI).
+class EngineReadinessSink {
+ public:
+  virtual ~EngineReadinessSink() = default;
+
+  // Called once browser services and profile startup have completed (the
+  // ChromeBrowserMainParts::PostBrowserStart point — after async profile
+  // unblocking), when the host may build its UI on Chromium's main thread.
+  virtual void OnEngineReady() = 0;
+};
+
+// Registers (or clears, with nullptr) the readiness sink. Main thread only;
+// the sink must outlive its registration.
+void SetEngineReadinessSink(EngineReadinessSink* sink);
+
+// Forwards the startup-complete transition to the registered sink. A no-op
+// when no sink is registered, so gated upstream call sites keep stock
+// behavior bit-identical. Main thread only.
+void SignalEngineReady();
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_READINESS_H_
