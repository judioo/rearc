+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+
+#include <pthread.h>
+
+#include <set>
+
+#include "base/check.h"
+#include "base/logging.h"
+
+namespace rearc {
+
+namespace {
+
+// Main-thread only; PostProfileInit and the future unregister path run on
+// BrowserThread::UI. Stores opaque handles only — see the header for why
+// Profile stays forward-declared here.
+std::set<Profile*> g_registered_profiles;
+
+}  // namespace
+
+void RegisterBridgeProfile(Profile* profile, bool is_initial_profile) {
+  CHECK(pthread_main_np());
+  CHECK(profile);
+  bool inserted = g_registered_profiles.insert(profile).second;
+  VLOG(1) << "ReArc bridge: profile registered (initial=" << is_initial_profile
+          << ", new=" << inserted
+          << ", count=" << g_registered_profiles.size() << ").";
+}
+
+void UnregisterBridgeProfile(Profile* profile) {
+  CHECK(pthread_main_np());
+  g_registered_profiles.erase(profile);
+}
+
+size_t GetRegisteredBridgeProfileCount() {
+  return g_registered_profiles.size();
+}
+
+bool IsBridgeProfileRegistered(Profile* profile) {
+  return g_registered_profiles.find(profile) != g_registered_profiles.end();
+}
+
+}  // namespace rearc
