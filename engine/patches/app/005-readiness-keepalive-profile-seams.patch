+
+namespace rearc {
+
+// ScopedKeepAlive seam (P-APP-001 sequence step 3: hold a ScopedKeepAlive
+// from components/keep_alive_registry while shell lifetime is active).
+// Scaffolding only (patch app/005): no call sites exist yet — the host
+// triggers acquisition through the readiness C ABI surface in the wave that
+// wires real shell integration, and release joins bridge finalization in the
+// ordered-teardown slice (P-APP-001 step 6).
+//
+// Callers must be on the main thread with BrowserProcess already created
+// (KeepAliveRegistry hangs off the browser process); acquisition while the
+// registry is shutting down CHECKs there by design.
+void AcquireShellKeepAlive();
+void ReleaseShellKeepAlive();
+bool HasShellKeepAlive();
+
+}  // namespace rearc
