@@ -0,0 +1,46 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_LIFECYCLE_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_LIFECYCLE_H_
+
+namespace rearc {
+
+// Host-side callbacks that let a shell own the NSApplication lifecycle while
+// Chromium's browser loop runs (P-APP-001, reference approach A: the upstream
+// base::RunLoop stays on the stack and its native pump enters -[NSApp run];
+// no external pump adapter is introduced).
+//
+// Slice 1 wires the host-owned application singleton (ReArcApplication) and
+// the termination bridge only. Readiness, keepalive, delegate/menu and
+// profile registration arrive in later slices per
+// engine/docs/patches/P-APP-001.md.
+//
+// All calls happen on the main thread (Chromium BrowserThread::UI).
+class EngineLifecycleHost {
+ public:
+  virtual ~EngineLifecycleHost() = default;
+
+  // Called from -[ReArcApplication terminate:]. Return true if the host
+  // consumed the request and now owns the shutdown flow. Returning false (or
+  // having no host installed) falls back to the upstream AppController quit
+  // path, preserving stock behavior when the engine runs standalone.
+  virtual bool HandleTerminateRequest() = 0;
+
+  // Called from -[ReArcApplication cancelTerminate:]. Same consumption
+  // contract as HandleTerminateRequest().
+  virtual bool HandleTerminateCancel() = 0;
+};
+
+// Installs (or clears, with nullptr) the lifecycle host. Must be called on
+// the main thread before NSApplication finishes launching; the host must
+// outlive its registration.
+void SetEngineLifecycleHost(EngineLifecycleHost* host);
+
+// Returns the installed host, or nullptr when the engine runs standalone.
+EngineLifecycleHost* GetEngineLifecycleHost();
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_LIFECYCLE_H_
