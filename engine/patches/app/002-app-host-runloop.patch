diff --git a/chrome/browser/rearc_bridge/rearc_application_mac.mm b/chrome/browser/rearc_bridge/rearc_application_mac.mm
new file mode 100644
index 0000000000..fe5599391b
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_application_mac.mm
@@ -0,0 +1,31 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "chrome/browser/rearc_bridge/rearc_application_mac.h"
+
+#include "chrome/browser/rearc_bridge/rearc_engine_lifecycle.h"
+
+@implementation ReArcApplication
+
+// Cocoa's orderly-quit entry point. When a lifecycle host is installed it
+// decides whether the upstream AppController-based quit flow runs; the host
+// path never calls exit() from this callback (P-APP-001 shutdown invariants).
+- (void)terminate:(id)sender {
+  rearc::EngineLifecycleHost* host = rearc::GetEngineLifecycleHost();
+  if (host && host->HandleTerminateRequest()) {
+    // The host consumed the request and owns the shutdown flow from here.
+    return;
+  }
+  [super terminate:sender];
+}
+
+- (void)cancelTerminate:(id)sender {
+  rearc::EngineLifecycleHost* host = rearc::GetEngineLifecycleHost();
+  if (host && host->HandleTerminateCancel()) {
+    return;
+  }
+  [super cancelTerminate:sender];
+}
+
+@end
diff --git a/chrome/browser/rearc_bridge/rearc_engine_entry_mac.h b/chrome/browser/rearc_bridge/rearc_engine_entry_mac.h
new file mode 100644
index 0000000000..37d2d8e498
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_engine_entry_mac.h
@@ -0,0 +1,51 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_ENTRY_MAC_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_ENTRY_MAC_H_
+
+#include <stdbool.h>
+
+// Public C ABI of the ReArc engine bridge (P-APP-001, slice 1). Exported from
+// the Chromium Framework via chrome/app/framework.exports. Keep this header
+// C-only and free of Chromium C++ types so Swift can consume it without the
+// Chromium C++ ABI.
+//
+// Slice-1 host flow: call ReArcEngineSetLifecycleCallbacks() on the main
+// thread, then invoke the framework's ordinary ChromeMain entry point. The
+// engine's run is blocking until shutdown (reference approach A in
+// engine/docs/patches/P-APP-001.md); there is no second NSApplicationMain and
+// no external pump.
+
+// Chromium compiles with -fvisibility=hidden; the framework's public
+// symbols are opted back in one by one (same convention as ChromeMain in
+// chrome/app/chrome_main.cc). The non-component framework.exports /
+// framework.order lists are a separate release-packaging hunk (P-APP-001
+// build row) and are not yet updated by slice 1.
+#define REARC_ENGINE_EXPORT __attribute__((visibility("default")))
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Host lifecycle callback. Return true when the host consumed the request and
+// owns the resulting flow; returning false declines it.
+typedef bool (*ReArcEngineLifecycleCallback)(void* user_data);
+
+// Bridge implementation version, e.g. "0.1.0". Static storage; do not free.
+REARC_ENGINE_EXPORT const char* ReArcEngineBridgeVersion(void);
+
+// Installs (or clears, with on_terminate_request == nullptr) the host's
+// lifecycle callbacks. Must be called on the main thread before the engine
+// entry point creates NSApplication; user_data is passed back verbatim.
+REARC_ENGINE_EXPORT void ReArcEngineSetLifecycleCallbacks(
+    ReArcEngineLifecycleCallback on_terminate_request,
+    ReArcEngineLifecycleCallback on_terminate_cancel,
+    void* user_data);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_ENGINE_ENTRY_MAC_H_
diff --git a/chrome/browser/rearc_bridge/rearc_engine_entry_mac.mm b/chrome/browser/rearc_bridge/rearc_engine_entry_mac.mm
new file mode 100644
index 0000000000..7e0f4c3bae
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_engine_entry_mac.mm
@@ -0,0 +1,62 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rearc_bridge/rearc_engine_entry_mac.h"
+
+#import <Foundation/Foundation.h>
+
+#include "base/check.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_lifecycle.h"
+
+namespace {
+
+// Adapts the exported C callback pair onto the C++ EngineLifecycleHost
+// interface. Registered before NSApplication exists and alive for the rest of
+// the process.
+class CallbackLifecycleHost final : public rearc::EngineLifecycleHost {
+ public:
+  void Reset(ReArcEngineLifecycleCallback on_terminate_request,
+             ReArcEngineLifecycleCallback on_terminate_cancel,
+             void* user_data) {
+    on_terminate_request_ = on_terminate_request;
+    on_terminate_cancel_ = on_terminate_cancel;
+    user_data_ = user_data;
+  }
+
+  bool HandleTerminateRequest() override {
+    return on_terminate_request_ && on_terminate_request_(user_data_);
+  }
+
+  bool HandleTerminateCancel() override {
+    return on_terminate_cancel_ && on_terminate_cancel_(user_data_);
+  }
+
+ private:
+  ReArcEngineLifecycleCallback on_terminate_request_ = nullptr;
+  ReArcEngineLifecycleCallback on_terminate_cancel_ = nullptr;
+  raw_ptr<void> user_data_ = nullptr;
+};
+
+CallbackLifecycleHost g_callback_lifecycle_host;
+
+}  // namespace
+
+const char* ReArcEngineBridgeVersion(void) {
+  return "0.1.0";
+}
+
+void ReArcEngineSetLifecycleCallbacks(
+    ReArcEngineLifecycleCallback on_terminate_request,
+    ReArcEngineLifecycleCallback on_terminate_cancel,
+    void* user_data) {
+  CHECK([NSThread isMainThread]);
+  if (!on_terminate_request) {
+    rearc::SetEngineLifecycleHost(nullptr);
+    return;
+  }
+  g_callback_lifecycle_host.Reset(on_terminate_request, on_terminate_cancel,
+                                  user_data);
+  rearc::SetEngineLifecycleHost(&g_callback_lifecycle_host);
+}
