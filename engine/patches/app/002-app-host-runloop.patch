+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_APP_DELEGATE_MAC_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_APP_DELEGATE_MAC_H_
+
+#ifdef __OBJC__
+
+#import <AppKit/AppKit.h>
+
+// The ReArc application delegate, installed in place of AppController when an
+// engine lifecycle host is registered (P-APP-001, slice 1). It deliberately
+// implements only the termination surface; window/menu/open-event behavior is
+// supplied by the host through shell callbacks in later slices and must never
+// fall through to a recreated AppController.
+@interface ReArcAppDelegate : NSObject <NSApplicationDelegate>
+@end
+
+#endif  // __OBJC__
+
+namespace rearc {
+
+// Installs a single retained ReArcAppDelegate as NSApp.delegate plus a
+// placeholder main menu. CHECKs the main thread and a nil delegate, failing
+// early if a plain NSApplication/SwiftUI delegate was created first (P-APP-001
+// acceptance invariant). Called from
+// ChromeBrowserMainPartsMac::PreCreateThreads() only when an engine lifecycle
+// host is registered.
+void InstallReArcAppDelegateAndMenu();
+
+// End-of-main-loop bridge finalization. Slice 1 records the transition only;
+// keepalive release and ordered tab teardown arrive with P-APP-001 later
+// slices and P-TAB-001. Must not touch AppController.sharedController: a
+// teardown-only call would recreate the delegate.
+void FinalizeReArcAppDelegate();
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_APP_DELEGATE_MAC_H_
diff --git a/chrome/browser/rearc_bridge/rearc_app_delegate_mac.mm b/chrome/browser/rearc_bridge/rearc_app_delegate_mac.mm
new file mode 100644
index 0000000000..d2451abc20
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_app_delegate_mac.mm
@@ -0,0 +1,58 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "chrome/browser/rearc_bridge/rearc_app_delegate_mac.h"
+
+#include "base/check_op.h"
+#include "base/logging.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_lifecycle.h"
+
+@implementation ReArcAppDelegate
+
+// The host owns the lifecycle once registered. A consumed terminate request
+// cancels AppKit's own termination because the host drives shutdown through
+// the Chromium quit closure in a later slice; never let AppKit fall into its
+// default exit() path, which would skip BrowserMain teardown.
+- (NSApplicationTerminateReply)applicationShouldTerminate:
+    (NSApplication*)sender {
+  rearc::EngineLifecycleHost* host = rearc::GetEngineLifecycleHost();
+  if (host && host->HandleTerminateRequest()) {
+    return NSTerminateCancel;
+  }
+  // No host (or host declined): refuse to tear down rather than risk an
+  // uncoordinated exit. Standalone runs never install this delegate.
+  LOG(WARNING) << "ReArcAppDelegate: termination request without a consuming "
+                  "host; cancelling.";
+  return NSTerminateCancel;
+}
+
+- (BOOL)applicationSupportsSecureRestorableState:(NSApplication*)app {
+  return YES;
+}
+
+@end
+
+namespace rearc {
+
+void InstallReArcAppDelegateAndMenu() {
+  CHECK([NSThread isMainThread]);
+  // Mirrors the upstream PreCreateThreads invariant: nothing may have
+  // installed a delegate before this point.
+  CHECK_EQ(nil, NSApp.delegate);
+  // Retained for the life of the process; the host outlives registration.
+  static ReArcAppDelegate* delegate = [[ReArcAppDelegate alloc] init];
+  NSApp.delegate = delegate;
+  // Placeholder menu surface. Shell-owned menu construction and callback
+  // forwarding arrive in a later P-APP-001 slice; an empty main menu keeps
+  // AppKit consistent without creating Chrome's menu or AppController.
+  NSApp.mainMenu = [[NSMenu alloc] initWithTitle:@"ReArc"];
+}
+
+void FinalizeReArcAppDelegate() {
+  CHECK([NSThread isMainThread]);
+  VLOG(1) << "ReArcAppDelegate: main message loop ended; bridge finalization "
+             "is a slice-1 no-op.";
+}
+
+}  // namespace rearc
