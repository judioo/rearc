+
+// Main-thread only; set before NSApplication finishes launching and read
+// from Cocoa termination entry points on the same thread.
+EngineLifecycleHost* g_engine_lifecycle_host = nullptr;
+
+}  // namespace
+
+void SetEngineLifecycleHost(EngineLifecycleHost* host) {
+  // Registration happens before NSApplication exists; Cocoa termination entry
