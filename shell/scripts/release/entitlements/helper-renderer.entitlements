<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Renderer and Aperitif Renderer helpers. Same as chrome/app/helper-renderer-entitlements.plist at the pin: V8 needs MAP_JIT (allow-jit). Chromium signs these without library validation (options restrict,kill,runtime). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
