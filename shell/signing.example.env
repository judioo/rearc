# Copy to signing.local.env (git-ignored) and fill in. Read by scripts/bundle-chromium.sh.
# List identities with: security find-identity -v -p codesigning
REARC_SIGN_IDENTITY="Apple Development: Your Name (XXXXXXXXXX)"
REARC_TEAM_ID="XXXXXXXXXX"
# Notarization (future): store credentials yourself, never in this file:
#   xcrun notarytool store-credentials rearc-notary --apple-id <apple-id> --team-id <team-id>

# iCloud sidebar sync (optional; leave unset for a build that says "iCloud sync unavailable").
# Steps in docs/ICLOUD-SETUP.md. Restricted entitlements: without a matching development
# profile macOS kills the app at launch, so the bundle scripts check the profile first.
#REARC_ICLOUD_CONTAINER="iCloud.com.rearc.browser"
#REARC_PROVISIONING_PROFILE="$HOME/Library/Developer/ReArc/ReArc_Development.provisionprofile"
# Only for scripts/bundle-webkit-dev.sh (its bundle id is com.rearc.browser.webkit-dev):
#REARC_WEBKIT_PROVISIONING_PROFILE="$HOME/Library/Developer/ReArc/ReArc_WebKit_Dev.provisionprofile"
# Development (default) or Production CloudKit environment:
#REARC_ICLOUD_ENVIRONMENT="Development"
